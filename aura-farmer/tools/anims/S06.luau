--!nocheck
-- S06 (5.900–6.600): сверхкрупно рот коня на фоне солнца. Камера неподвижна (штатив),
-- всё движение — голова, челюсть и губы. Пик смеха — на долю 12 (6.017 с), затем «замершая» улыбка.
--
-- Лицо задаётся напрямую суставами (градусы/студы), чтобы не зависеть от масштаба каналов face:
--   jaw(deg)  — раскрытие нижней челюсти (Jaw.rx = -deg);
--   lip(g, …) — верхняя губа: g=1 — поднята и вывернута (видны зубы), g<0 — опущена (рот закрыт).
local T0, N0, R0 = -9.8, -10.0, 0.3 -- «дом» шеи: голова повёрнута вправо (морда к левому краю кадра), подбородок вверх

-- смещение корня: s — к левому краю кадра, c — к камере, y — вверх (студы)
local PSI = math.rad(24.6) -- курс камеры (от -Z к -X), см. Shots/S06.luau
local function off(s, c, y)
	return { x = s * math.cos(PSI) - c * math.sin(PSI), y = y or 0, f = s * math.sin(PSI) + c * math.cos(PSI) }
end
local function neck(turn, nod, tilt)
	return { turn = T0 + (turn or 0), nod = N0 + (nod or 0), tilt = R0 + (tilt or 0) }
end
local NOFACE = { jaw = 0, grin = 0, ears = 1 } -- уши прижаты назад (не торчат над мордой в кадре)
local function mouth(jawDeg, g, ef, ey, erx)
	return {
		Jaw = { rx = -jawDeg },
		UpperLip = { y = 0.04 * g + (ey or 0), f = 0.05 * g + (ef or 0), rx = 4 * g + (erx or 0) },
	}
end

local function key(t, ease, s, c, y, dTurn, dNod, dTilt, jawDeg, g)
	return { t = t, ease = ease, root = off(s, c, y), neck = neck(dTurn, dNod, dTilt), face = NOFACE, joints = mouth(jawDeg, g) }
end

return {
	Horse = { keys = {
		--      t      ease       s(лев) c(камера) y     поворот кивок крен  челюсть губа
		-- 5.900 склейка: губы сомкнуты в самодовольной улыбке
		key(5.9, "smooth", 0, 0, 0, 0, 0, 0, -4, -0.8),
		-- 5.933 челюсть «щёлкает» вниз (почти поп), верхняя губа поднимается
		key(5.933, "out", 0.005, 0, 0.04, 0, -1, 1, 4, 0.4),
		-- 5.967 = 6.000 (на двойках): большой оскал, голова чуть вверх и вправо по крену
		key(5.967, "hold", 0.02, 0, -0.06, 0, -3, 2, 8, 1.1),
		key(6.0, "out", 0.02, 0, -0.06, 0, -3, 2, 8, 1.1),
		-- 6.033 пик смеха (доля 12 = 6.017): челюсть максимально, рывок к объективу и влево
		key(6.033, "smooth", 0.15, 0.1, -0.17, 4, -4, -3, 18, 1.2),
		key(6.067, "inout", 0.29, 0.13, -0.17, 6, -3, -4, 16.5, 1.2),
		-- 6.100 возврат, челюсть быстро закрывается
		key(6.1, "smooth", 0.08, 0.05, -0.03, 2, -1, -1, 7, 1.2),
		-- 6.133 = 6.167 почти дома
		key(6.133, "hold", 0.013, 0, 0.04, 0, 0, 0, 5, 1.0),
		key(6.167, "smooth", 0.013, 0, 0.04, 0, 0, 0, 5, 1.0),
		-- 6.200 дома, челюсть чуть «перезакрылась» (резиновый «боинг»)
		key(6.2, "smooth", 0, 0, 0, 0, 0, 0, 3.5, 1.0),
		-- 6.300…6.600 замершая улыбка «чи-и-из»
		key(6.3, "smooth", 0, 0, 0, 0, 0, 0, 4, 1.0),
		key(6.6, "smooth", 0, 0, 0, 0, 0, 0, 4, 1.0),
	} },
}
