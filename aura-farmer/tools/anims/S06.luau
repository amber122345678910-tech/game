--!nocheck
-- S06 (5.900–6.600): сверхкрупно рот коня на фоне солнца. Камера неподвижна (штатив),
-- всё движение — голова, челюсть и губы. Пик смеха — на долю 12 (6.017 с), затем «замершая» улыбка.
--
-- Лицо задаётся напрямую суставами (градусы/студы):
--   jaw      — раскрытие нижней челюсти, градусы (Jaw.rx = -jaw);
--   lip      — верхняя губа { подъём y, вперёд f, выворот rx }. Губа должна лежать на зубах (f ≥ 0):
--              при f < 0 она прячется под бархатную кожу морды, при большом f снизу виден тёмный «карман».
--   ll       — нижняя губа 0..1: опускается и выворачивается (видна красная кромка и нижние зубы).
-- «дом» шеи: голова чуть повёрнута вправо (морда к левому краю кадра, видна левая щека — заполняет правый край),
-- подбородок поднят. Камера (Shots/S06) подобрана так, что в «доме» середина верхних резцов — x≈58%, y≈47% кадра.
local T0, N0, R0 = -6, -10.0, 0.3

-- смещение корня: s — к левому краю кадра, c — к камере, y — вверх (студы)
local PSI = math.rad(24.6) -- курс камеры (от -Z к -X), см. Shots/S06.luau
local function off(s, c, y)
	return { x = s * math.cos(PSI) - c * math.sin(PSI), y = y or 0, f = s * math.sin(PSI) + c * math.cos(PSI) }
end
local function neck(turn, nod, tilt)
	return { turn = T0 + (turn or 0), nod = N0 + (nod or 0), tilt = R0 + (tilt or 0) }
end
local NOFACE = { jaw = 0, grin = 0, ears = 1 } -- уши прижаты назад (не торчат над мордой в кадре)
-- очки чуть выше по переносице: в кадре только низ оправ (как в клипе)
local GLASSES = { y = 0.06, f = -0.065 }

local function mouth(jaw, lip, ll)
	ll = ll or 0
	return {
		Jaw = { rx = -jaw },
		UpperLip = { y = lip[1], f = lip[2], rx = lip[3] },
		LowerLip = { y = -0.03 * ll, f = 0.01 * ll, rx = -8 * ll },
		Glasses = GLASSES,
	}
end

-- p = { s, c, y, dTurn, dNod, dTilt }
local function key(t, ease, p, jaw, lip, ll)
	return { t = t, ease = ease, root = off(p[1], p[2], p[3]), neck = neck(p[4], p[5], p[6]), face = NOFACE, joints = mouth(jaw, lip, ll) }
end

local HOME = { 0, 0.005, 0.024, 0, 0, 0 }
local CLOSED = { -0.02, 0, -2 } -- губы сомкнуты (самодовольная улыбка), нижняя губа спрятана под подбородком
local GRIN = { 0.045, 0.005, 0 } -- губа поднята и лежит на зубах

return {
	Horse = { keys = {
		-- 5.900 склейка: губы сомкнуты в самодовольной улыбке
		key(5.9, "out", { -0.02, 0.023, 0.078, 0, 0, 0 }, -4, CLOSED, 0),
		-- 5.933 челюсть «щёлкает» вниз (почти поп), верхняя губа поднимается
		key(5.933, "out", { -0.02, 0.019, -0.008, 0, -1, 1 }, 3.5, { 0.025, 0, 0 }, 0.2),
		-- 5.967 = 6.000 (на двойках): большой оскал, голова чуть вверх, крен
		key(5.967, "hold", { 0.002, 0.061, -0.078, 0, -3, 2 }, 8, GRIN, 0.4),
		key(6.0, "out", { 0.002, 0.061, -0.078, 0, -3, 2 }, 8, GRIN, 0.4),
		-- 6.033 пик смеха (доля 12 = 6.017): челюсть максимально, рывок к объективу и влево
		key(6.033, "smooth", { 0.189, 0.09, -0.21, 4, -7, -3 }, 24, { 0.05, 0.01, 2 }, 1),
		key(6.067, "inout", { 0.264, 0.054, -0.173, 6, -5, -4 }, 23, { 0.05, 0.01, 2 }, 1),
		-- 6.100 возврат, челюсть быстро закрывается
		key(6.1, "smooth", { 0.088, 0.04, -0.062, 2, -2, -1 }, 7, GRIN, 1),
		-- 6.133 = 6.167 почти дома
		key(6.133, "hold", { 0.006, 0.012, 0.014, 0, 0, 0 }, 4, GRIN, 0.9),
		key(6.167, "smooth", { 0.006, 0.012, 0.014, 0, 0, 0 }, 4, GRIN, 0.9),
		-- 6.200 дома, челюсть чуть «перезакрылась» (резиновый «боинг»)
		key(6.2, "smooth", HOME, 2.2, GRIN, 0.75),
		-- 6.300…6.600 замершая улыбка «чи-и-из»
		key(6.3, "smooth", HOME, 2.6, GRIN, 0.8),
		-- микродвижение «замершей» улыбки: дрейф челюсти < 0.5°, голова почти неподвижна (доля 13 = 6.504 — без акцента)
		key(6.45, "smooth", { 0, 0.006, 0.026, 0, -0.2, 0 }, 2.8, GRIN, 0.83),
		key(6.6, "smooth", HOME, 2.7, GRIN, 0.8),
	} },
}
