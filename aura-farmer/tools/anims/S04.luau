	{ 4.6333, fist(-1.92, 5.16, 0.94) },
	{ 4.9667, fist(-1.92, 5.17, 0.94), THUMB },
}

local keys = {}
local byT = {}
local function key(t)
	local k = byT[t]
	if not k then
		k = { t = t }
		byT[t] = k
		table.insert(keys, k)
	end
	return k
end

for _, b in body do
	local k = key(b[1])
	k.ease = b[8]
	k.root = { turn = b[2], x = b[9], y = b[10], f = b[11] }
	k.waist = { turn = b[3], bend = b[4] }
	k.neck = { turn = b[5], nod = b[6], tilt = b[7] }
end
for _, f in faceKeys do
	local k = key(f[1])
	k.face = { jaw = f[2], grin = f[3], brows = f[4] }
	k.joints = { LeftEar = { rz = f[5], rx = f[7] }, RightEar = { rz = f[6], rx = f[7] }, Mane = { rx = f[8], rz = f[9] } }
end
for _, a in armKeys do
	local k = key(a[1])
	k.lArm = a[2]
	k.lHand = a[3]
end

-- правая рука висит (вне кадра), ноги стоят на месте
-- правая рука на хлысте отстаёт назад и догоняет (follow-through), затем висит
local rArmKeys = {
	{ 3.8667, 8, -12, 20 },
	{ 3.9333, 12, -22, 26 },
	{ 4.0, 10, 4, 22 },
	{ 4.1667, 7, -3, 14 },
	{ 4.9667, 6, -4, 12 },
}
for _, r in rArmKeys do
	key(r[1]).rArm = { out = r[2], fwd = r[3], elbow = r[4] }
end
for _, t in { 3.8667, 4.9667 } do
	local k = key(t)
	k.rLeg = { ik = { 0.55, 0.3, 0 }, foot = { yaw = 0 } }
	k.lLeg = { ik = { -0.55, 0.3, 0 }, foot = { yaw = 0 } }
end

table.sort(keys, function(a, b)
	return a.t < b.t
end)

return {
	Horse = { keys = keys },
}
