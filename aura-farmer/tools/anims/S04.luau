	{ 4.9667, 0, 1.2, -0.15, -3, 3, -15, 0, 0 },
}

-- t, lArm, lHand
local armKeys = {
	{ 3.8667, { ik = { -1.45, 2.35, 0.15 }, space = "chest", pole = { -0.6, -0.2, -1 }, wrist = { palm = { 1, 0, 0 }, fingers = { 0, -1, 0 } } }, "relaxed" },
	{ 3.9, { ik = { -0.93, 5.25, 2.25 }, space = "chest", pole = { -0.96, -0.28, -0.01 }, wrist = { palm = { 0, -1, 0 }, fingers = { 0.1, 0, 1 } } }, "open" },
	{ 3.9333, { ik = { -2.45, 4.82, 2.03 }, space = "chest", pole = { -0.2, -0.98, -0.04 }, wrist = { palm = { 0.6, -0.6, 0.5 }, fingers = { -0.2, 0.6, 0.8 } } }, { curl = 0.7, thumb = 0, thumbOut = 1.2, spread = 0 } },
