	{ 4.2333, 0, -3, -5, -32.3, 0, -14, nil, 0, -0.03, 0 },
	{ 4.3, 0, -3, -4, -32.5, 1, -15, nil, 0, -0.07, 0 },
	{ 4.4333, 0, -3, -4, -32.5, 1, -15, "Sine_Out", 0, -0.07, 0 },
	{ 4.5333, 0, -2.2, -2.2, -33.2, -4, -11, nil, 0, -0.055, 0 },
	{ 4.6333, 0, -1.8, -1.5, -33.7, -6.5, -9.5, nil, 0, -0.05, 0 },
	{ 4.9667, 0, -1.8, -2.6, -33.2, -8, -10.5, nil, 0, -0.04, 0 },
}

-- t, jaw, grin, brows, LeftEar.rz (+ наружу), RightEar.rz (− наружу), уши rx (− назад), Mane.rx (− назад), Mane.rz (+ к левому плечу)
-- рот: закрыт -> на хлысте открывается -> смех «ХА!» с пиком на доле 4.066 -> закрывается к доле 4.553 в оскал
local faceKeys = {
	{ 3.8667, 0, 0.2, 0, 5, -5, -12, 0, 0 },
	{ 3.9, 0.2, 0.6, 0.2, 30, -10, -16, -8, 8 },
