	{ 4.0667, 0, -3, -8, -27, 0, -7, nil, 0, 0.04, 0 },
	{ 4.1667, 0, -3, -7, -27, 6, -5, "Sine_InOut", 0, 0.02, 0 },
	{ 4.2333, 0, -3, -5, -26, 11, -4, nil, 0, -0.03, 0 },
	{ 4.3, 0, -3, -4, -24.5, 14.5, -4, nil, 0, -0.07, 0 },
	{ 4.4333, 0, -3, -4, -24.5, 14.5, -4, "Sine_Out", 0, -0.07, 0 },
	{ 4.5333, 0, -2.2, -2.2, -27, 9.2, -4, nil, 0, -0.055, 0 },
	{ 4.6333, 0, -1.8, -1.5, -28.5, 5.5, -4, nil, 0, -0.05, 0 },
	{ 4.9667, 0, -1.8, -2.6, -28.5, 5.6, -4.5, nil, 0, -0.04, 0 },
}

-- t, jaw, grin, brows, LeftEar.rz (+ наружу), RightEar.rz (− наружу), уши rx (− назад), Mane.rx (− назад), Mane.rz (+ к левому плечу)
-- рот: закрыт -> на хлысте открывается -> смех «ХА!» с пиком на доле 4.066 -> закрывается к доле 4.553 в оскал
local faceKeys = {
	{ 3.8667, 0, 0.1, 0, 5, -5, -40, -10, 0 },
	{ 3.9, 0.15, 0.6, 0.2, 30, -10, -30, -12, 8 },
	{ 3.9333, 0.38, 0.9, 0.35, 60, -15, -18, -14, 12 },
	{ 3.9667, 0.45, 1.1, 0.4, 62, -12, -15, -10, 6 },
	{ 4.0, 0.5, 1.2, 0.4, 48, -6, -13, -2, -3 },
	{ 4.0333, 0.64, 1.3, 0.45, 32, -3, -12, 5, -2 },
	{ 4.0667, 0.7, 1.35, 0.45, 16, 2, -12, 3, 0 },
	{ 4.1667, 0.5, 1.35, 0.3, -10, 6, -14, -1, 0 },
