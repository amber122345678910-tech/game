	{ 3.9667, 0.65, 1.1, 0.4, 45, -10, -15, -10, 6 },
	{ 4.0, 0.75, 1.2, 0.4, 35, -6, -13, -2, -3 },
	{ 4.0333, 1.0, 1.3, 0.45, 22, -3, -12, 5, -2 },
	{ 4.0667, 1.15, 1.35, 0.45, 10, 2, -12, 3, 0 },
	{ 4.1667, 0.8, 1.35, 0.3, -10, 6, -14, -1, 0 },
