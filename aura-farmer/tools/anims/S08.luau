-- Поза (как в S09): лежит на животе, грудь поднята, руки в стороны-назад к поднятым щиколоткам.
-- Для селфи-ракурса голова «втянута» между высоко поднятыми плечами (как в кадре клипа: верх плеч
-- почти на уровне глаз, воротник рубашки по бокам челюсти) — это сдвиг сустава Head вниз-назад
-- относительно груди (шея уходит в воротник, из камеры не видно).
-- Камера неподвижна, всё движение — от коня:
--   голова подлетает (подбородок вверх) на доли 16/17 (7.968, 8.456) и оседает на слабых долях;
--   губы смыкаются на «p» (8.27–8.33) и «m» (8.63–8.67); большой акцент «MOR-» на доле 18 (8.944):
--   голова вверх и к правому плечу персонажа (влево в кадре), подбородок назад −12°, челюсть до упора,
--   грудь и плечи поднимаются; «-NING» — широкий оскал до конца плана; на доле 19 (9.432) — малый подъём.
--   Левое плечо персонажа (справа в кадре) пожимается на каждой доле с отставанием ~0.08 с.
-- Смещения головы (HEAD) подобраны численно по трекингу очков в референсе (положение в кадре).

local ROOT = { y = -2.25, bend = 88 }
local B0 = 30 -- наклон груди вперёд от вертикали (root.bend + waist.bend)
local EAR = 62 -- уши назад (градусы)
local P0 = 6 -- базовый наклон лица (подбородок вверх, градусы мира)
local BASE = { x = 0, up = -1.0, fwd = -0.45 } -- базовое смещение сустава Head (мир: вправо персонажа, вверх, к камере)

-- ===== матрицы 3x3 (поворот сустава Head в системе груди) =====
local rad, deg = math.rad, math.deg
local function rx(a)
	local c, s = math.cos(rad(a)), math.sin(rad(a))
	return { { 1, 0, 0 }, { 0, c, -s }, { 0, s, c } }
end
local function rz(a)
	local c, s = math.cos(rad(a)), math.sin(rad(a))
	return { { c, -s, 0 }, { s, c, 0 }, { 0, 0, 1 } }
end
local function mul(a, b)
	local r = {}
	for i = 1, 3 do
		r[i] = {}
		for j = 1, 3 do
			r[i][j] = a[i][1] * b[1][j] + a[i][2] * b[2][j] + a[i][3] * b[3][j]
		end
	end
	return r
end
local function mv(m, v)
	return {
		m[1][1] * v[1] + m[1][2] * v[2] + m[1][3] * v[3],
		m[2][1] * v[1] + m[2][2] * v[2] + m[2][3] * v[3],
		m[3][1] * v[1] + m[3][2] * v[2] + m[3][3] * v[3],
	}
end

-- Сустав Head: мировое смещение (dx — к правому плечу персонажа, up — вверх, fwd — к камере),
-- мировой наклон лица pitch (подбородок вверх+) и крен roll (+ к левому плечу персонажа),
-- с учётом текущего наклона груди B и крена tilt (Head задаётся в системе груди).
local function head(dx, up, fwd, pitch, roll, B, tilt)
	local inv = mul(rz(tilt), rx(B)) -- (Rx(-B)·Rz(-tilt))⁻¹; крен талии tilt+ = Rz(-tilt)
	local p = mv(inv, { dx, up, -fwd })
	local R = mul(inv, mul(rx(pitch), rz(roll)))
	-- разложение R = Rx(a)·Ry(b)·Rz(c) (как CFrame.Angles)
	local b = math.asin(math.clamp(R[1][3], -1, 1))
	local a = math.atan2(-R[2][3], R[3][3])
	local c = math.atan2(-R[1][2], R[1][1])
	return { x = p[1], y = p[2], f = -p[3], rx = deg(a), ry = deg(b), rz = deg(c) }
end

