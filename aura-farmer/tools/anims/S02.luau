--!nocheck
-- Ключи анимации плана S02 (см. tools/lib/Pose.luau — формат ключей).
-- Вставка: кулаки держат ремень по бокам от пряжки «A», камера неподвижна, всё движение — от бёдер.
-- Таз (root): x/y/крен сняты покадрово с референса (положение и наклон «A» в кадре, 25 к/с),
-- переведены в студы в плоскости пряжки. Провалы бёдер ~на доли 1.626 / 2.114 / 2.602 (на 1–2 кадра раньше),
-- верхи — на полудолях (1.867, ~2.27). Крен: +7.4° (правое бедро вниз) -> −4.6° -> +5.3°, период 2 доли.
-- Талия гасит ~75% крена — грудь почти ровная, «восьмёрка» идёт только бёдрами.
-- Кулаки — IK в пространстве таза (едут вместе с ремнём), на провалах — дожим (кисть чуть вниз/назад,
-- пальцы плотнее), в 1.933 — короткий рывок кистями «под солнце» (мотивирует блик пряжки).

-- Кисти на ремне. p — дожим на провале (0..1), snap — рывок кистями (0..1).
local function arms(t, p, snap, ease)
	snap = snap or 0
	local k = p + snap * 1.4
	local fy, ff = -0.7 - 0.1 * k, 0.38 - 0.12 * k
	return {
		t = t,
		ease = ease,
		rArm = {
			ik = { 0.86, 3.21 - 0.02 * p, 0.74 - 0.012 * p },
			space = "hips",
			pole = { 1, 0.1, 0.2 },
			wrist = { palm = { 0, -0.5, -1 }, fingers = { -0.6, fy, ff } },
		},
		lArm = {
			ik = { -0.86, 3.21 - 0.02 * p, 0.74 - 0.012 * p },
			space = "hips",
			pole = { -1, 0.1, 0.2 },
			wrist = { palm = { 0, -0.5, -1 }, fingers = { 0.6, fy, ff } },
		},
		rHand = { curl = 0.9 + 0.07 * p, thumb = 0.9, thumbOut = 0.1 },
		lHand = { curl = 0.9 + 0.07 * p, thumb = 0.9, thumbOut = 0.1 },
	}
end

local keys = {
	-- ===== Таз и талия =====
	{ t = 1.380, root = { x = -0.086, y = -0.025, tilt = 4.0 }, waist = { tilt = -3.0 } },
	{ t = 1.467, root = { x = -0.056, y = -0.077, tilt = 5.8 }, waist = { tilt = -4.3 } },
	{ t = 1.600, root = { x = 0.007, y = -0.144, tilt = 7.4 }, waist = { tilt = -5.6 } }, -- доля 1.626
	{ t = 1.633, root = { x = 0.032, y = -0.102, tilt = 6.9 }, waist = { tilt = -5.2 } }, -- резкий отскок
	{ t = 1.733, root = { x = 0.056, y = -0.040, tilt = 4.0 }, waist = { tilt = -3.0 } },
	{ t = 1.867, root = { x = 0.120, y = -0.020, tilt = -0.9 }, waist = { tilt = 0.7 } }, -- верх
	{ t = 1.967, root = { x = 0.129, y = -0.098, tilt = -4.5 }, waist = { tilt = 3.4 } }, -- крайнее положение вправо
	{ t = 2.067, root = { x = 0.108, y = -0.130, tilt = -4.6 }, waist = { tilt = 3.4 } }, -- доля 2.114
	{ t = 2.200, root = { x = 0.063, y = -0.085, tilt = -1.8 }, waist = { tilt = 1.4 } },
	{ t = 2.267, root = { x = 0.034, y = -0.063, tilt = 0.5 }, waist = { tilt = -0.4 } }, -- верх
	{ t = 2.367, root = { x = 0.009, y = -0.077, tilt = 2.9 }, waist = { tilt = -2.2 } },
	{ t = 2.467, root = { x = 0.003, y = -0.183, tilt = 4.9 }, waist = { tilt = -3.7 } },
	{ t = 2.533, root = { x = 0.017, y = -0.187, tilt = 5.0 }, waist = { tilt = -3.8 } }, -- доля 2.602, самый низ
	{ t = 2.600, root = { x = 0.036, y = -0.128, tilt = 5.3 }, waist = { tilt = -4.0 } },
	{ t = 2.667, root = { x = 0.042, y = -0.070, tilt = 5.0 }, waist = { tilt = -3.8 } },
	{ t = 2.750, root = { x = 0.044, y = -0.025, tilt = 4.0 }, waist = { tilt = -3.0 } },

	-- ===== Ноги: стопы стоят на песке, колени гнутся на провалах =====
	{ t = 1.380, rLeg = { ik = { 0.55, 0.3, 0 } }, lLeg = { ik = { -0.55, 0.3, 0 } } },
	{ t = 2.750, rLeg = { ik = { 0.55, 0.3, 0 } }, lLeg = { ik = { -0.55, 0.3, 0 } } },

	-- ===== Голова вне кадра: кивок на доли (для непрерывности) =====
	{ t = 1.380, neck = { nod = 2 } },
	{ t = 1.600, neck = { nod = 6, tilt = -2 } },
	{ t = 1.867, neck = { nod = 0, tilt = 1 } },
	{ t = 2.067, neck = { nod = 5, tilt = 2 } },
	{ t = 2.267, neck = { nod = 0 } },
	{ t = 2.533, neck = { nod = 6, tilt = -2 } },
	{ t = 2.750, neck = { nod = 1 } },

	-- ===== Кулаки на ремне =====
	arms(1.380, 0.3),
	arms(1.533, 0.6),
	arms(1.600, 1.0),
	arms(1.700, 0.1),
	arms(1.867, 0),
	arms(1.900, 0.05),
	arms(1.933, 0.3, 1), -- рывок кистями: «A» ловит солнце
	arms(1.990, 0.5, 0.15),
	arms(2.067, 1.0),
	arms(2.200, 0.2),
	arms(2.300, 0),
	arms(2.433, 0.6),
	arms(2.533, 1.0),
	arms(2.650, 0.3),
	arms(2.750, 0),
}

return {
	Horse = { keys = keys },
}
