--!nocheck
-- Ключи анимации плана S02 (см. tools/lib/Pose.luau — формат ключей).
-- Вставка: кулаки держат ремень по бокам от пряжки «A», камера неподвижна, всё движение — от бёдер.
-- Таз (root): x/y/крен подогнаны покадрово к референсу (низ «A» и центр её основания в кадре 854×480 на каждом
-- кадре 25 к/с, расхождение превью с клипом ≲ ±8 px). Провалы бёдер — 1.600 / 2.067 / 2.533 (на 1–2 кадра раньше
-- долей 1.626 / 2.114 / 2.602): вниз с ускорением, вверх — плавно, верхи на полудолях (≈1.85, ≈2.27).
-- Крен: +7.4° (правое бедро вниз) -> −4° -> +5.4°, период 2 доли; боковой «маятник» вправо к 1.93, обратно к 2.43.
-- Вперёд таз почти не ходит (пряжка в клипе не меняет размер) — лишь ~0.015 на провалах, «дожим».
-- Талия гасит ~75% крена и ~60% бокового сдвига — грудь почти неподвижна, «восьмёрка» идёт только бёдрами.

-- Хват (как в клипе): запястья — выше и снаружи, тыл кисти смотрит в камеру (чуть вверх), кисть идёт от запястья
-- вниз-внутрь-вперёд, ряд костяшек — внизу у ремня, пальцы подогнуты под ремень (большой палец — за ремнём);
-- перстни на средних пальцах — у нижнего внутреннего края кулака, печатками к камере.
-- Правый кулак (слева в кадре) лежит положе, левый (справа в кадре) — круче, как в референсе.
local GRIP = {
	R = { wrist = { 0.905, 3.24, 0.32 }, palm = { -0.3, -0.35, -1 }, fingers = { -0.52, -0.72, 0.42 }, pole = { 1, -0.2, -0.4 } },
	L = { wrist = { -0.74, 3.15, 0.32 }, palm = { 0.3, -0.3, -1 }, fingers = { 0.18, -0.86, 0.48 }, pole = { -1, -0.2, -0.4 } },
	curl = 0.82,
}

-- Кисти на ремне (IK в пространстве таза — кулаки «приклеены» к ремню и едут с бёдрами).
-- r, l = { dx, dy } — поправка запястья (студы). sq — дожим (0..1): кисть сгибается к ладони, пальцы плотнее;
-- snap — короткий рывок кистями «под солнце» (мотивирует блик в 1.933).
local function arms(t, r, l, sq, snap, ease)
	sq = sq or 0
	snap = snap or 0
	local function side(g, o)
		local w, fg = g.wrist, g.fingers
		local k = 0.05 * sq + 0.1 * snap
		return {
			ik = { w[1] + o[1], w[2] + o[2], w[3] - 0.01 * sq },
			space = "hips",
			pole = g.pole,
			wrist = { palm = g.palm, fingers = { fg[1], fg[2] - k, fg[3] - k } },
		}
	end
	local c = GRIP.curl + 0.06 * sq
	-- средний (с перстнем) чуть разогнут — печатка смотрит в камеру; безымянный и мизинец подогнуты под ремень
	local hand = { index = c + 0.04, middle = c - 0.15, ring = c + 0.12, pinky = c + 0.16, thumb = 0.9, thumbOut = 0.1 }
	return {
		t = t,
		ease = ease,
		rArm = side(GRIP.R, r),
		lArm = side(GRIP.L, l),
		rHand = hand,
		lHand = hand,
	}
end

-- ===== Таз =====
-- t, x (+ вправо от коня = влево в кадре), y, крен (+ правое бедро вниз), f (вперёд), ease
local ROOT = {
	{ 1.380, -0.088, -0.025, 4.0, 0.004 },
	{ 1.433, -0.067, -0.054, 5.2, 0.006 },
	{ 1.533, 0.011, -0.123, 6.6, 0.011 },
	{ 1.600, 0.065, -0.163, 7.4, 0.015, "out" }, -- доля 1.626
	{ 1.667, 0.091, -0.125, 6.0, 0.012 },
	{ 1.733, 0.111, -0.045, 3.8, 0.006 },
	{ 1.800, 0.133, -0.022, 1.5, 0.002 },
	{ 1.867, 0.142, -0.024, -0.3, 0.000 }, -- верх
	{ 1.933, 0.142, -0.079, -3.0, 0.006 }, -- крайнее положение вправо
	{ 2.000, 0.129, -0.118, -3.8, 0.010 },
	{ 2.067, 0.114, -0.154, -4.0, 0.013 }, -- доля 2.114
	{ 2.133, 0.087, -0.123, -2.8, 0.009 },
	{ 2.200, 0.067, -0.103, -1.0, 0.005 },
	{ 2.267, 0.047, -0.059, 1.0, 0.003 }, -- верх
	{ 2.367, 0.024, -0.085, 3.6, 0.006 },
	{ 2.433, 0.014, -0.173, 5.0, 0.012 },
	{ 2.533, 0.034, -0.212, 5.4, 0.015 }, -- доля 2.602, самый низ
	{ 2.600, 0.052, -0.151, 5.2, 0.012 },
	{ 2.667, 0.061, -0.098, 4.9, 0.008 },
	{ 2.750, 0.066, -0.043, 4.0, 0.002 },
}

local keys = {}
for _, r in ROOT do
	local x, tilt = r[2], r[4]
	table.insert(keys, {
		t = r[1],
		ease = r[6],
		root = { x = x, y = r[3], tilt = tilt, f = r[5] },
		-- противокрен талии (~75%) + компенсация бокового сдвига (грудь ходит ~40% от таза)
		waist = { tilt = -0.75 * tilt - 30 * x },
	})
end

for _, k in {
	-- ===== Ноги: стопы стоят на песке, колени гнутся на провалах =====
	{ t = 1.380, rLeg = { ik = { 0.55, 0.3, 0 } }, lLeg = { ik = { -0.55, 0.3, 0 } } },
	{ t = 2.750, rLeg = { ik = { 0.55, 0.3, 0 } }, lLeg = { ik = { -0.55, 0.3, 0 } } },

	-- ===== Голова вне кадра: кивок на доли (для непрерывности) =====
	{ t = 1.380, neck = { nod = 2 } },
	{ t = 1.600, neck = { nod = 6, tilt = -2 } },
	{ t = 1.867, neck = { nod = 0, tilt = 1 } },
	{ t = 2.067, neck = { nod = 5, tilt = 2 } },
	{ t = 2.267, neck = { nod = 0 } },
	{ t = 2.533, neck = { nod = 6, tilt = -2 } },
	{ t = 2.750, neck = { nod = 1 } },

	-- ===== Кулаки на ремне =====
	-- поправки подогнаны к положению перстней на кадрах клипа (1.433/1.867/2.067/2.267/2.533/2.667, ±2 px):
	-- на провалах кулаки проваливаются чуть меньше таза (руки «держат» вес), в 1.933–2.07 — рывок вверх-наружу
	arms(1.380, { -0.001, 0.000 }, { 0.034, 0.013 }, 0.3),
	arms(1.433, { -0.001, 0.000 }, { 0.034, 0.013 }, 0.5),
	arms(1.600, { -0.010, 0.012 }, { 0.039, 0.053 }, 1.0), -- доля 1.626: дожим
	arms(1.700, { -0.016, -0.024 }, { 0.041, 0.018 }, -0.2), -- отдача: кулаки чуть «подлетают» и оседают
	arms(1.867, { -0.027, -0.022 }, { 0.046, 0.036 }, 0),
	arms(1.900, { -0.018, -0.002 }, { 0.048, 0.050 }, 0.1),
	arms(1.933, { 0.010, 0.040 }, { 0.071, 0.072 }, 0.3, 1), -- рывок кистями: «A» ловит солнце
	arms(1.990, { 0.024, 0.031 }, { 0.075, 0.055 }, 0.6, 0.2),
	arms(2.067, { 0.034, 0.012 }, { 0.070, 0.022 }, 1.0), -- доля 2.114: дожим
	arms(2.160, { 0.005, -0.026 }, { 0.073, -0.014 }, -0.15),
	arms(2.267, { -0.015, -0.036 }, { 0.090, 0.002 }, 0),
	arms(2.433, { -0.021, -0.041 }, { 0.053, -0.003 }, 0.6),
	arms(2.533, { -0.025, -0.040 }, { 0.032, 0.009 }, 1.0), -- доля 2.602: дожим
	arms(2.600, { -0.039, -0.056 }, { 0.046, 0.012 }, 0.5),
	arms(2.667, { -0.052, -0.062 }, { 0.058, 0.013 }, 0),
	arms(2.750, { -0.052, -0.062 }, { 0.058, 0.013 }, 0),
} do
	table.insert(keys, k)
end

return {
	Horse = { keys = keys },
}
