--!nocheck
-- Ключи анимации плана S02 (см. tools/lib/Pose.luau — формат ключей).
-- Вставка: кулаки держат ремень по бокам от пряжки «A», камера неподвижна, всё движение — от бёдер.
-- Таз (root): x/y/крен сняты покадрово с референса (положение, высота нижнего края и наклон «A» в кадре,
-- 25 к/с), переведены в студы в плоскости пряжки; превью совпадает с клипом в пределах ~±8 px (854×480).
-- Провалы бёдер ~на доли 1.626 / 2.114 / 2.602 (на 1–2 кадра раньше), верхи — на полудолях (1.867, ~2.27).
-- Крен: +7.4° (правое бедро вниз) -> −4.2° -> +5.4°, период 2 доли. Вперёд таз почти не ходит (пряжка
-- в клипе не меняет размер) — лишь ~0.015 на провалах, «дожим».
-- Талия гасит ~75% крена — грудь почти ровная, «восьмёрка» идёт только бёдрами.
-- Кулаки — IK в пространстве таза (едут вместе с ремнём), на провалах — дожим (кисть чуть вниз/назад,
-- пальцы плотнее), в 1.933 — короткий рывок кистями «под солнце» (мотивирует блик пряжки).

-- Хват (как в клипе): манжеты/запястья — в верхних углах кадра, кисть свисает от запястья вниз-внутрь
-- к пряжке, тыл кисти смотрит в камеру (снизу), пальцы перехватывают ремень и загибаются под него,
-- большой палец — за ремнём. Перстни — на нижнем внутреннем «кулаке», печатками в камеру.
-- Правый кулак (слева в кадре) лежит положе, левый (справа в кадре) — круче, как в референсе.
local GRIP = {
	R = { wrist = { 0.74, 3.14, 0.40 }, palm = { -0.16, -0.82, -0.54 }, fingers = { -0.40, -0.45, 0.80 }, pole = { 1, -0.2, -0.4 } },
	L = { wrist = { -0.73, 3.07, 0.40 }, palm = { 0.12, -0.82, -0.56 }, fingers = { 0.35, -0.50, 0.80 }, pole = { -1, -0.2, -0.4 } },
	curl = 0.82,
}

-- Кисти на ремне (IK в пространстве таза — кулаки «приклеены» к ремню и едут с бёдрами).
-- r, l = { dx, dy } — поправка запястья (студы): в клипе кулаки проваливаются примерно на 60% глубины
-- провала бёдер (руки чуть «держат» вес), на верхах — немного выше. sq — дожим (0..1): кисть сгибается к
-- ладони, пальцы плотнее; snap — короткий рывок кистями «под солнце» (мотивирует блик в 1.933).
local function arms(t, r, l, sq, snap, ease)
	sq = sq or 0
	snap = snap or 0
	local function side(g, o)
		local w, fg = g.wrist, g.fingers
		local k = 0.1 * sq + 0.12 * snap
		return {
			ik = { w[1] + o[1], w[2] + o[2], w[3] - 0.01 * sq },
			space = "hips",
			pole = g.pole,
			wrist = { palm = g.palm, fingers = { fg[1], fg[2] - k, fg[3] - k } },
		}
	end
	local curl = GRIP.curl + 0.06 * sq
	return {
		t = t,
		ease = ease,
		rArm = side(GRIP.R, r),
		lArm = side(GRIP.L, l),
		rHand = { curl = curl, thumb = 0.9, thumbOut = 0.1 },
		lHand = { curl = curl, thumb = 0.9, thumbOut = 0.1 },
	}
end

local keys = {
	-- ===== Таз и талия =====
	-- y сверены с высотой основания «A» на кадрах клипа (854×480: 360/402/329/360/391/345/410/419/380 px
	-- в 1.433/1.600/1.867/1.933/2.067/2.267/2.433/2.533/2.667), ~0.002 студа на пиксель.
	-- В провал — с ускорением (бьёт в долю), из провала — плавный подъём к верху на полудоле.
	{ t = 1.380, root = { f = 0.004, x = -0.066, y = -0.030, tilt = 4.0 }, waist = { tilt = -3.0 } },
	{ t = 1.433, root = { f = 0.006, x = -0.045, y = -0.046, tilt = 5.2 }, waist = { tilt = -3.9 } },
	{ t = 1.533, root = { f = 0.011, x = -0.004, y = -0.106, tilt = 6.6 }, waist = { tilt = -5.0 } },
	{ t = 1.600, ease = "out", root = { f = 0.015, x = 0.030, y = -0.134, tilt = 7.4 }, waist = { tilt = -5.6 } }, -- доля 1.626
	{ t = 1.640, root = { f = 0.013, x = 0.050, y = -0.100, tilt = 6.8 }, waist = { tilt = -5.1 } }, -- отскок
	{ t = 1.733, root = { f = 0.004, x = 0.072, y = -0.037, tilt = 3.8 }, waist = { tilt = -2.9 } },
	{ t = 1.867, root = { f = 0.000, x = 0.114, y = -0.030, tilt = -0.3 }, waist = { tilt = 0.2 } }, -- верх
	{ t = 1.933, root = { f = 0.006, x = 0.116, y = -0.064, tilt = -3.4 }, waist = { tilt = 2.6 } }, -- крайнее положение вправо
	{ t = 2.067, root = { f = 0.013, x = 0.092, y = -0.128, tilt = -4.2 }, waist = { tilt = 3.2 } }, -- доля 2.114
	{ t = 2.150, root = { f = 0.008, x = 0.068, y = -0.102, tilt = -2.8 }, waist = { tilt = 2.1 } },
	{ t = 2.267, root = { f = 0.003, x = 0.034, y = -0.054, tilt = 1.0 }, waist = { tilt = -0.8 } }, -- верх
	{ t = 2.367, root = { f = 0.006, x = 0.016, y = -0.070, tilt = 3.6 }, waist = { tilt = -2.7 } },
	{ t = 2.433, root = { f = 0.012, x = 0.012, y = -0.142, tilt = 5.0 }, waist = { tilt = -3.8 } },
	{ t = 2.533, root = { f = 0.015, x = 0.030, y = -0.176, tilt = 5.4 }, waist = { tilt = -4.1 } }, -- доля 2.602, самый низ
	{ t = 2.600, root = { f = 0.012, x = 0.046, y = -0.124, tilt = 5.2 }, waist = { tilt = -4.0 } },
	{ t = 2.667, root = { f = 0.008, x = 0.056, y = -0.078, tilt = 4.9 }, waist = { tilt = -3.7 } },
	{ t = 2.750, root = { f = 0.002, x = 0.060, y = -0.030, tilt = 4.0 }, waist = { tilt = -3.0 } },

	-- ===== Ноги: стопы стоят на песке, колени гнутся на провалах =====
	{ t = 1.380, rLeg = { ik = { 0.55, 0.3, 0 } }, lLeg = { ik = { -0.55, 0.3, 0 } } },
	{ t = 2.750, rLeg = { ik = { 0.55, 0.3, 0 } }, lLeg = { ik = { -0.55, 0.3, 0 } } },

	-- ===== Голова вне кадра: кивок на доли (для непрерывности) =====
	{ t = 1.380, neck = { nod = 2 } },
	{ t = 1.600, neck = { nod = 6, tilt = -2 } },
	{ t = 1.867, neck = { nod = 0, tilt = 1 } },
	{ t = 2.067, neck = { nod = 5, tilt = 2 } },
	{ t = 2.267, neck = { nod = 0 } },
	{ t = 2.533, neck = { nod = 6, tilt = -2 } },
	{ t = 2.750, neck = { nod = 1 } },

	-- ===== Кулаки на ремне =====
	-- поправки сверены с положением перстней на кадрах клипа (854×480)
	arms(1.380, { -0.01, 0.01 }, { 0.01, 0.01 }, 0.3),
	arms(1.433, { -0.015, 0.03 }, { 0.012, 0.023 }, 0.5),
	arms(1.600, { 0.02, 0.052 }, { 0, 0.068 }, 1.0), -- доля 1.626: дожим
	arms(1.700, { 0, 0.012 }, { 0.01, 0.02 }, -0.2), -- отдача: кулаки чуть «подлетают» и оседают
	arms(1.867, { -0.03, -0.008 }, { 0.03, 0.017 }, 0),
	arms(1.900, { -0.02, 0.03 }, { 0.02, 0.04 }, 0.1),
	arms(1.933, { 0.02, 0.10 }, { 0.028, 0.095 }, 0.3, 1), -- рывок кистями: «A» ловит солнце
	arms(1.990, { 0.03, 0.09 }, { 0.03, 0.085 }, 0.6, 0.2),
	arms(2.067, { 0.03, 0.067 }, { 0.048, 0.068 }, 1.0), -- доля 2.114: дожим
	arms(2.160, { 0, 0.03 }, { 0.04, 0.02 }, -0.15),
	arms(2.267, { -0.025, -0.024 }, { 0.07, -0.015 }, 0),
	arms(2.433, { -0.025, 0.015 }, { 0.02, 0.033 }, 0.6),
	arms(2.533, { -0.01, 0.028 }, { 0, 0.055 }, 1.0), -- доля 2.602: дожим
	arms(2.600, { -0.03, -0.01 }, { 0.02, 0.02 }, 0.5),
	arms(2.667, { -0.06, -0.058 }, { 0.04, -0.018 }, 0),
	arms(2.750, { -0.05, -0.04 }, { 0.03, -0.02 }, 0),
}

return {
	Horse = { keys = keys },
}
