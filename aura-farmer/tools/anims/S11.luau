--!nocheck
-- Ключи анимации плана S11 (см. tools/lib/Pose.luau — формат ключей).
-- Конь-король на троне, левая нога закинута на правую. 13.133 «Cuz…» — взгляд вниз в камеру с оскалом,
-- руки на подлокотниках; на доле 13.334 кулаки вверх + голова запрокинута в хохоте (пик 13.50) -> руки
-- широко в стороны ладонями вверх («я лучший», с 13.63 почти неподвижно), голова выпрямляется к 13.95,
-- дальше — липсинк и самодовольная зубастая ухмылка (смех на долях 14.309 / 14.797, смыкание на 15.285).
-- Камера низко (≈1.8 студа) и смотрит вверх, поэтому «лицо в камеру» = морда наклонена вниз.

-- ===== Ноги (неподвижны весь план, IK в мире) =====
-- Правая (нижняя): голень почти вертикально, стопа на подиуме (верх Y=0.8), носок чуть наружу.
local R_LEG = { ik = { 0.3, 1.15, 1.88 }, pole = { -0.18, 0.37, 0.92 }, foot = { palm = { 0, 1, 0.05 }, fingers = { 0.15, -0.05, 1 } } }
-- Левая (верхняя): бедро лежит поперёк правого, колено — самая высокая точка (≈3.4) и смотрит в камеру;
-- голень свисает по диагонали к правому боку перед правой голенью, носок оттянут вниз.
local L_LEG = { ik = { 0.82, 2.62, 1.98 }, pole = { -0.08, 1, 0.47 }, foot = { palm = { -0.25, 0.5, 0.83 }, fingers = { 0.45, -0.8, 0.4 } } }

-- ===== Руки (IK в мире, ориентация кисти — ладонь/пальцы) =====
local function arm(side, x, y, f, pole, palm, fingers)
	local s = if side == "r" then 1 else -1
	return {
		ik = { s * x, y, f },
		pole = { s * pole[1], pole[2], pole[3] },
		wrist = { palm = { s * palm[1], palm[2], palm[3] }, fingers = { s * fingers[1], fingers[2], fingers[3] } },
	}
end
-- локоть назад-вниз, плечо почти опущено (рука не «крылом»)
local ELBOW_BACK = { 0.35, -0.45, -1 }
-- на подлокотнике (шапка-свиток x=±1.92, верх 3.43, f 0.79…1.45); lift — подъём кисти над ним
local function rest(side, lift)
	lift = lift or 0
	if side == "r" then
		-- правая: кулак на переднем завитке, костяшки вперёд-вверх
		return arm("r", 1.84, 3.74 + lift, 1.0 + lift * 0.4, ELBOW_BACK, { -0.25, -0.95 + lift * 0.6, 0.15 }, { 0, -0.55 + lift, 0.85 })
	end
	-- левая: кисть свисает через передний край, пальцы вниз
	return arm("l", 1.86, 3.74, 1.1, ELBOW_BACK, { -0.1, -0.75, -0.6 }, { 0, -0.75, 0.66 })
end
-- кулак (костяшки вверх-наружу, ладонь к телу)
local function fist(side, x, y, f, pole)
	return arm(side, x, y, f, pole or { 0.55, -0.75, -0.4 }, { -1, -0.15, 0.2 }, { 0.15, 1, 0.3 })
end
-- раскрытые руки ладонями вверх; o — «раскрытость» 0..1 (поворот ладони вверх)
local function open(side, x, y, f, o, pole)
	o = o or 1
	local palm = { -1 + 0.95 * o, 0.1 + 0.9 * o, 0.25 - 0.05 * o }
	local fingers = { 0.2 + 0.75 * o, 1 - 0.85 * o, 0.35 }
	return arm(side, x, y, f, pole or { 0.3, -1, -0.5 }, palm, fingers)
end
-- поза «я лучший»: x — вынос кистей в стороны (камера облетает трон, кисти медленно раскрываются шире,
-- чтобы в кадре держаться у краёв трона, как в клипе), dy — дыхание/дрейф; левая чуть выше правой
local function spreadR(x, dy)
	return open("r", x, 3.8 + (dy or 0), 0.85, 1, { 0.15, -1, 0.05 })
end
local function spreadL(x, dy, f)
	return open("l", x + 0.05, 4.37 + (dy or 0), f or 0.95, 1, { 0.15, -1, 0.05 })
end

