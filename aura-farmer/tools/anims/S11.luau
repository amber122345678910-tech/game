-- Шея: «лицо к камере» при низкой камере ≈ суммарный наклон головы +2…+10° вниз
-- (root.bend −14 + waist.bend + neck.nod). turn+ — влево (к правому краю кадра), tilt+ — к правому плечу.
local function N(nod, turn, tilt)
	return { nod = nod, turn = turn, tilt = tilt }
end

