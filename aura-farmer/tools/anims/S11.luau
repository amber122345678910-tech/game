local ROOT = { y = 0.2, f = 0.6, turn = 10, bend = -11 }
local function W(bend, tilt, turn)
	return { bend = bend, turn = turn or -4, tilt = tilt or 0 }
end

-- ===== Лицо: jaw (0..1.6), grin всегда поднят (зубы видны), brows −1 хмурый … +1 удивлённый =====
local function F(jaw, brows, ears, mane)
	return { jaw = jaw, grin = 1, brows = brows or 0, ears = ears or 0, mane = mane or 0 }
end

-- Шея: nod+ — вниз, turn+ — влево (к правому краю кадра), tilt+ — к правому плечу (макушка влево в кадре).
local function N(nod, turn, tilt)
	return { nod = nod, turn = turn, tilt = tilt }
end

