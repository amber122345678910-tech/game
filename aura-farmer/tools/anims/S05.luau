--!nocheck
-- Ключи анимации плана S05 (см. tools/lib/Pose.luau — формат ключей).
-- Инсерт груди: камера неподвижна, весь «грув» — микродвижение корпуса в бит (123 BPM):
--   доля 10 = 5.041, шестнадцатая перед долей 11 = 5.407, доля 11 = 5.529.
--   Подъём на долю/шестнадцатую, провал «вниз-назад» сразу после доли (быстро вниз ~2 кадра, медленно обратно ~0.2 с).
-- Цели заданы для ГРУДИ (уровень цепи, y≈4.4): f — к камере (+), y — вверх (студы), pitch — наклон груди вперёд (+, град.).
-- Таз (root) пересчитывается так, чтобы с учётом наклона в поясе грудь прошла ровно по цели; стопы стоят (IK лодыжек),
-- для запаса на «подъём» колени чуть согнуты (BASE_Y).
-- Амплитуды переведены из пикселей референса в студы для нашей дистанции камеры (~2.05 студа, кадр ≈1.1 студа по высоте).

local LEVER = 4.4 - 3.1 -- от пояса (waistY) до цепи, студы
local BASE_Y = -0.03 -- лёгкий присед: колени не в «замке», есть ход вверх

local function key(t, f, y, pitch, roll, nod, ease)
	local rootF = f - LEVER * math.rad(pitch)
	return {
		t = t,
		ease = ease,
		root = { y = BASE_Y + y, f = rootF },
		waist = { bend = pitch, tilt = roll },
		neck = { nod = nod },
		rLeg = { ik = { 0.55, 0.3, 0 } },
		lLeg = { ik = { -0.55, 0.3, 0 } },
		rArm = { fwd = 8, out = -5, elbow = 20 },
		lArm = { fwd = 8, out = -5, elbow = 20 },
	}
end

return {
	Horse = { keys = {
		--      t       f       y       pitch  roll   nod
		key(4.90, 0.000, 0.000, 0.0, 0.0, 0.0),
		key(4.9667, 0.000, 0.000, 0.0, 0.0, 0.0),
		-- доля 10 (5.041): подъём к камере
		key(5.033, 0.012, 0.018, 0.3, 0.0, 0.4, "out"),
		-- провал вниз-назад (быстро, ~2 кадра), грудь чуть откинута
		key(5.100, -0.040, 0.002, -0.8, -0.2, -0.6),
		key(5.150, -0.038, -0.005, -0.7, -0.2, -0.5),
		-- медленный возврат
		key(5.333, -0.022, -0.006, -0.4, -0.1, -0.2, "linear"),
		key(5.367, 0.000, -0.002, 0.0, 0.0, 0.0),
		-- шестнадцатая перед долей 11 (5.407): «качок» грудью вперёд-вверх, левая сторона коня чуть выше (крен вправо)
		key(5.400, 0.020, 0.023, 1.0, 0.8, 0.6),
		key(5.433, 0.004, 0.012, 0.4, 0.3, 0.3),
		key(5.467, -0.019, -0.003, -0.3, -0.2, -0.2, "out"),
		-- доля 11 (5.529): самый глубокий провал
		key(5.533, -0.038, -0.0115, -0.9, -0.4, -0.6),
		key(5.567, -0.034, -0.009, -0.8, -0.3, -0.5),
		-- плавный выход и успокоение
		key(5.633, -0.016, -0.007, -0.4, -0.1, -0.2),
		key(5.867, -0.011, -0.007, -0.2, 0.0, -0.1),
		key(5.950, -0.011, -0.007, -0.2, 0.0, -0.1),
	} },
}
