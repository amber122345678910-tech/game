--!nocheck
-- Ключи анимации плана S05 (см. tools/lib/Pose.luau — формат ключей).
-- Инсерт груди: камера неподвижна, весь «грув» — микродвижение корпуса в бит (123 BPM):
--   доля 10 = 5.041, шестнадцатая перед долей 11 = 5.407, доля 11 = 5.529.
--   Подъём на долю/шестнадцатую, провал «вниз-назад» сразу после доли (вниз ~2 кадра, обратно ~0.2 с).
-- Цели заданы для ЦЕПИ (y≈4.15–4.3): f — к камере (+, студы), y — вверх (студы), pitch — наклон груди вперёд (+, град.),
-- roll — крен груди (+ поднимает левый край коня = правый край кадра).
-- Таз (root) пересчитывается так, чтобы с учётом наклона/крена в поясе цепь прошла ровно по цели; стопы стоят
-- (IK лодыжек), для запаса на «подъём» колени чуть согнуты (BASE_Y).
-- Амплитуды — по замерам клипа (масштаб кадра 0.977…1.0095, сдвиг цепи 3–14 px из 480) для нашей камеры
-- (~2.1 студа до цепи, кадр 0.8 студа по высоте, 1 px ≈ 0.0017 студа): f = (масштаб − 1)·2.1.
-- Цепь приварена к груди (отдельного сустава нет), поэтому «подскок» цепи на 5.40 сыгран рывком груди
-- вверх-вперёд с креном (левый край коня выше), а «приземление» на долю 11 — креном в обратную сторону.
-- Руки (вне кадра) чуть вперёд и к корпусу: рукава закрывают просвет у талии в нижних углах кадра.

local LEVER = 4.25 - 3.1 -- от пояса (waistY) до цепи по высоте, студы
local FWD = 0.55 -- цепь впереди оси пояса, студы (наклон вперёд опускает её на FWD·θ)
local BASE_Y = -0.04 -- лёгкий присед: колени не в «замке», есть ход вверх

-- f/y — целевое смещение цепи; таз компенсирует побочные сдвиги от наклона (pitch) и крена (roll) в поясе.
local function key(t, f, y, pitch, roll, ease)
	local p, r = math.rad(pitch), math.rad(roll)
	return {
		t = t,
		ease = ease,
		root = { x = -LEVER * r, y = BASE_Y + y + FWD * p, f = f - LEVER * p },
		waist = { bend = pitch, tilt = roll },
		neck = { nod = -0.6 * pitch, tilt = -0.8 * roll },
		rLeg = { ik = { 0.55, 0.3, 0 } },
		lLeg = { ik = { -0.55, 0.3, 0 } },
		rArm = { fwd = 16, out = -22, elbow = 28 },
		lArm = { fwd = 16, out = -22, elbow = 28 },
	}
end

return {
	Horse = { keys = {
		--      t       f        y        pitch  roll
		key(4.900, 0.000, 0.000, 0.0, 0.0),
		key(4.9667, 0.000, 0.000, 0.0, 0.0),
		key(5.000, 0.004, 0.002, 0.1, 0.0),
		-- доля 10 (5.041): маленький подъём к камере (масштаб 1.006, цепь выше на ~3.5 px)
		key(5.033, 0.013, 0.006, 0.3, 0.0),
		-- провал вниз-назад: быстро (~2 кадра), грудь чуть откинута
		key(5.067, -0.025, -0.002, -0.3, -0.1),
		key(5.100, -0.048, -0.008, -0.6, -0.15),
		key(5.133, -0.046, -0.0075, -0.6, -0.15),
		-- держит провал и медленно, почти линейно, выходит
		key(5.167, -0.042, -0.007, -0.55, -0.1),
		key(5.200, -0.032, -0.0065, -0.45, -0.1, "linear"),
		key(5.333, -0.023, -0.006, -0.3, -0.05),
		-- «щелчок» обратно в покой
		key(5.367, -0.002, -0.003, 0.0, 0.0),
		-- шестнадцатая перед долей 11 (5.407): «качок» грудью вперёд-вверх, левый край коня (правый край кадра) выше
		key(5.400, 0.020, 0.024, 0.8, 1.6),
		-- цепь падает: правый край кадра падает быстрее центра (крен в обратную сторону)
		key(5.433, 0.004, 0.012, 0.3, -0.4),
		key(5.467, -0.021, 0.000, -0.2, -0.4, "in"),
		-- доля 11 (5.529): самый глубокий провал, цепь «приземляется» с перелётом (правый край кадра ниже)
		key(5.533, -0.040, -0.009, -0.6, -0.9),
		key(5.567, -0.036, -0.008, -0.55, -0.65),
		key(5.600, -0.025, -0.006, -0.4, -0.5),
		-- выход и успокоение (чуть ниже и дальше покоя)
		key(5.633, -0.017, -0.004, -0.3, -0.4),
		key(5.750, -0.014, -0.0038, -0.25, -0.33),
		key(5.867, -0.013, -0.0037, -0.2, -0.3),
		key(5.950, -0.013, -0.0037, -0.2, -0.3),
	} },
}
