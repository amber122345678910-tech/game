--!nocheck
-- УСТАРЕВШЕЕ ИМЯ (оставлено для совместимости). По кадрам S10 «кудрявый статист» справа в кадре (и фигура
-- за рукой коня — её отражение) — это WomanB: пышные тёмные кудри, белая майка, чёрные спортивные шорты
-- до середины бедра с белыми лампасами, белые короткие носки, оранжевые кроссовки. Модуль возвращает
-- WomanB без очков; в новых планах используйте WomanB{glasses=false} напрямую.
local WomanB = require("./WomanB")

return function(opts)
	local o = { glasses = false }
	for k, v in opts or {} do
		o[k] = v
	end
	return WomanB(o)
end
