--!nocheck
-- Статистка в спортзале (S10): девушка у стойки с гантелями слева в кадре И её отражение в зеркале — это
-- WomanA (шэг с пепельной макушкой и чёлкой, белый кроп-топ в рубчик, чёрные широкие шорты до колена с розами,
-- босиком) без очков. Рыжеватый оттенок волос в кадре даёт тёплый свет зала, поэтому цвет волос НЕ меняется:
-- девушка и отражение должны совпадать (оба — GymWoman, или оба — WomanA{glasses=false}; не смешивать).
local WomanA = require("./WomanA")

return function(opts)
	local o = { glasses = false }
	for k, v in opts or {} do
		o[k] = v
	end
	return WomanA(o)
end
