{
  "name": "CoreRoulette",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayerScripts"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "SignalBehavior": "Deferred"
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 0,
        "Brightness": 0,
        "GlobalShadows": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
