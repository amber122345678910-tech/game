{
  "name": "LightningCatchers",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "DataSync": { "$className": "RemoteEvent" },
        "StrikeSpawn": { "$className": "RemoteEvent" },
        "StrikeResult": { "$className": "RemoteEvent" },
        "Catch": { "$className": "RemoteEvent" },
        "ShardSpawn": { "$className": "RemoteEvent" },
        "ShardCollect": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" },
        "Banner": { "$className": "RemoteEvent" },
        "Effect": { "$className": "RemoteEvent" },
        "BoltFX": { "$className": "UnreliableRemoteEvent" },
        "Request": { "$className": "RemoteFunction" }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 8,
        "CharacterWalkSpeed": 18,
        "CharacterJumpPower": 50
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "SignalBehavior": "Deferred",
        "PhysicsSteppingMethod": "Adaptive",
        "PlayerCharacterDestroyBehavior": "Enabled",
        "RejectCharacterDeletions": "Enabled",
        "Gravity": 196.2
      },
      "Map": {
        "$path": "src/map/Map.rbxmx"
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Unified",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": false,
        "ClockTime": 19.6,
        "GeographicLatitude": 30,
        "Brightness": 1.6,
        "ExposureCompensation": 0.25,
        "Ambient": [0.31, 0.31, 0.44],
        "OutdoorAmbient": [0.48, 0.49, 0.65],
        "ColorShift_Top": [0.6, 0.67, 1.0],
        "ColorShift_Bottom": [0.2, 0.2, 0.35],
        "EnvironmentDiffuseScale": 0.45,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25,
        "FogEnd": 100000
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.26,
          "Offset": 0.15,
          "Color": [0.59, 0.63, 0.82],
          "Decay": [0.3, 0.32, 0.53],
          "Glare": 0.1,
          "Haze": 1.0
        }
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 3000,
          "CelestialBodiesShown": true,
          "MoonAngularSize": 12,
          "SunAngularSize": 10
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.7,
          "Size": 24,
          "Threshold": 0.92
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.18,
          "Saturation": 0.18,
          "TintColor": [0.94, 0.94, 1.0]
        }
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "MaterialService": {
      "$properties": {
        "Use2022Materials": true
      }
    },
    "StarterGui": {
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    }
  }
}
