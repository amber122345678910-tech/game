local current: { [string]: string } = EN
local lang = "en"

function Locale.setLanguage(code: string)
	lang = if string.sub(string.lower(code), 1, 2) == "ru" then "ru" else "en"
	current = if lang == "ru" then RU else EN
end

function Locale.getLanguage(): string
	return lang
end

function Locale.has(key: string): boolean
	return current[key] ~= nil or EN[key] ~= nil
end

function Locale.t(key: string, ...: any): string
	local text = current[key] or EN[key]
	if not text then
		return key
	end
	if select("#", ...) > 0 then
		local ok, formatted = pcall(string.format, text, ...)
		if ok then
			return formatted
		end
	end
	return text
end

-- Удобные обёртки
function Locale.item(id: string): string
	return Locale.t("Item_" .. id)
end

function Locale.itemDesc(id: string): string
	return Locale.t("ItemDesc_" .. id)
end

function Locale.perk(id: string): string
	return Locale.t("Perk_" .. id)
end

function Locale.inmateName(id: string): string
	return Locale.t("Inmate_" .. id .. "_Name")
end

function Locale.inmateRule(id: string): string
	return Locale.t("Inmate_" .. id .. "_Rule")
end

function Locale.inmateAlert(id: string): string
	return Locale.t("Inmate_" .. id .. "_Alert")
end

return Locale
