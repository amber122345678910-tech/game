	UfoHum = { Id = "rbxassetid://9125515917", Volume = 0.5, Looped = true, Group = "SFX", RollOff = 80 }, -- Resonant Humming (PSE)
	Takeoff = { Id = "rbxassetid://9113081793", Volume = 0.6, Group = "SFX" }, -- Airy Whoosh Blast 4 (PSE)
