      <Item class="ModuleScript" referent="2916">
        <Properties>
          <string name="Name">Dialogue</string>
          <string name="Source"><![CDATA[-- Dialogue box with typewriter text, speaker tags, glitch effect for Rick, and choices.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)
local Lang = require(script.Parent.Lang)
local Audio = require(script.Parent.Audio)

local Dialogue = {}

local rgb = Color3.fromRGB
local SPEAKERS = {
	Rick = { color = rgb(110, 222, 245), pitch = 0.78 },
	Morty = { color = rgb(250, 222, 70), pitch = 1.3 },
	MortyThought = { color = rgb(250, 222, 70), pitch = 1.3, italic = true },
	Beth = { color = rgb(244, 112, 136), pitch = 1.12 },
	Jerry = { color = rgb(136, 204, 104), pitch = 0.95 },
	Summer = { color = rgb(255, 150, 92), pitch = 1.4 },
	Unknown = { color = rgb(200, 120, 255), pitch = 0.6 },
}

local gui: ScreenGui? = nil
local panel, tag, tagLabel, body, ghostA, ghostB, arrow, choiceHolder
local advanceSignal = Instance.new("BindableEvent")
local busy = false
local onSpeaker: ((string?) -> ())? = nil

local function build()
	if gui then
		return
	end
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = UI.new("ScreenGui", {
		Name = "Dialogue",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 40,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = pg,
	})
	gui = g
	local canvas = UI.canvas(g)
	panel = UI.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -48),
		Size = UDim2.fromOffset(1240, 170),
		BackgroundColor3 = rgb(8, 9, 14),
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = canvas,
	}, { UI.corner(18), UI.stroke(1.5, Color3.new(1, 1, 1), 0.85, true) })
	UI.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = panel,
	}, { UI.corner(18), UI.gradient(nil, { 1, 0.6 }, 90) })
	tag = UI.new("Frame", {
		Name = "Tag",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.fromOffset(200, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = rgb(250, 222, 70),
		Parent = panel,
	}, { UI.corner(10), UI.padding(16, 0, 16, 0) })
	tagLabel = UI.label({
		Font = Enum.Font.GothamBlack,
		TextSize = 22,
		TextColor3 = rgb(16, 16, 20),
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = tag,
	})
	local function textLabel(name: string, color: Color3, transparency: number, z: number)
		return UI.label({
			Name = name,
			Font = Enum.Font.GothamMedium,
			TextSize = 30,
			TextColor3 = color,
			TextTransparency = transparency,
			TextWrapped = true,
			RichText = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(40, 38),
			Size = UDim2.new(1, -80, 1, -56),
			ZIndex = z,
			Parent = panel,
		})
	end
	ghostA = textLabel("GhostA", rgb(255, 40, 90), 1, 2)
	ghostB = textLabel("GhostB", rgb(40, 230, 255), 1, 2)
	body = textLabel("Body", Color3.new(1, 1, 1), 0, 3)
	arrow = UI.label({
		Text = "▼",
		Font = Enum.Font.GothamBold,
		TextSize = 20,
		TextColor3 = Color3.new(1, 1, 1),
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -14),
		Size = UDim2.fromOffset(40, 24),
		Parent = panel,
	})
	choiceHolder = UI.new("Frame", {
		Name = "Choices",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -240),
		Size = UDim2.fromOffset(1240, 90),
		Visible = false,
		Parent = canvas,
	}, { UI.list(24, true, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
end

local function isAdvanceInput(input: InputObject): boolean
	local t = input.UserInputType
	local k = input.KeyCode
	return t == Enum.UserInputType.MouseButton1
		or t == Enum.UserInputType.Touch
		or k == Enum.KeyCode.Space
		or k == Enum.KeyCode.E
		or k == Enum.KeyCode.Return
		or k == Enum.KeyCode.ButtonA
end

UserInputService.InputBegan:Connect(function(input, processed)
	if busy and isAdvanceInput(input) and not (processed and input.UserInputType == Enum.UserInputType.Touch) then
		advanceSignal:Fire()
	end
end)

local GLITCH_CHARS = { "█", "▓", "▒", "░", "#", "%", "&", "@", "Ж", "Ψ", "¤", "§" }
local function corrupt(text: string, amount: number): string
	local out = {}
	for _, cp in utf8.codes(text) do
		local ch = utf8.char(cp)
		if ch ~= " " and math.random() < amount then
			table.insert(out, GLITCH_CHARS[math.random(1, #GLITCH_CHARS)])
		else
			table.insert(out, ch)
		end
	end
	return table.concat(out)
end

function Dialogue.setSpeakerCallback(fn: ((string?) -> ())?)
	onSpeaker = fn
end

--[[
	Show a line and wait. opts:
	  auto     = seconds to wait after the text is fully shown, then continue on its own (true = automatic time)
	  glitch   = 0..1 how broken the text looks (Rick)
	  noWait   = return immediately (the box stays until the next line or hide())
]]
function Dialogue.say(speaker: string, line: any, opts: { [string]: any }?)
	build()
	local o = opts or {}
	local info = SPEAKERS[speaker] or SPEAKERS.Unknown
	local text = Lang.t(line)
	if info.italic then
		text = "<i>" .. text .. "</i>"
	end
	panel.Visible = true
	tag.BackgroundColor3 = info.color
	tagLabel.Text = Lang.t("who." .. speaker)
	body.Text = text
	ghostA.Text = text
	ghostB.Text = text
	body.MaxVisibleGraphemes = 0
	arrow.TextTransparency = 1
	if onSpeaker then
		onSpeaker(speaker)
	end
	local glitch = o.glitch or 0
	local total = utf8.len(body.ContentText) or #text
	local shown = 0
	local skip = false
	busy = true
	local conn = advanceSignal.Event:Connect(function()
		skip = true
	end)
	local cps = o.speed or 38
	local blip = 0
	-- typewriter
	while shown < total and not skip do
		local dt = RunService.RenderStepped:Wait()
		local before = math.floor(shown)
		shown = math.min(total, shown + dt * cps)
		body.MaxVisibleGraphemes = math.floor(shown)
		if math.floor(shown) ~= before then
			blip += 1
			if blip % 3 == 0 then
				Audio.play("UITick", info.pitch * (0.92 + math.random() * 0.16))
			end
		end
		if glitch > 0 then
			local g = math.random() < glitch * 0.35
			body.Text = if g then corrupt(text, glitch * 0.4) else text
			ghostA.TextTransparency = if g then 0.45 else 1
			ghostB.TextTransparency = if g then 0.45 else 1
			ghostA.Position = UDim2.fromOffset(40 + math.random(-5, 5), 38 + math.random(-2, 2))
			ghostB.Position = UDim2.fromOffset(40 + math.random(-5, 5), 38 + math.random(-2, 2))
			ghostA.MaxVisibleGraphemes = math.floor(shown)
			ghostB.MaxVisibleGraphemes = math.floor(shown)
			panel.Position = UDim2.new(0.5, if g then math.random(-6, 6) else 0, 1, -48)
		end
	end
	conn:Disconnect()
	body.Text = text
	body.MaxVisibleGraphemes = -1
	ghostA.TextTransparency = 1
	ghostB.TextTransparency = 1
	panel.Position = UDim2.new(0.5, 0, 1, -48)
	if onSpeaker then
		onSpeaker(nil)
	end
	if o.noWait then
		busy = false
		return
	end
	-- wait for the player (or auto continue)
	task.wait(0.12)
	arrow.TextTransparency = 0.3
	local done = false
	local conn2 = advanceSignal.Event:Connect(function()
		done = true
	end)
	local autoTime = if o.auto == true then 1.2 + total * 0.035 elseif type(o.auto) == "number" then o.auto else nil
	local t0 = os.clock()
	local lastGlitch = 0
	while not done do
		local dt = RunService.RenderStepped:Wait()
		arrow.Position = UDim2.new(1, -24, 1, -14 + math.sin(os.clock() * 6) * 3)
		if autoTime and os.clock() - t0 > autoTime then
			break
		end
		if glitch > 0 then
			lastGlitch += dt
			if lastGlitch > 0.08 then
				lastGlitch = 0
				local g = math.random() < glitch * 0.12
				body.Text = if g then corrupt(text, glitch * 0.3) else text
				ghostA.TextTransparency = if g then 0.5 else 1
				ghostB.TextTransparency = if g then 0.5 else 1
			end
		end
	end
	conn2:Disconnect()
	body.Text = text
	ghostA.TextTransparency = 1
	ghostB.TextTransparency = 1
	arrow.TextTransparency = 1
	busy = false
end

function Dialogue.hide()
	if panel then
		panel.Visible = false
	end
	busy = false
end

-- Show buttons, return the index of the picked option.
function Dialogue.choice(options: { any }): number
	build()
	for _, c in choiceHolder:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	choiceHolder.Visible = true
	local picked = 0
	local unlock = UI.new("TextButton", { Name = "Unlock", Modal = true, Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), Parent = gui })
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
	local buttons = {}
	for i, opt in options do
		local b = UI.new("TextButton", {
			Name = "Choice" .. i,
			AutoButtonColor = false,
			Text = "",
			BackgroundColor3 = rgb(16, 18, 26),
			BackgroundTransparency = 0.1,
			Size = UDim2.fromOffset(470, 84),
			LayoutOrder = i,
			Parent = choiceHolder,
		}, { UI.corner(16), UI.stroke(2, rgb(250, 222, 70), 0.3, true) })
		UI.label({
			Text = tostring(i),
			Font = Enum.Font.GothamBlack,
			TextSize = 26,
			TextColor3 = rgb(16, 16, 20),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = rgb(250, 222, 70),
			Position = UDim2.fromOffset(18, 21),
			Size = UDim2.fromOffset(42, 42),
			Parent = b,
		}, { UI.corner(10) })
		UI.label({
			Text = Lang.t(opt),
			Font = Enum.Font.GothamBold,
			TextSize = 28,
			TextColor3 = Color3.new(1, 1, 1),
			TextWrapped = true,
			Position = UDim2.fromOffset(78, 0),
			Size = UDim2.new(1, -96, 1, 0),
			Parent = b,
		})
		local scale = UI.new("UIScale", { Parent = b })
		b.MouseEnter:Connect(function()
			Audio.play("UIHover")
			UI.tween(scale, 0.15, { Scale = 1.05 }, Enum.EasingStyle.Back)
			UI.tween(b, 0.15, { BackgroundColor3 = rgb(40, 44, 60) })
		end)
		b.MouseLeave:Connect(function()
			UI.tween(scale, 0.15, { Scale = 1 })
			UI.tween(b, 0.15, { BackgroundColor3 = rgb(16, 18, 26) })
		end)
		b.Activated:Connect(function()
			if picked == 0 then
				picked = i
			end
		end)
		scale.Scale = 0
		UI.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, nil, 0.08 * i)
		table.insert(buttons, b)
	end
	local keyConn = UserInputService.InputBegan:Connect(function(input)
		local map = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.DPadLeft] = 1, [Enum.KeyCode.DPadRight] = 2 }
		local n = map[input.KeyCode]
		if n and n <= #options and picked == 0 then
			picked = n
		end
	end)
	while picked == 0 do
		RunService.RenderStepped:Wait()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	keyConn:Disconnect()
	Audio.play("UIClick")
	local chosen = buttons[picked]
	UI.tween(chosen, 0.12, { BackgroundColor3 = rgb(250, 222, 70) })
	task.wait(0.25)
	choiceHolder.Visible = false
	unlock:Destroy()
	UserInputService.MouseIconEnabled = false
	return picked
end

return Dialogue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2917">
        <Properties>
          <string name="Name">Director</string>
          <string name="Source"><![CDATA[-- Cutscene camera: cuts, smooth moves, tracking, free look (player can look around), shake.
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Settings = require(script.Parent.Settings)

local Director = {}

local active = false
local base: CFrame = CFrame.new()
local trackFn: ((number) -> CFrame)? = nil
local moveFrom: CFrame? = nil
local moveTo: CFrame? = nil
local moveStart = 0
local moveDur = 1
local moveEase = "smooth"
local fovFrom, fovTo, fovStart, fovDur = 70, 70, 0, 0

local freeOn = false
local yaw, pitch = 0, 0
local limits = { yaw = 1.2, pitchUp = 0.9, pitchDown = 0.9 }
local touchDelta = Vector2.zero

local shakes: { { amp: number, t0: number, dur: number, freq: number, seed: number } } = {}
local roll = 0

local function ease(x: number, kind: string?): number
	x = math.clamp(x, 0, 1)
	if kind == "linear" then
		return x
	elseif kind == "in" then
		return x * x * x
	elseif kind == "out" then
		return 1 - (1 - x) ^ 3
	end
	return x * x * (3 - 2 * x)
end
Director.ease = ease

local function camera(): Camera
	return workspace.CurrentCamera
end

local function step(dt: number)
	if not active then
		return
	end
	local now = os.clock()
	local cf = base
	if moveFrom and moveTo then
		local a = ease((now - moveStart) / moveDur, moveEase)
		cf = (moveFrom :: CFrame):Lerp(moveTo :: CFrame, a)
		if a >= 1 then
			base = moveTo :: CFrame
			moveFrom, moveTo = nil, nil
		end
	elseif trackFn then
		cf = (trackFn :: (number) -> CFrame)(dt)
		base = cf
	end

	if freeOn then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		local d = UserInputService:GetMouseDelta() + touchDelta
		touchDelta = Vector2.zero
		local k = 0.0045 * (Settings.Get("Sensitivity") or 1)
		yaw = math.clamp(yaw - d.X * k, -limits.yaw, limits.yaw)
		pitch = math.clamp(pitch - d.Y * k, -limits.pitchDown, limits.pitchUp)
	else
		yaw *= math.exp(-dt * 3)
		pitch *= math.exp(-dt * 3)
	end
	cf = cf * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)

	-- shake (sum of active shakes, smooth noise)
	local sx, sy, sr = 0, 0, 0
	for i = #shakes, 1, -1 do
		local s = shakes[i]
		local t = now - s.t0
		if t > s.dur then
			table.remove(shakes, i)
		else
			local fade = 1 - t / s.dur
			local a = s.amp * fade * fade
			sx += math.noise(t * s.freq, s.seed, 0) * a
			sy += math.noise(s.seed, t * s.freq, 0) * a
			sr += math.noise(0, s.seed, t * s.freq) * a
		end
	end
	cf = cf * CFrame.new(sx * 0.6, sy * 0.6, 0) * CFrame.Angles(sy * 0.05, sx * 0.05, sr * 0.08 + roll)

	local cam = camera()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = cf
	if fovDur > 0 then
		local a = ease((now - fovStart) / fovDur)
		cam.FieldOfView = fovFrom + (fovTo - fovFrom) * a
		if a >= 1 then
			fovDur = 0
		end
	end
end

UserInputService.InputChanged:Connect(function(input, processed)
	if active and freeOn and input.UserInputType == Enum.UserInputType.Touch and not processed then
		touchDelta += Vector2.new(input.Delta.X, input.Delta.Y)
	end
end)

function Director.start(fromCurrent: boolean?)
	if not active then
		active = true
		if fromCurrent ~= false then
			base = camera().CFrame
		end
		RunService:BindToRenderStep("Director", Enum.RenderPriority.Camera.Value + 10, step)
	end
end

function Director.stop()
	if active then
		active = false
		RunService:UnbindFromRenderStep("Director")
	end
	freeOn = false
	trackFn = nil
	moveFrom, moveTo = nil, nil
	table.clear(shakes)
	roll = 0
	yaw, pitch = 0, 0
end

function Director.isActive(): boolean
	return active
end

function Director.cut(cf: CFrame, fov: number?)
	Director.start(false)
	trackFn = nil
	moveFrom, moveTo = nil, nil
	base = cf
	yaw, pitch = 0, 0
	if fov then
		camera().FieldOfView = fov
		fovDur = 0
	end
	local cam = camera()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = cf
end

-- smooth move from the current base to `cf` (yields unless async)
function Director.move(cf: CFrame, duration: number, easeKind: string?, fov: number?, async: boolean?)
	Director.start()
	trackFn = nil
	moveFrom = base
	moveTo = cf
	moveStart = os.clock()
	moveDur = math.max(duration, 0.001)
	moveEase = easeKind or "smooth"
	if fov then
		Director.fov(fov, duration)
	end
	if not async then
		task.wait(duration)
	end
end

-- follow a function every frame: fn(dt) -> CFrame
function Director.track(fn: (number) -> CFrame)
	Director.start()
	moveFrom, moveTo = nil, nil
	trackFn = fn
end

function Director.fov(value: number, duration: number?)
	local cam = camera()
	if not duration or duration <= 0 then
		cam.FieldOfView = value
		fovDur = 0
		return
	end
	fovFrom = cam.FieldOfView
	fovTo = value
	fovStart = os.clock()
	fovDur = duration
end

function Director.freeLook(on: boolean, newLimits: { yaw: number?, pitchUp: number?, pitchDown: number? }?)
	freeOn = on
	if newLimits then
		limits.yaw = newLimits.yaw or limits.yaw
		limits.pitchUp = newLimits.pitchUp or limits.pitchUp
		limits.pitchDown = newLimits.pitchDown or limits.pitchDown
	end
	if on then
		UserInputService.MouseIconEnabled = false
	end
end

function Director.resetLook()
	yaw, pitch = 0, 0
end

function Director.lookAngles(): (number, number)
	return yaw, pitch
end

function Director.shake(amplitude: number, duration: number, frequency: number?)
	table.insert(shakes, { amp = amplitude, t0 = os.clock(), dur = duration, freq = frequency or 12, seed = math.random() * 100 })
end

function Director.roll(angle: number)
	roll = angle
end

function Director.base(): CFrame
	return base
end

return Director
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2918">
        <Properties>
          <string name="Name">Fx</string>
          <string name="Source"><![CDATA[-- Visual effects: screen overlays (flash, fade, glitch, speed lines, letterbox, titles)
-- and world effects (explosions, shockwaves, sonic rings, beams, dust). Client only.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

local UI = require(script.Parent.UI)
local Audio = require(script.Parent.Audio)
local Lang = require(script.Parent.Lang)

local Fx = {}
local rgb = Color3.fromRGB

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local folder = Instance.new("Folder")
folder.Name = "ClientFx"
folder.Parent = workspace

----------------------------------------------------------------------------
-- overlay
----------------------------------------------------------------------------
local gui: ScreenGui
local canvas: Frame
local flashFrame, blackFrame, heatFrame, glitchFrame, linesFrame, barTop, barBottom, titleGroup, titleMain, titleSub
local glitchGrade: ColorCorrectionEffect

local function build()
	if gui then
		return
	end
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = UI.new("ScreenGui", {
		Name = "FxOverlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 60,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = pg,
	})
	canvas = UI.canvas(gui)
	canvas.ZIndex = 12 -- titles draw above the black fade
	heatFrame = UI.full(gui, "Heat", 1)
	for i, rot in { 0, 90, 180, 270 } do
		UI.new("Frame", {
			BackgroundColor3 = rgb(255, 120, 40),
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Parent = heatFrame,
		}, { UI.gradient(nil, { 0, 0.7, 1, 1 }, rot) })
		local _ = i
	end
	heatFrame.Visible = false
	linesFrame = UI.full(gui, "SpeedLines", 2)
	linesFrame.Visible = false
	for i = 1, 48 do
		UI.new("Frame", {
			Name = "Line" .. i,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(200, 2),
			Parent = linesFrame,
		})
	end
	glitchFrame = UI.full(gui, "Glitch", 3)
	glitchFrame.Visible = false
	for i = 1, 26 do
		UI.new("Frame", { Name = "Bar" .. i, BorderSizePixel = 0, Parent = glitchFrame })
	end
	UI.label({
		Name = "Lost",
		Font = Enum.Font.RobotoMono,
		TextSize = 40,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 0.1),
		TextScaled = false,
		Parent = glitchFrame,
	})
	barTop = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.fromScale(1, 0), ZIndex = 8, Parent = gui })
	barBottom = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), ZIndex = 8, Parent = gui })
	flashFrame = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 9, Parent = gui })
	blackFrame = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 10, Parent = gui })
	titleGroup = UI.new("CanvasGroup", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), GroupTransparency = 1, ZIndex = 11, Parent = canvas })
	titleSub = UI.label({
		Font = Enum.Font.GothamMedium,
		TextSize = 22,
		TextColor3 = rgb(250, 222, 70),
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.fromOffset(1400, 30),
		Parent = titleGroup,
	})
	titleMain = UI.label({
		Font = Enum.Font.GothamBlack,
		TextSize = 60,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.51),
		Size = UDim2.fromOffset(1600, 80),
		Parent = titleGroup,
	})
	UI.stroke(2, Color3.new(0, 0, 0), 0.4).Parent = titleMain

	glitchGrade = Instance.new("ColorCorrectionEffect")
	glitchGrade.Name = "GlitchGrade"
	glitchGrade.Enabled = false
	glitchGrade.Parent = Lighting
end

function Fx.init()
	build()
end

function Fx.flash(color: Color3?, peak: number?, tin: number?, tout: number?)
	build()
	flashFrame.BackgroundColor3 = color or Color3.new(1, 1, 1)
	UI.tween(flashFrame, tin or 0.05, { BackgroundTransparency = 1 - (peak or 1) })
	task.delay((tin or 0.05) + 0.02, function()
		UI.tween(flashFrame, tout or 0.8, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
	end)
end

function Fx.fade(alpha: number, t: number, wait: boolean?)
	build()
	UI.tween(blackFrame, t, { BackgroundTransparency = 1 - alpha }, Enum.EasingStyle.Sine)
	if wait then
		task.wait(t)
	end
end

function Fx.black(alpha: number)
	build()
	blackFrame.BackgroundTransparency = 1 - alpha
end

function Fx.letterbox(on: boolean, t: number?)
	build()
	local h = if on then 0.09 else 0
	UI.tween(barTop, t or 1, { Size = UDim2.fromScale(1, h) }, Enum.EasingStyle.Quint)
	UI.tween(barBottom, t or 1, { Size = UDim2.fromScale(1, h) }, Enum.EasingStyle.Quint)
end

-- chapter title card (yields ~3.4 s)
function Fx.title(key: string)
	build()
	titleMain.Text = Lang.t(key)
	titleSub.Text = UI.spaced(Lang.t("ch.sub"))
	titleGroup.GroupTransparency = 1
	titleMain.Position = UDim2.fromScale(0.5, 0.53)
	UI.tween(titleGroup, 0.8, { GroupTransparency = 0 }, Enum.EasingStyle.Sine)
	UI.tween(titleMain, 1.2, { Position = UDim2.fromScale(0.5, 0.51) }, Enum.EasingStyle.Quint)
	task.wait(2.4)
	UI.tween(titleGroup, 0.9, { GroupTransparency = 1 }, Enum.EasingStyle.Sine)
	task.wait(0.9)
end

function Fx.heat(alpha: number, t: number?)
	build()
	heatFrame.Visible = alpha > 0
	for _, f in heatFrame:GetChildren() do
		if f:IsA("Frame") then
			UI.tween(f, t or 0.5, { BackgroundTransparency = 1 - alpha })
		end
	end
end

local linesConn: RBXScriptConnection? = nil
function Fx.speedLines(on: boolean, strength: number?)
	build()
	if linesConn then
		linesConn:Disconnect()
		linesConn = nil
	end
	linesFrame.Visible = on
	if not on then
		return
	end
	local s = strength or 1
	local data = {}
	for i, l in linesFrame:GetChildren() do
		data[l] = { a = math.random() * math.pi * 2, r = math.random(), speed = 0.9 + math.random() * 1.4, len = 80 + math.random() * 260 }
		local _ = i
	end
	linesConn = RunService.RenderStepped:Connect(function(dt)
		for l, d in data do
			d.r += dt * d.speed * s
			if d.r > 1 then
				d.r = 0.05 + math.random() * 0.1
				d.a = math.random() * math.pi * 2
			end
			local r = 0.08 + d.r * 0.7
			l.Position = UDim2.fromScale(0.5 + math.cos(d.a) * r, 0.5 + math.sin(d.a) * r * 1.6)
			l.Rotation = math.deg(math.atan2(math.sin(d.a) * 1.6, math.cos(d.a)))
			l.Size = UDim2.fromOffset(d.len * (0.3 + d.r), 2 + d.r * 2)
			l.BackgroundTransparency = 1 - math.clamp(d.r * 1.2, 0, 0.85)
		end
	end)
end

-- "Cameraman" style screen glitch (async)
local glitchToken = 0
function Fx.glitch(duration: number, intensity: number?)
	build()
	glitchToken += 1
	local my = glitchToken
	local k = intensity or 1
	glitchFrame.Visible = true
	glitchGrade.Enabled = true
	local lost = glitchFrame:FindFirstChild("Lost") :: TextLabel
	lost.Text = Lang.t("glitch.lost")
	task.spawn(function()
		local t0 = os.clock()
		local colors = { rgb(255, 30, 80), rgb(30, 255, 120), rgb(40, 120, 255), Color3.new(1, 1, 1), Color3.new(0, 0, 0), rgb(255, 0, 255) }
		while os.clock() - t0 < duration and my == glitchToken do
			local fade = 1 - (os.clock() - t0) / duration
			local amount = k * (0.4 + 0.6 * fade)
			for _, b in glitchFrame:GetChildren() do
				if b:IsA("Frame") then
					if math.random() < 0.55 * amount then
						b.Visible = true
						b.BackgroundColor3 = colors[math.random(1, #colors)]
						b.BackgroundTransparency = 0.15 + math.random() * 0.6
						local h = math.random(2, 46)
						b.Position = UDim2.new(math.random() * 0.4 - 0.2, 0, math.random(), 0)
						b.Size = UDim2.new(0.3 + math.random() * 1.0, 0, 0, h)
					else
						b.Visible = false
					end
				end
			end
			lost.Visible = math.random() < 0.3 * amount
			lost.Position = UDim2.new(0.5, math.random(-30, 30), 0.5, math.random(-12, 12))
			lost.TextColor3 = colors[math.random(1, 4)]
			glitchGrade.TintColor = Color3.new(1 - math.random() * 0.4 * amount, 1 - math.random() * 0.4 * amount, 1 - math.random() * 0.4 * amount)
			glitchGrade.Saturation = -math.random() * amount
			glitchGrade.Contrast = math.random() * 0.6 * amount
			glitchGrade.Brightness = (math.random() - 0.5) * 0.3 * amount
			task.wait(0.04 + math.random() * 0.05)
		end
		if my == glitchToken then
			glitchFrame.Visible = false
			glitchGrade.Enabled = false
		end
	end)
end

function Fx.stopGlitch()
	glitchToken += 1
	if glitchFrame then
		glitchFrame.Visible = false
		glitchGrade.Enabled = false
	end
end

-- muffled hearing (after an explosion)
local muffles: { Instance } = {}
function Fx.muffle(on: boolean)
	for _, m in muffles do
		m:Destroy()
	end
	table.clear(muffles)
	if on then
		for _, name in { "SFX", "Music", "Ambience" } do
			local g = SoundService:FindFirstChild(name)
			if g then
				local eq = Instance.new("EqualizerSoundEffect")
				eq.HighGain = -40
				eq.MidGain = -18
				eq.LowGain = 4
				eq.Parent = g
				table.insert(muffles, eq)
			end
		end
	end
end

----------------------------------------------------------------------------
-- world effects
----------------------------------------------------------------------------
local function fxPart(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, val in props do
		(p :: any)[k] = val
	end
	p.Parent = folder
	return p
end
Fx.part = fxPart

local function emitterAt(pos: Vector3, props: { [string]: any }): (BasePart, ParticleEmitter)
	local holder = fxPart({ Transparency = 1, Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(pos) })
	local pe = Instance.new("ParticleEmitter")
	pe.Enabled = false
	for k, val in props do
		(pe :: any)[k] = val
	end
	pe.Parent = holder
	return holder, pe
end

function Fx.sparks(pos: Vector3, count: number?, color: Color3?)
	local holder, pe = emitterAt(pos, {
		Texture = SPARK,
		Color = ColorSequence.new(color or rgb(255, 200, 120)),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.4, 1.0),
		Speed = NumberRange.new(20, 50),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -60, 0),
		Drag = 2,
	})
	pe:Emit(count or 30)
	task.delay(2, function()
		holder:Destroy()
	end)
end

function Fx.smoke(pos: Vector3, size: number?, count: number?, color: Color3?, life: number?)
	local s = size or 4
	local holder, pe = emitterAt(pos, {
		Texture = SMOKE,
		Color = ColorSequence.new(color or rgb(50, 46, 44)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s * 0.6), NumberSequenceKeypoint.new(1, s * 2.4) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new((life or 3) * 0.7, life or 3),
		Speed = NumberRange.new(s * 0.6, s * 2.2),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-30, 30),
		Drag = 1.5,
		Acceleration = Vector3.new(0, s * 0.4, 0),
		LightInfluence = 0.8,
	})
	pe:Emit(count or 20)
	task.delay((life or 3) + 1, function()
		holder:Destroy()
	end)
	return holder
end

function Fx.dust(pos: Vector3, radius: number?, count: number?)
	local r = radius or 10
	local holder, pe = emitterAt(pos, {
		Texture = SMOKE,
		Color = ColorSequence.new(rgb(220, 160, 104)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, r * 0.4), NumberSequenceKeypoint.new(1, r * 1.3) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(2, 4),
		Speed = NumberRange.new(r * 1.5, r * 3.5),
		SpreadAngle = Vector2.new(80, 10),
		EmissionDirection = Enum.NormalId.Top,
		Rotation = NumberRange.new(0, 360),
		Drag = 3,
		Acceleration = Vector3.new(0, 2, 0),
		LightInfluence = 1,
	})
	pe.Shape = Enum.ParticleEmitterShape.Disc
	pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	holder.Size = Vector3.new(r * 2, 0.2, r * 2)
	pe:Emit(count or 40)
	task.delay(5, function()
		holder:Destroy()
	end)
end

-- expanding energy shell
function Fx.shockwave(pos: Vector3, radius: number, duration: number?, color: Color3?)
	local d = duration or 0.6
	local ball = fxPart({
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.ForceField,
		Color = color or rgb(255, 200, 140),
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(pos),
		Transparency = 0,
	})
	UI.tween(ball, d, { Size = Vector3.new(radius * 2, radius * 2, radius * 2), Transparency = 1 }, Enum.EasingStyle.Quad)
	local ring = fxPart({
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.Neon,
		Color = color or rgb(255, 220, 170),
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		Transparency = 0.3,
	})
	UI.tween(ring, d * 1.2, { Size = Vector3.new(0.2, radius * 2.4, radius * 2.4), Transparency = 1 }, Enum.EasingStyle.Quad)
	task.delay(d * 1.3, function()
		ball:Destroy()
		ring:Destroy()
	end)
end

function Fx.explosion(pos: Vector3, scale: number?, opts: { [string]: any }?)
	local s = scale or 1
	local o = opts or {}
	-- fireball
	local fire = fxPart({
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon,
		Color = rgb(255, 210, 120),
		Size = Vector3.new(0.5, 0.5, 0.5) * s,
		CFrame = CFrame.new(pos),
	})
	local light = Instance.new("PointLight")
	light.Range = 40 * math.sqrt(s)
	light.Brightness = 10
	light.Color = rgb(255, 170, 90)
	light.Parent = fire
	UI.tween(fire, 0.22, { Size = Vector3.new(9, 9, 9) * s, Color = rgb(255, 120, 40) }, Enum.EasingStyle.Quad)
	task.delay(0.22, function()
		UI.tween(fire, 0.7, { Size = Vector3.new(12, 12, 12) * s, Color = rgb(90, 20, 10), Transparency = 1 }, Enum.EasingStyle.Quad)
		UI.tween(light, 0.9, { Brightness = 0 })
	end)
	task.delay(1.1, function()
		fire:Destroy()
	end)
	-- smoke, sparks, shockwave
	Fx.smoke(pos, 4 * s, math.floor(24 * math.sqrt(s)), o.smokeColor, 4)
	Fx.sparks(pos, math.floor(50 * math.sqrt(s)))
	Fx.shockwave(pos, 14 * s, 0.5, o.waveColor)
	-- flying debris
	local debris = {}
	for i = 1, (o.debris or 14) do
		local p = fxPart({
			Size = Vector3.new(0.2 + math.random() * 0.6, 0.2 + math.random() * 0.4, 0.2 + math.random() * 0.6) * math.sqrt(s),
			Color = (o.debrisColors and o.debrisColors[math.random(1, #o.debrisColors)]) or rgb(40, 38, 36),
			Material = Enum.Material.SmoothPlastic,
			CFrame = CFrame.new(pos),
		})
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5).Unit
		table.insert(debris, { part = p, vel = dir * (20 + math.random() * 30) * math.sqrt(s), spin = Vector3.new(math.random(), math.random(), math.random()) * 10 })
		local _ = i
	end
	task.spawn(function()
		local t = 0
		while t < 1.6 do
			local dt = RunService.RenderStepped:Wait()
			t += dt
			for _, d in debris do
				d.vel += Vector3.new(0, -90, 0) * dt
				local p = d.part
				p.CFrame = (p.CFrame + d.vel * dt) * CFrame.Angles(d.spin.X * dt, d.spin.Y * dt, d.spin.Z * dt)
			end
		end
		for _, d in debris do
			d.part:Destroy()
		end
	end)
	-- sound
	if o.sound ~= false then
		local holder = fxPart({ Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos) })
		local snd = Audio.make(o.sound or "Explosion", holder)
		if snd then
			snd.RollOffMaxDistance = 600
			snd:Play()
		end
		task.delay(8, function()
			holder:Destroy()
		end)
	end
end

-- ring of sound travelling forward from `origin` (CFrame looking where it flies)
function Fx.sonicRing(origin: CFrame, distance: number, duration: number?, size: number?, color: Color3?)
	local d = duration or 0.6
	local sz = size or 6
	local ring = fxPart({
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.ForceField,
		Color = color or rgb(120, 220, 255),
		Size = Vector3.new(0.6, sz, sz),
		CFrame = origin * CFrame.Angles(0, math.rad(90), 0),
	})
	local core = fxPart({
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.Neon,
		Color = color or rgb(150, 230, 255),
		Transparency = 0.6,
		Size = Vector3.new(0.2, sz * 0.9, sz * 0.9),
		CFrame = origin * CFrame.Angles(0, math.rad(90), 0),
	})
	local target = origin * CFrame.new(0, 0, -distance) * CFrame.Angles(0, math.rad(90), 0)
	UI.tween(ring, d, { CFrame = target, Size = Vector3.new(0.6, sz * 3, sz * 3), Transparency = 0.7 }, Enum.EasingStyle.Linear)
	UI.tween(core, d, { CFrame = target, Size = Vector3.new(0.2, sz * 2.6, sz * 2.6), Transparency = 1 }, Enum.EasingStyle.Linear)
	task.delay(d, function()
		ring:Destroy()
		core:Destroy()
	end)
end

-- energy beam between two points; returns a handle {Set(from, to), SetWidth(w), Destroy()}
function Fx.beam(from: Vector3, to: Vector3, width: number, color: Color3?)
	local col = color or rgb(150, 230, 255)
	local core = fxPart({ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = Color3.new(1, 1, 1) })
	local glow = fxPart({ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = col, Transparency = 0.45 })
	local shell = fxPart({ Shape = Enum.PartType.Cylinder, Material = Enum.Material.ForceField, Color = col })
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 6
	light.Color = col
	light.Parent = glow
	local handle = {}
	local w = width
	function handle.Set(a: Vector3, b: Vector3)
		local len = (b - a).Magnitude
		local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
		local jitter = 1 + (math.random() - 0.5) * 0.25
		core.Size = Vector3.new(len, w * 0.35 * jitter, w * 0.35 * jitter)
		glow.Size = Vector3.new(len, w * jitter, w * jitter)
		shell.Size = Vector3.new(len, w * 1.8, w * 1.8)
		core.CFrame = cf
		glow.CFrame = cf
		shell.CFrame = cf
	end
	function handle.SetWidth(nw: number)
		w = nw
	end
	function handle.Destroy()
		core:Destroy()
		glow:Destroy()
		shell:Destroy()
	end
	handle.Set(from, to)
	return handle
end

-- a big dark part flash (used for the curse hand blur)
function Fx.clear()
	folder:ClearAllChildren()
end

return Fx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2919">
        <Properties>
          <string name="Name">Puppet</string>
          <string name="Source"><![CDATA[-- Procedural animation for NPC rigs (R6 family + Rick) and big rigs (Titan, entity).
-- Poses are tables of jointName -> CFrame (joint Transform). Layers: walking, talking, breathing,
-- look-at, glitch. Applied every frame in PreSimulation.
local RunService = game:GetService("RunService")

local Puppet = {}
Puppet.__index = Puppet

local active: { any } = {}

----------------------------------------------------------------------------
-- R6 joint helpers (R6 joints have rotated frames)
----------------------------------------------------------------------------
local R6 = {}
-- forward > 0 swings the limb forward; out > 0 lifts the arm sideways away from the body
function R6.arm(side: number, forward: number, out: number?): CFrame
	return CFrame.Angles(0, 0, side * forward) * CFrame.Angles(-(out or 0), 0, 0)
end
function R6.leg(side: number, forward: number): CFrame
	return CFrame.Angles(0, 0, side * forward)
end
-- yaw > 0 turns the head left, pitch > 0 nods down
function R6.neck(yaw: number, pitch: number): CFrame
	return CFrame.Angles(pitch, 0, yaw)
end
-- lean > 0 leans forward, yaw > 0 twists left
function R6.root(lean: number, yaw: number?): CFrame
	return CFrame.Angles(lean, 0, yaw or 0)
end
Puppet.R6 = R6

-- ready-made R6 poses
local poses = {}
poses.stand = {}
poses.sit = {
	["Right Hip"] = R6.leg(1, 1.57),
	["Left Hip"] = R6.leg(-1, 1.57),
	["Right Shoulder"] = R6.arm(1, 0.45, 0.05),
	["Left Shoulder"] = R6.arm(-1, 0.45, 0.05),
}
poses.sitEat = {
	["Right Hip"] = R6.leg(1, 1.57),
	["Left Hip"] = R6.leg(-1, 1.57),
	["Right Shoulder"] = R6.arm(1, 0.9, 0.1),
	["Left Shoulder"] = R6.arm(-1, 0.55, 0.05),
	Neck = R6.neck(0, 0.25),
}
poses.sitRead = {
	["Right Hip"] = R6.leg(1, 1.57),
	["Left Hip"] = R6.leg(-1, 1.57),
	["Right Shoulder"] = R6.arm(1, 1.25, -0.25),
	["Left Shoulder"] = R6.arm(-1, 1.25, -0.25),
	Neck = R6.neck(0, 0.3),
}
poses.sitPhone = {
	["Right Hip"] = R6.leg(1, 1.57),
	["Left Hip"] = R6.leg(-1, 1.57),
	["Right Shoulder"] = R6.arm(1, 1.1, -0.35),
	["Left Shoulder"] = R6.arm(-1, 1.1, -0.35),
	Neck = R6.neck(0, 0.45),
}
poses.sitPoint = {
	["Right Hip"] = R6.leg(1, 1.57),
	["Left Hip"] = R6.leg(-1, 1.57),
	["Right Shoulder"] = R6.arm(1, 1.55, 0.15),
	["Left Shoulder"] = R6.arm(-1, 0.4, 0.05),
	RootJoint = R6.root(0.12),
}
poses.standPoint = {
	["Right Shoulder"] = R6.arm(1, 1.5, 0.1),
	["Left Shoulder"] = R6.arm(-1, 0.1, 0.25),
	RootJoint = R6.root(0.08),
}
poses.shocked = {
	["Right Shoulder"] = R6.arm(1, 2.6, 0.3),
	["Left Shoulder"] = R6.arm(-1, 2.6, 0.3),
	RootJoint = R6.root(-0.15),
	Neck = R6.neck(0, -0.2),
}
poses.sitShocked = {
	["Right Hip"] = R6.leg(1, 1.2),
	["Left Hip"] = R6.leg(-1, 1.2),
	["Right Shoulder"] = R6.arm(1, 2.4, 0.4),
	["Left Shoulder"] = R6.arm(-1, 2.4, 0.4),
	RootJoint = R6.root(-0.3),
	Neck = R6.neck(0, -0.25),
}
poses.lean = {
	RootJoint = R6.root(0.55),
	Neck = R6.neck(0, 0.35),
	["Right Shoulder"] = R6.arm(1, 0.5, 0.1),
	["Left Shoulder"] = R6.arm(-1, 0.5, 0.1),
}
poses.handsOnHips = {
	["Right Shoulder"] = R6.arm(1, -0.2, 0.55),
	["Left Shoulder"] = R6.arm(-1, -0.2, 0.55),
}
poses.holdRadar = {
	["Right Shoulder"] = R6.arm(1, 1.25, -0.15),
	["Left Shoulder"] = R6.arm(-1, 1.15, -0.2),
	Neck = R6.neck(0, 0.45),
}
poses.drag = {
	RootJoint = R6.root(0.35),
	["Right Shoulder"] = R6.arm(1, -1.2, 0.1),
	["Left Shoulder"] = R6.arm(-1, 0.6, 0),
}
poses.crawl = {
	RootJoint = R6.root(1.2),
	["Right Shoulder"] = R6.arm(1, 1.5, 0.2),
	["Left Shoulder"] = R6.arm(-1, 1.5, 0.2),
	["Right Hip"] = R6.leg(1, 0.6),
	["Left Hip"] = R6.leg(-1, 0.6),
	Neck = R6.neck(0, -0.6),
}
poses.cough = {
	RootJoint = R6.root(0.35),
	["Right Shoulder"] = R6.arm(1, 2.2, -0.3),
	Neck = R6.neck(0, 0.4),
}
poses.pilot = {
	["Right Hip"] = R6.leg(1, 1.4),
	["Left Hip"] = R6.leg(-1, 1.4),
	["Right Shoulder"] = R6.arm(1, 1.15, 0),
	["Left Shoulder"] = R6.arm(-1, 1.15, 0),
}
poses.wave = {
	["Right Shoulder"] = R6.arm(1, 0.3, 2.6),
}
Puppet.Poses = poses

----------------------------------------------------------------------------
function Puppet.new(model: Model, kind: string?)
	local self = setmetatable({}, Puppet)
	self.model = model
	self.kind = kind or "R6"
	self.root = (model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Root")) :: BasePart
	self.joints = {} :: { [string]: Motor6D }
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			self.joints[d.Name] = d
		end
	end
	self.target = {} :: { [string]: CFrame }
	self.current = {} :: { [string]: CFrame }
	self.smooth = 8
	self.t = math.random() * 10
	self.walk = 0
	self.walkPhase = 0
	self.walkSpeed = 0
	self.talking = false
	self.gesture = 1
	self.glitch = 0
	self.lookTarget = nil :: Vector3?
	self.follow = nil :: ((number) -> CFrame)?
	self.extra = nil :: ((number, number) -> { [string]: CFrame })?
	self.blinkAt = os.clock() + 2 + math.random() * 3
	self.parts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(self.parts, d)
			if d.Name == "EyeL" or d.Name == "EyeR" or d.Name == "Mouth" then
				d:SetAttribute("BaseSize", d.Size)
			end
		end
	end
	table.insert(active, self)
	return self
end

function Puppet:destroy()
	local i = table.find(active, self)
	if i then
		table.remove(active, i)
	end
end

function Puppet:pose(nameOrTable: any, smooth: number?)
	local p = if type(nameOrTable) == "string" then poses[nameOrTable] else nameOrTable
	table.clear(self.target)
	for k, cf in p or {} do
		self.target[k] = cf
	end
	if smooth then
		self.smooth = smooth
	end
end

function Puppet:set(joint: string, cf: CFrame?)
	self.target[joint] = cf
end

function Puppet:snap()
	for name, joint in self.joints do
		local cf = self.target[name] or CFrame.new()
		self.current[name] = cf
		joint.Transform = cf
	end
end

function Puppet:place(cf: CFrame)
	self.follow = nil
	self.root.CFrame = cf
end

function Puppet:visible(on: boolean)
	for _, p in self.parts do
		p.LocalTransparencyModifier = if on then 0 else 1
	end
	self.hidden = not on
end

-- walk (anchored root slides on a flat plane). Yields until arrived.
function Puppet:walkTo(pos: Vector3, speed: number?, faceAtEnd: Vector3?)
	local sp = speed or 9
	self.follow = nil
	self.walk = 1
	self.walkSpeed = sp
	local y = self.root.Position.Y
	local goal = Vector3.new(pos.X, y, pos.Z)
	while true do
		local dt = RunService.Heartbeat:Wait()
		local cur = self.root.Position
		local delta = goal - cur
		local dist = delta.Magnitude
		if dist < 0.25 then
			break
		end
		local stepLen = math.min(dist, sp * dt)
		local dir = delta.Unit
		local newPos = cur + dir * stepLen
		local look = self.root.CFrame.LookVector
		local wantLook = Vector3.new(dir.X, 0, dir.Z).Unit
		local lerped = look:Lerp(wantLook, math.min(1, dt * 8))
		if lerped.Magnitude < 0.01 then
			lerped = wantLook
		end
		self.root.CFrame = CFrame.lookAt(newPos, newPos + Vector3.new(lerped.X, 0, lerped.Z))
	end
	self.walk = 0
	if faceAtEnd then
		self:face(faceAtEnd)
	end
end

function Puppet:face(pos: Vector3, instant: boolean?)
	local p = self.root.Position
	local target = Vector3.new(pos.X, p.Y, pos.Z)
	if (target - p).Magnitude < 0.01 then
		return
	end
	if instant then
		self.root.CFrame = CFrame.lookAt(p, target)
		return
	end
	local from = self.root.CFrame
	local to = CFrame.lookAt(p, target)
	task.spawn(function()
		local t = 0
		while t < 1 do
			t += RunService.Heartbeat:Wait() * 4
			self.root.CFrame = from:Lerp(to, math.min(t, 1))
		end
	end)
end

function Puppet:lookAt(pos: Vector3?)
	self.lookTarget = pos
end

----------------------------------------------------------------------------
local function headAngles(self, neckJoint: Motor6D): (number, number)
	local target = self.lookTarget
	if not target then
		return 0, 0
	end
	local part0 = neckJoint.Part0
	if not part0 then
		return 0, 0
	end
	local origin = part0.CFrame * neckJoint.C0
	local rel = part0.CFrame:VectorToObjectSpace(target - origin.Position)
	local yaw = math.atan2(-rel.X, -rel.Z)
	local flat = math.sqrt(rel.X * rel.X + rel.Z * rel.Z)
	local pitch = math.atan2(-rel.Y, flat)
	return math.clamp(yaw, -1.1, 1.1), math.clamp(pitch, -0.7, 0.7)
end

function Puppet:_step(dt: number)
	self.t += dt
	local t = self.t
	if self.follow then
		self.root.CFrame = self.follow(dt)
	end
	local out: { [string]: CFrame } = {}
	for k, cf in self.target do
		out[k] = cf
	end
	local function mul(name: string, cf: CFrame)
		out[name] = (out[name] or CFrame.new()) * cf
	end

	if self.kind == "R6" then
		-- walking
		if self.walk > 0 then
			self.walkPhase += dt * (self.walkSpeed or 9) * 0.9
			local a = math.sin(self.walkPhase) * 0.75 * self.walk
			mul("Right Hip", R6.leg(1, a))
			mul("Left Hip", R6.leg(-1, -a))
			mul("Right Shoulder", R6.arm(1, -a * 0.8))
			mul("Left Shoulder", R6.arm(-1, a * 0.8))
			mul("RootJoint", R6.root(0.05, math.sin(self.walkPhase) * 0.05))
		else
			-- breathing / idle sway
			mul("RootJoint", R6.root(math.sin(t * 1.4) * 0.012, math.sin(t * 0.45) * 0.02))
		end
		-- talking gestures + head
		local yaw, pitch = 0, 0
		if self.joints.Neck then
			yaw, pitch = headAngles(self, self.joints.Neck)
		end
		if self.talking then
			pitch += math.sin(t * 7.3) * 0.05 + math.sin(t * 3.1) * 0.04
			yaw += math.sin(t * 2.2) * 0.08
			if self.walk == 0 and self.gesture > 0 then
				mul("Right Shoulder", R6.arm(1, (0.25 + 0.2 * math.sin(t * 2.6)) * self.gesture, 0.15 * self.gesture))
				mul("Left Shoulder", R6.arm(-1, (0.12 + 0.12 * math.sin(t * 2.1 + 1)) * self.gesture, 0.1 * self.gesture))
			end
		end
		mul("Neck", R6.neck(yaw, pitch))
	else
		-- big rigs: gentle idle on the root
		local yaw, pitch = 0, 0
		if self.joints.Neck then
			yaw, pitch = headAngles(self, self.joints.Neck)
		end
		mul("Neck", CFrame.Angles(-pitch, yaw, 0))
	end
	if self.extra then
		for k, cf in self.extra(t, dt) do
			mul(k, cf)
		end
	end

	-- glitch: random twitches + flicker
	if self.glitch > 0 and not self.hidden then
		if math.random() < self.glitch * 0.18 then
			for name in self.joints do
				if math.random() < 0.4 then
					mul(name, CFrame.Angles((math.random() - 0.5) * self.glitch, (math.random() - 0.5) * self.glitch, (math.random() - 0.5) * self.glitch))
				end
			end
		end
		if math.random() < self.glitch * 0.08 then
			local victims = {}
			for i = 1, math.random(2, 8) do
				local p = self.parts[math.random(1, #self.parts)]
				if p and p.Transparency < 1 then
					table.insert(victims, p)
					p.LocalTransparencyModifier = if math.random() < 0.5 then 1 else 0.6
				end
				local _ = i
			end
			task.delay(0.05 + math.random() * 0.08, function()
				if not self.hidden then
					for _, p in victims do
						p.LocalTransparencyModifier = 0
					end
				end
			end)
		end
	end

	-- blink + mouth
	local now = os.clock()
	if now > self.blinkAt then
		self.blinkAt = now + 2.5 + math.random() * 4
		for _, p in self.parts do
			if p.Name == "EyeL" or p.Name == "EyeR" then
				local base = p:GetAttribute("BaseSize")
				if base then
					p.Size = Vector3.new(base.X, base.Y * 0.12, base.Z)
					task.delay(0.12, function()
						p.Size = base
					end)
				end
			end
		end
	end
	for _, p in self.parts do
		if p.Name == "Mouth" then
			local base = p:GetAttribute("BaseSize")
			if base then
				local open = if self.talking then math.max(0, math.sin(t * 16) * 0.5 + math.sin(t * 9.7) * 0.5) else 0
				p.Size = Vector3.new(base.X, base.Y + open * 0.32, base.Z)
			end
		end
	end

	-- smooth + apply
	local k = 1 - math.exp(-self.smooth * dt)
	for name, joint in self.joints do
		local goal = out[name] or CFrame.new()
		local cur = self.current[name] or CFrame.new()
		cur = cur:Lerp(goal, k)
		self.current[name] = cur
		joint.Transform = cur
	end
end

RunService.PreSimulation:Connect(function(dt)
	for _, p in active do
		local ok, err = pcall(p._step, p, dt)
		if not ok then
			warn("Puppet error:", err)
		end
	end
end)

return Puppet
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2920">
        <Properties>
          <string name="Name">Scenes</string>
          <string name="Source"><![CDATA[-- Lighting + ambience for every story location.
local Graphics = require(script.Parent.Graphics)
local Audio = require(script.Parent.Audio)

local Scenes = {}
local rgb = Color3.fromRGB

Scenes.Presets = {
	-- 7 AM in the Smith house
	Morning = {
