      <Item class="ModuleScript" referent="820">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	GAME CONFIG  —  change things here.

	MenuStyle  : which main menu you see.   "Cinematic" | "Cartoon" | "Monitor" | "VHS" | "Notebook"
	Graphics   : starting graphics preset.  "Moonlight" | "Sunrise" | "Cartoon" | "Portal" | "Noir"
	ShowStylePicker : the little bar at the bottom of the menu that lets you flip
	                  through the variants. Set to false when you have picked your favourite.
]]
local Config = {}

Config.Title = "RICK AND MORTY"
Config.Subtitle = "WAKE UP, MORTY"
Config.Version = "v0.1"

Config.MenuStyle = "Cinematic"
Config.Graphics = "Moonlight"
Config.ShowStylePicker = true

Config.MenuStyles = { "Cinematic", "Cartoon", "Monitor", "VHS", "Notebook" }
Config.GraphicsPresets = { "Moonlight", "Sunrise", "Cartoon", "Portal", "Noir" }

-- Default values of the Settings page
Config.Defaults = {
	Music = 0.6,
	Sound = 0.8,
	Sensitivity = 1.0,
	FOV = 72,
	Brightness = 0,
	HeadBob = true,
	ShowBody = true,
}

--[[
	SOUNDS
	All of these are public Roblox audio (licensed APM music, Pro Sound Effects
	library, official Roblox UI sounds, or files that ship with the Roblox client),
	so they play in any game. To use a different sound, paste another
	"rbxassetid://NUMBER" into Id. Volume is 0..1 (before the Settings sliders).
]]
Config.Sounds = {
	-- Menu music (each menu style picks one)
	MusicDreamy = { Id = "rbxassetid://9046435309", Volume = 0.45, Looped = true, Group = "Music" }, -- The Still, Sad Music Of Humanity (APM)
	MusicLofi = { Id = "rbxassetid://9043887091", Volume = 0.5, Looped = true, Group = "Music" }, -- Lo-fi Chill A (APM)
	MusicNight = { Id = "rbxassetid://9047105702", Volume = 0.5, Looped = true, Group = "Music" }, -- Light Dreamer (APM)
	MusicSynth = { Id = "rbxassetid://1837087135", Volume = 0.45, Looped = true, Group = "Music" }, -- Ambient Light (APM)

	-- Room
	Snore = { Id = "rbxassetid://9113862735", Volume = 0.55, Looped = true, Group = "SFX", RollOff = 26 }, -- Comic Snoring Male (PSE)
	Alarm = { Id = "rbxassetid://9113083860", Volume = 0.6, Looped = true, Group = "SFX", RollOff = 40 }, -- Alarm Beeps 1 (PSE)
	ClockTick = { Id = "rbxassetid://9116463812", Volume = 0.18, Looped = true, Group = "Ambience", RollOff = 18 }, -- Mantle Clock 1 (PSE)
	Crickets = { Id = "rbxassetid://9112764891", Volume = 0.3, Looped = true, Group = "Ambience" }, -- Crickets Night 3 (PSE)
	Birds = { Id = "rbxassetid://9119383684", Volume = 0.3, Looped = true, Group = "Ambience" }, -- Sonoma Morning Birds (PSE)
	PortalHum = { Id = "rbxassetid://9114340342", Volume = 0.25, Looped = true, Group = "Ambience" }, -- Energy Pass By Sci Fi (PSE)

	-- Waking up
	Gasp = { Id = "rbxassetid://9114555214", Volume = 0.5, Group = "SFX" }, -- Gasp Deep Inhale And Exhale (PSE)
	Cloth = { Id = "rbxassetid://9113824106", Volume = 0.6, Group = "SFX" }, -- Cloth Movement 21 (PSE)
	GetUp = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.5, Group = "SFX" }, -- ships with Roblox
	Switch = { Id = "rbxassetid://9116286721", Volume = 0.6, Group = "SFX" }, -- Light Switch Flip (PSE)
	Click = { Id = "rbxassetid://9119717523", Volume = 0.5, Group = "SFX" }, -- Switch Click (PSE)
	Whoosh = { Id = "rbxassetid://9126229255", Volume = 0.45, Group = "SFX" }, -- Whoosh By Fast Airy (PSE)
	Portal = { Id = "rbxassetid://9114340342", Volume = 0.5, Group = "SFX" }, -- Energy Pass By Sci Fi (PSE)

	-- Menu UI (official Roblox UI sounds)
	UIHover = { Id = "rbxassetid://10066931761", Volume = 0.35, Group = "SFX" },
	UIClick = { Id = "rbxassetid://15675032796", Volume = 0.6, Group = "SFX" },
	UIBack = { Id = "rbxassetid://10066914500", Volume = 0.5, Group = "SFX" },
	UISwoosh = { Id = "rbxassetid://15675024286", Volume = 0.4, Group = "SFX" },
	UITick = { Id = "rbxasset://sounds/volume_slider.ogg", Volume = 0.5, Group = "SFX" }, -- ships with Roblox
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="821">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[-- Tiny UI toolkit shared by all menu styles.
local TweenService = game:GetService("TweenService")

local UI = {}

UI.DESIGN_HEIGHT = 1080

function UI.new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	local parent = nil
	if props then
		for k, val in props do
			if k == "Parent" then
				parent = val
			else
				(inst :: any)[k] = val
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?, delay: number?): Tween
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out, 0, false, delay or 0), props)
	tw:Play()
	return tw
end

function UI.corner(radius: number | UDim): UICorner
	return UI.new("UICorner", { CornerRadius = if typeof(radius) == "UDim" then radius else UDim.new(0, radius :: number) })
end

function UI.round(): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function UI.stroke(thickness: number, color: Color3, transparency: number?, border: boolean?): UIStroke
	return UI.new("UIStroke", {
		Thickness = thickness,
		Color = color,
		Transparency = transparency or 0,
		ApplyStrokeMode = if border then Enum.ApplyStrokeMode.Border else Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

function UI.padding(l: number, t: number?, r: number?, b: number?): UIPadding
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, l),
		PaddingTop = UDim.new(0, t or l),
		PaddingRight = UDim.new(0, r or l),
		PaddingBottom = UDim.new(0, b or t or l),
	})
end

function UI.list(padding: number, horizontal: boolean?, halign: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, padding),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.gradient(colors: { Color3 }?, transparency: { number }?, rotation: number?): UIGradient
	local g = UI.new("UIGradient", { Rotation = rotation or 0 })
	if colors then
		local kps = {}
		for i, c in colors do
			table.insert(kps, ColorSequenceKeypoint.new((i - 1) / math.max(#colors - 1, 1), c))
		end
		g.Color = ColorSequence.new(kps)
	end
	if transparency then
		local kps = {}
		for i, tr in transparency do
			table.insert(kps, NumberSequenceKeypoint.new((i - 1) / math.max(#transparency - 1, 1), tr))
		end
		g.Transparency = NumberSequence.new(kps)
	end
	return g
end

-- "PLAY" -> "P L A Y" (cheap letter spacing)
function UI.spaced(text: string, gap: string?): string
	local out = {}
	for _, cp in utf8.codes(text) do
		table.insert(out, utf8.char(cp))
	end
	return table.concat(out, gap or " ")
end

function UI.full(parent: Instance, name: string, z: number?): Frame
	return UI.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = z or 1,
		Parent = parent,
	})
end

-- A canvas that is always 1080 "design pixels" tall (bigger on phones),
-- so offsets look the same on every screen.
function UI.canvas(parent: Instance): (Frame, UIScale)
	local canvas = UI.new("Frame", { Name = "Canvas", BackgroundTransparency = 1, Parent = parent })
	local scale = UI.new("UIScale", { Parent = canvas })
	local camera = workspace.CurrentCamera
	local function update()
		local vp = camera.ViewportSize
		local design = UI.DESIGN_HEIGHT
		if vp.Y < 600 then
			design = 820
		end
		local s = math.max(vp.Y / design, 0.2)
		-- very narrow screens: make sure ~1000 design px fit horizontally
		if vp.X / s < 1000 then
			s = vp.X / 1000
		end
		scale.Scale = s
		canvas.Size = UDim2.fromOffset(vp.X / s, vp.Y / s)
	end
	update()
	local conn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	canvas.Destroying:Connect(function()
		conn:Disconnect()
	end)
	return canvas, scale
end

function UI.label(props: { [string]: any }): TextLabel
	local base = {
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		RichText = false,
	}
	for k, val in props do
		base[k] = val
	end
	return UI.new("TextLabel", base)
end

return UI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="822">
        <Properties>
          <string name="Name">Widgets</string>
          <string name="Source"><![CDATA[-- Settings widgets (slider / toggle / choice). Each menu style passes a theme:
-- { Font, Text, TextDim, Accent, Track, TrackTransparency, Knob, KnobStroke, RowHeight,
--   LabelSize, Width, ValueWidth, Uppercase, Textual, Corner, Sound(kind) }
local UserInputService = game:GetService("UserInputService")
local UI = require(script.Parent.UI)

local Widgets = {}

local function caption(theme, s: string): string
	return if theme.Uppercase then string.upper(s) else s
end

local function sound(theme, kind: string)
	if theme.Sound then
		theme.Sound(kind)
	end
end

local function makeRow(parent: Instance, theme, text: string, order: number)
	local row = UI.new("Frame", {
		Name = text,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(theme.Width, theme.RowHeight),
		LayoutOrder = order,
		Parent = parent,
	})
	local lbl = UI.label({
		Name = "Label",
		Font = theme.Font,
		Text = caption(theme, text),
		TextColor3 = theme.TextDim,
		TextSize = theme.LabelSize,
		Size = UDim2.fromScale(0.42, 1),
		Parent = row,
	})
	local right = UI.new("Frame", {
		Name = "Control",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.42, 0),
		Size = UDim2.fromScale(0.58, 1),
		Parent = row,
	})
	row.MouseEnter:Connect(function()
		lbl.TextColor3 = theme.Text
		sound(theme, "hover")
	end)
	row.MouseLeave:Connect(function()
		lbl.TextColor3 = theme.TextDim
	end)
	return row, right, lbl
end

local function textButton(theme, props)
	local base = {
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Font = theme.Font,
		TextColor3 = theme.Text,
		TextSize = theme.LabelSize,
		Text = "",
	}
	for k, val in props do
		base[k] = val
	end
	return UI.new("TextButton", base)
end

function Widgets.Slider(parent: Instance, theme, opts)
	local row, right = makeRow(parent, theme, opts.Label, opts.Order or 0)
	local valueWidth = theme.ValueWidth or 70
	local value = opts.Value
	local minV, maxV = opts.Min, opts.Max
	local step = opts.Step or 0.05

	local function snap(x: number): number
		local s = math.floor((x - minV) / step + 0.5) * step + minV
		return math.clamp(s, minV, maxV)
	end

	local valueText = UI.label({
		Font = theme.Font,
		TextColor3 = theme.Text,
		TextSize = theme.LabelSize - 2,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, valueWidth, 1, 0),
		Parent = right,
	})

	local render: (number) -> ()
	if theme.Textual then
		local bar = textButton(theme, {
			TextColor3 = theme.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -valueWidth, 1, 0),
			Parent = right,
		})
		render = function(v)
			local n = math.floor((v - minV) / (maxV - minV) * 10 + 0.5)
			bar.Text = "< " .. string.rep("|", n) .. string.rep(".", 10 - n) .. " >"
		end
		bar.Activated:Connect(function(input)
			local x = if input then input.Position.X else bar.AbsolutePosition.X + bar.AbsoluteSize.X
			local mid = bar.AbsolutePosition.X + bar.AbsoluteSize.X / 2
			local delta = (maxV - minV) / 10
			value = snap(value + (if x < mid then -delta else delta))
			render(value)
			valueText.Text = if opts.Format then opts.Format(value) else tostring(value)
			sound(theme, "tick")
			if opts.OnChanged then
				opts.OnChanged(value)
			end
		end)
	else
		local track = textButton(theme, {
			BackgroundTransparency = theme.TrackTransparency or 0.7,
			BackgroundColor3 = theme.Track,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, -(valueWidth + 18), 0, theme.TrackHeight or 6),
			Parent = right,
		})
		if theme.Corner then
			UI.corner(theme.Corner).Parent = track
		end
		local fill = UI.new("Frame", {
			BackgroundColor3 = theme.Accent,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(0.5, 1),
			Parent = track,
		})
		if theme.Corner then
			UI.corner(theme.Corner).Parent = fill
		end
		local ks = theme.KnobSize or 18
		local knob = UI.new("Frame", {
			BackgroundColor3 = theme.Knob or theme.Accent,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(ks, ks),
			ZIndex = 2,
			Parent = track,
		})
		if theme.KnobShape ~= "square" then
			UI.round().Parent = knob
		end
		if theme.KnobStroke then
			UI.stroke(theme.KnobStrokeThickness or 2, theme.KnobStroke, 0, true).Parent = knob
		end
		-- big invisible hit area so it is easy to grab
		local hit = textButton(theme, {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, math.max(theme.RowHeight - 8, 24)),
			ZIndex = 3,
			Parent = track,
		})
		render = function(v)
			local a = (v - minV) / (maxV - minV)
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.fromScale(a, 0.5)
		end
		local dragging = false
		local function fromX(x: number)
			local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local old = value
			value = snap(minV + a * (maxV - minV))
			if value ~= old then
				render(value)
				valueText.Text = if opts.Format then opts.Format(value) else tostring(value)
				sound(theme, "tick")
				if opts.OnChanged then
					opts.OnChanged(value)
				end
			end
		end
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				fromX(input.Position.X)
			end
		end)
		local c1 = UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				fromX(input.Position.X)
			end
		end)
		local c2 = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		row.Destroying:Connect(function()
			c1:Disconnect()
			c2:Disconnect()
		end)
	end
	value = snap(value)
	render(value)
	valueText.Text = if opts.Format then opts.Format(value) else tostring(value)
	return row
end

function Widgets.Toggle(parent: Instance, theme, opts)
	local row, right = makeRow(parent, theme, opts.Label, opts.Order or 0)
	local value = opts.Value == true
	local render: () -> ()
	local button
	if theme.Textual then
		button = textButton(theme, {
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromScale(1, 1),
			Parent = right,
		})
		render = function()
			button.Text = if value then "[ ON  ]" else "[ OFF ]"
			button.TextColor3 = if value then theme.Accent else theme.TextDim
		end
	else
		button = textButton(theme, {
			BackgroundTransparency = theme.TrackTransparency or 0.7,
			BackgroundColor3 = theme.Track,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(58, 30),
			Parent = right,
		})
		UI.round().Parent = button
		if theme.KnobStroke then
			UI.stroke(theme.KnobStrokeThickness or 2, theme.KnobStroke, 0, true).Parent = button
		end
		local knob = UI.new("Frame", {
			BackgroundColor3 = theme.Knob or Color3.new(1, 1, 1),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 4, 0.5, 0),
			Size = UDim2.fromOffset(22, 22),
			Parent = button,
		})
		UI.round().Parent = knob
		local state = UI.label({
			Font = theme.Font,
			TextColor3 = theme.Text,
			TextSize = theme.LabelSize - 4,
			Position = UDim2.new(0, 72, 0, 0),
			Size = UDim2.new(0, 80, 1, 0),
			Parent = right,
		})
		render = function()
			UI.tween(knob, 0.18, { Position = if value then UDim2.new(1, -26, 0.5, 0) else UDim2.new(0, 4, 0.5, 0) }, Enum.EasingStyle.Back)
			UI.tween(button, 0.18, {
				BackgroundColor3 = if value then theme.Accent else theme.Track,
				BackgroundTransparency = if value then 0 else (theme.TrackTransparency or 0.7),
			})
			state.Text = caption(theme, if value then "On" else "Off")
		end
	end
	button.Activated:Connect(function()
		value = not value
		render()
		sound(theme, "click")
		if opts.OnChanged then
			opts.OnChanged(value)
		end
	end)
	render()
	return row
end

function Widgets.Choice(parent: Instance, theme, opts)
	local row, right = makeRow(parent, theme, opts.Label, opts.Order or 0)
	local options = opts.Options
	local index = table.find(options, opts.Value) or 1
	local arrowW = 36
	local left = textButton(theme, {
		Text = if theme.Textual then "<" else "‹",
		TextColor3 = theme.Accent,
		TextSize = theme.LabelSize + 4,
		Size = UDim2.new(0, arrowW, 1, 0),
		Parent = right,
	})
	local rightBtn = textButton(theme, {
		Text = if theme.Textual then ">" else "›",
		TextColor3 = theme.Accent,
		TextSize = theme.LabelSize + 4,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, arrowW, 1, 0),
		Parent = right,
	})
	local valueLabel = UI.label({
		Font = theme.Font,
		TextColor3 = theme.Text,
		TextSize = theme.LabelSize - 2,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, arrowW, 0, 0),
		Size = UDim2.new(1, -arrowW * 2, 1, 0),
		Parent = right,
	})
	local function render()
		valueLabel.Text = caption(theme, options[index])
	end
	local function shift(d: number)
		index = (index - 1 + d) % #options + 1
		render()
		sound(theme, "click")
		if opts.OnChanged then
			opts.OnChanged(options[index])
		end
	end
	left.Activated:Connect(function()
		shift(-1)
	end)
	rightBtn.Activated:Connect(function()
		shift(1)
	end)
	render()
	return row, function(v)
		index = table.find(options, v) or index
		render()
	end
end

return Widgets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="823">
        <Properties>
          <string name="Name">Settings</string>
          <string name="Source"><![CDATA[-- Player settings for this session (client side).
local Config = require(script.Parent.Config)

local Settings = {}
Settings.Values = table.clone(Config.Defaults)
Settings.Values.Graphics = Config.Graphics
Settings.Values.MenuStyle = Config.MenuStyle

local changed = Instance.new("BindableEvent")
Settings.Changed = changed.Event

function Settings.Get(key: string): any
	return Settings.Values[key]
end

function Settings.Set(key: string, value: any)
	if Settings.Values[key] == value then
		return
	end
	Settings.Values[key] = value
	changed:Fire(key, value)
end

return Settings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="824">
        <Properties>
          <string name="Name">Audio</string>
          <string name="Source"><![CDATA[-- Sound helper: one-shots, 3D sounds and cross-faded music.
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Config = require(script.Parent.Config)

local Audio = {}

local oneShots: { [string]: Sound } = {}
local musicSound: Sound? = nil
local musicKey: string? = nil

local function group(name: string): SoundGroup?
	local g = SoundService:FindFirstChild(name)
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = name
		g.Parent = SoundService
	end
	return g :: SoundGroup
end

function Audio.make(key: string, parent: Instance?): Sound?
	local def = Config.Sounds[key]
	if not def or not def.Id or def.Id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = def.Id
	s.Volume = def.Volume or 0.5
	s.Looped = def.Looped == true
	s.SoundGroup = group(def.Group or "SFX")
	if def.RollOff then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = def.RollOffMin or 5
		s.RollOffMaxDistance = def.RollOff
	end
	s:SetAttribute("BaseVolume", s.Volume)
	s.Parent = parent or SoundService
	return s
end

-- 2D one-shot (UI clicks, whooshes...)
function Audio.play(key: string, pitch: number?): Sound?
	local s = oneShots[key]
	if not s then
		s = Audio.make(key, SoundService)
		if not s then
			return nil
		end
		oneShots[key] = s
	end
	local snd = s :: Sound
	snd.PlaybackSpeed = pitch or 1
	snd.TimePosition = 0
	snd:Play()
	return snd
end

function Audio.fadeTo(sound: Sound?, volume: number, t: number)
	if sound then
		TweenService:Create(sound, TweenInfo.new(t, Enum.EasingStyle.Sine), { Volume = volume }):Play()
	end
end

function Audio.fadeIn(sound: Sound?, t: number)
	if sound then
		local target = sound:GetAttribute("BaseVolume") or sound.Volume
		sound.Volume = 0
		if not sound.IsPlaying then
			sound:Play()
		end
		Audio.fadeTo(sound, target, t)
	end
end

function Audio.fadeOut(sound: Sound?, t: number, destroy: boolean?)
	if sound then
		Audio.fadeTo(sound, 0, t)
		task.delay(t + 0.05, function()
			if destroy then
				sound:Destroy()
			else
				sound:Stop()
			end
		end)
	end
end

function Audio.music(key: string?, fadeTime: number?)
	local t = fadeTime or 1.5
	if key == musicKey then
		return
	end
	if musicSound then
		Audio.fadeOut(musicSound, t, true)
	end
	musicSound = nil
	musicKey = key
	if key then
		local s = Audio.make(key, SoundService)
		if s then
			Audio.fadeIn(s, t)
			musicSound = s
		end
	end
end

function Audio.setGroupVolume(name: string, volume: number)
	local g = group(name)
	if g then
		g.Volume = volume
	end
end

return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="825">
        <Properties>
          <string name="Name">Graphics</string>
          <string name="Source"><![CDATA[-- Graphics presets: lighting, colour grading, lamps, outlines.
-- Everything here runs on the client, so each player sees their own choice.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Graphics = {}

local rgb = Color3.fromRGB

--[[
	Lights you can switch per preset (names of Light objects inside MortysHouse):
	MoonBeam, SunBeam, DeskLamp, NightLamp, CeilingLight, StreetLamp, PortalLight, MonitorGlow, ClockGlow
	true / false = on / off, or a table of properties to override.
]]
Graphics.Presets = {
	Moonlight = {
		Description = "Night. Cold moonlight through the window, warm desk lamp.",
		Lighting = {
			ClockTime = 0.4,
			Brightness = 1.6,
			Ambient = rgb(24, 27, 40),
			OutdoorAmbient = rgb(60, 70, 100),
			ColorShift_Top = rgb(0, 0, 0),
			EnvironmentDiffuseScale = 0.35,
			EnvironmentSpecularScale = 0.5,
			ExposureCompensation = 0.15,
			ShadowSoftness = 0.25,
		},
		Atmosphere = { Density = 0.3, Color = rgb(100, 120, 170), Decay = rgb(40, 50, 80), Glare = 0, Haze = 1 },
		Grade = { Saturation = -0.05, Contrast = 0.1, Brightness = 0, TintColor = rgb(225, 232, 255) },
		Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.3 },
		SunRays = nil,
		Lights = {
			MoonBeam = { Brightness = 3, Color = rgb(140, 165, 255) },
			SunBeam = false,
			DeskLamp = true,
			NightLamp = false,
			CeilingLight = false,
			StreetLamp = true,
			PortalLight = false,
			MonitorGlow = { Color = rgb(120, 170, 255) },
			ClockGlow = true,
		},
		NightWindows = true,
		Portal = false,
		Outlines = false,
		Dust = true,
		Clock = "3:14",
		Ambience = "Crickets",
	},
	Sunrise = {
		Description = "Early morning. Low orange sun on the wall, floating dust.",
		Lighting = {
			ClockTime = 6.5,
			Brightness = 2.4,
			Ambient = rgb(70, 56, 52),
			OutdoorAmbient = rgb(150, 122, 110),
			ColorShift_Top = rgb(255, 196, 150),
			EnvironmentDiffuseScale = 0.6,
			EnvironmentSpecularScale = 0.6,
			ExposureCompensation = 0.1,
			ShadowSoftness = 0.15,
		},
		Atmosphere = { Density = 0.35, Color = rgb(255, 190, 150), Decay = rgb(180, 110, 90), Glare = 0.6, Haze = 1.6 },
		Grade = { Saturation = 0.12, Contrast = 0.06, Brightness = 0, TintColor = rgb(255, 240, 226) },
		Bloom = { Intensity = 0.8, Size = 30, Threshold = 1.1 },
		SunRays = { Intensity = 0.06, Spread = 0.7 },
		Lights = {
			MoonBeam = false,
			SunBeam = { Brightness = 5.5, Color = rgb(255, 168, 96) },
			DeskLamp = false,
			NightLamp = false,
			CeilingLight = false,
			StreetLamp = false,
			PortalLight = false,
			MonitorGlow = { Color = rgb(120, 170, 255), Brightness = 0.4 },
			ClockGlow = true,
		},
		NightWindows = false,
		Portal = false,
		Outlines = false,
		Dust = true,
		Clock = "6:58",
		Ambience = "Birds",
	},
	Cartoon = {
		Description = "Bright, flat colours and black outlines, like the show.",
		Lighting = {
			ClockTime = 10,
			Brightness = 2.2,
			Ambient = rgb(150, 150, 162),
			OutdoorAmbient = rgb(170, 170, 182),
			ColorShift_Top = rgb(0, 0, 0),
			EnvironmentDiffuseScale = 1,
			EnvironmentSpecularScale = 0,
			ExposureCompensation = 0,
			ShadowSoftness = 0.6,
		},
		Atmosphere = { Density = 0.2, Color = rgb(190, 220, 255), Decay = rgb(150, 180, 220), Glare = 0, Haze = 0 },
		Grade = { Saturation = 0.35, Contrast = 0.12, Brightness = 0.02, TintColor = rgb(255, 255, 255) },
		Bloom = { Intensity = 0.25, Size = 20, Threshold = 1.6 },
		SunRays = nil,
		Lights = {
			MoonBeam = false,
			SunBeam = false,
			DeskLamp = true,
			NightLamp = false,
			CeilingLight = { Brightness = 1.2 },
			StreetLamp = false,
			PortalLight = false,
			MonitorGlow = { Color = rgb(120, 255, 150), Brightness = 0.5 },
			ClockGlow = true,
		},
		NightWindows = false,
		Portal = false,
		Outlines = true,
		Dust = false,
		Clock = "8:15",
		Ambience = "Birds",
	},
	Portal = {
		Description = "Night. Rick opened a portal in the yard. Green glow everywhere.",
		Lighting = {
			ClockTime = 0.2,
			Brightness = 1,
			Ambient = rgb(18, 34, 24),
			OutdoorAmbient = rgb(40, 80, 50),
			ColorShift_Top = rgb(0, 0, 0),
			EnvironmentDiffuseScale = 0.35,
			EnvironmentSpecularScale = 0.6,
			ExposureCompensation = 0.2,
			ShadowSoftness = 0.2,
		},
		Atmosphere = { Density = 0.35, Color = rgb(90, 160, 100), Decay = rgb(30, 70, 40), Glare = 0, Haze = 1.2 },
		Grade = { Saturation = 0.15, Contrast = 0.14, Brightness = 0, TintColor = rgb(222, 255, 226) },
		Bloom = { Intensity = 1.2, Size = 40, Threshold = 0.95 },
		SunRays = nil,
		Lights = {
			MoonBeam = false,
			SunBeam = false,
			DeskLamp = false,
			NightLamp = false,
			CeilingLight = false,
			StreetLamp = false,
			PortalLight = true,
			MonitorGlow = { Color = rgb(120, 255, 140) },
			ClockGlow = true,
		},
		NightWindows = true,
		Portal = true,
		Outlines = false,
		Dust = true,
		Clock = "3:14",
		Ambience = "PortalHum",
	},
	Noir = {
		Description = "Black and white, hard moonlight shadows. Spooky.",
		Lighting = {
			ClockTime = 0.5,
			Brightness = 2,
			Ambient = rgb(14, 14, 14),
			OutdoorAmbient = rgb(60, 60, 60),
			ColorShift_Top = rgb(0, 0, 0),
			EnvironmentDiffuseScale = 0.25,
			EnvironmentSpecularScale = 0.6,
			ExposureCompensation = 0.3,
			ShadowSoftness = 0.05,
		},
		Atmosphere = { Density = 0.32, Color = rgb(150, 150, 150), Decay = rgb(60, 60, 60), Glare = 0, Haze = 1.4 },
		Grade = { Saturation = -1, Contrast = 0.38, Brightness = 0.02, TintColor = rgb(255, 255, 255) },
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 1.2 },
		SunRays = nil,
		Lights = {
			MoonBeam = { Brightness = 4.5, Color = rgb(235, 240, 255), Angle = 38 },
			SunBeam = false,
			DeskLamp = false,
			NightLamp = false,
			CeilingLight = false,
			StreetLamp = true,
			PortalLight = false,
			MonitorGlow = { Color = rgb(200, 210, 255) },
			ClockGlow = true,
		},
		NightWindows = true,
		Portal = false,
		Outlines = false,
		Dust = true,
		Clock = "3:14",
		Ambience = "Crickets",
	},
}

local house: Model? = nil
local lights: { [string]: { Light } } = {}
local bulbs: { [string]: { BasePart } } = {}
local nightWindows: { BasePart } = {}
local portalParts: { BasePart } = {}
local outlineModels: { Model } = {}
local highlights: { Highlight } = {}
local lightOn: { [string]: boolean } = {}
local portalConn: RBXScriptConnection? = nil
local current: string? = nil
local brightnessOffset = 0

local function scan()
	if house then
		return
	end
	house = workspace:WaitForChild("MortysHouse") :: Model
	for _, d in (house :: Model):GetDescendants() do
		if d:IsA("Light") then
			lights[d.Name] = lights[d.Name] or {}
			table.insert(lights[d.Name], d)
			d:SetAttribute("BaseBrightness", d.Brightness)
			d:SetAttribute("BaseColor", d.Color)
			if d:IsA("SpotLight") or d:IsA("SurfaceLight") then
				d:SetAttribute("BaseAngle", (d :: any).Angle)
			end
		elseif d:IsA("BasePart") then
			local bulbFor = d:GetAttribute("BulbFor")
			if bulbFor then
				bulbs[bulbFor] = bulbs[bulbFor] or {}
				table.insert(bulbs[bulbFor], d)
				d:SetAttribute("OffMaterial", if d.Material == Enum.Material.Neon then "SmoothPlastic" else d.Material.Name)
			end
			if d:GetAttribute("NightWindow") ~= nil then
				d:SetAttribute("LitColor", d.Color)
				table.insert(nightWindows, d)
			end
			if d:GetAttribute("PortalFX") then
				table.insert(portalParts, d)
			end
		elseif d:IsA("Model") and d:GetAttribute("Outline") then
			table.insert(outlineModels, d)
		end
	end
end

-- Turn a named lamp on/off (also lights up its bulb).
function Graphics.SetLight(name: string, on: boolean, props: { [string]: any }?)
	scan()
	lightOn[name] = on
	for _, l in lights[name] or {} do
		l.Enabled = on
		l.Brightness = if props and props.Brightness then props.Brightness else l:GetAttribute("BaseBrightness")
		l.Color = if props and props.Color then props.Color else l:GetAttribute("BaseColor")
		if props and props.Angle and (l:IsA("SpotLight") or l:IsA("SurfaceLight")) then
			(l :: any).Angle = props.Angle
		elseif l:GetAttribute("BaseAngle") then
			(l :: any).Angle = l:GetAttribute("BaseAngle")
		end
	end
	for _, b in bulbs[name] or {} do
		if on then
			b.Material = Enum.Material.Neon
		else
			b.Material = (Enum.Material :: any)[b:GetAttribute("OffMaterial") or "SmoothPlastic"]
		end
	end
end

function Graphics.IsLightOn(name: string): boolean
	return lightOn[name] == true
end

local function tweenProps(inst: Instance?, props: { [string]: any }?, t: number)
	if inst and props then
		TweenService:Create(inst, TweenInfo.new(t, Enum.EasingStyle.Sine), props):Play()
	end
end

local function setOutlines(on: boolean)
	for _, h in highlights do
		h:Destroy()
	end
	table.clear(highlights)
	if not on then
		return
	end
	for i, m in outlineModels do
		if i > 30 then
			break
		end
		local h = Instance.new("Highlight")
		h.Name = "CartoonOutline"
		h.FillTransparency = 1
		h.OutlineTransparency = 0
		h.OutlineColor = rgb(24, 20, 28)
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Adornee = m
		h.Parent = m
		table.insert(highlights, h)
	end
end

local function setPortal(on: boolean)
	if portalConn then
		portalConn:Disconnect()
		portalConn = nil
	end
	for _, p in portalParts do
		p.Transparency = if on then 0 else 1
		for _, d in p:GetChildren() do
			if d:IsA("ParticleEmitter") then
				d.Enabled = on
			end
		end
	end
	if on then
		local t0 = os.clock()
		portalConn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			for _, l in lights.PortalLight or {} do
				l.Brightness = 5 + math.noise(t * 2.3, 0.3) * 3 + math.sin(t * 9) * 0.4
			end
			for i, p in portalParts do
				p.CFrame = p.CFrame * CFrame.Angles(0.01 * (if i % 2 == 0 then 1 else -1), 0, 0)
			end
		end)
	end
end

local function setNightWindows(night: boolean)
	for _, w in nightWindows do
		local lit = w:GetAttribute("NightWindow") == true
		if night and lit then
			w.Material = Enum.Material.Neon
			w.Color = w:GetAttribute("LitColor") or w.Color
		else
			w.Material = Enum.Material.Glass
			w.Color = rgb(52, 60, 76)
		end
	end
end

local function setDust(on: boolean)
	local dustPart = house and (house :: Model):FindFirstChild("DustVolume", true)
	local emitter = dustPart and dustPart:FindFirstChildOfClass("ParticleEmitter")
	if emitter then
		emitter.Enabled = on
	end
end

local function setClock(text: string)
	local clock = house and (house :: Model):FindFirstChild("AlarmClock")
	local label = clock and clock:FindFirstChild("ClockText", true)
	if label then
		(label :: TextLabel).Text = text
	end
end

function Graphics.Get(name: string)
	return Graphics.Presets[name]
end

function Graphics.Current(): string?
	return current
end

function Graphics.SetBrightnessOffset(v: number)
	brightnessOffset = v
	if current then
		local p = Graphics.Presets[current]
		Lighting.ExposureCompensation = p.Lighting.ExposureCompensation + brightnessOffset
	end
end

-- Apply a preset. `instant` skips the fade.
function Graphics.Apply(name: string, instant: boolean?, keepClock: boolean?)
	scan()
	local p = Graphics.Presets[name]
	if not p then
		warn("Unknown graphics preset", name)
		return
	end
	current = name
	local t = if instant then 0 else 0.8

	local lightingProps = table.clone(p.Lighting)
	lightingProps.ExposureCompensation = p.Lighting.ExposureCompensation + brightnessOffset
	local clockTime = lightingProps.ClockTime
	lightingProps.ClockTime = nil
	Lighting.ClockTime = clockTime
	local shadowSoftness = lightingProps.ShadowSoftness
	lightingProps.ShadowSoftness = nil
	pcall(function()
		Lighting.ShadowSoftness = shadowSoftness
	end)
	tweenProps(Lighting, lightingProps, t)
	tweenProps(Lighting:FindFirstChildOfClass("Atmosphere"), p.Atmosphere, t)
	tweenProps(Lighting:FindFirstChild("Grade"), p.Grade, t)
	tweenProps(Lighting:FindFirstChild("Bloom"), p.Bloom, t)
	local rays = Lighting:FindFirstChild("SunRays") :: SunRaysEffect?
	if rays then
		rays.Enabled = p.SunRays ~= nil
		if p.SunRays then
			tweenProps(rays, p.SunRays, t)
		end
	end

	for lightName, setting in p.Lights do
		if setting == false then
			Graphics.SetLight(lightName, false)
		elseif setting == true then
			Graphics.SetLight(lightName, true)
		else
			Graphics.SetLight(lightName, true, setting)
		end
	end

	setNightWindows(p.NightWindows)
	setPortal(p.Portal)
	setOutlines(p.Outlines)
	setDust(p.Dust)
	if not keepClock then
		setClock(p.Clock)
	end
end

-- Extra outline target (e.g. the player's own character in the menu)
function Graphics.OutlinesOn(): boolean
	return current ~= nil and Graphics.Presets[current].Outlines == true
end

return Graphics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="826">
        <Properties>
          <string name="Name">MenuController</string>
          <string name="Source"><![CDATA[-- Menu logic shared by every menu style.
-- A style module only decides how things LOOK (see MenuStyles/*). This file decides what they DO.
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Widgets = require(script.Parent.Widgets)
local Settings = require(script.Parent.Settings)
local Config = require(script.Parent.Config)
local Audio = require(script.Parent.Audio)

local MenuController = {}
MenuController.__index = MenuController

export type Ctx = {
	Gui: ScreenGui,
	Canvas: Frame,
	Full: Frame,
	Mode: string, -- "main" | "pause"
	Actions: { [string]: () -> () },
}

function MenuController.new(styleModule, ctx)
	local self = setmetatable({}, MenuController)
	self.ctx = ctx
	self.connections = {}
	self.pages = {}
	self.buttons = {}
	self.current = nil
	self.selected = 0
	self.busy = false
	self.alive = true

	local style = styleModule.Build(ctx)
	self.style = style
	style.Theme.Sound = function(kind: string)
		if kind == "hover" then
			Audio.play("UIHover")
		elseif kind == "tick" then
			Audio.play("UITick")
		else
			Audio.play("UIClick")
		end
	end

	self:_buildMain()
	self:_buildSettings()
	self:_buildCredits()
	self:_buildConfirm()
	self:Show("Main", true)
	style.Intro()

	table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
		self:_onKey(input, processed)
	end))
	if style.Update then
		table.insert(self.connections, RunService.RenderStepped:Connect(function(dt)
			style.Update(dt)
		end))
	end
	return self
end

function MenuController:_page(name: string): GuiObject
	local page = self.style.NewPage(name)
	page.Visible = false
	self.pages[name] = page
	self.buttons[name] = {}
	return page
end

function MenuController:_addButton(pageName: string, text: string, kind: string, action: () -> ())
	local list = self.buttons[pageName]
	local index = #list + 1
	local button, setHover = self.style.MakeButton(self.pages[pageName], text, 100 + index, kind)
	local entry = { Button = button, SetHover = setHover, Action = action, Kind = kind }
	table.insert(list, entry)
	button.MouseEnter:Connect(function()
		self:_select(index, true)
	end)
	button.MouseLeave:Connect(function()
		if self.selected == index then
			setHover(false)
			self.selected = 0
		end
	end)
	button.Activated:Connect(function()
		self:_activate(entry)
	end)
	return entry
end

function MenuController:_select(index: number, playSound: boolean)
	local list = self.buttons[self.current]
	if not list then
		return
	end
	if self.selected ~= index then
		local old = list[self.selected]
		if old then
			old.SetHover(false)
		end
		self.selected = index
		local entry = list[index]
		if entry then
			entry.SetHover(true)
			if playSound then
				Audio.play("UIHover")
			end
		end
	end
end

function MenuController:_activate(entry)
	if self.busy or not self.alive then
		return
	end
	if entry.Kind == "back" then
		Audio.play("UIBack")
	else
		Audio.play("UIClick")
	end
	entry.Action()
end

function MenuController:_onKey(input: InputObject, _processed: boolean)
	if not self.alive or self.busy then
		return
	end
	local key = input.KeyCode
	local list = self.buttons[self.current]
	if not list or #list == 0 then
		return
	end
	if key == Enum.KeyCode.Down or key == Enum.KeyCode.S or key == Enum.KeyCode.DPadDown then
		self:_select(if self.selected == 0 then 1 else (self.selected % #list) + 1, true)
	elseif key == Enum.KeyCode.Up or key == Enum.KeyCode.W or key == Enum.KeyCode.DPadUp then
		self:_select(if self.selected <= 1 then #list else self.selected - 1, true)
	elseif key == Enum.KeyCode.Return or key == Enum.KeyCode.KeypadEnter or key == Enum.KeyCode.ButtonA then
		local entry = list[self.selected]
		if entry then
			self:_activate(entry)
		end
	elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.ButtonB then
		if self.current ~= "Main" then
			Audio.play("UIBack")
			self:Show("Main")
		end
	end
end

function MenuController:Show(name: string, instant: boolean?)
	local page = self.pages[name]
	if not page or self.current == name then
		return
	end
	local old = self.current and self.pages[self.current]
	local list = self.buttons[self.current]
	if list and list[self.selected] then
		list[self.selected].SetHover(false)
	end
	self.current = name
	self.selected = 0
	if self.style.ShowPage then
		self.style.ShowPage(page, old, instant)
	else
		if old then
			old.Visible = false
		end
		page.Visible = true
	end
	if not instant then
		Audio.play("UISwoosh")
	end
end

function MenuController:_buildMain()
	local page = self:_page("Main")
	if self.style.MakeTitle then
		self.style.MakeTitle(page)
	end
	local a = self.ctx.Actions
	if self.ctx.Mode == "pause" then
		self:_addButton("Main", "Resume", "primary", function()
			a.Resume()
		end)
		self:_addButton("Main", "Settings", "normal", function()
			self:Show("Settings")
		end)
		self:_addButton("Main", "Main Menu", "danger", function()
			self:_confirm("Back to the main menu?", a.MainMenu)
		end)
	else
		self:_addButton("Main", "Play", "primary", function()
			a.Play()
		end)
		self:_addButton("Main", "Settings", "normal", function()
			self:Show("Settings")
		end)
		self:_addButton("Main", "Credits", "normal", function()
			self:Show("Credits")
		end)
		self:_addButton("Main", "Quit", "danger", function()
			self:_confirm("Leave the game?", a.Quit)
		end)
	end
end

function MenuController:_buildSettings()
	local page = self:_page("Settings")
	local theme = self.style.Theme
	self.style.MakeHeading(page, "Settings", 1)
	local order = 2
	local function nextOrder()
		order += 1
		return order
	end
	Widgets.Choice(page, theme, {
		Label = "Graphics",
		Options = Config.GraphicsPresets,
		Value = Settings.Get("Graphics"),
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("Graphics", v)
		end,
	})
	local function pct(v)
		return tostring(math.floor(v * 100 + 0.5)) .. "%"
	end
	Widgets.Slider(page, theme, {
		Label = "Music",
		Min = 0,
		Max = 1,
		Step = 0.05,
		Value = Settings.Get("Music"),
		Format = pct,
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("Music", v)
		end,
	})
	Widgets.Slider(page, theme, {
		Label = "Sounds",
		Min = 0,
		Max = 1,
		Step = 0.05,
		Value = Settings.Get("Sound"),
		Format = pct,
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("Sound", v)
		end,
	})
	Widgets.Slider(page, theme, {
		Label = "Mouse speed",
		Min = 0.2,
		Max = 2,
		Step = 0.1,
		Value = Settings.Get("Sensitivity"),
		Format = function(v)
			return string.format("%.1fx", v)
		end,
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("Sensitivity", v)
		end,
	})
	Widgets.Slider(page, theme, {
		Label = "Field of view",
		Min = 60,
		Max = 100,
		Step = 1,
		Value = Settings.Get("FOV"),
		Format = function(v)
			return tostring(math.floor(v)) .. "°"
		end,
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("FOV", v)
		end,
	})
	Widgets.Slider(page, theme, {
		Label = "Brightness",
		Min = -1,
		Max = 1,
		Step = 0.1,
		Value = Settings.Get("Brightness"),
		Format = function(v)
			return (if v > 0 then "+" else "") .. string.format("%.1f", v)
		end,
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("Brightness", v)
		end,
	})
	Widgets.Toggle(page, theme, {
		Label = "Head bob",
		Value = Settings.Get("HeadBob"),
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("HeadBob", v)
		end,
	})
	Widgets.Toggle(page, theme, {
		Label = "See your body",
		Value = Settings.Get("ShowBody"),
		Order = nextOrder(),
		OnChanged = function(v)
			Settings.Set("ShowBody", v)
		end,
	})
	self:_addButton("Settings", "Back", "back", function()
		self:Show("Main")
	end)
end

function MenuController:_buildCredits()
	local page = self:_page("Credits")
	self.style.MakeHeading(page, "Credits", 1)
	local lines = {
		"Rick and Morty fan game. Not affiliated with Adult Swim.",
		"Made in Roblox Studio.",
		"Music: APM Music (Roblox licensed library).",
		"Sound effects: Pro Sound Effects & Roblox.",
	}
	for i, line in lines do
		self.style.MakeText(page, line, 1 + i)
	end
	self:_addButton("Credits", "Back", "back", function()
		self:Show("Main")
	end)
end

function MenuController:_buildConfirm()
	local page = self:_page("Confirm")
	self.confirmHeading = self.style.MakeHeading(page, "Are you sure?", 1)
	self:_addButton("Confirm", "Yes", "danger", function()
		if self.confirmAction then
			self.confirmAction()
		end
	end)
	self:_addButton("Confirm", "No", "back", function()
		self:Show("Main")
	end)
end

function MenuController:_confirm(question: string, action: () -> ())
	self.confirmAction = action
	local heading = self.confirmHeading
	if heading then
		local theme = self.style.Theme
		local text = if theme.Uppercase then string.upper(question) else question
		if heading:IsA("TextLabel") then
			heading.Text = text
		end
		for _, d in heading:GetDescendants() do
			if d:IsA("TextLabel") then
				d.Text = text
			end
		end
	end
	self:Show("Confirm")
end

-- Play the style's exit animation, then call done().
function MenuController:Close(done: (() -> ())?)
	if not self.alive then
		return
	end
	self.busy = true
	self.style.Outro(function()
		self:Destroy()
		if done then
			done()
		end
	end)
end

function MenuController:Destroy()
	if not self.alive then
		return
	end
	self.alive = false
	for _, c in self.connections do
		c:Disconnect()
	end
	self.style.Destroy()
end

return MenuController
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="827">
        <Properties>
          <string name="Name">MenuStyles</string>
