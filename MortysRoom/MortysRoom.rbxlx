local ambience: Sound? = nil
local ambienceKey: string? = nil
local current: string? = nil

function Scenes.setAmbience(key: string?)
	if key == ambienceKey then
		return
	end
	if ambience then
		Audio.fadeOut(ambience, 1.5, true)
	end
	ambience = nil
	ambienceKey = key
	if key then
		local s = Audio.make(key, workspace.CurrentCamera)
		if s then
			Audio.fadeIn(s, 2)
			ambience = s
		end
	end
end

local function setSpaceVisible(on: boolean)
	local space = workspace:FindFirstChild("Space")
	if space then
		for _, d in space:GetDescendants() do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = if on then 0 else 1
			end
		end
	end
end
setSpaceVisible(false)
Scenes.setSpaceVisible = setSpaceVisible

function Scenes.apply(name: string, instant: boolean?)
	local p = Scenes.Presets[name]
	if not p then
		warn("Unknown scene", name)
		return
	end
	current = name
	Graphics.ApplyTable(p, instant, true)
	setSpaceVisible(p.ShowSpace == true)
	Scenes.setAmbience(p.Ambience)
end

function Scenes.current(): string?
	return current
end

return Scenes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6928">
        <Properties>
          <string name="Name">Story</string>
          <string name="Source"><![CDATA[--[[
	THE STORY (12 chapters). Every line is written in Russian and English.
	  1  Good morning   - wake up, take the phone, go downstairs
	  2  Breakfast      - Beth: "put the phone away!" -> choice -> the phone explodes
	  3  Rick's garage  - Rick rebuilt Morty, but Rick is glitching
	  4  Flight         - saucer out of the garage, warp, planet B137, landing
	  5  Planet B137    - Rick tries to ditch Morty, something knocks him down, the curse
	  6  The Titan      - old village, radar, Titan Speakerman 2.0 vs the entity, knock-back, drag
	  7..12 live in StoryCurve: the bunker plan, the Curve Bell, Evil Morty, the hunt,
	        the Alliance, the camera base, home (+ a scene after the credits)
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")

local Game = script.Parent
local UI = require(Game.UI)
local Lang = require(Game.Lang)
local Audio = require(Game.Audio)
local Graphics = require(Game.Graphics)
local Fx = require(Game.Fx)
local Director = require(Game.Director)
local Dialogue = require(Game.Dialogue)
local Puppet = require(Game.Puppet)
local Scenes = require(Game.Scenes)
local StoryCurve = require(Game.StoryCurve)

local Story = {}
local rgb = Color3.fromRGB
local CANCEL = "__story_cancel__"

local api: any = nil
local R: { [string]: any } = {}
local P: { [string]: any } = {}
local init: { [string]: any } = {}
local runId = 0
local loops: { Instance } = {}

----------------------------------------------------------------------------
-- small helpers
----------------------------------------------------------------------------
local function camera(): Camera
	return workspace.CurrentCamera
end

local function makeCtx(id: number)
	local c = {}
	function c.alive(): boolean
		return id == runId
	end
	function c.check()
		if id ~= runId then
			error(CANCEL, 0)
		end
	end
	function c.wait(t: number)
		task.wait(t)
		c.check()
	end
	function c.say(who: string, line: any, opts: any?)
		c.check()
		Dialogue.say(who, line, opts)
		c.check()
	end
	function c.waitUntil(fn: () -> boolean, timeout: number?): boolean
		local t0 = os.clock()
		while not fn() do
			task.wait(0.05)
			c.check()
			if timeout and os.clock() - t0 > timeout then
				return false
			end
		end
		return true
	end
	function c.interact(id2: string): Instance
		local done: Instance? = nil
		local old = api.handlers[id2]
		api.handlers[id2] = function(model)
			done = model
		end
		local ok = pcall(c.waitUntil, function()
			return done ~= nil
		end)
		api.handlers[id2] = old
		if not ok then
			error(CANCEL, 0)
		end
		return done :: Instance
	end
	return c
end

local function loopSound(key: string, parent: Instance?): Sound?
	local s = Audio.make(key, parent)
	if s then
		s:Play()
		table.insert(loops, s)
	end
	return s
end

local function stopLoop(s: Sound?, fade: number?)
	if s then
		Audio.fadeOut(s, fade or 0.6, true)
		local i = table.find(loops, s)
		if i then
			table.remove(loops, i)
		end
	end
end

local function play3D(key: string, pos: Vector3, pitch: number?)
	local holder = Fx.part({ Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos) })
	local s = Audio.make(key, holder)
	if s then
		s.PlaybackSpeed = pitch or 1
		s:Play()
	end
	task.delay(12, function()
		holder:Destroy()
	end)
end

local function eyeFromHead(headCF: CFrame): CFrame
	local p = (headCF * CFrame.new(0, 0.05, -0.55)).Position
	return CFrame.lookAt(p, p + headCF.LookVector, headCF.UpVector)
end

local function bezier(a: Vector3, b: Vector3, c: Vector3, t: number): Vector3
	local u = 1 - t
	return a * (u * u) + b * (2 * u * t) + c * (t * t)
end

local function setParts(model: Instance, props: { [string]: any })
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			for k, val in props do
				(d :: any)[k] = val
			end
		end
	end
end

local function emitters(model: Instance, name: string?, on: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("ParticleEmitter") and (name == nil or d.Name == name) then
			d.Enabled = on
		end
	end
end

-- rotate a set of parts around a hinge
local function hingeRotate(parts: { [BasePart]: CFrame }, hinge: Vector3, rot: CFrame)
	local H = CFrame.new(hinge)
	local M = H * rot * H:Inverse()
	for part, cf in parts do
		part.CFrame = M * cf
	end
end

local function animate(duration: number, fn: (number) -> (), easeKind: string?)
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		fn(Director.ease(a, easeKind))
		if a >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
end

----------------------------------------------------------------------------
-- Morty's phone in first person (local part in front of the camera)
----------------------------------------------------------------------------
local VM = { part = nil :: BasePart?, mode = "hidden", heat = 0, t = 0, offset = CFrame.new(0, -3, -2) }
do
	local function build()
		local p = Instance.new("Part")
		p.Name = "PhoneViewmodel"
		p.Size = Vector3.new(0.42, 0.82, 0.05)
		p.Color = rgb(24, 24, 28)
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Back
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 500
		sg.LightInfluence = 0
		sg.Brightness = 1.4
		sg.ClipsDescendants = true
		sg.Parent = p
		local bg = UI.new("Frame", { Name = "Bg", BackgroundColor3 = rgb(12, 8, 36), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = sg }, { UI.gradient({ rgb(40, 16, 90), rgb(8, 40, 70) }, nil, 90) })
		local _ = bg
		for i = 1, 14 do
			UI.new("Frame", {
				Name = "Star",
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Position = UDim2.fromScale(math.random(), math.random()),
				Size = UDim2.fromOffset(3, 3),
				Parent = sg,
			})
			local _ = i
		end
		UI.label({ Name = "Title", Text = "GALAXY RAID III", Font = Enum.Font.GothamBlack, TextSize = 26, TextColor3 = rgb(255, 220, 80), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.04), Size = UDim2.fromScale(1, 0.08), Parent = sg })
		UI.new("Frame", { Name = "Boss", BackgroundColor3 = rgb(220, 50, 90), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(90, 70), Parent = sg }, { UI.corner(20) })
		UI.new("Frame", { Name = "Ship", BackgroundColor3 = rgb(110, 230, 255), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.78), Size = UDim2.fromOffset(34, 40), Rotation = 45, Parent = sg }, { UI.corner(6) })
		UI.new("Frame", { Name = "Laser", BackgroundColor3 = rgb(255, 255, 160), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.new(0, 4, 0.36, 0), Parent = sg })
		UI.label({ Name = "Hud", Text = "FPS 12   CPU 71°C", Font = Enum.Font.RobotoMono, TextSize = 18, TextColor3 = rgb(200, 255, 200), Position = UDim2.fromScale(0.04, 0.9), Size = UDim2.fromScale(0.92, 0.06), Parent = sg })
		local warn = UI.new("Frame", { Name = "Warn", BackgroundColor3 = rgb(200, 20, 20), BackgroundTransparency = 0.15, Visible = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromScale(0.9, 0.2), Parent = sg }, { UI.corner(10) })
		UI.label({ Name = "Text", Text = "", Font = Enum.Font.GothamBlack, TextSize = 30, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = warn })
		VM.part = p
		VM.gui = sg
	end
	function VM.setMode(m: string)
		if not VM.part then
			build()
		end
		VM.mode = m
		if m ~= "hidden" and VM.part then
			(VM.part :: BasePart).Parent = camera()
		end
	end
	function VM.setHeat(h: number)
		VM.heat = h
	end
	function VM.position(): Vector3
		return if VM.part then (VM.part :: BasePart).Position else camera().CFrame.Position
	end
	local targets = {
		hand = CFrame.new(1.0, -0.95, -2.1) * CFrame.Angles(math.rad(-12), math.rad(-22), math.rad(-6)),
		table = CFrame.new(0.12, -0.72, -1.5) * CFrame.Angles(math.rad(-28), math.rad(-4), 0),
		pocket = CFrame.new(0.85, -2.6, -1.4) * CFrame.Angles(math.rad(-60), 0, 0),
		hidden = CFrame.new(0.85, -3.2, -1.4),
	}
	RunService:BindToRenderStep("PhoneViewmodel", Enum.RenderPriority.Camera.Value + 20, function(dt)
		local p = VM.part
		if not p then
			return
		end
		VM.t += dt
		local target = targets[VM.mode] or targets.hidden
		VM.offset = VM.offset:Lerp(target, 1 - math.exp(-dt * 8))
		local bob = CFrame.new(math.sin(VM.t * 1.3) * 0.01, math.sin(VM.t * 2.1) * 0.012, 0)
		p.CFrame = camera().CFrame * VM.offset * bob
		if VM.mode == "hidden" and (VM.offset.Position - targets.hidden.Position).Magnitude < 0.05 then
			p.Parent = nil
			return
		end
		-- screen animation
		local sg = VM.gui
		local boss = sg:FindFirstChild("Boss") :: Frame
		boss.Position = UDim2.fromScale(0.5 + math.sin(VM.t * 1.7) * 0.28, 0.3 + math.sin(VM.t * 2.9) * 0.04)
		local ship = sg:FindFirstChild("Ship") :: Frame
		ship.Position = UDim2.fromScale(0.5 + math.sin(VM.t * 1.1 + 1) * 0.3, 0.78)
		local laser = sg:FindFirstChild("Laser") :: Frame
		laser.Position = UDim2.fromScale(ship.Position.X.Scale, 0.72)
		laser.Visible = math.floor(VM.t * 8) % 2 == 0
		local temp = 71 + VM.heat * 29
		local hud = sg:FindFirstChild("Hud") :: TextLabel
		hud.Text = string.format("FPS %d   CPU %d°C", math.max(1, 12 - math.floor(VM.heat * 10)), math.floor(temp))
		hud.TextColor3 = if VM.heat > 0.5 then rgb(255, 120, 120) else rgb(200, 255, 200)
		local warn = sg:FindFirstChild("Warn") :: Frame
		warn.Visible = VM.heat > 0.6 and math.floor(VM.t * 5) % 2 == 0
		local wt = warn:FindFirstChild("Text") :: TextLabel
		wt.Text = Lang.t("phone.hot") .. " " .. math.floor(temp) .. "°C"
		if VM.heat > 0.3 then
			p.CFrame = p.CFrame * CFrame.new((math.random() - 0.5) * 0.01 * VM.heat, (math.random() - 0.5) * 0.01 * VM.heat, 0)
		end
	end)
end

----------------------------------------------------------------------------
-- Rick's radar (prop in his hand + big screen overlay)
----------------------------------------------------------------------------
local Radar = { gui = nil :: ScreenGui?, prop = nil :: BasePart?, on = false }
do
	local function build()
		local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
		local g = UI.new("ScreenGui", { Name = "Radar", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 35, Enabled = false, Parent = pg })
		local canvas = UI.canvas(g)
		local panel = UI.new("CanvasGroup", {
			Name = "Panel",
			BackgroundColor3 = rgb(6, 16, 10),
			BackgroundTransparency = 0.15,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -90, 0.42, 0),
			Size = UDim2.fromOffset(470, 600),
			GroupTransparency = 1,
			Parent = canvas,
		}, { UI.corner(24), UI.stroke(3, rgb(110, 255, 140), 0.3, true) })
		UI.label({ Text = "", Name = "Title", Font = Enum.Font.RobotoMono, TextSize = 26, TextColor3 = rgb(140, 255, 160), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 34), Parent = panel })
		local scope = UI.new("Frame", { Name = "Scope", BackgroundColor3 = rgb(10, 40, 20), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 66), Size = UDim2.fromOffset(330, 330), ClipsDescendants = false, Parent = panel }, { UI.round(), UI.stroke(2, rgb(110, 255, 140), 0.2, true) })
		for i, s in { 0.66, 0.33 } do
			UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(s, s), Parent = scope }, { UI.round(), UI.stroke(1.5, rgb(110, 255, 140), 0.5, true) })
			local _ = i
		end
		UI.new("Frame", { BackgroundColor3 = rgb(110, 255, 140), BackgroundTransparency = 0.6, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 1), Parent = scope })
		UI.new("Frame", { BackgroundColor3 = rgb(110, 255, 140), BackgroundTransparency = 0.6, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 1, 1, 0), Parent = scope })
		local sweep = UI.new("Frame", { Name = "Sweep", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), Parent = scope })
		UI.new("Frame", { BackgroundColor3 = rgb(140, 255, 160), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.5, 0, 0, 3), Parent = sweep }, { UI.gradient(nil, { 0, 0.6 }, 0) })
		UI.new("Frame", { Name = "Blip", BackgroundColor3 = rgb(255, 50, 40), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.78, 0.22), Size = UDim2.fromOffset(22, 22), Parent = scope }, { UI.round() })
		UI.label({ Name = "Line1", Text = "", Font = Enum.Font.RobotoMono, TextSize = 24, TextColor3 = rgb(140, 255, 160), Position = UDim2.fromOffset(34, 420), Size = UDim2.new(1, -68, 0, 30), Parent = panel })
		UI.label({ Name = "Line2", Text = "", Font = Enum.Font.GothamBlack, TextSize = 34, TextColor3 = rgb(255, 60, 50), Position = UDim2.fromOffset(34, 452), Size = UDim2.new(1, -68, 0, 40), Parent = panel })
		UI.label({ Name = "Line3", Text = "", Font = Enum.Font.RobotoMono, TextSize = 24, TextColor3 = rgb(140, 255, 160), Position = UDim2.fromOffset(34, 500), Size = UDim2.new(1, -68, 0, 30), Parent = panel })
		UI.label({ Name = "Line4", Text = "", Font = Enum.Font.GothamBlack, TextSize = 34, TextColor3 = rgb(255, 220, 60), Position = UDim2.fromOffset(34, 532), Size = UDim2.new(1, -68, 0, 40), Parent = panel })
		Radar.gui = g
		Radar.panel = panel
		Radar.sweep = sweep
		Radar.blip = scope:FindFirstChild("Blip")
	end
	-- lines = { title, line1, line2, line3, line4 } (Lang keys); nil = the threat screen
	function Radar.setLines(lines: { any }?)
		if not Radar.gui then
			build()
		end
		local l = lines or { "radar.title", "radar.threat", "radar.max", "radar.eta", "radar.days" }
		local panel = Radar.panel
		panel:FindFirstChild("Title").Text = Lang.t(l[1])
		panel:FindFirstChild("Line1").Text = Lang.t(l[2])
		panel:FindFirstChild("Line2").Text = Lang.t(l[3])
		panel:FindFirstChild("Line3").Text = Lang.t(l[4])
		panel:FindFirstChild("Line4").Text = Lang.t(l[5])
	end
	-- where the red dot is on the scope (0..1, 0..1)
	function Radar.setBlip(x: number, y: number, visible: boolean?)
		if not Radar.gui then
			build()
		end
		Radar.blip.Position = UDim2.fromScale(x, y)
		Radar.blip.Visible = visible ~= false
	end
	function Radar.show(on: boolean, lines: { any }?)
		if not Radar.gui then
			build()
		end
		Radar.on = on
		local g = Radar.gui :: ScreenGui
		local panel = Radar.panel
		if on then
			g.Enabled = true
			Radar.setLines(lines)
			panel.Position = UDim2.new(1, -60, 0.42, 0)
			UI.tween(panel, 0.5, { GroupTransparency = 0, Position = UDim2.new(1, -90, 0.42, 0) }, Enum.EasingStyle.Back)
		else
			UI.tween(panel, 0.3, { GroupTransparency = 1 })
			task.delay(0.35, function()
				if not Radar.on then
					g.Enabled = false
				end
			end)
		end
	end
	local pingT = 0
	RunService.RenderStepped:Connect(function(dt)
		if Radar.on and Radar.sweep then
			Radar.sweep.Rotation = (Radar.sweep.Rotation + dt * 180) % 360
			Radar.blip.BackgroundTransparency = if math.floor(os.clock() * 3) % 2 == 0 then 0 else 0.6
			pingT += dt
			if pingT > 1 then
				pingT = 0
				Audio.play("RadarPing")
			end
		end
		local prop = Radar.prop
		if prop and P.rick then
			local arm = P.rick.model:FindFirstChild("Right Arm") :: BasePart?
			if arm then
				prop.CFrame = arm.CFrame * CFrame.new(-0.2, -1.25, -0.35) * CFrame.Angles(math.rad(-90), 0, 0)
			end
		end
	end)
	function Radar.holdProp(on: boolean)
		if on and not Radar.prop then
			local p = Fx.part({ Size = Vector3.new(1.1, 0.22, 0.8), Color = rgb(70, 74, 80), Material = Enum.Material.Metal })
			local screen = Instance.new("Part")
			screen.Size = Vector3.new(0.7, 0.05, 0.55)
			screen.Color = rgb(110, 255, 140)
			screen.Material = Enum.Material.Neon
			screen.Anchored = false
			screen.CanCollide = false
			screen.Massless = true
			screen.CFrame = p.CFrame * CFrame.new(0, 0.12, 0)
			local w = Instance.new("WeldConstraint")
			w.Part0 = p
			w.Part1 = screen
			w.Parent = screen
			screen.Parent = p
			Radar.prop = p
		elseif not on and Radar.prop then
			(Radar.prop :: BasePart):Destroy()
			Radar.prop = nil
		end
	end
end

----------------------------------------------------------------------------
-- world state helpers
----------------------------------------------------------------------------
local doorOpen = false
local function setDoor(open: boolean, instant: boolean?)
	doorOpen = open
	R.doorModel:SetAttribute("Open", open)
	local hinge = R.doorLeaf:GetAttribute("Hinge") or Vector3.new(5.13, 3.4, 8.39)
	local from = if open then 0 else math.rad(100)
	local to = if open then math.rad(100) else 0
	if instant then
		hingeRotate(init.door, hinge, CFrame.Angles(0, to, 0))
		return
	end
	play3D("Click", hinge, 0.6)
	task.spawn(animate, 0.8, function(a)
		hingeRotate(init.door, hinge, CFrame.Angles(0, from + (to - from) * a, 0))
	end)
end

local function setGarageDoor(open: boolean, instant: boolean?)
	local hinge = R.garageDoor:GetAttribute("Hinge") or Vector3.new(-19.8, -1.05, -21)
	local to = if open then math.rad(85) else 0
	if instant then
		hingeRotate(init.garageDoor, hinge, CFrame.Angles(0, 0, to))
		return
	end
	play3D("GarageDoor", hinge)
	animate(1.8, function(a)
		hingeRotate(init.garageDoor, hinge, CFrame.Angles(0, 0, to * a))
	end)
end

local function setPhoneOnNightstand(visible: boolean)
	for _, d in R.phone:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if visible then 0 else 1
			d.CanQuery = visible
		end
	end
end

local function familyAtBreakfast()
	for name, poseName in { Beth = "sitEat", Jerry = "sitRead", Summer = "sitPhone" } do
		local p = P[string.lower(name)]
		local seat = R.seats:FindFirstChild(name)
		if p and seat then
			p:place(seat.CFrame)
			p:pose(poseName, 8)
			p:lookAt(nil)
			p.gesture = 1
		end
	end
end

local function saucerThrust(on: boolean)
	emitters(R.saucer, "Thrust", on)
end

local function saucerTo(cf: CFrame)
	R.saucer:PivotTo(cf)
end

-- fly the saucer to `target` over `duration`, with a little wobble. Yields.
local function fly(target: CFrame, duration: number, easeKind: string?, wobble: number?)
	local from = R.saucer:GetPivot()
	local w = wobble or 0.04
	local t0 = os.clock()
	animate(duration, function(a)
		local t = os.clock() - t0
		local cf = from:Lerp(target, a) * CFrame.Angles(math.sin(t * 2.3) * w, 0, math.sin(t * 1.7) * w)
		saucerTo(cf)
	end, easeKind)
end

local function seatRickInSaucer()
	local rick = P.rick
	rick.follow = function()
		return R.saucerSpots.SeatRick.CFrame
	end
	rick:pose("pilot", 10)
	rick:lookAt(nil)
end

local function mortySaucerEye(): CFrame
	return R.saucerSpots.EyeMorty.CFrame * CFrame.Angles(math.rad(-10), 0, 0)
end

local function ensureDesert(c)
	c.waitUntil(function()
		return workspace:GetAttribute("DesertReady") == true
	end, 30)
	-- make sure the terrain has reached us
	c.waitUntil(function()
		local hit = workspace:Raycast(Vector3.new(6000, 50, 0), Vector3.new(0, -100, 0))
		return hit ~= nil
	end, 20)
end

-- character: make sure it exists, then put it somewhere hidden / frozen for a cutscene
local function holdCharacterAt(c, cf: CFrame)
	if not api.root() then
		api.spawn()
		c.check()
	end
	api.hideCharacter(true)
	local r = api.root()
	if r and r.Anchored and not r:GetAttribute("ClientFrozen") then
		-- still held by the server after spawning
		api.release(cf)
	else
		api.teleport(cf)
	end
	c.check()
	api.freeze(true)
end

local function giveControl(c, cf: CFrame, look: CFrame?)
	if not api.root() then
		api.spawn()
		c.check()
	end
	local r = api.root()
	if r and r.Anchored and not r:GetAttribute("ClientFrozen") then
		-- still held by the server after spawning
		api.release(cf)
	else
		api.freeze(false)
		api.teleport(cf)
	end
	c.check()
	api.hideCharacter(false)
	api.gameplay(true, look or (CFrame.new(cf.Position + Vector3.new(0, 1.5, 0)) * cf.Rotation))
end

----------------------------------------------------------------------------
-- CHAPTER 1: Good morning
----------------------------------------------------------------------------
local CH = {}

CH[1] = function(c, _fresh: boolean)
	api.state("story")
	Director.start()
	local face = api.headCore.CFrame
	Audio.play("Whoosh")
	Director.move(CFrame.lookAt(face.Position + face.LookVector * 2.4 + Vector3.new(0.9, 0.5, 0.9), face.Position), 2.0, "smooth", 50)
	c.check()
	Fx.fade(1, 0.6, true)
	api.snore(false)
	api.setSleeping(false)
	api.lids(0, 0)
	task.spawn(api.spawn)
	api.hideCharacter(true)
	Scenes.apply("Morning", true)
	setPhoneOnNightstand(true)
	setDoor(false, true)
	Fx.black(0)
	api.setAlarm(true)
	Fx.title("ch.1")
	c.check()
	local eye = eyeFromHead(face)
	api.lie(eye, { blink = true, closedTime = 0.3, allowOnly = { AlarmClock = true } })
	c.check()
	api.waitGetUp(if api.isTouch then "hint.lying.touch" else "hint.lying")
	c.check()
	-- get up: sit on the edge of the bed, then stand
	Audio.play("Cloth")
	task.delay(0.5, Audio.play, "GetUp")
	local sitPos = Vector3.new(-6.95, 4.55, -4.9)
	Director.move(CFrame.lookAt(sitPos, sitPos + Vector3.new(1, -0.28, 0.35)), 1.4)
	c.wait(0.15)
	local wp = api.wakePoint.CFrame
	local standPos = wp.Position + Vector3.new(0, 1.5, 0)
	local standCF = CFrame.lookAt(standPos, standPos + wp.LookVector * 10 + Vector3.new(0, -0.8, 0))
	Director.move(standCF, 1.1)
	c.waitUntil(function()
		return api.root() ~= nil
	end, 10)
	api.release(wp)
	api.hideCharacter(false)
	api.gameplay(true, standCF)
	c.check()

	-- the phone
	local phoneTaken = false
	api.handlers.Door = function()
		if not phoneTaken then
			Audio.play("Click", 0.7)
			api.say({ ru = "Морти: Стоп... а телефон?", en = "Morty: Wait... where's my phone?" })
		else
			setDoor(not doorOpen)
		end
	end
	api.objective("obj.phone")
	api.prompt(if api.isTouch then "hint.walk.touch" else "hint.walk")
	task.delay(7, function()
		if c.alive() then
			api.prompt(nil)
		end
	end)
	c.interact("Phone")
	phoneTaken = true
	setPhoneOnNightstand(false)
	Audio.play("Click", 1.3)
	VM.setMode("hand")
	api.objective(nil)
	c.say("MortyThought", { ru = "Так... ещё один уровень Galaxy Raid перед завтраком.", en = "Okay... one more level of Galaxy Raid before breakfast." }, { auto = true })
	Dialogue.hide()
	c.wait(0.4)
	c.say("Beth", { ru = "(снизу) МОРТИ! Завтрак на столе!", en = "(from downstairs) MORTY! Breakfast is ready!" }, { auto = 2 })
	Dialogue.hide()
	api.objective("obj.kitchen")
	local chairPos = R.seats:FindFirstChild("Morty").Position
	c.waitUntil(function()
		local r = api.root()
		return r ~= nil and (r.Position - chairPos).Magnitude < 9
	end)
	api.objective("obj.sit")
	c.interact("SitDown")
	api.objective(nil)
end

----------------------------------------------------------------------------
-- CHAPTER 2: Breakfast
----------------------------------------------------------------------------
local function kitchenBlast(c, eye: CFrame, blastPos: Vector3, beepSound: Sound?)
	Fx.flash(Color3.new(1, 1, 1), 1, 0.03, 1.4)
	Fx.explosion(blastPos, 0.5, { sound = "ExplosionSmall", debris = 18, debrisColors = { rgb(30, 30, 34), rgb(200, 200, 210), rgb(110, 230, 255) } })
	play3D("Electric", blastPos)
	stopLoop(beepSound, 0.05)
	VM.setMode("hidden")
	VM.setHeat(0)
	for _, name in { "beth", "jerry", "summer" } do
		P[name]:pose("sitShocked", 18)
		P[name]:lookAt(blastPos)
		P[name].talking = false
	end
	Director.freeLook(false)
	Director.shake(2.4, 1.6, 16)
	Fx.muffle(true)
	Audio.play("Tinnitus")
	Director.move(eye * CFrame.new(0.3, 0.4, 1.4) * CFrame.Angles(math.rad(38), math.rad(12), math.rad(28)), 0.45, "out")
	c.wait(0.3)
	Director.move(eye * CFrame.new(0.6, -1.8, 2.6) * CFrame.Angles(math.rad(70), math.rad(20), math.rad(80)), 0.9, "in")
	Audio.play("Thud")
	Director.shake(1.2, 0.5)
	Fx.glitch(0.6, 0.35)
	Fx.fade(1, 1.4, true)
	Audio.music(nil, 1)
	c.wait(1.2)
	Fx.muffle(false)
end

CH[2] = function(c, fresh: boolean)
	api.state("story")
	api.gameplay(false)
	local seat = R.seats:FindFirstChild("Morty").CFrame
	local eye = seat * CFrame.new(0, 1.95, -0.3) * CFrame.Angles(math.rad(-12), 0, 0)
	if fresh then
		Fx.black(1)
		api.setSleeping(false)
		Scenes.apply("Morning", true)
		setPhoneOnNightstand(false)
		setDoor(true, true)
	end
	holdCharacterAt(c, seat * CFrame.new(1.8, 0, 0))
	familyAtBreakfast()
	Director.start()
	if fresh then
		Director.cut(eye, 72)
		Fx.fade(0, 1)
	else
		Director.move(eye, 1.2, "smooth", 72)
	end
	Audio.play("Cloth", 0.9)
	Director.freeLook(true, { yaw = 1.3, pitchUp = 0.5, pitchDown = 0.8 })
	VM.setMode("table")
	VM.setHeat(0.2)
	Audio.music("MusicBreakfast", 2)
	local clinking = true
	task.spawn(function()
		while clinking and c.alive() do
			task.wait(1.5 + math.random() * 2.5)
			if clinking then
				Audio.play("Clink", 0.8 + math.random() * 0.6)
			end
		end
	end)
	Fx.title("ch.2")
	c.check()
	local beth, jerry, summer = P.beth, P.jerry, P.summer
	jerry:lookAt(eye.Position)
	c.say("Jerry", { ru = "Доброе утро, сынок! Знаешь, какой сегодня день? День... э-э... отличных дел!", en = "Morning, son! You know what today is? It's a day for... uh... great things!" })
	jerry:lookAt(nil)
	c.say("Summer", { ru = "Пап, никто не спрашивал.", en = "Dad, nobody asked." })
	VM.setHeat(0.35)
	c.say("MortyThought", { ru = "Ещё чуть-чуть... босс почти побеждён...", en = "Almost there... the boss is almost dead..." })
	-- Beth notices the phone
	beth:lookAt(eye.Position)
	c.wait(0.6)
	beth:pose("sitPoint", 14)
	Director.shake(0.6, 0.4)
	Audio.play("Thud", 1.4)
	c.say("Beth", { ru = "МОРТИ!! Ты уже везде со своим телефоном ходишь! Мне это надоело! Убирай сейчас же!", en = "MORTY!! You take that phone everywhere! I'm sick of it! Put it away right now!" })
	summer:lookAt(eye.Position)
	c.say("Summer", { ru = "Ха. Попался.", en = "Ha. Busted." }, { auto = 1.2 })
	Dialogue.hide()
	Director.freeLook(false)
	local pick = Dialogue.choice({
		{ ru = "Убрать телефон", en = "Put the phone away" },
		{ ru = "Не убирать", en = "Keep playing" },
	})
	c.check()
	Director.freeLook(true)
	local beep: Sound? = nil
	local blastPos: Vector3
	if pick == 1 then
		c.say("Morty", { ru = "Ладно, ладно... всё, убрал.", en = "Okay, okay... it's away." }, { auto = true })
		VM.setMode("pocket")
		Audio.play("Cloth", 1.2)
		beth:pose("sitEat", 8)
		beth:lookAt(nil)
		summer:lookAt(nil)
		c.say("Beth", { ru = "Спасибо, милый. Ешь, пока не остыло.", en = "Thank you, sweetie. Eat before it gets cold." }, { auto = true })
		c.say("Jerry", { ru = "Кстати, я тут подумал заняться... гончарным делом.", en = "By the way, I've been thinking of taking up... pottery." }, { auto = true })
		c.say("Summer", { ru = "Не надо.", en = "Don't." }, { auto = 1.1 })
		Dialogue.hide()
		local function pocket(): Vector3
			return (camera().CFrame * CFrame.new(0.6, -2.2, -0.6)).Position
		end
		beep = loopSound("OverheatBeep", camera())
		c.wait(1.6)
		c.say("MortyThought", { ru = "Чего это так греется в кармане?..", en = "Why is my pocket getting so hot..." }, { auto = true })
		local smoking = true
		task.spawn(function()
			while smoking and c.alive() do
				Fx.smoke(pocket(), 0.5, 4, rgb(90, 90, 96), 2)
				task.wait(0.25)
			end
		end)
		if beep then
			beep.PlaybackSpeed = 1.3
		end
		jerry:lookAt(eye.Position + Vector3.new(0, -1.5, 0))
		c.say("Jerry", { ru = "Кто-то жарит бекон?", en = "Is someone frying bacon?" }, { auto = true })
		if beep then
			beep.PlaybackSpeed = 1.7
		end
		c.say("Morty", { ru = "Ой... я же не закрыл игру!", en = "Oh no... I didn't close the game!" }, { auto = 1.0 })
		smoking = false
		Dialogue.hide()
		blastPos = pocket()
	else
		c.say("Morty", { ru = "Мам, ну ещё минуточку! Тут босс!", en = "Mom, just one more minute! It's a boss fight!" }, { auto = true })
		c.say("Beth", { ru = "Морти Смит!!", en = "Morty Smith!!" }, { auto = 1.2 })
		beep = loopSound("OverheatBeep", camera())
		local heating = true
		task.spawn(function()
			local h = 0.35
			while heating and c.alive() do
				h = math.min(1, h + 0.04)
				VM.setHeat(h)
				if h > 0.55 then
					Fx.smoke(VM.position(), 0.4, 3, rgb(90, 90, 96), 1.6)
				end
				if beep then
					beep.PlaybackSpeed = 1 + h
				end
				task.wait(0.2)
			end
		end)
		c.wait(1.4)
		jerry:lookAt(VM.position())
		c.say("Jerry", { ru = "Сынок... он что, дымится?", en = "Son... is that thing smoking?" }, { auto = true })
		summer:lookAt(VM.position())
		c.say("Morty", { ru = "Э-э-э... мам?..", en = "Uh... Mom?.." }, { auto = 1.0 })
		heating = false
		Dialogue.hide()
		blastPos = VM.position()
	end
	clinking = false
	kitchenBlast(c, eye, blastPos, beep)
end

----------------------------------------------------------------------------
-- CHAPTER 3: Rick's garage
----------------------------------------------------------------------------
local RICK_NONSENSE = {
	{ ru = "Шлёп-шлёп... зюзюбрики.", en = "Wubba lubba... flarp." },
	{ ru = "Я вижу звуки, Морти. Они фиолетовые.", en = "I can see sounds, Morty. They're purple." },
	{ ru = "Кто-нибудь заказывал пиццу с... болтами?", en = "Did anyone order a pizza with... bolts?" },
	{ ru = "Морти, у меня в ухе кто-то ремонт делает.", en = "Morty, somebody's renovating my ear." },
}

CH[3] = function(c, _fresh: boolean)
	api.state("story")
	api.gameplay(false)
	Fx.black(1)
	Director.start()
	local stand = R.garageSpots.MortyStand.CFrame
	holdCharacterAt(c, stand)
	VM.setMode("hidden")
	api.setAlarm(false)
	Scenes.apply("Garage", true)
	setGarageDoor(false, true)
	saucerTo(init.saucer)
	local rick = P.rick
	rick.follow = nil
	rick:place(R.garageSpots.RickByTable.CFrame)
	rick:pose("lean", 8)
	rick.glitch = 0.35
	local head = R.garageSpots.MortyHead.CFrame
	rick:lookAt(head.Position)
	local bubbles = loopSound("Bubbles", R.lab:FindFirstChild("Vat"):FindFirstChild("Goo"))
	local _ = bubbles
	api.lids(0, 0)
	Fx.title("ch.3")
	c.check()
	Fx.black(0)
	api.lie(eyeFromHead(head), { blink = true, closedTime = 0.5, interact = false, yaw = 1.5 })
	c.check()
	c.say("Rick", { ru = "Морти! Морти, ты меня слышишь? *бульк*", en = "Morty! Morty, can you hear me? *burp*" }, { glitch = 0.2 })
	Audio.play("Burp", 0.9)
	c.say("Rick", { ru = "Ты взорвался, Морти. Твой телефон взорвался. Прямо за завтраком.", en = "You exploded, Morty. Your phone exploded. Right at breakfast." }, { glitch = 0.35 })
	c.say("Rick", { ru = "Пришлось собрать тебя по к-к-кусочкам. Девяносто ш-ш-шесть процентов тебя. Остальное... не спрашивай.", en = "Had to put you back together p-p-piece by piece. Ninety-s-s-six percent of you. The rest... don't ask." }, { glitch = 0.6 })
	c.say("Morty", { ru = "Рик... с тобой всё нормально? Ты какой-то... мерцаешь.", en = "Rick... are you okay? You're kind of... flickering." })
	rick.glitch = 1
	Fx.glitch(1.2, 0.7)
	Audio.play("Glitch3")
	c.say("Rick", { ru = "Я в полном порядке, Морти. Я огурчик. Я ТОСТЕР. Я... ОШИБКА: РИК_НЕ_НАЙДЕН.", en = "I'm totally fine, Morty. I'm a pickle. I'm a TOASTER. I'm... ERROR: RICK_NOT_FOUND." }, { glitch = 1 })
	rick.glitch = 0.35
	c.say("Rick", { ru = "...Короче, неважно. Вставай, хватит валяться!", en = "...Anyway, never mind. Get up, quit lying around!" }, { glitch = 0.2 })
	Dialogue.hide()
	api.waitGetUp(if api.isTouch then "hint.lying.touch" else "hint.lying.simple")
	c.check()
	Audio.play("Cloth")
	task.delay(0.4, Audio.play, "GetUp")
	local sitPos = Vector3.new(-39.4, -3.25, -20.8)
	Director.move(CFrame.lookAt(sitPos, sitPos + Vector3.new(1, -0.25, 0.1)), 1.3)
	local standEye = CFrame.new(stand.Position + Vector3.new(0, 1.5, 0)) * stand.Rotation
	Director.move(standEye, 1.0)
	rick:pose("stand", 8)
	giveControl(c, stand, standEye)
	-- Rick keeps looking at Morty
	local watching = true
	task.spawn(function()
		while watching and c.alive() do
			rick:lookAt(camera().CFrame.Position)
			task.wait(0.1)
		end
	end)
	c.say("Rick", { ru = "Слушай сюда. Нас ждёт очередное приключение! Планета B137.", en = "Listen up. Another adventure awaits! Planet B137." }, { auto = true, glitch = 0.25 })
	c.say("Rick", { ru = "Пустыня, оранжевое небо и никаких телефонов. Тебе понравится.", en = "Desert, orange sky and no phones. You'll love it." }, { auto = true, glitch = 0.25 })
	c.say("Rick", { ru = "Сколько пальцев я показываю? Неправильно. Их у меня одиннадцать.", en = "How many fingers am I holding up? Wrong. I have eleven." }, { auto = true, glitch = 0.7 })
	c.say("Rick", { ru = "Садись в тарелку!", en = "Get in the saucer!" }, { auto = 1.5, glitch = 0.2 })
	Dialogue.hide()
	api.objective("obj.saucer")
	watching = false
	-- Rick climbs into the pilot seat
	local seatPos = R.saucerSpots.SeatRick.Position
	local side = Vector3.new(seatPos.X - 4.6, rick.root.Position.Y, seatPos.Z)
	rick:walkTo(side, 7)
	c.check()
	local from = rick.root.CFrame
	animate(0.6, function(a)
		rick.root.CFrame = from:Lerp(R.saucerSpots.SeatRick.CFrame, a) * CFrame.new(0, math.sin(a * math.pi) * 1.5, 0)
	end)
	seatRickInSaucer()
	-- while we wait, Rick talks nonsense
	local waiting = true
	task.spawn(function()
		local i = 0
		while waiting and c.alive() do
			task.wait(9)
			if waiting then
				i = i % #RICK_NONSENSE + 1
				rick.glitch = 0.9
				Audio.play("Glitch1")
				api.say({ ru = "Рик: " .. RICK_NONSENSE[i].ru, en = "Rick: " .. RICK_NONSENSE[i].en }, 3)
				task.wait(0.6)
				rick.glitch = 0.3
			end
		end
	end)
	c.interact("Saucer")
	waiting = false
	api.objective(nil)
end

----------------------------------------------------------------------------
-- CHAPTER 4: Flight to B137
----------------------------------------------------------------------------
CH[4] = function(c, fresh: boolean)
	api.state("story")
	api.gameplay(false)
	Fx.fade(1, 0.35, true)
	if fresh then
		Scenes.apply("Garage", true)
		saucerTo(init.saucer)
		setGarageDoor(false, true)
		P.rick.glitch = 0.3
	end
	holdCharacterAt(c, R.garageSpots.MortyStand.CFrame)
	seatRickInSaucer()
	Director.start()
	Director.track(mortySaucerEye)
	Director.freeLook(true, { yaw = 1.7, pitchUp = 0.9, pitchDown = 0.9 })
	Director.fov(72)
	Fx.fade(0, 0.6)
	local hum = loopSound("UfoHum", R.saucer.PrimaryPart)
	saucerThrust(true)
	task.spawn(Fx.title, "ch.4")
	c.say("Rick", { ru = "Пристегнись, Морти. А, тут нет ремней. Ну держись тогда.", en = "Buckle up, Morty. Oh wait, no seatbelts. Just hold on then." }, { auto = true, glitch = 0.2 })
	Dialogue.hide()
	setGarageDoor(true)
	c.check()
	Audio.music("MusicFlight", 2)
	local p0 = init.saucer
	fly(p0 * CFrame.new(0, 3, 0), 1.6, "smooth", 0.03)
	Audio.play("Takeoff")
	fly(CFrame.lookAt(Vector3.new(-12, -5.5, -21), Vector3.new(20, -4, -21)), 2.6, "in", 0.02)
	Scenes.apply("Sky")
	fly(CFrame.lookAt(Vector3.new(16, 34, -56), Vector3.new(40, 110, -130)), 3.6, "linear", 0.03)
	c.say("Morty", { ru = "Ух ты... наш дом отсюда такой маленький!", en = "Whoa... our house looks so tiny from up here!" }, { auto = 1.6, noWait = false })
	Dialogue.hide()
	fly(CFrame.lookAt(Vector3.new(46, 170, -160), Vector3.new(70, 300, -260)), 2.6, "linear", 0.02)
	-- warp
	Fx.speedLines(true, 1.6)
	Director.fov(115, 1.2)
	Audio.play("Warp")
	Director.shake(0.6, 1.4, 20)
	fly(CFrame.lookAt(Vector3.new(70, 300, -260), Vector3.new(100, 500, -400)), 1.2, "in", 0.01)
	Fx.flash(Color3.new(1, 1, 1), 1, 0.08, 0.7)
	c.wait(0.08)
	Scenes.apply("Space", true)
	local S = Vector3.new(-9000, 3000, 0)
	saucerTo(CFrame.lookAt(S, S + Vector3.new(0, -0.05, -1)))
	Director.fov(72, 0.8)
	Fx.speedLines(false)
	-- cruise towards the planet
	local cruising = true
	task.spawn(function()
		local from = R.saucer:GetPivot()
		local to = CFrame.lookAt(S + Vector3.new(0, -300, -2700), S + Vector3.new(0, -360, -3700))
		local t0 = os.clock()
		while cruising and c.alive() do
			local a = math.clamp((os.clock() - t0) / 18, 0, 1)
			local t = os.clock() - t0
			saucerTo(from:Lerp(to, a) * CFrame.Angles(math.sin(t * 0.9) * 0.02, 0, math.sin(t * 0.7) * 0.03))
			RunService.RenderStepped:Wait()
		end
	end)
	c.wait(1.5)
	c.say("Rick", { ru = "Вот она. B137. Местные называют её... никак. Тут нет местных. Наверное.", en = "There she is. B137. The locals call it... nothing. There are no locals. Probably." }, { auto = true, glitch = 0.2 })
	P.rick.glitch = 1
	Fx.glitch(1.4, 0.8)
	Audio.play("Glitch2")
	Director.shake(0.8, 1.2)
	c.say("Rick", { ru = "B137... B137... Б-Б-Б-Б-Б—", en = "B137... B137... B-B-B-B-B—" }, { auto = 1.0, glitch = 1 })
	c.say("Morty", { ru = "Рик?!", en = "Rick?!" }, { auto = 0.8 })
	P.rick.glitch = 0.3
	c.say("Rick", { ru = "Всё нормально! Помехи. Космические. Наверное. *бульк*", en = "Everything's fine! Interference. Space interference. Probably. *burp*" }, { auto = true, glitch = 0.3 })
	Audio.play("Burp", 0.85)
	Dialogue.hide()
	c.wait(3)
	-- re-entry
	local reentry = loopSound("Reentry", camera())
	Fx.heat(0.6, 2.5)
	Director.shake(1.4, 4.5, 18)
	c.say("Morty", { ru = "Рик, мы горим!", en = "Rick, we're on fire!" }, { auto = 1.2 })
	c.say("Rick", { ru = "Это называется «вход в атмосферу», Морти!", en = "It's called atmospheric entry, Morty!" }, { auto = 1.2 })
	Dialogue.hide()
	c.wait(1.2)
	Fx.flash(rgb(255, 170, 90), 1, 0.25, 1.0)
	c.wait(0.25)
	cruising = false
	stopLoop(reentry, 1)
	ensureDesert(c)
	Scenes.apply("Desert", true)
	Fx.heat(0, 1.5)
	-- land
	local land = R.spots.Landing.CFrame
	local startPos = (land * CFrame.new(-120, 230, 260)).Position
	saucerTo(CFrame.lookAt(startPos, land.Position + Vector3.new(0, 30, 0)))
	fly(CFrame.lookAt((land * CFrame.new(0, 26, 0)).Position, (land * CFrame.new(0, 26, -10)).Position), 5, "out", 0.03)
	fly(land, 2.4, "out", 0.015)
	Fx.dust(land.Position, 14, 70)
	Director.shake(0.9, 0.7)
	Audio.play("Thud", 0.7)
	saucerThrust(false)
	stopLoop(hum, 2)
	Audio.music(nil, 3)
end

----------------------------------------------------------------------------
-- CHAPTER 5: Planet B137
----------------------------------------------------------------------------
local function crashSite(): CFrame
	local o = R.spots.Landing.Position
	return CFrame.new(o + Vector3.new(14, -0.6, -6)) * CFrame.Angles(math.rad(14), math.rad(70), math.rad(-11))
end

CH[5] = function(c, fresh: boolean)
	api.state("story")
	api.gameplay(false)
	if fresh then
		Fx.black(1)
		ensureDesert(c)
		Scenes.apply("Desert", true)
		saucerTo(R.spots.Landing.CFrame)
		P.rick.glitch = 0.3
		holdCharacterAt(c, R.spots.MortyExit.CFrame)
		seatRickInSaucer()
		Director.start()
		Director.track(mortySaucerEye)
		Fx.fade(0, 0.8)
	end
	Audio.music("MusicEerie", 3)
	task.spawn(Fx.title, "ch.5")
	c.say("Rick", { ru = "Приехали. Выходи, Морти, разомни ноги.", en = "We're here. Out you go, Morty. Stretch your legs." }, { auto = true, glitch = 0.2 })
	Dialogue.hide()
	Fx.fade(1, 0.35, true)
	local exitCF = R.spots.MortyExit.CFrame
	Director.stop()
	giveControl(c, exitCF)
	Fx.fade(0, 0.5)
	api.objective("obj.look")
	local r = api.root()
	local startPos = if r then r.Position else exitCF.Position
	c.waitUntil(function()
		local rr = api.root()
		return rr ~= nil and (rr.Position - startPos).Magnitude > 7
	end, 5)
	api.objective(nil)

	-- Rick ditches Morty
	api.gameplay(false)
	api.freeze(true)
	local eyePos = camera().CFrame.Position
	local lookAtPos = R.saucer:GetPivot().Position + Vector3.new(0, 3, 0)
	local focus = camera().CFrame.Position + camera().CFrame.LookVector * 10
	Director.start()
	Director.track(function(dt)
		focus = focus:Lerp(lookAtPos, math.min(1, dt * 4))
		return CFrame.lookAt(eyePos, focus)
	end)
	c.say("Rick", { ru = "Прощай, Морти! Так будет лучше!", en = "Goodbye, Morty! It's for the best!" }, { auto = 1.2, glitch = 0.2 })
	Dialogue.hide()
	local hum = loopSound("UfoHum", R.saucer.PrimaryPart)
	saucerThrust(true)
	Audio.play("Takeoff")
	local land = R.spots.Landing.CFrame
	local tracking = true
	task.spawn(function()
		while tracking and c.alive() do
			lookAtPos = R.saucer:GetPivot().Position + Vector3.new(0, 2, 0)
			RunService.RenderStepped:Wait()
		end
	end)
	fly(land * CFrame.new(0, 12, 0), 1.2, "out", 0.03)
	local hitPos = (land * CFrame.new(46, 30, -78)).Position
	fly(CFrame.lookAt(hitPos, hitPos + (hitPos - land.Position).Unit), 1.8, "in", 0.02)
	-- something unseen hits the saucer (its hand): a dark blur + shock
	local hand = R.hand
	local from = CFrame.lookAt(hitPos + Vector3.new(-60, 30, 30), hitPos) * CFrame.Angles(0, 0, math.rad(80))
	local to = CFrame.lookAt(hitPos + Vector3.new(40, -10, -20), hitPos + Vector3.new(80, -10, -40)) * CFrame.Angles(0, 0, math.rad(80))
	setParts(hand, { Transparency = 0.55 })
	task.spawn(function()
		animate(0.3, function(a)
			hand:PivotTo(from:Lerp(to, a))
		end, "in")
		setParts(hand, { Transparency = 1 })
	end)
	c.wait(0.18)
	play3D("MetalCrash", hitPos)
	Audio.play("Boom", 0.8)
	Fx.shockwave(hitPos, 26, 0.45, rgb(30, 20, 30))
	Fx.sparks(hitPos, 60)
	Director.shake(1.6, 0.8)
	stopLoop(hum, 0.3)
	saucerThrust(false)
	-- tumble down next to Morty
	local site = crashSite()
	local start = R.saucer:GetPivot()
	local spinAxis = CFrame.Angles(0, 0, 0)
	local t0 = os.clock()
	animate(1.6, function(a)
		local t = os.clock() - t0
		local pos = bezier(start.Position, start.Position:Lerp(site.Position, 0.5) + Vector3.new(0, 16, 0), site.Position + Vector3.new(0, 1.2, 0), a)
		spinAxis = CFrame.Angles(t * 7, t * 3, t * 5)
		saucerTo(CFrame.new(pos) * spinAxis)
	end, "in")
	tracking = false
	saucerTo(site)
	Fx.explosion(site.Position + Vector3.new(0, 1, 0), 1.2, { sound = "MetalCrash", debris = 22, debrisColors = { rgb(150, 155, 160), rgb(90, 96, 104), rgb(214, 146, 88) } })
	Fx.dust(site.Position, 22, 120)
	Director.shake(2.6, 1.4)
	emitters(R.saucer, "CrashSmoke", true)
	for _, d in R.saucer:GetDescendants() do
		if d:IsA("Fire") then
			d.Enabled = true
		end
	end
	lookAtPos = site.Position + Vector3.new(0, 2, 0)
	c.wait(1.6)
	-- Rick crawls out of the wreck
	local rick = P.rick
	rick.follow = nil
	local rickSeat = R.saucerSpots.SeatRick.CFrame
	local toward = (eyePos - site.Position) * Vector3.new(1, 0, 1)
	local crawlPos = site.Position + toward.Unit * 6 + Vector3.new(0, 3.36 - site.Position.Y + site.Position.Y, 0)
	crawlPos = Vector3.new(crawlPos.X, 3.36, crawlPos.Z)
	rick:place(rickSeat)
	rick:pose("crawl", 6)
	local crawlFrom = rick.root.CFrame
	local crawlTo = CFrame.lookAt(crawlPos, Vector3.new(eyePos.X, 3.36, eyePos.Z))
	animate(1.4, function(a)
		rick.root.CFrame = crawlFrom:Lerp(crawlTo, a)
		lookAtPos = rick.root.Position + Vector3.new(0, 1, 0)
	end)
	rick:pose("cough", 8)
	rick.glitch = 0.45
	c.say("Rick", { ru = "Кха-кха! Всё хорошо! Всё под контролем! Я так и задумал!", en = "Cough, cough! Everything's fine! Totally under control! That was the plan!" }, { glitch = 0.3 })
	rick:pose("stand", 6)
	rick:lookAt(eyePos)
	lookAtPos = rick.root.Position + Vector3.new(0, 2.2, 0)
	c.say("Morty", { ru = "Рик! Почему ты пытался меня бросить?!", en = "Rick! Why did you try to ditch me?!" })
	c.say("Rick", { ru = "Морти... за мной охотится проклятие. Проклятие неудачи.", en = "Morty... something's hunting me. A curse. A curse of bad luck." }, { glitch = 0.25 })
	c.say("Rick", { ru = "Я хотел увести его подальше от тебя. Освободить тебя, Морти. Не получилось.", en = "I wanted to lead it away from you. Set you free, Morty. Didn't work." }, { glitch = 0.25 })
	c.say("Morty", { ru = "А что тебя сбило?! Там же ничего не было!", en = "So what knocked you down?! There was nothing there!" })
	Fx.glitch(0.5, 0.4)
	c.say("Rick", { ru = "Это была ЕГО рука, Морти. Оно хотело добить меня... а потом вернуться за тобой.", en = "That was ITS hand, Morty. It wanted to finish me off... and then come back for you." }, { glitch = 0.5 })
	c.say("Rick", { ru = "Пошли. Тарелке конец, а стоять на месте — плохая идея.", en = "Come on. The saucer's toast, and standing still is a bad idea." }, { glitch = 0.2 })
	Dialogue.hide()
	-- walk with Rick to the old houses
	local look = camera().CFrame
	Director.stop()
	api.freeze(false)
	api.gameplay(true, look)
	api.objective("obj.follow")
	local reached = 0
	task.spawn(function()
		for i = 1, 5 do
			local m = R.spots:FindFirstChild("Path" .. i)
			if not m or not c.alive() then
				break
			end
			while c.alive() do
				local rr = api.root()
				if not rr or (rr.Position - rick.root.Position).Magnitude < 22 then
					break
				end
				rick:lookAt(rr.Position)
				task.wait(0.2)
			end
			rick:lookAt(nil)
			rick:walkTo(m.Position, 7.5)
			reached = i
		end
	end)
	c.waitUntil(function()
		return reached >= 2
	end)
	c.say("Morty", { ru = "Рик, а как выглядит это проклятие?", en = "Rick, what does this curse even look like?" }, { auto = true })
	c.say("Rick", { ru = "Не знаю, Морти. Никто его не видел и не остался... ну, целым.", en = "Don't know, Morty. Nobody's seen it and stayed... you know, in one piece." }, { auto = true, glitch = 0.2 })
	Dialogue.hide()
	c.waitUntil(function()
		return reached >= 3
	end)
	c.say("Rick", { ru = "А ещё у меня в голове кто-то поёт. Тихо так. Про унитазы.", en = "Also, someone's singing in my head. Real quiet. About toilets." }, { auto = true, glitch = 0.5 })
	c.say("Morty", { ru = "Чего?..", en = "What?.." }, { auto = 1 })
	Dialogue.hide()
	c.waitUntil(function()
		return reached >= 4
	end)
	c.say("Morty", { ru = "Рик, смотри! Дома! Какие-то древние...", en = "Rick, look! Houses! They look ancient..." }, { auto = true })
	Dialogue.hide()
	c.waitUntil(function()
		return reached >= 5
	end)
	api.objective(nil)
end

----------------------------------------------------------------------------
-- CHAPTER 6: The Titan
----------------------------------------------------------------------------
local TITAN_POSES = {
	stand = {},
	fly = {
		ShoulderL = CFrame.Angles(-0.35, 0, -0.3),
		ShoulderR = CFrame.Angles(-0.35, 0, 0.3),
		HipL = CFrame.Angles(-0.2, 0, 0),
		HipR = CFrame.Angles(-0.1, 0, 0),
		KneeL = CFrame.Angles(-0.5, 0, 0),
		KneeR = CFrame.Angles(-0.3, 0, 0),
		Waist = CFrame.Angles(-0.3, 0, 0),
	},
	land = {
		HipL = CFrame.Angles(0.9, 0, -0.12),
		HipR = CFrame.Angles(0.9, 0, 0.12),
		KneeL = CFrame.Angles(-1.5, 0, 0),
		KneeR = CFrame.Angles(-1.5, 0, 0),
		AnkleL = CFrame.Angles(0.6, 0, 0),
		AnkleR = CFrame.Angles(0.6, 0, 0),
		Waist = CFrame.Angles(-0.4, 0, 0),
		ShoulderL = CFrame.Angles(0.3, 0, -0.6),
		ShoulderR = CFrame.Angles(0.3, 0, 0.6),
		Neck = CFrame.Angles(0.25, 0, 0),
	},
	aim = {
		ShoulderR = CFrame.Angles(1.5, 0, 0.12),
		ElbowR = CFrame.Angles(0.08, 0, 0),
		ShoulderL = CFrame.Angles(0.35, 0, -0.35),
		Waist = CFrame.Angles(-0.08, -0.25, 0),
		HipL = CFrame.Angles(0.3, 0, -0.08),
		HipR = CFrame.Angles(-0.2, 0, 0.08),
		KneeL = CFrame.Angles(-0.4, 0, 0),
	},
	pods = {
		ShoulderL = CFrame.Angles(0.5, 0, -0.5),
		ShoulderR = CFrame.Angles(0.5, 0, 0.5),
		Waist = CFrame.Angles(0.12, 0, 0),
		Neck = CFrame.Angles(-0.15, 0, 0),
	},
	hit = {
		Waist = CFrame.Angles(0.4, 0.25, 0),
		ShoulderL = CFrame.Angles(-0.7, 0, -0.7),
		ShoulderR = CFrame.Angles(-0.5, 0, 0.8),
		Neck = CFrame.Angles(0.35, 0, 0),
		KneeL = CFrame.Angles(-0.3, 0, 0),
	},
	charge = {
		ShoulderL = CFrame.Angles(0.15, 0, -1.2),
		ShoulderR = CFrame.Angles(0.15, 0, 1.2),
		ElbowL = CFrame.Angles(0.6, 0, 0),
		ElbowR = CFrame.Angles(0.6, 0, 0),
		Waist = CFrame.Angles(0.2, 0, 0),
		Neck = CFrame.Angles(0.25, 0, 0),
		HipL = CFrame.Angles(0.25, 0, -0.18),
		HipR = CFrame.Angles(-0.25, 0, 0.18),
		KneeL = CFrame.Angles(-0.4, 0, 0),
		KneeR = CFrame.Angles(-0.2, 0, 0),
	},
	fire = {
		ShoulderL = CFrame.Angles(0.6, 0, -0.9),
		ShoulderR = CFrame.Angles(0.6, 0, 0.9),
		Waist = CFrame.Angles(-0.2, 0, 0),
		Neck = CFrame.Angles(-0.1, 0, 0),
		HipL = CFrame.Angles(0.35, 0, -0.18),
		HipR = CFrame.Angles(-0.35, 0, 0.18),
		KneeL = CFrame.Angles(-0.5, 0, 0),
	},
}

local ENTITY_POSES = {
	idle = {},
	raise = {
		ShoulderL = CFrame.Angles(2.4, 0, -0.4),
		ShoulderR = CFrame.Angles(2.4, 0, 0.4),
		ElbowL = CFrame.Angles(0.5, 0, 0),
		ElbowR = CFrame.Angles(0.5, 0, 0),
		Neck = CFrame.Angles(-0.3, 0, 0),
	},
	swing = {
		ShoulderR = CFrame.Angles(1.3, 0, 1.0),
		ElbowR = CFrame.Angles(0.8, 0, 0),
		ShoulderL = CFrame.Angles(0.4, 0, -0.5),
		Waist = CFrame.Angles(-0.25, 0.5, 0),
	},
	hit = {
		Waist = CFrame.Angles(0.35, -0.2, 0),
		Neck = CFrame.Angles(-0.45, 0, 0),
		ShoulderL = CFrame.Angles(0.9, 0, -0.9),
		ShoulderR = CFrame.Angles(0.9, 0, 0.9),
	},
}

local function titanPart(name: string): BasePart?
	return R.titanModel:FindFirstChild(name, true) :: BasePart?
end

local function titanJets(on: boolean)
	emitters(R.titanModel, "Jet", on)
	for _, d in R.titanModel:GetDescendants() do
		if d:IsA("PointLight") and d.Name == "JetLight" then
			d.Brightness = if on then 4 else 0
		end
	end
end

local function entityCloud(on: boolean)
	emitters(R.entityModel, "BlackCloud", on)
end

local function bigBlackSmoke(pos: Vector3, scale: number)
	Fx.smoke(pos, 6 * scale, 18, rgb(12, 10, 14), 6)
end

CH[6] = function(c, fresh: boolean)
	api.state("story")
	local rick = P.rick
	local V = R.village
	local mv = R.spots.MortyVillage.CFrame
	if fresh then
		Fx.black(1)
		ensureDesert(c)
		Scenes.apply("Desert", true)
		saucerTo(crashSite())
		emitters(R.saucer, "CrashSmoke", true)
		rick.follow = nil
		rick:place(R.spots.Path5.CFrame)
		rick:pose("stand")
		rick.glitch = 0.3
		holdCharacterAt(c, mv)
		Fx.fade(0, 1)
	end
	api.gameplay(false)
	api.freeze(true)
	api.hideCharacter(true)
	local eye = CFrame.new(mv.Position + Vector3.new(0, 1.92, 0)) * mv.Rotation
	Director.start()
	Director.move(eye, 1.4, "smooth", 70)
	Audio.music("MusicDread", 3)
	local rickSpot = mv.Position + mv.RightVector * 3.2 + mv.LookVector * 0.8
	task.spawn(function()
		rick:walkTo(Vector3.new(rickSpot.X, 3.36, rickSpot.Z), 6, mv.Position + mv.LookVector * 40)
	end)
	Fx.title("ch.6")
	c.check()
	Director.freeLook(true, { yaw = 1.3, pitchUp = 0.9, pitchDown = 0.5 })
	c.say("Rick", { ru = "Тут кто-то живёт, Морти. Дым из трубы. И следы свежие.", en = "Somebody lives here, Morty. Smoke from the chimney. Fresh footprints." }, { glitch = 0.15 })
	-- a shadow passes the lit window
	local houseA = V:FindFirstChild("HouseA")
	local win = houseA and houseA:FindFirstChild("Window2") :: BasePart?
	local shadow = V:FindFirstChild("WindowShadow") :: BasePart?
	if win and shadow then
		Director.freeLook(false)
		local winPos = win.Position
		Director.track(function()
			return CFrame.lookAt(eye.Position, winPos)
		end)
		c.wait(1.0)
		shadow.Transparency = 0
		animate(1.3, function(a)
			shadow.CFrame = win.CFrame * CFrame.new(-1.1 + 2.2 * a, -0.1, -0.35)
		end, "linear")
		shadow.Transparency = 1
		c.say("Morty", { ru = "Там кто-то был в окне!", en = "Someone was in that window!" })
		c.say("Rick", { ru = "Не до них сейчас.", en = "No time for them now." }, { glitch = 0.1 })
	end
	-- radar
	Director.track(function()
		return CFrame.lookAt(eye.Position, rick.root.Position + Vector3.new(0, 1.2, 0))
	end)
	rick:lookAt(nil)
	rick:pose("holdRadar", 8)
	Radar.holdProp(true)
	Audio.play("Servo", 1.6)
	c.wait(0.8)
	Radar.show(true)
	c.say("Rick", { ru = "Так... Угроза — максимальная. Прибудет через пять дней.", en = "Okay... Threat level: maximum. Arrival in five days." }, { glitch = 0.2 })
	c.say("Rick", { ru = "Пять дней, Морти. Нам нужно развиться и построить бункер, чтобы выжить.", en = "Five days, Morty. We have to level up and build a bunker to survive." }, { glitch = 0.2 })
	c.say("Morty", { ru = "Бункер?! Из чего, из песка?!", en = "A bunker?! Out of what, sand?!" })
	Dialogue.hide()
	Radar.show(false)
	Radar.holdProp(false)
	rick:pose("stand", 8)

	-- the sound... and Titan Speakerman 2.0
	Audio.music(nil, 1.5)
	local theme = Audio.make("TitanTheme", SoundService)
	if theme then
		theme:Play()
		table.insert(loops, theme)
	end
	Director.shake(0.35, 3.5, 6)
	c.wait(1.2)
	rick:lookAt(eye.Position + Vector3.new(0, 30, 0))
	c.say("Rick", { ru = "Морти... ты это слышишь?", en = "Morty... do you hear that?" }, { auto = 1.4 })
	Dialogue.hide()

	local titan = P.titan
	local landing = R.spots.TitanLanding.CFrame
	local entityHome = R.spots.EntityHome.CFrame
	local faceEntity = CFrame.lookAt(landing.Position, Vector3.new(entityHome.Position.X, 0, entityHome.Position.Z))
	local standRoot = faceEntity * CFrame.new(0, 30.4, 0)
	local left = -mv.RightVector
	local p0 = landing.Position + left * 170 + Vector3.new(0, 320, 0) - mv.LookVector * 40
	local p1 = landing.Position + left * 50 + Vector3.new(0, 170, 0)
	local p2 = standRoot.Position
	titan:pose(TITAN_POSES.fly, 6)
	titan:snap()
	titan.root.CFrame = CFrame.lookAt(p0, p1)
	titanJets(true)
	local thruster = Audio.make("Thruster", titan.root)
	if thruster then
		thruster:Play()
		table.insert(loops, thruster)
	end
	Director.track(function()
		return CFrame.lookAt(eye.Position, titan.root.Position + Vector3.new(0, 10, 0))
	end)
	Director.fov(62, 2)
	local prev = p0
	animate(5.2, function(a)
		local pos = bezier(p0, p1, p2 + Vector3.new(0, 12, 0), a)
		local dir = pos - prev
		prev = pos
		local look = if dir.Magnitude > 0.01 then dir.Unit else faceEntity.LookVector
		local flat = Vector3.new(look.X, look.Y * 0.4, look.Z)
		titan.root.CFrame = CFrame.lookAt(pos, pos + flat):Lerp(CFrame.new(pos) * faceEntity.Rotation, math.clamp((a - 0.75) * 4, 0, 1))
		if a > 0.82 then
			titan:pose(TITAN_POSES.land, 10)
		end
	end, "out")
	-- touchdown
	titanJets(false)
	stopLoop(thruster, 0.4)
	local crouch = faceEntity * CFrame.new(0, 30.4 - 7.2, 0)
	animate(0.25, function(a)
		titan.root.CFrame = (standRoot * CFrame.new(0, 12, 0)):Lerp(crouch, a)
	end, "in")
	play3D("RobotStomp", landing.Position)
	Audio.play("Boom", 0.9)
	Fx.dust(landing.Position, 34, 160)
	Fx.shockwave(landing.Position + Vector3.new(0, 2, 0), 46, 0.7, rgb(255, 210, 160))
	Director.shake(2.6, 1.4, 14)
	c.wait(1.0)
	play3D("Servo", titan.root.Position)
	titan:pose(TITAN_POSES.stand, 4)
	animate(1.4, function(a)
		titan.root.CFrame = crouch:Lerp(standRoot, a)
	end)
	play3D("RobotVoice", titan.root.Position + Vector3.new(0, 30, 0), 0.9)
	c.say("MortyThought", { ru = "Это... Титан Спикермен?!", en = "Is that... Titan Speakerman?!" }, { auto = 1.6 })
	Dialogue.hide()

	-- the black cloud and the entity
	Scenes.apply("DesertDark")
	local entity = P.entity
	entity:pose(ENTITY_POSES.idle, 3)
	entity.extra = function(t, _dt)
		local out = {
			Waist = CFrame.Angles(math.sin(t * 0.6) * 0.06, math.sin(t * 0.4) * 0.1, 0),
			ShoulderL = CFrame.Angles(math.sin(t * 0.9) * 0.15, 0, -0.1),
			ShoulderR = CFrame.Angles(math.sin(t * 0.8 + 1) * 0.15, 0, 0.1),
		}
		for ti = 1, 6 do
			for k = 1, 5 do
				out["T" .. ti .. "_" .. k] = CFrame.Angles(math.sin(t * 1.3 + ti + k * 0.6) * 0.28, 0, math.cos(t * 1.1 + ti * 2 + k * 0.5) * 0.22)
			end
		end
		return out
	end
	local below = entityHome * CFrame.new(0, -175, 0)
	entity.root.CFrame = below
	entityCloud(true)
	c.wait(1.2)
	Director.track(function()
		return CFrame.lookAt(eye.Position, entity.root.Position + Vector3.new(0, 70, 0))
	end)
	Director.fov(55, 3)
	play3D("RoarDeep", entityHome.Position, 0.6)
	Director.shake(1.0, 5, 6)
	animate(5, function(a)
		entity.root.CFrame = below:Lerp(entityHome, a)
	end, "out")
	play3D("Roar", entityHome.Position + Vector3.new(0, 100, 0), 0.7)
	c.say("Morty", { ru = "Что... ЭТО?!", en = "What... IS THAT?!" }, { auto = 1.2 })
	rick:lookAt(eye.Position)
	c.say("Rick", { ru = "Не смотри на него, Морти!", en = "Don't look at it, Morty!" }, { auto = 1.2, glitch = 0.4 })
	Dialogue.hide()

	-- FIGHT ------------------------------------------------------------------
	local chest = (R.entityModel:FindFirstChild("Chest", true) :: BasePart)
	Director.track(function()
		local mid = titan.root.Position:Lerp(entity.root.Position + Vector3.new(0, 60, 0), 0.45)
		return CFrame.lookAt(eye.Position, mid)
	end)
	Director.fov(62, 1)
	-- 1) sonic cannon volley
	titan.smooth = 14
	titan:pose(TITAN_POSES.aim)
	play3D("Charge", titan.root.Position)
	c.wait(0.8)
	local muzzle = titanPart("Muzzle")
	for i = 1, 5 do
		if muzzle then
			local origin = CFrame.lookAt(muzzle.Position, chest.Position)
			Fx.sonicRing(origin, (chest.Position - muzzle.Position).Magnitude, 0.45, 9, rgb(255, 90, 50))
			play3D("SonicBoom", muzzle.Position, 1 + i * 0.05)
		end
		Director.shake(0.5, 0.3)
		c.wait(0.45)
		local hitPos = chest.Position + Vector3.new(math.random(-12, 12), math.random(-10, 10), -16)
		Fx.explosion(hitPos, 3, { sound = "Explosion", smokeColor = rgb(14, 12, 16), waveColor = rgb(255, 120, 80) })
		entity:pose(ENTITY_POSES.hit, 10)
		c.wait(0.2)
	end
	entity:pose(ENTITY_POSES.idle, 4)
	play3D("Roar", chest.Position, 0.8)
	-- 2) the entity strikes back
	entity.smooth = 6
	entity:pose(ENTITY_POSES.swing)
	c.wait(0.7)
	titan:pose(TITAN_POSES.hit)
	local knock = standRoot * CFrame.new(0, 0, 14)
	task.spawn(animate, 0.4, function(a)
		titan.root.CFrame = standRoot:Lerp(knock, a)
	end, "out")
	Fx.sparks(titan.root.Position + Vector3.new(0, 14, 0), 80, rgb(255, 170, 120))
	Fx.explosion(titan.root.Position + Vector3.new(0, 14, 6), 2, { sound = "MetalCrash", smokeColor = rgb(14, 12, 16) })
	Director.shake(1.4, 0.8)
	c.wait(1.0)
	entity:pose(ENTITY_POSES.idle, 4)
	titan:pose(TITAN_POSES.stand, 6)
	task.spawn(animate, 0.8, function(a)
		titan.root.CFrame = knock:Lerp(standRoot, a)
	end)
	c.wait(0.9)
	-- 3) shoulder speakers
	titan:pose(TITAN_POSES.pods, 10)
	c.wait(0.4)
	for i = 1, 3 do
		for _, podName in { "PodL", "PodR" } do
			local pod = titanPart(podName)
			if pod then
				Fx.sonicRing(CFrame.lookAt(pod.Position, chest.Position), (chest.Position - pod.Position).Magnitude, 0.5, 11, rgb(255, 90, 50))
			end
		end
		play3D("SonicBoom", titan.root.Position + Vector3.new(0, 30, 0), 0.8)
		Director.shake(0.6, 0.3)
		c.wait(0.5)
		Fx.explosion(chest.Position + Vector3.new(math.random(-14, 14), math.random(-8, 14), -14), 3.5, { sound = "Explosion", smokeColor = rgb(14, 12, 16), waveColor = rgb(255, 120, 80) })
		bigBlackSmoke(chest.Position, 2)
		local _ = i
	end
	-- 4) the entity rises up and roars
	entity:pose(ENTITY_POSES.raise, 5)
	play3D("RoarDeep", chest.Position, 0.5)
	Director.shake(1.2, 2)
	c.wait(1.6)
	-- 5) core charge
	titan:pose(TITAN_POSES.charge, 6)
	local core = titanPart("Core")
	local coreLight = core and core:FindFirstChildOfClass("PointLight")
	local coreSize = if core then core.Size else Vector3.one
	play3D("ChargeLong", titan.root.Position, 0.9)
	animate(2.4, function(a)
		if coreLight then
			coreLight.Brightness = 2 + a * 14
			coreLight.Range = 40 + a * 20
		end
		if core then
			core.Size = coreSize * (1 + a * 0.5)
		end
		if math.random() < 0.3 and core then
			Fx.sparks(core.Position, 6, rgb(255, 170, 120))
		end
		Director.roll(math.sin(os.clock() * 30) * 0.004 * a)
	end, "in")
	Director.roll(0)
	-- 6) FIRE
	titan:pose(TITAN_POSES.fire, 12)
	play3D("Laser", titan.root.Position + Vector3.new(0, 20, 0))
	Fx.flash(rgb(255, 170, 140), 0.6, 0.05, 0.5)
	local beam = Fx.beam(if core then core.Position else titan.root.Position, chest.Position, 9, rgb(255, 80, 40))
	local firing = true
	task.spawn(function()
		while firing do
			beam.Set(if core then core.Position else titan.root.Position, chest.Position)
			Fx.sparks(chest.Position, 4, rgb(255, 170, 120))
			RunService.RenderStepped:Wait()
		end
		beam.Destroy()
	end)
	Director.shake(1.8, 1.6, 20)
	c.wait(1.4)
	firing = false
	Fx.explosion(chest.Position, 9, { sound = "ExplosionBig", smokeColor = rgb(10, 8, 12), waveColor = rgb(255, 230, 200), debris = 30 })
	bigBlackSmoke(chest.Position, 4)
	Fx.shockwave(chest.Position, 420, 1.4, rgb(255, 230, 200))
	Fx.dust(eye.Position - Vector3.new(0, 4, 0) + mv.LookVector * 60, 60, 160)
	if coreLight then
		coreLight.Brightness = 2
		coreLight.Range = 40
	end
	if core then
		core.Size = coreSize
	end
	entity:pose(ENTITY_POSES.hit, 8)
	c.wait(1.0)

	-- KNOCK-BACK (camera glitch like a Cameraman) ---------------------------
	Fx.flash(Color3.new(1, 1, 1), 1, 0.03, 1.2)
	Fx.glitch(4.5, 1)
	local static = loopSound("StaticLoop", camera())
	Fx.muffle(true)
	Audio.play("Tinnitus")
	Audio.play("BodyWhoosh")
	Director.freeLook(false)
	local back = -mv.LookVector
	local flyTo = CFrame.lookAt(eye.Position + back * 16 + Vector3.new(0, 5, 0), eye.Position + mv.LookVector * 30) * CFrame.Angles(0.6, 0.4, 1.6)
	local current = camera().CFrame
	Director.cut(current)
	Director.move(flyTo, 0.7, "out")
	c.check()
	local lyingPos = Vector3.new(eye.Position.X, 1.0, eye.Position.Z) + back * 22
	local lyingCF = CFrame.lookAt(lyingPos, lyingPos + mv.LookVector * 30 + Vector3.new(0, 14, 0)) * CFrame.Angles(0, 0, math.rad(78))
	Director.move(lyingCF, 0.35, "in")
	Audio.play("Thud")
	Fx.dust(lyingPos, 6, 30)
	Director.shake(1.6, 0.6)
	local blur = Lighting:FindFirstChild("Blur") :: BlurEffect?
	if blur then
		blur.Size = 12
		blur.Enabled = true
	end
	c.wait(1.8)
	-- Rick runs in and grabs Morty's hand
	local hatch = R.hatch
	setParts(hatch, { Transparency = 0, CanCollide = true })
	rick.follow = nil
	rick:pose("stand", 10)
	local rickNear = lyingPos + mv.LookVector * 3 + mv.RightVector * 1.5
	task.spawn(function()
		rick:walkTo(Vector3.new(rickNear.X, 3.36, rickNear.Z), 22, lyingPos)
	end)
	c.wait(1.4)
	rick:lookAt(lyingPos)
	c.say("Rick", { ru = "Морти! Вставай! Хватай меня за руку!", en = "Morty! Get up! Grab my hand!" }, { auto = 1.4, glitch = 0.35 })
	Dialogue.hide()
	stopLoop(static, 0.6)
	-- the drag to the bunker
	local hatchPos = (hatch:FindFirstChild("Lid") :: BasePart).Position
	rick:lookAt(nil)
	rick:pose("drag", 8)
	local dragging = true
	task.spawn(function()
		rick:walkTo(Vector3.new(hatchPos.X, 3.36, hatchPos.Z) + (Vector3.new(rickNear.X, 0, rickNear.Z) - Vector3.new(hatchPos.X, 0, hatchPos.Z)).Unit * 2, 6.5)
		dragging = false
	end)
	Director.track(function()
		local rr = rick.root.CFrame
		local behind = rr.Position - rr.LookVector * 3.4
		local camPos = Vector3.new(behind.X, 1.25 + math.abs(math.sin(os.clock() * 6)) * 0.25, behind.Z)
		return CFrame.lookAt(camPos, rr.Position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.sin(os.clock() * 3) * 0.08)
	end)
	if blur then
		task.spawn(function()
			animate(2, function(a)
				blur.Size = 12 - a * 8
			end)
		end)
	end
	task.spawn(function()
		while dragging and c.alive() do
			local rr = rick.root.CFrame
			local p = rr.Position + rr.LookVector * -(30 + math.random() * 40) + rr.RightVector * (math.random() - 0.5) * 60
			Fx.explosion(Vector3.new(p.X, 2, p.Z), 2 + math.random() * 2.5, { sound = "Explosion", smokeColor = rgb(14, 12, 16) })
			Director.shake(0.7, 0.4)
			task.wait(0.55 + math.random() * 0.4)
		end
	end)
	c.waitUntil(function()
		return not dragging
	end, 12)
	dragging = false
	Fx.fade(1, 0.4, true)
	if blur then
		blur.Enabled = false
		blur.Size = 0
	end
	Fx.stopGlitch()
	stopLoop(theme, 2)
	entityCloud(false)
end

----------------------------------------------------------------------------
-- public
----------------------------------------------------------------------------
function Story.init(a)
	api = a
	local house = api.house
	R.house = house
	R.seats = house:WaitForChild("Seats")
	R.phone = house:WaitForChild("Phone")
	R.doorModel = house:WaitForChild("Door")
	R.doorLeaf = R.doorModel:WaitForChild("Leaf")
	R.cast = workspace:WaitForChild("Cast")
	R.lab = workspace:WaitForChild("RickLab")
	R.garageSpots = R.lab:WaitForChild("GarageSpots")
	R.garage = workspace:WaitForChild("RickGarage")
	R.garageDoor = R.garage:WaitForChild("GarageDoor")
	R.saucer = workspace:WaitForChild("Saucer")
	R.saucerSpots = R.saucer:WaitForChild("Spots")
	R.planet = workspace:WaitForChild("Planet")
	R.spots = R.planet:WaitForChild("PlanetSpots")
	R.village = R.planet:WaitForChild("Village")
	R.bunker = R.planet:WaitForChild("Bunker")
	R.bunkerSpots = R.bunker:WaitForChild("BunkerSpots")
	R.hatch = R.bunker:WaitForChild("Hatch")
	R.bunkerRoom = R.bunker:WaitForChild("BunkerRoom")
	R.fight = R.planet:WaitForChild("Fight")
	R.titanModel = R.fight:WaitForChild("TitanSpeakerman")
	R.entityModel = R.fight:WaitForChild("Entity")
	R.hand = R.fight:WaitForChild("CurseHand")

	P.beth = Puppet.new(R.cast:WaitForChild("Beth"), "R6")
	P.jerry = Puppet.new(R.cast:WaitForChild("Jerry"), "R6")
	P.summer = Puppet.new(R.cast:WaitForChild("Summer"), "R6")
	P.rick = Puppet.new(R.cast:WaitForChild("Rick"), "R6")
	P.titan = Puppet.new(R.titanModel, "Rig")
	P.entity = Puppet.new(R.entityModel, "Rig")

	init.saucer = R.saucer:GetPivot()
	init.rick = P.rick.root.CFrame
	init.titan = P.titan.root.CFrame
	init.entity = P.entity.root.CFrame
	init.hand = R.hand:GetPivot()
	init.door = {}
	for _, d in R.doorLeaf:GetDescendants() do
		if d:IsA("BasePart") then
			init.door[d] = d.CFrame
		end
	end
	init.garageDoor = {}
	for _, d in R.garageDoor:GetDescendants() do
		if d:IsA("BasePart") then
			init.garageDoor[d] = d.CFrame
		end
	end
	familyAtBreakfast()
	P.rick:pose("stand")

	-- chapters 7-12 get the same tools
	StoryCurve.init({
		CH = CH,
		R = R,
		P = P,
		init = init,
		loops = loops,
		api = function()
			return api
		end,
		camera = camera,
		loopSound = loopSound,
		stopLoop = stopLoop,
		play3D = play3D,
		eyeFromHead = eyeFromHead,
		bezier = bezier,
		setParts = setParts,
		emitters = emitters,
		hingeRotate = hingeRotate,
		animate = animate,
		VM = VM,
		Radar = Radar,
		setDoor = setDoor,
		setGarageDoor = setGarageDoor,
		setPhoneOnNightstand = setPhoneOnNightstand,
		saucerTo = saucerTo,
		saucerThrust = saucerThrust,
		ensureDesert = ensureDesert,
		holdCharacterAt = holdCharacterAt,
		giveControl = giveControl,
		TITAN_POSES = TITAN_POSES,
		ENTITY_POSES = ENTITY_POSES,
		titanPart = titanPart,
		titanJets = titanJets,
		entityCloud = entityCloud,
		bigBlackSmoke = bigBlackSmoke,
	})

	-- puppets talk when their line is on screen
	Dialogue.setSpeakerCallback(function(who)
		for name, p in { Rick = P.rick, Beth = P.beth, Jerry = P.jerry, Summer = P.summer } do
			p.talking = (who == name)
		end
		StoryCurve.onSpeaker(who)
	end)
end

function Story.run(a, chapter: number)
	api = a
	runId += 1
	local id = runId
	local c = makeCtx(id)
	task.spawn(function()
		local ok, err = pcall(function()
			for ch = chapter, #CH do
				c.check()
				CH[ch](c, ch == chapter)
			end
		end)
		if not ok and err ~= CANCEL then
			warn("Story error:", err)
			-- don't leave the player stuck: go back to the menu
			if id == runId then
				Fx.fade(1, 0.5, true)
				api.toMenu()
			end
		end
	end)
end

function Story.stop()
	runId += 1
end

function Story.reset(_a)
	Director.stop()
	Dialogue.hide()
	Fx.clear()
	Fx.stopGlitch()
	Fx.speedLines(false)
	Fx.heat(0, 0)
	Fx.letterbox(false, 0)
	Fx.muffle(false)
	VM.setMode("hidden")
	VM.setHeat(0)
	Radar.show(false)
	Radar.holdProp(false)
	for _, s in loops do
		if s and s.Parent then
			s:Destroy()
		end
	end
	table.clear(loops)
	Audio.music(nil, 0.5)
	local blur = Lighting:FindFirstChild("Blur") :: BlurEffect?
	if blur then
		blur.Enabled = false
		blur.Size = 0
	end
	setPhoneOnNightstand(true)
	setDoor(false, true)
	setGarageDoor(false, true)
	saucerTo(init.saucer)
	saucerThrust(false)
	emitters(R.saucer, "CrashSmoke", false)
	for _, d in R.saucer:GetDescendants() do
		if d:IsA("Fire") then
			d.Enabled = false
		end
	end
	local rick = P.rick
	rick.follow = nil
	rick:place(init.rick)
	rick:pose("stand")
	rick.glitch = 0
	rick:lookAt(nil)
	rick:visible(true)
	familyAtBreakfast()
	P.titan.root.CFrame = init.titan
	P.titan:pose(TITAN_POSES.stand)
	titanJets(false)
	P.entity.root.CFrame = init.entity
	P.entity.extra = nil
	entityCloud(false)
	R.hand:PivotTo(init.hand)
	setParts(R.hand, { Transparency = 1 })
	setParts(R.hatch, { Transparency = 1, CanCollide = false })
	local shadow = R.village:FindFirstChild("WindowShadow") :: BasePart?
	if shadow then
		shadow.Transparency = 1
	end
	for _, lightName in { "KitchenSun", "KitchenLight", "BunkerEmergency", "SurgeryLight" } do
		Graphics.SetLight(lightName, false)
	end
	Scenes.setSpaceVisible(false)
	StoryCurve.reset()
	api.hideCharacter(true)
end

return Story
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6929">
        <Properties>
          <string name="Name">StoryCurve</string>
          <string name="Source"><![CDATA[--[[
	CHAPTERS 7-12: the Curve arc. Every line is written in Russian and English.
	  7  The bunker      - how to reach Evil Morty: the Central Finite Curve, Rick Prime, the Curve Bell
	  8  The Curve Bell  - the Silent dimension: three pylons, the bell rings, the sky cracks, Evil Morty
	  9  The hunt        - J-22 (upside down), D-716 (cubes), K-9 (mushrooms), back to B137:
	                       the signal is Rick. Tentacles. The chase. "YOU DON'T BELONG HERE."
	 10  The Alliance    - the army, the wounded Titan, the choice (the bunker = death), the virus
	 11  The camera base - friends Cam and Lens, Astro toilets teleport in, the mothership, the real Rick
	 12  Home            - "Blips and Chitz?" "No, Rick." Sleep. ...and after the credits: Rick Prime.
]]
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")

local Game = script.Parent
local Lang = require(Game.Lang)
local Audio = require(Game.Audio)
local Graphics = require(Game.Graphics)
local Fx = require(Game.Fx)
local Director = require(Game.Director)
local Dialogue = require(Game.Dialogue)
local Puppet = require(Game.Puppet)
local Scenes = require(Game.Scenes)

local StoryCurve = {}
local rgb = Color3.fromRGB
local R6 = Puppet.R6

local K: any = nil -- the tools Story hands over
local R: any, P: any = nil, nil
local W: { [string]: any } = {} -- world references
local S: { [string]: any } = { crowd = {}, conns = {}, portals = {}, loops = {} } -- undone by reset()
local start: { [string]: any } = {} -- where things live when unused

----------------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------------
local function api()
	return K.api()
end

local function say(c, who: string, ru: string, en: string, opts: any?)
	c.say(who, { ru = ru, en = en }, opts)
end

local function spot(folder: Instance, name: string): CFrame
	local m = folder:FindFirstChild(name)
	if m and m:IsA("BasePart") then
		return m.CFrame
	end
	warn("StoryCurve: missing spot " .. name)
	return CFrame.new()
end

-- a root marker (feet + 3) -> the eye of a standing Morty
local function eyeOf(rootCF: CFrame, h: number?): CFrame
	return CFrame.new(rootCF.Position + Vector3.new(0, h or 1.92, 0)) * rootCF.Rotation
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function near(pos: Vector3, r: number): boolean
	local root = api().root()
	if not root then
		return false
	end
	return flat(root.Position - pos).Magnitude <= r
end

local function waitNear(c, pos: Vector3, r: number, timeout: number?): boolean
	return c.waitUntil(function()
		return near(pos, r)
	end, timeout)
end

local function connect(sig: RBXScriptSignal, fn: (...any) -> ()): RBXScriptConnection
	local conn = sig:Connect(fn)
	table.insert(S.conns, conn)
	return conn
end

local function openPortal(cf: CFrame, kind: string?, d: number?)
	local h = Fx.portal(cf, kind, d)
	table.insert(S.portals, h)
	return h
end

local function closePortals()
	for _, h in S.portals do
		h.Close()
	end
	table.clear(S.portals)
end

local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
local function groundAt(pos: Vector3): number
	terrainOnly.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(Vector3.new(pos.X, 80, pos.Z), Vector3.new(0, -200, 0), terrainOnly)
	return if hit then hit.Position.Y else 0
end

local function partsWithAttr(model: Instance, attr: string): { BasePart }
	local out = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute(attr) ~= nil then
			table.insert(out, d)
		end
	end
	return out
end

local function loop(key: string, parent: Instance?, volume: number?, pitch: number?): Sound?
	local s = K.loopSound(key, parent)
	if s then
		if volume then
			s.Volume = volume
		end
		if pitch then
			s.PlaybackSpeed = pitch
		end
		s.Looped = true
	end
	return s
end

----------------------------------------------------------------------------
-- crowds (Cameramen, Speakermen, TV Men cloned from templates)
----------------------------------------------------------------------------
local function spawnAgent(kind: string, cf: CFrame, name: string?): any
	local t = W.templates and W.templates:FindFirstChild(kind)
	if not t then
		return nil
	end
	local m = t:Clone() :: Model
	m.Name = name or kind
	m:SetAttribute("Template", nil)
	m:PivotTo(cf)
	m.Parent = R.cast
	local p = Puppet.new(m, "R6")
	p.t = math.random() * 10
	table.insert(S.crowd, p)
	return p
end

local function clearCrowd()
	for _, p in S.crowd do
		p:destroy()
		if p.model then
			p.model:Destroy()
		end
	end
	table.clear(S.crowd)
	S.cam, S.lens, S.commander = nil, nil, nil
end

local AGENT_KINDS = { "Cameraman", "Speakerman", "TVMan" }

-- rows of agents in front of `center`, all facing `faceTo`
local function formation(center: Vector3, faceTo: Vector3, rows: number, cols: number, gap: number)
	local dir = flat(faceTo - center).Unit
	local right = dir:Cross(Vector3.yAxis)
	local out = {}
	for row = 0, rows - 1 do
		for col = 0, cols - 1 do
			local x = (col - (cols - 1) / 2) * gap + (if row % 2 == 1 then gap * 0.5 else 0)
			local p = center + right * x - dir * row * gap * 1.1
			local y = groundAt(p) + 3.45
			local pos = Vector3.new(p.X, y, p.Z)
			local kind = AGENT_KINDS[((row * cols + col) % 3) + 1]
			local a = spawnAgent(kind, CFrame.lookAt(pos, pos + dir))
			if a then
				table.insert(out, a)
			end
		end
	end
	return out
end

----------------------------------------------------------------------------
-- Evil Morty's two faces
----------------------------------------------------------------------------
local EVIL_ONLY = { "EvilLidL", "EvilBrowL", "EvilBrowR", "EvilSmirk", "EyeL", "PupilL", "Mouth" }
local function evilFace(neutral: boolean)
	local m = P.evil.model
	for _, n in EVIL_ONLY do
		local p = m:FindFirstChild(n, true)
		if p and p:IsA("BasePart") then
			p.Transparency = if neutral then 1 else 0
		end
	end
	for _, p in partsWithAttr(m, "NeutralFace") do
		p.Transparency = if neutral then 0 else 1
	end
	S.neutral = neutral
end

----------------------------------------------------------------------------
-- the Titan: extra poses, wounds, the curse's head in his hand, cannons
----------------------------------------------------------------------------
local TP = {}
TP.aimBoth = {
	ShoulderL = CFrame.Angles(1.45, 0, -0.08),
	ShoulderR = CFrame.Angles(1.45, 0, 0.08),
	ElbowL = CFrame.Angles(0.1, 0, 0),
	ElbowR = CFrame.Angles(0.1, 0, 0),
	Waist = CFrame.Angles(-0.1, 0, 0),
	HipL = CFrame.Angles(0.35, 0, -0.12),
	HipR = CFrame.Angles(-0.25, 0, 0.12),
	KneeL = CFrame.Angles(-0.45, 0, 0),
}
TP.holdHead = {
	ShoulderL = CFrame.Angles(0.75, 0, -0.25),
	ElbowL = CFrame.Angles(0.95, 0, 0),
	ShoulderR = CFrame.Angles(0.15, 0, 0.3),
	Waist = CFrame.Angles(0.05, 0.1, 0),
	KneeR = CFrame.Angles(-0.15, 0, 0),
}
TP.aimRight = {
	ShoulderR = CFrame.Angles(1.5, 0, 0.1),
	ElbowR = CFrame.Angles(0.05, 0, 0),
	ShoulderL = CFrame.Angles(0.75, 0, -0.25),
	ElbowL = CFrame.Angles(0.95, 0, 0),
	Waist = CFrame.Angles(-0.05, -0.2, 0),
	HipL = CFrame.Angles(0.3, 0, -0.1),
	KneeL = CFrame.Angles(-0.4, 0, 0),
}
TP.carry = {
	ShoulderL = CFrame.Angles(0.75, 0, -0.25),
	ElbowL = CFrame.Angles(0.95, 0, 0),
	ShoulderR = CFrame.Angles(0.2, 0, 0.45),
	HipL = CFrame.Angles(0.25, 0, -0.08),
	HipR = CFrame.Angles(0.1, 0, 0.08),
	KneeL = CFrame.Angles(-0.5, 0, 0),
	KneeR = CFrame.Angles(-0.35, 0, 0),
	AnkleL = CFrame.Angles(0.4, 0, 0),
	AnkleR = CFrame.Angles(0.3, 0, 0),
	Waist = CFrame.Angles(-0.25, 0, 0),
}

local function titanWounded(on: boolean)
	for _, d in R.titanModel:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("Damage") then
				d.Transparency = if on then 0 else 1
			end
			if d:GetAttribute("LeftCannon") then
				d.Transparency = if on then 1 else 0
			end
		elseif d:IsA("ParticleEmitter") and (d.Name == "Sparks" or d.Name == "Smoke") then
			d.Enabled = on
		elseif d:IsA("PointLight") and d.Name == "MuzzleLight" and d.Parent and d.Parent:GetAttribute("LeftCannon") then
			d.Enabled = not on
		end
	end
	S.wounded = on
end

local function muzzle(name: string): BasePart?
	return R.titanModel:FindFirstChild(name, true) :: BasePart?
end

-- glow the cannon muzzles (0..1)
local function cannonCharge(a: number)
	for _, g in partsWithAttr(R.titanModel, "TitanMuzzle") do
		local base = g:GetAttribute("BaseSize") or g.Size
		if not g:GetAttribute("BaseSize") then
			g:SetAttribute("BaseSize", g.Size)
		end
		g.Size = base * (1 + a * 0.8)
		local l = g:FindFirstChildOfClass("PointLight")
		if l then
			l.Brightness = 1.5 + a * 10
			l.Range = 26 + a * 24
		end
	end
end

local function holdCurseHead(on: boolean)
	if S.headConn then
		S.headConn:Disconnect()
		S.headConn = nil
	end
	local wisps = W.curseHead.PrimaryPart and W.curseHead.PrimaryPart:FindFirstChildOfClass("ParticleEmitter")
	if wisps then
		wisps.Enabled = on
	end
	if on then
		local hand = R.titanModel:FindFirstChild("HandL") :: BasePart?
		S.headConn = RunService.RenderStepped:Connect(function()
			if hand then
				local look = R.titanModel.PrimaryPart.CFrame.LookVector
				local pos = hand.Position + Vector3.new(0, 4.4, 0) + look * 1.5
				W.curseHead:PivotTo(CFrame.lookAt(pos, pos + flat(look)))
			end
		end)
	end
end

local function titanTo(cf: CFrame)
	P.titan.root.CFrame = cf * CFrame.new(0, 30.4, 0)
end

-- the Titan flies in along a curve and lands (yields)
local function titanLand(c, from: Vector3, groundCF: CFrame, dur: number)
	local titan = P.titan
	local standRoot = groundCF * CFrame.new(0, 30.4, 0)
	local mid = from:Lerp(standRoot.Position, 0.5) + Vector3.new(0, 60, 0)
	titan:pose(K.TITAN_POSES.fly, 6)
	titan:snap()
	titan.root.CFrame = CFrame.lookAt(from, mid)
	K.titanJets(true)
	local thruster = Audio.make("Thruster", titan.root)
	if thruster then
		thruster:Play()
	end
	local prev = from
	K.animate(dur, function(a)
		local pos = K.bezier(from, mid, standRoot.Position + Vector3.new(0, 12, 0), a)
		local dir = pos - prev
		prev = pos
		local look = if dir.Magnitude > 0.01 then dir.Unit else standRoot.LookVector
		titan.root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(look.X, look.Y * 0.4, look.Z)):Lerp(CFrame.new(pos) * standRoot.Rotation, math.clamp((a - 0.7) * 3.4, 0, 1))
		if a > 0.82 then
			titan:pose(K.TITAN_POSES.land, 10)
		end
	end, "out")
	c.check()
	K.titanJets(false)
	if thruster then
		Audio.fadeOut(thruster, 0.4, true)
	end
	local crouch = groundCF * CFrame.new(0, 30.4 - 7.2, 0)
	K.animate(0.25, function(a)
		titan.root.CFrame = (standRoot * CFrame.new(0, 12, 0)):Lerp(crouch, a)
	end, "in")
	K.play3D("RobotStomp", groundCF.Position)
	Audio.play("Boom", 0.9)
	Fx.dust(groundCF.Position, 34, 160)
	Fx.shockwave(groundCF.Position + Vector3.new(0, 2, 0), 46, 0.7, rgb(255, 190, 150))
	Director.shake(2.4, 1.2, 14)
	c.wait(0.6)
	titan:pose(K.TITAN_POSES.stand, 4)
	K.animate(1.0, function(a)
		titan.root.CFrame = crouch:Lerp(standRoot, a)
	end)
end

----------------------------------------------------------------------------
-- tentacle beasts
----------------------------------------------------------------------------
local function beastWiggle(p, speed: number)
	p.wiggle = speed
	p.extra = function(t, _dt)
		local sp = p.wiggle or 1
		local out = {}
		local n = p.model:GetAttribute("Tentacles") or 8
		for ti = 1, n do
			local legs = ti <= 4
			for k = 1, 6 do
				local ph = t * (2.5 + sp * 5) + ti * 1.9 + k * 0.7
				local amp = (if legs then 0.18 else 0.3) * (0.6 + sp * 0.4)
				out["T" .. ti .. "_" .. k] = CFrame.Angles(math.sin(ph) * amp, 0, math.cos(ph * 0.83) * amp * 0.8)
			end
		end
		out.Waist = CFrame.Angles(math.sin(t * 6 * sp) * 0.05, math.sin(t * 2.1) * 0.12, 0)
		return out
	end
end

local function pitWiggle(speed: number, reach: number)
	local p = P.pit
	p.extra = function(t, _dt)
		local out = {}
		for ti = 1, 5 do
			for k = 1, 7 do
				local ph = t * (3 + speed * 6) + ti * 1.3 + k * 0.8
				out["T" .. ti .. "_" .. k] = CFrame.Angles(math.sin(ph) * 0.35 + reach * 0.12, 0, math.cos(ph * 0.9) * 0.3)
			end
		end
		return out
	end
end

local function hideBeasts()
	for _, key in { "rickBeast", "evilBeast", "pit" } do
		local p = P[key]
		p.follow = nil
		p.extra = nil
		p.root.CFrame = start[key]
		K.emitters(p.model, "BlackCloud", false)
	end
	P.entity.root.CFrame = start.entity
	P.entity.extra = nil
	K.entityCloud(false)
end

----------------------------------------------------------------------------
-- the bunker shed (the fake one)
----------------------------------------------------------------------------
local function shedVisible(on: boolean)
	for _, d in W.shed:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("ShedPart") then
			d.Transparency = if on then 0 else 1
			d.CanCollide = on
		end
	end
	local sign = W.shed:FindFirstChild("Sign")
	local gui = sign and sign:FindFirstChildOfClass("SurfaceGui")
	if gui then
		gui.Enabled = on
	end
end

local function shedDoor(a: number)
	local door = W.shed:FindFirstChild("ShedDoor")
	if door and start.shedDoor then
		K.hingeRotate(start.shedDoor, door:GetAttribute("Hinge"), CFrame.Angles(0, a * math.rad(100), 0))
	end
end

----------------------------------------------------------------------------
-- the Silent dimension
----------------------------------------------------------------------------
local function pylonOn(model: Instance, on: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("PylonCrystal") then
				d.Material = if on then Enum.Material.Neon else Enum.Material.Glass
				d.Color = if on then rgb(140, 255, 180) else rgb(40, 80, 60)
			elseif d:GetAttribute("PylonPanel") then
				d.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
				d.Color = if on then rgb(140, 255, 180) else rgb(60, 120, 90)
			end
		elseif d:IsA("PointLight") and d.Name == "PylonLight" then
			d.Brightness = if on then 2.5 else 0
		end
	end
end

local function resetSilent()
	for i = 1, 3 do
		local py = W.silent:FindFirstChild("Pylon" .. i)
		if py then
			pylonOn(py, false)
		end
	end
	for _, p in partsWithAttr(W.cracks, "Crack") do
		p.Transparency = 1
	end
	for _, p in partsWithAttr(W.bell, "BellRing") do
		p.Transparency = 1
	end
	for _, p in partsWithAttr(W.bell, "BellCone") do
		p.Color = rgb(150, 40, 24)
	end
	for part, cf in start.prongs or {} do
		part.CFrame = cf
	end
end

----------------------------------------------------------------------------
-- companions who follow Morty around
----------------------------------------------------------------------------
local function follow(p, side: number, speed: number)
	p.follow = function(dt)
		local cur = p.root.CFrame
		local root = api().root()
		if not root then
			return cur
		end
		local rc = root.CFrame
		local target = rc.Position + rc.RightVector * (side * 3.4) - rc.LookVector * 3.2
		local delta = flat(target - cur.Position)
		local dist = delta.Magnitude
		if dist < 1.4 then
			p.walk = 0
			local look = flat(rc.LookVector)
			if look.Magnitude < 0.01 then
				return cur
			end
			return cur:Lerp(CFrame.lookAt(cur.Position, cur.Position + look), math.min(1, dt * 4))
		end
		p.walk = 1
		p.walkSpeed = speed
		local step = math.min(dist, (speed + math.max(0, dist - 6) * 1.6) * dt)
		local newPos = cur.Position + delta.Unit * step
		return CFrame.lookAt(newPos, newPos + delta)
	end
end

local function stopFollow(p)
	p.follow = nil
	p.walk = 0
end

----------------------------------------------------------------------------
-- small shared beats
----------------------------------------------------------------------------
local function arriveIn(c, folder: Instance, scene: string, caption: string, withEvil: boolean)
	Fx.black(1)
	local arrive = spot(folder, "Arrive")
	K.holdCharacterAt(c, arrive)
	api().hideCharacter(true)
	Scenes.apply(scene, true)
	local rick = P.rick
	rick.follow = nil
	rick:visible(true)
	rick:place(spot(folder, "RickArrive"))
	rick:pose("stand")
	rick:snap()
	if withEvil then
		local evil = P.evil
		evil.follow = nil
		evil:visible(true)
		evil:place(spot(folder, "EvilArrive"))
		evil:pose("stand")
		evil:snap()
	end
	local portal = openPortal(spot(folder, "Portal"), "green", 9)
	Director.start()
	Director.cut(eyeOf(arrive), 70)
	Director.freeLook(true, { yaw = 1.4, pitchUp = 0.8, pitchDown = 0.6 })
	Audio.play("Whoosh")
	Fx.flash(rgb(200, 255, 200), 0.8, 0.02, 0.6)
	Fx.fade(0, 0.5)
	Fx.caption(caption)
	task.delay(1.4, function()
		portal.Close()
	end)
	return arrive
end

-- a portal out: Rick + Evil Morty walk in, then the player (yields until the player is through)
local function leaveThrough(c, cf: CFrame, kind: string?)
	local portal = openPortal(cf, kind or "green", 9)
	local pos = cf.Position
	local ground = Vector3.new(pos.X, 0, pos.Z)
	for _, p in { P.rick, P.evil } do
		if p.root.Position.Y > -100 then
			stopFollow(p)
			task.spawn(function()
				p:walkTo(Vector3.new(ground.X, p.root.Position.Y, ground.Z), 10)
				p:visible(false)
			end)
		end
	end
	api().objective("obj.portal")
	waitNear(c, pos, 3.4, 40)
	api().objective(nil)
	Audio.play("Whoosh")
	Fx.flash(rgb(200, 255, 200), 1, 0.05, 0.4)
	Fx.fade(1, 0.25, true)
	portal.Close()
	api().gameplay(false)
	api().freeze(true)
end

-- Rick checks the radar (yields)
local function radarCheck(c, lines: { any }, blipX: number, blipY: number, blipOn: boolean)
	local rick = P.rick
	stopFollow(rick)
	rick:lookAt(nil)
	rick:pose("holdRadar", 8)
	K.Radar.holdProp(true)
	Audio.play("Servo", 1.6)
	c.wait(0.6)
	K.Radar.show(true, lines)
	K.Radar.setBlip(blipX, blipY, blipOn)
end

local function radarDone()
	K.Radar.show(false)
	K.Radar.holdProp(false)
	P.rick:pose("stand", 8)
end

----------------------------------------------------------------------------
-- CHAPTER 7: The bunker - the plan
----------------------------------------------------------------------------
local function ch7(c, _fresh: boolean)
	api().state("story")
	api().gameplay(false)
	Fx.black(1)
	local rick = P.rick
	local spots = R.bunkerSpots
	local seat = spots.MortySeat.CFrame
	K.holdCharacterAt(c, seat)
	Scenes.apply("Bunker", true)
	Fx.muffle(false)
	rick.follow = nil
	rick:visible(true)
	rick:place(spots.RickSeat.CFrame)
	rick:pose("sit", 10)
	rick:snap()
	rick.glitch = 0.25
	local eye = spots.MortyEye.CFrame
	rick:lookAt(eye.Position)
	Director.start()
	Director.cut(eye, 70)
	Director.freeLook(true, { yaw = 1.4, pitchUp = 0.6, pitchDown = 0.9 })
	local room = R.bunkerRoom
	local tbl = room:FindFirstChild("BunkerTable")
	local map = tbl and tbl:FindFirstChild("Map") :: BasePart?
	local label = map and map:FindFirstChild("TargetLabel", true) :: TextLabel?
	if label then
		label.Text = Lang.t("map.target")
	end
	Audio.music("MusicBunker", 4)
	Fx.title("ch.7")
	c.check()
	Fx.fade(0, 1.6)

	-- bombs falling up above: the lamp swings, dust rains down
	local lamp = room:FindFirstChild("HangingLamp")
	local lampInit: { [BasePart]: CFrame } = {}
	if lamp then
		for _, d in lamp:GetDescendants() do
			if d:IsA("BasePart") then
				lampInit[d] = d.CFrame
			end
		end
	end
	local swing = 0
	local pivot = if lamp then lamp:GetAttribute("Pivot") else nil
	local dust = room:FindFirstChild("DustSource")
	local dustEmitter = dust and dust:FindFirstChildOfClass("ParticleEmitter")
	local function boom(strength: number)
		Audio.play("MuffledBoom", 0.8 + math.random() * 0.4)
		Director.shake(0.5 * strength, 0.9)
		swing += 0.18 * strength
		if dustEmitter then
			dustEmitter:Emit(math.floor(30 * strength))
		end
		Audio.play("DustFall", 1 + math.random() * 0.2)
		Graphics.SetLight("BunkerLamp", false)
		Graphics.SetLight("BunkerEmergency", true, { Brightness = 1.6 })
		task.delay(0.08 + math.random() * 0.12, function()
			Graphics.SetLight("BunkerLamp", true)
		end)
		task.delay(0.6, function()
			Graphics.SetLight("BunkerEmergency", false)
		end)
	end
	local bombing = true
	task.spawn(function()
		local t = 0
		while bombing and c.alive() do
			local dt = RunService.RenderStepped:Wait()
			t += dt
			swing *= math.exp(-dt * 0.5)
			if pivot then
				local a = math.sin(t * 2.2) * swing
				K.hingeRotate(lampInit, pivot, CFrame.Angles(a, 0, a * 0.6))
			end
		end
		if lamp then
			for part, cf in lampInit do
				part.CFrame = cf
			end
		end
	end)
	task.spawn(function()
		while bombing and c.alive() do
			task.wait(5 + math.random() * 3)
			if bombing and c.alive() then
				boom(1)
			end
		end
	end)

	c.wait(1)
	say(c, "Morty", "Рик... что это было? Тот робот... с колонками вместо головы?", "Rick... what was that? That robot... with speakers for a head?")
	say(c, "Rick", "Титан Спикермен. Версия два-ноль. Если он здесь — дело дрянь.", "Titan Speakerman. Version two-point-oh. If he's here, things are bad.", { glitch = 0.2 })
	say(c, "Rick", "А та штука в дыму... Морти, проклятие — это не просто неудача. За ним кто-то стоит.", "And that thing in the smoke... Morty, the curse isn't just bad luck. Someone's behind it.", { glitch = 0.3 })
	-- Rick points at the map
	rick:pose({
		["Right Hip"] = R6.leg(1, 1.57),
		["Left Hip"] = R6.leg(-1, 1.57),
		["Right Shoulder"] = R6.arm(1, 1.3, 0.1),
		RootJoint = R6.root(0.25),
	}, 8)
	Director.freeLook(false)
	if map then
		Director.move(CFrame.lookAt(eye.Position, map.Position), 1.0)
	end
	say(c, "Rick", "Злой Морти. Только он знает, что творится за краем.", "Evil Morty. He's the only one who knows what's out past the edge.", { glitch = 0.15 })
	boom(1.6)
	say(c, "Morty", "Злой Морти?! Но как нам до него добраться?", "Evil Morty?! How do we even get to him?")
	rick:pose("sit", 8)
	Director.move(eye, 1.0)
	Director.freeLook(true)
	say(c, "Rick", "Он сидит снаружи Центральной Конечной Кривой. Туда просто так не попасть.", "He's sitting outside the Central Finite Curve. You don't just walk out there.", { glitch = 0.2 })
	say(c, "Morty", "Центральной... чего?", "The Central... what?")
	say(c, "Rick", "Ладно, урок. Мультивселенная бесконечна, Морти. Бесконечно много миров.", "Okay, lesson time. The multiverse is infinite, Morty. Infinitely many worlds.", { glitch = 0.15 })
	say(c, "Rick", "Но мы, Рики, вырезали из неё кусок. Только те миры, где Рик — самый умный во вселенной. И обнесли их стеной.", "But we Ricks cut a piece out of it. Only the worlds where Rick is the smartest being in the universe. And we walled them in.", { glitch = 0.2 })
	say(c, "Rick", "Это и есть Центральная Конечная Кривая. Огромный загон для Риков. А снаружи — всё остальное.", "That's the Central Finite Curve. A giant pen for Ricks. And outside it: everything else.", { glitch = 0.2 })

	-- Morty dozes off while Rick lectures
	Fx.muffle(true)
	task.spawn(api().lids, 0.22, 3.2)
	Director.move(eye * CFrame.Angles(math.rad(-16), 0, math.rad(4)), 3.4, "smooth", nil, true)
	say(c, "Rick", "...стенка держится на резонансе... частота... гармоники... бла-бла-бла...", "...the wall runs on resonance... frequency... harmonics... blah blah blah...", { auto = 1.2, glitch = 0.35 })
	say(c, "Rick", "...и вот тогда мы с Риком Праймом...", "...and that's when Rick Prime and I...", { auto = 0.6, glitch = 0.2 })
	Dialogue.hide()
	-- ...and he's awake
	Fx.muffle(false)
	api().lids(1, 0.12)
	Audio.play("Gasp")
	Director.move(eye, 0.2)
	Director.shake(0.4, 0.3)
	boom(1.2)
	say(c, "Morty", "РИК ПРАЙМ?!", "RICK PRIME?!")
	say(c, "Rick", "О, проснулся. Да. Мы с ним однажды уже трясли эту стенку. Давно. Когда были... почти друзьями.", "Oh, now you're awake. Yeah. He and I rattled that wall once. Long ago. Back when we were... almost friends.", { glitch = 0.25 })
	say(c, "Rick", "Мы нашли её частоту. Если ударить по кривой правильным звуком — она звенит, как колокол. И её слышат все, кто за ней.", "We found its frequency. Hit the curve with the right sound and it rings like a bell. Everyone outside hears it.", { glitch = 0.2 })
	say(c, "Morty", "И Злой Морти услышит?", "And Evil Morty will hear it?")
	say(c, "Rick", "Это его стена, Морти. Конечно, услышит. И придёт посмотреть, кто по ней стучит.", "It's his wall now, Morty. Of course he'll hear it. And he'll come see who's knocking.", { glitch = 0.2 })
	say(c, "Morty", "А чем мы по ней ударим? У нас нет колокола.", "And what do we hit it with? We don't have a bell.")
	-- the Titan's speaker on the table
	local prop = Fx.part({ Size = Vector3.new(1.6, 1.6, 0.9), Color = rgb(18, 18, 20), Material = Enum.Material.Metal })
	local cone = Fx.part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 1.2, 1.2), Color = rgb(255, 64, 28), Material = Enum.Material.Neon })
	if map then
		local base = map.CFrame * CFrame.new(0.6, 0.8, -0.2) * CFrame.Angles(0, math.rad(160), 0)
		prop.CFrame = base
		cone.CFrame = base * CFrame.new(0, 0, -0.46) * CFrame.Angles(0, math.rad(90), 0)
	end
	local glow = Instance.new("PointLight")
	glow.Color = rgb(255, 70, 30)
	glow.Range = 8
	glow.Brightness = 1.5
	glow.Parent = cone
	Audio.play("Clink", 0.6)
	if map then
		Director.move(CFrame.lookAt(eye.Position, prop.Position), 0.8)
	end
	say(c, "Rick", "Есть. Кусок колонки Титана. Подобрал, пока ты валялся в песке. Самый громкий динамик в мультивселенной.", "We do. A chunk of the Titan's speaker. Grabbed it while you were lying in the sand. The loudest speaker in the multiverse.", { glitch = 0.2 })
	say(c, "Rick", "Сделаем из него Колокол Кривой. Но звонить надо в полной тишине. Там, где нет ни одного звука.", "We'll turn it into a Curve Bell. But you have to ring it in total silence. Somewhere with no sound at all.", { glitch = 0.2 })
	say(c, "Morty", "И где такое место?", "And where's a place like that?")
	-- Rick gets up and opens a portal
	Director.move(eye, 0.8)
	local y0 = seat.Position.Y - 2.7
	local center = Vector3.new(seat.Position.X, y0, seat.Position.Z - 3.6)
	local portalCF = CFrame.lookAt(center + Vector3.new(-8.6, 3.6, 0), center + Vector3.new(0, 3.6, 0))
	rick:pose("stand", 8)
	rick:place(CFrame.lookAt(center + Vector3.new(-2.5, 3.36, -3.6), center + Vector3.new(-8, 3.36, 0)))
	Audio.play("Click")
	local portal = openPortal(portalCF, "green", 7.5)
	say(c, "Rick", "Тихое измерение. Пошли, Морти. И постарайся не шуметь. *рыг*", "The Silent dimension. Let's go, Morty. And try not to make a sound. *burp*", { glitch = 0.25 })
	Audio.play("Burp")
	Dialogue.hide()
	task.spawn(function()
		rick:walkTo(Vector3.new(portalCF.Position.X + 0.5, center.Y + 3.36, portalCF.Position.Z), 7)
		rick:visible(false)
	end)
	-- Morty walks in himself
	Director.freeLook(false)
	local standPos = Vector3.new(center.X + 1.8, y0 + 3, center.Z + 3.6)
	K.giveControl(c, CFrame.lookAt(standPos, Vector3.new(portalCF.Position.X, standPos.Y, portalCF.Position.Z)))
	api().objective("obj.portal")
	waitNear(c, portalCF.Position, 2.6, 45)
	api().objective(nil)
	bombing = false
	Audio.play("Whoosh")
	Fx.flash(rgb(220, 255, 220), 1, 0.05, 0.4)
	Fx.fade(1, 0.25, true)
	portal.Close()
	prop:Destroy()
	cone:Destroy()
	api().gameplay(false)
	api().freeze(true)
	Audio.music(nil, 0.4)
end

----------------------------------------------------------------------------
-- CHAPTER 8: The Curve Bell
----------------------------------------------------------------------------
local function bellBong(strength: number)
	local B = spot(W.silentSpots, "Bell").Position
	Audio.play("Clink", 0.22)
	Audio.play("Boom", 0.55)
	K.play3D("SonicBoom", B + Vector3.new(0, 30, 0), 0.6)
	Fx.shockwave(B + Vector3.new(0, 20, 0), 180 + strength * 120, 1.6 + strength, rgb(235, 245, 255))
	Fx.flash(Color3.new(1, 1, 1), 0.25 + strength * 0.35, 0.03, 0.9)
	Director.shake(0.6 + strength * 1.2, 1.4 + strength, 18)
	-- the prongs shiver
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 2.4 do
			local k = 1 - (os.clock() - t0) / 2.4
			for part, cf in start.prongs or {} do
				local sx = part:GetAttribute("BellProng") or 1
				part.CFrame = cf * CFrame.new(sx * math.sin(os.clock() * 70) * 0.35 * k * strength, 0, 0)
			end
			RunService.RenderStepped:Wait()
		end
		for part, cf in start.prongs or {} do
			part.CFrame = cf
		end
	end)
end

local function crackSky(c, upTo: number)
	-- show crack segments in order of their number (k * 10 + branch)
	local list = partsWithAttr(W.cracks, "Crack")
	table.sort(list, function(a, b)
		return a:GetAttribute("Crack") < b:GetAttribute("Crack")
	end)
	local level = -1
	for _, p in list do
		local n = p:GetAttribute("Crack")
		if n <= upTo and p.Transparency > 0.5 then
			p.Transparency = 0
			local k = math.floor(n / 10)
			if k ~= level then
				level = k
				Audio.play("Glitch2", 0.45 + k * 0.05)
				Director.shake(0.25, 0.3)
			end
			task.wait(0.035)
			c.check()
		end
	end
end

local function ch8(c, _fresh: boolean)
	api().state("story")
	api().gameplay(false)
	Audio.music(nil, 0.3)
	resetSilent()
	P.evil:place(start.evil)
	evilFace(false)
	P.evil.glitch = 0
	local sp = W.silentSpots
	local arrive = arriveIn(c, sp, "Silent", "loc.silent", false)
	local rick = P.rick
	rick.glitch = 0.3
	Fx.title("ch.8")
	c.check()
	say(c, "Morty", "Тут... так тихо. Я слышу, как у меня сердце стучит.", "It's... so quiet here. I can hear my own heartbeat.")
	say(c, "Rick", "Тихое измерение S-0. Тут нет ни одного звука, кроме тех, что ты принёс с собой.", "Silent dimension S-0. There's not a single sound here except the ones you bring along.", { glitch = 0.2 })
	local bellPos = spot(sp, "Bell").Position
	Director.freeLook(false)
	Director.move(CFrame.lookAt(eyeOf(arrive).Position, bellPos + Vector3.new(0, 28, 0)), 1.4)
	say(c, "Rick", "Идеальное место, чтобы позвонить в кривую. Знакомься — Колокол Кривой.", "The perfect place to ring the curve. Meet the Curve Bell.", { glitch = 0.15 })
	say(c, "Morty", "Это же... гигантский камертон! С колонкой Титана посередине!", "That's... a giant tuning fork! With the Titan's speaker in the middle!")
	say(c, "Rick", "Собрал за ночь. Ну, почти за ночь. Включи три пилона вокруг, а я настрою частоту.", "Built it overnight. Well, almost overnight. Switch on the three pylons around it, I'll tune the frequency.", { glitch = 0.25 })
	Dialogue.hide()
	local consoleCF = spot(sp, "RickConsole")
	task.spawn(function()
		rick:walkTo(consoleCF.Position, 9, consoleCF.Position + consoleCF.LookVector * 5)
	end)
	K.giveControl(c, arrive, CFrame.lookAt(eyeOf(arrive).Position, bellPos + Vector3.new(0, 10, 0)))
	api().objective("obj.pylons")
	local done = 0
	local activated = {}
	while done < 3 do
		local model = c.interact("Pylon")
		local idx = model:GetAttribute("Index")
		if idx and not activated[idx] then
			activated[idx] = true
			done += 1
			pylonOn(model, true)
			Audio.play("Electric", 1.2)
			Audio.play("Switch")
			local crystal = model:FindFirstChild("Crystal") :: BasePart?
			if crystal then
				Fx.sparks(crystal.Position, 24, rgb(160, 255, 190))
				Fx.sonicRing(CFrame.lookAt(crystal.Position, bellPos + Vector3.new(0, 9, 0)), (bellPos - crystal.Position).Magnitude, 0.8, 3, rgb(140, 255, 180))
			end
			api().objective({ ru = ("Включи три пилона (%d/3)"):format(done), en = ("Switch on the three pylons (%d/3)"):format(done) })
			if done == 1 then
				say(c, "Rick", "Есть один! Чувствуешь, как воздух дрожит? Это кривая чешется.", "That's one! Feel the air trembling? That's the curve getting itchy.", { auto = 1.6, glitch = 0.2 })
			elseif done == 2 then
				say(c, "MortyThought", "Почему Рик так глючит? Даже здесь, где ничего нет...", "Why is Rick glitching so much? Even here, where there's nothing at all...", { auto = 2 })
			end
			Dialogue.hide()
		end
	end
	api().objective("obj.rickBell")
	waitNear(c, consoleCF.Position, 12, 60)
	api().objective(nil)
	api().gameplay(false)
	api().freeze(true)
	api().hideCharacter(true)

	-- RING THE BELL ---------------------------------------------------------------
	local watch = spot(sp, "MortyWatch")
	local watchEye = CFrame.lookAt(eyeOf(watch).Position, bellPos + Vector3.new(0, 30, 0))
	Director.start()
	Director.move(watchEye, 1.4, "smooth", 70)
	rick:lookAt(bellPos + Vector3.new(0, 10, 0))
	say(c, "Rick", "Частота... есть. Морти, закрой уши. Хотя нет. Не поможет.", "Frequency... locked. Morty, cover your ears. Actually no. It won't help.", { glitch = 0.3 })
	Dialogue.hide()
	local cone = partsWithAttr(W.bell, "BellCone")[1]
	local ring = partsWithAttr(W.bell, "BellRing")[1]
	K.play3D("ChargeLong", bellPos, 0.8)
	K.animate(2.2, function(a)
		if cone then
			cone.Color = Color3.fromRGB(150, 40, 24):Lerp(Color3.fromRGB(255, 120, 70), a)
		end
		if ring then
			ring.Transparency = 1 - a * 0.85
		end
		Director.roll(math.sin(os.clock() * 40) * 0.003 * a)
	end, "in")
	Director.roll(0)
	c.check()
	bellBong(0.6)
	c.wait(2.2)
	say(c, "Morty", "О-ОНО РАБОТАЕТ?!", "I-IS IT WORKING?!", { auto = 0.8 })
	Dialogue.hide()
	bellBong(1)
	Scenes.apply("SilentCrack")
	-- the sky cracks
	Director.move(CFrame.lookAt(watchEye.Position, Vector3.new(bellPos.X, 175, bellPos.Z - 390)), 1.2, "smooth", 62)
	crackSky(c, 39)
	c.wait(1.2)
	bellBong(1.4)
	crackSky(c, 99)
	Fx.glitch(0.8, 0.5)
	Audio.music("MusicEerie", 3)
	say(c, "Rick", "Есть! Кривая трещит! Её сейчас слышит каждый Рик в мультивселенной!", "Yes! The curve is cracking! Every Rick in the multiverse can hear it right now!", { auto = 1.4, glitch = 0.4 })
	Dialogue.hide()
	-- someone comes through
	local core = partsWithAttr(W.cracks, "Crack")
	for _, p in core do
		if p:GetAttribute("Crack") == 0 then
			p.Transparency = 0
		end
	end
	c.wait(0.8)
	local evilPortal = openPortal(spot(sp, "EvilPortal"), "white", 8)
	Director.move(CFrame.lookAt(watchEye.Position, spot(sp, "EvilPortal").Position), 1.0, "smooth", 60)
	local evil = P.evil
	evil:visible(true)
	evil:place(spot(sp, "EvilPortal") * CFrame.new(0, -3, 0))
	evil:pose("stand")
	evil:snap()
	local evilSpot = spot(sp, "EvilArrive")
	evil:walkTo(evilSpot.Position, 5, watchEye.Position)
	evilPortal.Close()
	evil:lookAt(watchEye.Position)
	Director.track(function()
		local head = evil.model:FindFirstChild("Head") :: BasePart?
		return CFrame.lookAt(watchEye.Position, if head then head.Position else evilSpot.Position)
	end)
	Director.fov(48, 1.5)
	say(c, "EvilMorty", "Кто стучит в мою стену?", "Who's knocking on my wall?")
	say(c, "Morty", "Э-это мы! То есть... привет. Злой Морти.", "I-it's us! I mean... hi. Evil Morty.")
	say(c, "EvilMorty", "Не называй меня так.", "Don't call me that.")
	evil:lookAt(rick.root.Position + Vector3.new(0, 1.5, 0))
	say(c, "EvilMorty", "Рик. Ну конечно. Кто ещё станет ломать кривую ради собственной шкуры.", "Rick. Of course. Who else would crack the curve to save his own skin.")
	say(c, "Rick", "Не ради своей. Ради шкуры Морти. За нами охотится проклятие.", "Not mine. Morty's. A curse is hunting us.", { glitch = 0.3 })
	evil:lookAt(watchEye.Position)
	say(c, "EvilMorty", "Это не проклятие. Я видел его снаружи кривой. Оно не из нашей мультивселенной.", "It's not a curse. I've seen it outside the curve. It's not from our multiverse.")
	say(c, "EvilMorty", "Оно ходит между мирами и ищет самого умного. Питается неудачей. Ломает тебе жизнь — и растёт.", "It walks between worlds looking for the smartest one around. It feeds on bad luck. It wrecks your life, and it grows.")
	say(c, "EvilMorty", "А потом надевает твоё лицо.", "And then it puts on your face.")
	say(c, "Morty", "Н-надевает... лицо?!", "P-puts on... your face?!")
	say(c, "EvilMorty", "Чтобы его убить, нужно найти, где оно прячется. Оно всегда прячется у всех на виду.", "To kill it, you have to find where it hides. It always hides in plain sight.")
	-- Rick glitches hard... and Evil Morty notices
	say(c, "Rick", "Отлично. Найдём, убьём, закроем дыру, и все р-р-р-расходятся по д-д-домам.", "Great. We find it, we kill it, we patch the hole and everyone g-g-g-goes h-h-home.", { glitch = 0.9 })
	rick.glitch = 1
	Fx.glitch(0.5, 0.35)
	Audio.play("Glitch3", 0.9)
	c.wait(0.7)
	rick.glitch = 0.35
	evil:lookAt(rick.root.Position + Vector3.new(0, 1.6, 0))
	local head = evil.model:FindFirstChild("Head") :: BasePart?
	if head then
		local face = head.CFrame * CFrame.new(0, 0.1, -3.2)
		Director.move(CFrame.lookAt(face.Position, head.Position), 0.5, "out", 40)
	end
	c.wait(0.5)
	evilFace(true)
	Audio.play("Glitch1", 0.6)
	c.wait(1.6)
	evil.glitch = 0.14
	c.wait(0.6)
	Director.move(CFrame.lookAt(watchEye.Position, if head then head.Position else evilSpot.Position), 0.6, "smooth", 50)
	evil:lookAt(watchEye.Position)
	say(c, "Morty", "Эй... Всё хорошо?", "Hey... Is everything okay?")
	say(c, "EvilMorty", "Не твоё дело.", "None of your business.")
	c.wait(0.4)
	say(c, "EvilMorty", "Я иду с вами. Хочу увидеть эту тварь своими глазами. Ну... своим глазом.", "I'm coming with you. I want to see this thing with my own eyes. Well... my own eye.")
	say(c, "Rick", "Тогда в путь. Радар найдёт её в одном из миров. Наверное.", "Then let's go. The radar will find it in one of the worlds. Probably.", { glitch = 0.3 })
	Dialogue.hide()
	Director.fov(70, 1)
	local out = openPortal(CFrame.lookAt(watch.Position + Vector3.new(-8, 3, -10), watch.Position + Vector3.new(0, 3, 0)), "green", 9)
	Audio.play("Click")
	c.wait(1.2)
	Fx.fade(1, 0.6, true)
	out.Close()
	Audio.music(nil, 1)
end

----------------------------------------------------------------------------
-- CHAPTER 9: The hunt
----------------------------------------------------------------------------
local function worldJ22(c)
	local sp = W.j22:FindFirstChild("J22Spots")
	local rain = W.j22:FindFirstChild("RainSource")
	local rainEmitter = rain and rain:FindFirstChildOfClass("ParticleEmitter")
	if rainEmitter then
		rainEmitter.Enabled = true
	end
	local arrive = arriveIn(c, sp, "Upside", "loc.j22", true)
	Audio.music("MusicEerie", 2)
	c.wait(1.2)
	say(c, "Rick", "J-22. Тут всё вверх ногами.", "J-22. Everything here is upside down.", { glitch = 0.2 })
	Director.freeLook(false)
	Director.move(CFrame.lookAt(eyeOf(arrive).Position, eyeOf(arrive).Position + Vector3.new(-10, 18, -40)), 1.2)
	say(c, "Morty", "Рик... а почему дождь идёт ВВЕРХ?!", "Rick... why is the rain falling UP?!")
	say(c, "Rick", "Потому что тут «вверх» — это «вниз», Морти. Не задавай вопросов, ответы тебе не понравятся.", "Because up here is down, Morty. Don't ask questions you don't want the answers to.", { glitch = 0.2 })
	say(c, "EvilMorty", "Проверь радар, Рик. Я не собираюсь торчать в этом мире.", "Check the radar, Rick. I'm not hanging around in this world.")
	Director.move(eyeOf(arrive), 0.8)
	radarCheck(c, { "radar.search", "radar.signal", "radar.none", "radar.where", "radar.glitch" }, 0.5, 0.5, false)
	say(c, "Rick", "Пусто. Хм. Пройдёмся по улице, может, оно залезло в какой-нибудь дом.", "Nothing. Hm. Let's walk down the street, maybe it crawled into one of the houses.", { glitch = 0.2 })
	radarDone()
	Dialogue.hide()
	Director.freeLook(false)
	K.giveControl(c, arrive)
	follow(P.rick, 1, 8)
	follow(P.evil, -1, 8)
	api().objective("obj.explore")
	local walk = spot(sp, "Walk")
	waitNear(c, walk.Position, 8, 50)
	api().objective(nil)
	-- a voice from an upside-down house
	K.play3D("Thud", walk.Position + Vector3.new(-28, 14, 0), 0.8)
	say(c, "Unknown", "ЭЙ! А ну не топчите наш потолок!", "HEY! Stop stomping on our ceiling!", { auto = 1.4 })
	say(c, "Morty", "П-простите!", "S-sorry!", { auto = 1 })
	say(c, "Rick", "Местные. Живут на потолке и ругаются на всех, кто ходит по полу. Классика.", "Locals. They live on the ceiling and yell at anyone walking on the floor. Classic.", { auto = 2, glitch = 0.2 })
	say(c, "EvilMorty", "Его здесь нет. Дальше.", "It's not here. Next.", { auto = 1.4 })
	Dialogue.hide()
	leaveThrough(c, spot(sp, "PortalOut"))
	if rainEmitter then
		rainEmitter.Enabled = false
	end
end

local function worldD716(c)
	local sp = W.d716:FindFirstChild("D716Spots")
	local arrive = arriveIn(c, sp, "Cube", "loc.d716", true)
	Audio.music("MusicLofi", 2)
	c.wait(1.2)
	say(c, "Rick", "D-716. Тут всё из кубов. Даже солнце. Особенно солнце.", "D-716. Everything here is made of cubes. Even the sun. Especially the sun.", { glitch = 0.2 })
	say(c, "Morty", "А почему коровы квадратные?", "And why are the cows square?")
	say(c, "Rick", "Потому что круглые коровы — это физика, Морти. А здесь — геометрия.", "Because round cows are physics, Morty. This place is geometry.", { glitch = 0.15 })
	Dialogue.hide()
	Director.freeLook(false)
	K.giveControl(c, arrive)
	follow(P.rick, 1, 8)
	follow(P.evil, -1, 8)
	api().objective("obj.cow")
	local cowSpot = spot(sp, "CowTalk")
	waitNear(c, cowSpot.Position, 9, 60)
	api().objective(nil)
	-- the nearest cow turns to Morty
	local cow: Model? = nil
	local best = math.huge
	for _, m in W.d716:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("Cow") then
			local d = (m:GetPivot().Position - cowSpot.Position).Magnitude
			if d < best then
				best = d
				cow = m
			end
		end
	end
	local root = api().root()
	if cow and root then
		-- the cow's head is on its -Z side: point -Z at Morty
		local from = cow:GetPivot()
		local to = CFrame.lookAt(from.Position, Vector3.new(root.Position.X, from.Position.Y, root.Position.Z))
		task.spawn(K.animate, 0.6, function(a)
			cow:PivotTo(from:Lerp(to, a))
		end)
	end
	K.play3D("RobotVoice", cowSpot.Position, 0.5)
	say(c, "Cow", "МУ.", "MOO.", { auto = 1 })
	say(c, "Morty", "...Э-э, привет?", "...Uh, hi?")
	say(c, "Cow", "Ищете чёрную штуку с щупальцами? Была тут вчера. Сказала «му» и исчезла. Я обиделась.", "Looking for a black thing with tentacles? It was here yesterday. Said moo and vanished. I was offended.")
	say(c, "Morty", "К-корова разговаривает?!", "Th-the cow is talking?!")
	say(c, "Rick", "Это даже не входит в топ-пять странностей за сегодня, Морти.", "That's not even in today's top five weirdest things, Morty.", { glitch = 0.25 })
	radarCheck(c, { "radar.search", "radar.signal", "radar.weak", "radar.where", "radar.glitch" }, 0.88, 0.3, true)
	say(c, "Rick", "Сигнал слабый... и прыгает. Будто оно ходит вокруг нас.", "The signal's weak... and it keeps jumping. Like it's walking around us.", { glitch = 0.35 })
	radarDone()
	P.evil.glitch = 0.25
	P.evil:lookAt(eyeOf(api().root() and api().root().CFrame or arrive).Position)
	say(c, "Morty", "Эй... ты мерцаешь. Как Рик.", "Hey... you're flickering. Like Rick.")
	say(c, "EvilMorty", "Тебе кажется. Идём.", "You're imagining it. Let's go.")
	Dialogue.hide()
	P.evil.glitch = 0.15
	leaveThrough(c, spot(sp, "PortalOut"))
end

local function worldK9(c)
	local sp = W.k9:FindFirstChild("K9Spots")
	local spores = W.k9:FindFirstChild("SporeSource")
	local sporeEmitter = spores and spores:FindFirstChildOfClass("ParticleEmitter")
	if sporeEmitter then
		sporeEmitter.Enabled = true
	end
	local arrive = arriveIn(c, sp, "Mushroom", "loc.k9", true)
	Audio.music("MusicEerie", 2)
	c.wait(1.2)
	say(c, "Rick", "K-9. Грибной лес. Не дыши глубоко, Морти. Споры.", "K-9. The mushroom forest. Don't breathe too deep, Morty. Spores.", { glitch = 0.25 })
	say(c, "Morty", "Красиво... и жутко.", "It's pretty... and creepy.")
	Dialogue.hide()
	Director.freeLook(false)
	K.giveControl(c, arrive)
	follow(P.rick, 1, 8)
	follow(P.evil, -1, 8)
	api().objective("obj.clearing")
	local clearing = spot(sp, "Clearing")
	-- halfway down the path the spores kick in
	c.waitUntil(function()
		local r = api().root()
		return r ~= nil and (r.Position.Z < (arrive.Position.Z + clearing.Position.Z) / 2 + 6)
	end, 40)
	local eyes = W.k9:FindFirstChild("SporeEyes")
	Fx.glitch(1.4, 0.35)
	Audio.play("Glitch2", 0.6)
	if eyes then
		for _, p in eyes:GetChildren() do
			if p:IsA("BasePart") then
				p.Transparency = 0
			end
		end
	end
	K.play3D("RoarDeep", arrive.Position + Vector3.new(0, 10, -40), 0.7)
	say(c, "Morty", "Т-там глаза! Красные глаза в грибах!", "Th-there are eyes! Red eyes in the mushrooms!", { auto = 1.2 })
	c.wait(0.4)
	if eyes then
		for _, p in eyes:GetChildren() do
			if p:IsA("BasePart") then
				p.Transparency = 1
			end
		end
	end
	say(c, "Rick", "Это споры, Морти. Галлюцинации. Наверное.", "That's the spores, Morty. Hallucinations. Probably.", { auto = 1.4, glitch = 0.3 })
	say(c, "EvilMorty", "Это не галлюцинации.", "Those aren't hallucinations.", { auto = 1.4 })
	Dialogue.hide()
	waitNear(c, clearing.Position, 10, 50)
	api().objective(nil)
	api().gameplay(false)
	api().freeze(true)
	api().hideCharacter(true)
	stopFollow(P.rick)
	stopFollow(P.evil)
	local r = api().root()
	local eyeCF = if r then CFrame.lookAt(r.Position + Vector3.new(0, 1.5, 0), P.rick.root.Position + Vector3.new(0, 1.4, 0)) else eyeOf(clearing)
	Director.start()
	Director.cut(eyeCF, 70)
	radarCheck(c, { "radar.search", "radar.signal", "radar.strong", "radar.where", "radar.b137" }, 0.5, 0.5, true)
	Audio.play("OverheatBeep", 1.4)
	say(c, "Rick", "Есть сигнал! Сильный! Это... B137?! Мы же только оттуда!", "A signal! A strong one! It's... B137?! We just came from there!", { glitch = 0.45 })
	say(c, "EvilMorty", "Значит, оно всё время было рядом с вами.", "Then it's been right next to you the whole time.")
	say(c, "Rick", "Открываю портал. Держитесь ближе. И... не смотрите на меня так.", "Opening a portal. Stay close. And... stop looking at me like that.", { glitch = 0.6 })
	radarDone()
	Dialogue.hide()
	local out = openPortal(CFrame.lookAt(clearing.Position + Vector3.new(0, 3, -10), clearing.Position + Vector3.new(0, 3, 0)), "green", 9)
	Audio.play("Click")
	c.wait(1.4)
	Fx.fade(1, 0.5, true)
	out.Close()
	if sporeEmitter then
		sporeEmitter.Enabled = false
	end
end

-- B137 at sunset: the signal is Rick
local function hunt137(c)
	K.ensureDesert(c)
	local sp = R.planet:FindFirstChild("ChaseSpots")
	shedVisible(true)
	shedDoor(0)
	local arrive = arriveIn(c, sp, "DesertDusk", "loc.b137", true)
	local rick, evil = P.rick, P.evil
	rick.glitch = 0.4
	Audio.music("MusicDread", 3)
	c.wait(1.2)
	local shedPos = W.shed:GetPivot().Position
	Director.freeLook(false)
	Director.move(CFrame.lookAt(eyeOf(arrive).Position, shedPos + Vector3.new(0, 4, 0)), 1.2, "smooth", 55)
	say(c, "Morty", "Это... наш бункер? Ты его достроил?", "Is that... our bunker? You finished it?")
	say(c, "Rick", "Пока ты спал. Пять дней, Морти. Ну, или пять минут. Время — сложная штука.", "While you were asleep. Five days, Morty. Or five minutes. Time's complicated.", { glitch = 0.45 })
	Director.move(eyeOf(arrive), 0.8, "smooth", 70)
	radarCheck(c, { "radar.search", "radar.dist", "radar.zero", "radar.where", "radar.here" }, 0.5, 0.5, true)
	Audio.play("OverheatBeep", 1.6)
	say(c, "Rick", "Ноль метров? Значит, оно прямо... здесь.", "Zero meters? So it's right... here.", { glitch = 0.5 })
	say(c, "Morty", "Рик... точка на радаре — это ты.", "Rick... the dot on the radar is you.")
	rick:lookAt(eyeOf(arrive).Position)
	say(c, "Rick", "Я? Хе... хе-хе... Не-е-ет, Морти, это бред, я же... я же Р-Р-Р-РИК...", "Me? Heh... heh-heh... No-o-o, Morty, that's crazy, I'm... I'm R-R-R-RICK...", { glitch = 1 })
	say(c, "EvilMorty", "Морти. Отойди от него. Медленно.", "Morty. Step away from him. Slowly.")
	radarDone()
	Dialogue.hide()

	-- RICK TURNS ------------------------------------------------------------------
	rick.glitch = 1.4
	Fx.glitch(2.2, 0.7)
	Audio.play("Glitch3")
	K.play3D("RoarDeep", rick.root.Position, 1.2)
	Director.shake(1.2, 2.2, 14)
	local rickPos = rick.root.Position
	local groundY = groundAt(rickPos)
	for i = 1, 4 do
		K.bigBlackSmoke(rickPos + Vector3.new(0, i * 2, 0), 1 + i * 0.4)
		c.wait(0.3)
	end
	rick:visible(false)
	rick.glitch = 0
	local rb = P.rickBeast
	local beastHome = CFrame.lookAt(Vector3.new(rickPos.X, groundY, rickPos.Z), Vector3.new(arrive.Position.X, groundY, arrive.Position.Z))
	rb.root.CFrame = beastHome * CFrame.new(0, -30, 0)
	beastWiggle(rb, 1.4)
	K.emitters(rb.model, "BlackCloud", true)
	Director.track(function()
		return CFrame.lookAt(eyeOf(arrive).Position, rb.root.Position + Vector3.new(0, 18, 0))
	end)
	Director.fov(68, 0.8)
	K.animate(1.1, function(a)
		rb.root.CFrame = (beastHome * CFrame.new(0, -30, 0)):Lerp(beastHome, a)
	end, "out")
	K.play3D("Roar", rickPos + Vector3.new(0, 20, 0), 0.8)
	Director.shake(1.6, 1.2)
	say(c, "Morty", "Р-Р-РИК?!", "R-R-RICK?!", { auto = 0.8 })
	say(c, "EvilMorty", "Я так и знал...", "I knew it...", { auto = 0.8 })
	Dialogue.hide()
	-- it grabs Evil Morty (we only hear it)
	local evilPos = evil.root.Position
	Director.track(function()
		local head = evil.model:FindFirstChild("Head") :: BasePart?
		return CFrame.lookAt(eyeOf(arrive).Position, if head then head.Position else evilPos)
	end)
	rb.wiggle = 3
	c.wait(0.6)
	Fx.black(1)
	Audio.play("Thud", 0.7)
	Audio.play("Glitch1", 0.5)
	c.wait(0.9)
	evil:visible(false)
	evil.glitch = 0
	local eb = P.evilBeast
	local evilHome = CFrame.lookAt(Vector3.new(evilPos.X, groundAt(evilPos), evilPos.Z), Vector3.new(arrive.Position.X, 0, arrive.Position.Z))
	eb.root.CFrame = evilHome * CFrame.new(0, -6, 0)
	beastWiggle(eb, 1.6)
	K.emitters(eb.model, "BlackCloud", true)
	Fx.fade(0, 0.3)
	K.animate(0.8, function(a)
		eb.root.CFrame = (evilHome * CFrame.new(0, -6, 0)):Lerp(evilHome, a)
	end, "out")
	K.play3D("Roar", evilPos + Vector3.new(0, 14, 0), 1.1)
	Director.shake(1.0, 0.8)
	say(c, "MortyThought", "Он... он и его тоже...", "He... he got him too...", { auto = 1.2 })
	-- the curse itself rises behind them
	local ent = P.entity
	local entCF = CFrame.lookAt(Vector3.new(rickPos.X, 0, rickPos.Z + 110), Vector3.new(arrive.Position.X, 0, arrive.Position.Z))
	ent.root.CFrame = entCF * CFrame.new(0, -170, 0)
	K.entityCloud(true)
	ent:pose(K.ENTITY_POSES.raise, 3)
	Director.track(function()
		return CFrame.lookAt(eyeOf(arrive).Position, ent.root.Position + Vector3.new(0, 90, 0))
	end)
	K.play3D("RoarDeep", entCF.Position + Vector3.new(0, 80, 0), 0.6)
	K.animate(2.4, function(a)
		ent.root.CFrame = (entCF * CFrame.new(0, -170, 0)):Lerp(entCF, a)
	end, "out")
	Director.shake(1.6, 2, 8)
	say(c, "MortyThought", "Проклятие, Рик и Злой Морти... они теперь одно целое...", "The curse, Rick and Evil Morty... they're one thing now...", { auto = 1.2 })
	say(c, "Morty", "А-А-А-А-А! БЕЖАТЬ! БЕЖАТЬ!", "A-A-A-A-AH! RUN! RUN!", { auto = 0.6 })
	Dialogue.hide()

	-- THE CHASE -----------------------------------------------------------------
	Audio.music("MusicAction", 0.5)
	Director.fov(70, 0.3)
	local hum = api().humanoid()
	K.giveControl(c, arrive, CFrame.lookAt(eyeOf(arrive).Position, shedPos + Vector3.new(0, 3, 0)))
	if hum then
		hum.WalkSpeed = 16
	end
	api().objective("obj.run")
	local t0 = os.clock()
	local gap = 26
	local lunge = false
	local held = false -- the Titan is holding them back
	local holdPos: Vector3? = nil
	local entityGap = 95
	local chaseConn = connect(RunService.Heartbeat, function(dt)
		local root = api().root()
		if not root then
			return
		end
		local target = if lunge then 4 else math.max(10, 26 - (os.clock() - t0) * 1.1)
		gap += (target - gap) * math.min(1, dt * (if lunge then 6 else 1.5))
		local pp = flat(root.Position)
		for i, b in { rb, eb } do
			local cur = b.root.Position
			local side = (if i == 1 then 1 else -1) * 5
			local want: Vector3
			if held and holdPos then
				want = holdPos + Vector3.new(side * 2, 0, 6 + math.sin(os.clock() * 2 + i) * 3)
			else
				local away = flat(cur) - pp
				if away.Magnitude < 0.1 then
					away = Vector3.new(0, 0, 1)
				end
				local right = away.Unit:Cross(Vector3.yAxis)
				want = pp + away.Unit * gap + right * side
			end
			local next = flat(cur):Lerp(want, math.min(1, dt * 3.2))
			local y = groundAt(next)
			b.root.CFrame = CFrame.lookAt(Vector3.new(next.X, y, next.Z), Vector3.new(pp.X, y, pp.Z))
		end
		-- the giant follows far behind
		local ec = flat(ent.root.Position)
		local away = ec - pp
		if away.Magnitude > 1 then
			local want = pp + away.Unit * (if held then entityGap + 60 else entityGap)
			local next = ec:Lerp(want, math.min(1, dt * 0.8))
			ent.root.CFrame = CFrame.lookAt(next, pp)
		end
	end)
	-- growls behind your back
	task.spawn(function()
		while c.alive() and not held do
			task.wait(2 + math.random() * 1.5)
			if held or not c.alive() then
				break
			end
			K.play3D(if math.random() < 0.5 then "Roar" else "RoarDeep", rb.root.Position + Vector3.new(0, 12, 0), 0.9 + math.random() * 0.4)
			if gap < 16 then
				Fx.glitch(0.2, 0.25)
			end
		end
	end)
	-- run until they almost catch you
	c.waitUntil(function()
		local root = api().root()
		return (os.clock() - t0 > 13) or (root ~= nil and root.Position.Z < shedPos.Z + 125)
	end, 30)
	lunge = true
	rb.wiggle = 3
	eb.wiggle = 3
	Fx.glitch(0.4, 0.3)
	K.play3D("Roar", api().root() and api().root().Position or arrive.Position, 1)
	c.wait(0.7)
	-- freeze! the Titan arrives
	api().gameplay(false)
	api().freeze(true)
	api().hideCharacter(true)
	local root = api().root()
	local mpos = if root then root.Position else arrive.Position
	local eyePos = mpos + Vector3.new(0, 1.5, 0)
	local back = flat(rb.root.Position - mpos).Unit
	Director.start()
	Director.move(CFrame.lookAt(eyePos, eyePos + back * 20 + Vector3.new(0, 6, 0)), 0.35, "out", 75)
	Audio.music(nil, 0.3)
	local theme = Audio.make("TitanTheme", SoundService)
	if theme then
		theme:Play()
		table.insert(S.loops, theme)
	end
	local landAt = mpos + back * 14
	landAt = Vector3.new(landAt.X, groundAt(landAt), landAt.Z)
	holdPos = flat(mpos + back * 34)
	local landCF = CFrame.lookAt(landAt, landAt + back)
	titanWounded(false)
	Director.track(function()
		return CFrame.lookAt(eyePos, P.titan.root.Position + Vector3.new(0, 8, 0))
	end)
	titanLand(c, mpos - back * 160 + Vector3.new(0, 260, 0), landCF, 2.6)
	-- the shockwave throws them back
	held = true
	lunge = false
	Fx.shockwave(landAt + Vector3.new(0, 3, 0), 60, 0.6, rgb(255, 120, 80))
	Director.track(function()
		return CFrame.lookAt(eyePos, P.titan.root.Position + Vector3.new(0, 30, 0))
	end)
	c.wait(0.6)
	K.play3D("RobotVoice", P.titan.root.Position + Vector3.new(0, 30, 0), 0.7)
	say(c, "Titan", "ВАМ. НЕ МЕСТО. ЗДЕСЬ.", "YOU. DON'T. BELONG. HERE.", { auto = 1.6 })
	Dialogue.hide()
	P.titan:pose(TP.aimBoth, 6)
	K.play3D("ChargeLong", P.titan.root.Position + Vector3.new(0, 30, 0), 1)
	task.spawn(K.animate, 3, function(a)
		cannonCharge(a)
	end, "in")
	c.wait(0.8)
	say(c, "MortyThought", "Бункер! Бегом!", "The bunker! Go!", { auto = 0.6 })
	Dialogue.hide()
	-- run to the shed
	local doorSpot = W.shed:FindFirstChild("DoorSpot") :: BasePart
	K.giveControl(c, CFrame.lookAt(mpos, Vector3.new(shedPos.X, mpos.Y, shedPos.Z)))
	if hum then
		hum.WalkSpeed = 16
	end
	api().objective("obj.run")
	rb.wiggle = 2.5
	eb.wiggle = 2.5
	waitNear(c, doorSpot.Position, 16, 10)
	api().objective(nil)

	-- FIRE --------------------------------------------------------------------
	local blastAt = Vector3.new(holdPos.X, 6, holdPos.Z)
	local beams = {}
	for _, name in { "Muzzle", "MuzzleL" } do
		local m = muzzle(name)
		if m then
			table.insert(beams, { muzzle = m, beam = Fx.beam(m.Position, blastAt, 6, rgb(255, 70, 40)) })
		end
	end
	local core = K.titanPart("Core")
	local coreBeam = if core then Fx.beam(core.Position, blastAt, 9, rgb(255, 90, 50)) else nil
	K.play3D("Laser", P.titan.root.Position + Vector3.new(0, 30, 0))
	local firing = true
	task.spawn(function()
		while firing do
			for _, b in beams do
				b.beam.Set(b.muzzle.Position, blastAt)
			end
			if coreBeam and core then
				coreBeam.Set(core.Position, blastAt)
			end
			RunService.RenderStepped:Wait()
		end
		for _, b in beams do
			b.beam.Destroy()
		end
		if coreBeam then
			coreBeam.Destroy()
		end
	end)
	c.wait(0.9)
	Fx.explosion(blastAt, 10, { sound = "ExplosionBig", smokeColor = rgb(10, 8, 12), waveColor = rgb(255, 150, 110), debris = 30 })
	Fx.shockwave(blastAt, 320, 1.4, rgb(255, 200, 170))
	K.bigBlackSmoke(blastAt, 4)
	firing = false
	cannonCharge(0)
	-- the blast throws Morty
	api().gameplay(false)
	api().freeze(true)
	api().hideCharacter(true)
	local r2 = api().root()
	local m2 = if r2 then r2.Position else doorSpot.Position
	local fwd = flat(shedPos - m2)
	fwd = if fwd.Magnitude > 0.1 then fwd.Unit else Vector3.new(0, 0, -1)
	Fx.flash(Color3.new(1, 1, 1), 1, 0.03, 1.4)
	Fx.glitch(3, 1)
	Fx.muffle(true)
	Audio.play("Tinnitus")
	Audio.play("BodyWhoosh")
	Director.start()
	local fly = CFrame.lookAt(m2 + fwd * 8 + Vector3.new(0, 5, 0), m2 + fwd * 30) * CFrame.Angles(0.8, 0, 1.4)
	Director.move(fly, 0.5, "out")
	local lieAt = Vector3.new(m2.X, groundAt(m2) + 0.9, m2.Z) + fwd * 12
	Director.move(CFrame.lookAt(lieAt, lieAt + Vector3.new(0, 30, 0) + fwd * 4) * CFrame.Angles(0, 0, math.rad(15)), 0.3, "in")
	Audio.play("Thud")
	Fx.dust(lieAt, 6, 30)
	Director.shake(1.4, 0.6)
	if hum then
		hum.WalkSpeed = 9
	end
	-- park everything for the next chapter
	chaseConn:Disconnect()
	hideBeasts()
	S.mortyLie = lieAt
	c.wait(2.2)
	Fx.fade(1, 1.6, true)
	if theme then
		Audio.fadeOut(theme, 2, true)
	end
end

local function ch9(c, fresh: boolean)
	api().state("story")
	api().gameplay(false)
	if fresh then
		Fx.black(1)
		evilFace(true)
	end
	P.rick.glitch = 0.3
	P.evil.glitch = 0.15
	Fx.title("ch.9")
	c.check()
	worldJ22(c)
	worldD716(c)
	worldK9(c)
	hunt137(c)
	Fx.stopGlitch()
end

----------------------------------------------------------------------------
-- CHAPTER 10: The Alliance
----------------------------------------------------------------------------
local function ch10(c, _fresh: boolean)
	api().state("story")
	api().gameplay(false)
	Fx.black(1)
	K.ensureDesert(c)
	Scenes.apply("DesertDusk", true)
	hideBeasts()
	P.rick:visible(false)
	P.evil:visible(false)
	shedVisible(true)
	shedDoor(0)
	clearCrowd()
	local doorSpot = (W.shed:FindFirstChild("DoorSpot") :: BasePart).CFrame
	local facing = -flat(doorSpot.LookVector).Unit -- away from the shed
	local M = doorSpot.Position + facing * 8
	M = Vector3.new(M.X, groundAt(M) + 3, M.Z)
	local lieAt = Vector3.new(M.X, M.Y - 2.1, M.Z)
	K.holdCharacterAt(c, CFrame.lookAt(M, M + facing))
	api().hideCharacter(true)
	-- the army and the wounded Titan holding the curse's head
	local armyCenter = M + facing * 34
	formation(Vector3.new(armyCenter.X, 0, armyCenter.Z), M, 3, 8, 5)
	local tPos = M + facing * 78
	tPos = Vector3.new(tPos.X, groundAt(tPos), tPos.Z)
	local titan = P.titan
	titanWounded(true)
	titan:pose(TP.holdHead, 10)
	titan:snap()
	titanTo(CFrame.lookAt(tPos, Vector3.new(M.X, tPos.Y, M.Z)))
	titan:lookAt(M)
	holdCurseHead(true)
	local commanderCF = CFrame.lookAt(Vector3.new(armyCenter.X, 0, armyCenter.Z) - facing * 10 + Vector3.new(0, groundAt(armyCenter) + 3.45, 0), M)
	S.commander = spawnAgent("TVMan", commanderCF, "Commander")
	-- wake up on the sand
	Director.start()
	Director.cut(CFrame.lookAt(lieAt, lieAt + Vector3.new(0, 30, 0) - facing * 4) * CFrame.Angles(0, 0, math.rad(15)), 70)
	local blur = Lighting:FindFirstChild("Blur") :: BlurEffect?
	if blur then
		blur.Size = 14
		blur.Enabled = true
	end
	Fx.muffle(true)
	for _ = 1, 3 do
		Fx.smoke(M + facing * 20 + Vector3.new(0, 4, 0), 8, 10, rgb(30, 28, 30), 6)
	end
	Fx.fade(0, 2)
	Fx.title("ch.10")
	c.check()
	say(c, "Morty", "Ох... я... живой?..", "Ugh... am I... alive?..", { auto = 1.2 })
	Dialogue.hide()
	if blur then
		task.spawn(K.animate, 2, function(a)
			blur.Size = 14 * (1 - a)
		end)
	end
	Fx.muffle(false)
	Audio.play("Cloth")
	Audio.play("GetUp")
	local eye = CFrame.lookAt(M + Vector3.new(0, 1.5, 0), tPos + Vector3.new(0, 30, 0))
	Director.move(CFrame.lookAt(M + Vector3.new(0, 0.2, 0), M + Vector3.new(0, 0.2, 0) + facing * 10), 1.0)
	Director.move(eye, 1.4, "smooth", 62)
	if blur then
		blur.Enabled = false
	end
	Audio.music("MusicEerie", 3)
	say(c, "MortyThought", "Камерамены... Спикермены... ТВ-мены... Целая армия.", "Cameramen... Speakermen... TV Men... A whole army.")
	say(c, "MortyThought", "И у Титана в руке... голова проклятия.", "And in the Titan's hand... the curse's head.")
	Dialogue.hide()

	-- THE CHOICE ---------------------------------------------------------------
	local pitCF = CFrame.new(W.shed:GetPivot().Position)
	while true do
		c.check()
		Director.freeLook(false)
		Director.cut(eye, 62)
		local pick = Dialogue.choice({ "choice.bunker", "choice.look" })
		c.check()
		if pick == 1 then
			-- into the bunker...
			Director.move(CFrame.lookAt(eye.Position, doorSpot.Position + Vector3.new(0, 1.5, 0) - facing * 6), 0.8)
			local inside = doorSpot.Position + Vector3.new(0, 1.5, 0)
			Director.move(CFrame.lookAt(inside, inside - facing * 10), 1.8, "smooth")
			Audio.play("Click", 0.7)
			K.animate(0.6, function(a)
				shedDoor(a)
			end, "out")
			c.wait(0.8)
			-- tentacles burst out of the hatch
			local pit = P.pit
			local tilt = CFrame.lookAt(pitCF.Position, pitCF.Position + Vector3.new(facing.X, 0, facing.Z)) * CFrame.Angles(math.rad(-55), 0, 0)
			pit.root.CFrame = tilt * CFrame.new(0, -14, 0)
			pitWiggle(2, 1)
			K.emitters(pit.model, "BlackCloud", true)
			K.play3D("Roar", pitCF.Position, 1.3)
			K.animate(0.35, function(a)
				pit.root.CFrame = (tilt * CFrame.new(0, -14, 0)):Lerp(tilt, a)
			end, "out")
			Fx.flash(rgb(120, 0, 0), 0.6, 0.02, 0.4)
			Director.move(CFrame.lookAt(pitCF.Position + Vector3.new(0, 1, 0), pitCF.Position - Vector3.new(0, 10, 0)) * CFrame.Angles(0, 0, 1.2), 0.35, "in")
			Audio.play("Thud")
			Fx.glitch(0.6, 1)
			Fx.black(1)
			Fx.death(true)
			Audio.music(nil, 0.3)
			c.wait(3.6)
			-- back to the moment of choice
			pit.root.CFrame = start.pit
			K.emitters(pit.model, "BlackCloud", false)
			pit.extra = nil
			shedDoor(0)
			Fx.death(false)
			Fx.stopGlitch()
			c.wait(0.6)
			Fx.fade(0, 0.8)
			Audio.music("MusicEerie", 2)
		else
			break
		end
	end

	-- LOOK AROUND: the Titan blasts the fake bunker ----------------------------
	Director.freeLook(true, { yaw = 2.6, pitchUp = 0.9, pitchDown = 0.5 })
	say(c, "MortyThought", "Где Рик?.. Где Злой Морти?..", "Where's Rick?.. Where's Evil Morty?..", { auto = 2.2 })
	Dialogue.hide()
	Director.freeLook(false)
	local shedPos = W.shed:GetPivot().Position + Vector3.new(0, 3.5, 0)
	titan:face(Vector3.new(shedPos.X, tPos.Y, shedPos.Z))
	titan:pose(TP.aimRight, 6)
	titan:lookAt(shedPos)
	Director.move(CFrame.lookAt(eye.Position + facing:Cross(Vector3.yAxis) * 6, (titan.root.Position + shedPos) / 2 + Vector3.new(0, 14, 0)), 1.2, "smooth", 66)
	K.play3D("Charge", titan.root.Position + Vector3.new(0, 30, 0))
	task.spawn(K.animate, 1.6, function(a)
		cannonCharge(a)
	end, "in")
	say(c, "Morty", "Эй! Что ты делаешь?! Это же наш бункер!", "Hey! What are you doing?! That's our bunker!", { auto = 0.8 })
	Dialogue.hide()
	local m = muzzle("Muzzle")
	if m then
		local beam = Fx.beam(m.Position, shedPos, 5, rgb(255, 70, 40))
		K.play3D("Laser", m.Position)
		K.animate(0.6, function()
			beam.Set(m.Position, shedPos)
		end, "linear")
		beam.Destroy()
	end
	cannonCharge(0)
	local wood = { rgb(120, 86, 56), rgb(110, 78, 50), rgb(132, 94, 60), rgb(90, 64, 40) }
	Fx.explosion(shedPos, 4, { sound = "ExplosionBig", smokeColor = rgb(40, 34, 30), waveColor = rgb(255, 160, 110), debris = 46, debrisColors = wood })
	shedVisible(false)
	Director.shake(1.6, 1)
	-- what was hiding inside
	local pit = P.pit
	pit.root.CFrame = pitCF * CFrame.new(0, -14, 0)
	pitWiggle(2.4, 0)
	K.emitters(pit.model, "BlackCloud", true)
	K.animate(0.5, function(a)
		pit.root.CFrame = (pitCF * CFrame.new(0, -14, 0)):Lerp(pitCF * CFrame.new(0, -1, 0), a)
	end, "out")
	K.play3D("Roar", pitCF.Position, 1.4)
	Director.move(CFrame.lookAt(eye.Position, pitCF.Position + Vector3.new(0, 5, 0)), 0.5, "smooth", 55)
	say(c, "Morty", "Т-там были... ЩУПАЛЬЦА?! В нашем бункере?!", "Th-there were... TENTACLES?! In our bunker?!", { auto = 1 })
	Dialogue.hide()
	-- second shot into the hole
	if m then
		local beam = Fx.beam(m.Position, pitCF.Position, 4, rgb(255, 70, 40))
		K.animate(0.5, function()
			beam.Set(m.Position, pitCF.Position)
		end, "linear")
		beam.Destroy()
	end
	Fx.explosion(pitCF.Position + Vector3.new(0, 2, 0), 3, { sound = "Explosion", smokeColor = rgb(10, 8, 12), waveColor = rgb(255, 120, 80) })
	Fx.sparks(pitCF.Position + Vector3.new(0, 3, 0), 60, rgb(255, 80, 50))
	K.animate(0.8, function(a)
		pit.root.CFrame = (pitCF * CFrame.new(0, -1, 0)):Lerp(pitCF * CFrame.new(0, -16, 0), a)
	end, "in")
	pit.root.CFrame = start.pit
	pit.extra = nil
	K.emitters(pit.model, "BlackCloud", false)
	titan:pose(TP.holdHead, 4)
	titan:face(Vector3.new(M.X, tPos.Y, M.Z))
	titan:lookAt(M)

	-- the Commander explains
	local cmd = S.commander
	if cmd then
		local to = M + facing * 6
		task.spawn(function()
			cmd:walkTo(Vector3.new(to.X, cmd.root.Position.Y, to.Z), 7, M)
		end)
		Director.track(function()
			local head = cmd.model:FindFirstChild("Head") :: BasePart?
			return CFrame.lookAt(eye.Position, if head then head.Position else cmd.root.Position)
		end)
		Director.fov(55, 2)
	end
	Audio.music("MusicBunker", 3)
	c.wait(1.6)
	say(c, "Commander", "Спокойно, малыш. Мы — Альянс. Камерамены, Спикермены, ТВ-мены.", "Easy, kid. We're the Alliance. Cameramen, Speakermen, TV Men.")
	say(c, "Commander", "То, что гналось за тобой, — не проклятие. Это вирус. Он прячется от нас уже двадцать лет.", "The thing chasing you isn't a curse. It's a virus. It's been hiding from us for twenty years.")
	say(c, "Commander", "Он вселяется в самых умных существ во вселенной. Носит их лица. Говорит их голосами.", "It gets inside the smartest beings in the universe. Wears their faces. Talks with their voices.")
	say(c, "Morty", "Т-то есть... Рик... это был не Рик?!", "S-so... Rick... wasn't Rick?!")
	say(c, "Commander", "Твой Рик был заражён. С того самого момента, как его коснулась та рука.", "Your Rick was infected. Ever since that hand touched him.")
	say(c, "MortyThought", "Рука... Там, в пустыне, когда тарелка упала. «Это была ЕГО рука»...", "The hand... Back in the desert, when the saucer went down. \"That was ITS hand\"...")
	say(c, "Commander", "Даже бункер он строил для тебя. Ловушку.", "He even built that bunker for you. A trap.")
	say(c, "Morty", "А настоящий Рик?.. И Злой Морти?..", "And the real Rick?.. And Evil Morty?..")
	say(c, "Commander", "Вирус копирует, а не заменяет. Настоящий Рик где-то там. Найдётся. Они всегда находятся.", "The virus copies, it doesn't replace. The real Rick is out there somewhere. He'll turn up. They always do.")
	K.play3D("RobotVoice", titan.root.Position + Vector3.new(0, 30, 0), 0.6)
	say(c, "Titan", "ГОЛОВУ — НА БАЗУ.", "THE HEAD GOES TO THE BASE.")
	say(c, "Commander", "Слышал? Летим на базу. Ты с нами, Морти. Здесь тебе больше нельзя оставаться.", "You heard him. We're flying to the base. You're coming with us, Morty. You can't stay here.")
	Dialogue.hide()

	-- THE FLIGHT ------------------------------------------------------------------
	Fx.fade(1, 0.6, true)
	Director.fov(70, 0)
	titan:pose(TP.carry, 8)
	titan:lookAt(nil)
	local torso = R.titanModel:FindFirstChild("Torso") :: BasePart?
	local function shoulderEye(): CFrame
		if not torso then
			return eye
		end
		local cf = torso.CFrame * CFrame.new(9, 12, -2)
		local look = R.titanModel.PrimaryPart.CFrame.LookVector
		return CFrame.lookAt(cf.Position, cf.Position + look * 40 - Vector3.new(0, 6, 0))
	end
	Director.track(shoulderEye)
	Fx.fade(0, 0.6)
	say(c, "MortyThought", "Я сижу на плече у Титана Спикермена. Мама мне не поверит.", "I'm sitting on Titan Speakerman's shoulder. Mom's never gonna believe this.", { auto = 1.6 })
	Dialogue.hide()
	K.titanJets(true)
	local thruster = loop("Thruster", titan.root, 0.8)
	local up0 = titan.root.CFrame
	local skyPortal = up0.Position + up0.LookVector * 260 + Vector3.new(0, 230, 0)
	local portal = openPortal(CFrame.lookAt(skyPortal, skyPortal - up0.LookVector), "red", 120)
	K.play3D("Takeoff", tPos, 0.8)
	Director.shake(0.6, 2)
	K.animate(5.2, function(a)
		local pos = K.bezier(up0.Position, up0.Position + Vector3.new(0, 140, 0), skyPortal + up0.LookVector * 40, a)
		titan.root.CFrame = CFrame.lookAt(pos, pos + up0.LookVector + Vector3.new(0, 0.25 * (1 - a), 0))
	end, "in")
	Audio.play("Warp")
	Fx.flash(rgb(255, 120, 90), 1, 0.05, 0.8)
	Fx.speedLines(true, 1)
	c.wait(0.4)
	Fx.fade(1, 0.3, true)
	Fx.speedLines(false)
	portal.Close()
	K.titanJets(false)
	K.stopLoop(thruster, 0.5)
	holdCurseHead(false)
	clearCrowd()
end

----------------------------------------------------------------------------
-- CHAPTER 11: The camera base
----------------------------------------------------------------------------
local function cityFx(on: boolean)
	K.emitters(W.base, "CitySmoke", on)
end

local function placeShips(visible: boolean)
	for i = 1, 10 do
		local ship = W.astro:FindFirstChild("AstroShip" .. i)
		if ship then
			ship:PivotTo(if visible then spot(W.baseSpots, "Ship" .. i) else start.ships[i])
		end
	end
end

local function ch11(c, fresh: boolean)
	api().state("story")
	api().gameplay(false)
	Fx.black(1)
	Scenes.apply("City", true)
	cityFx(true)
	clearCrowd()
	placeShips(false)
	W.mother:PivotTo(start.mother)
	local sp = W.baseSpots
	local land = spot(sp, "TitanLand")
	local mortyLand = spot(sp, "MortyLand")
	-- the curse's head goes into the containment cube
	local cube = W.base:FindFirstChild("Containment", true) :: BasePart?
	if cube then
		W.curseHead:PivotTo(CFrame.lookAt(cube.Position, cube.Position + Vector3.new(0, 0, 1)))
	end
	-- agents around the pad
	for _, mk in W.formation:GetChildren() do
		if mk:IsA("BasePart") then
			local kind = AGENT_KINDS[(tonumber(string.sub(mk.Name, 2)) or 1) % 3 + 1]
			spawnAgent(kind, mk.CFrame)
		end
	end
	S.cam = spawnAgent("Cameraman", spot(sp, "CamFriend"), "Cam")
	S.lens = spawnAgent("Cameraman", spot(sp, "LensFriend"), "Lens")
	S.commander = spawnAgent("TVMan", spot(sp, "Commander"), "Commander")
	-- Lens has a blue lens and a little antenna, so the friends don't look the same
	if S.lens then
		local lens = S.lens.model:FindFirstChild("CamLens", true) :: BasePart?
		if lens then
			lens.Color = rgb(60, 140, 220)
		end
	end
	local titan = P.titan
	titanWounded(true)
	holdCurseHead(false)
	K.holdCharacterAt(c, mortyLand)
	api().hideCharacter(true)
	local torso = R.titanModel:FindFirstChild("Torso") :: BasePart?
	Director.start()
	if not fresh and torso then
		-- landing on the pad, seen from the Titan's shoulder
		local from = land.Position + Vector3.new(-200, 260, 160)
		Director.track(function()
			local cf = torso.CFrame * CFrame.new(9, 12, -2)
			return CFrame.lookAt(cf.Position, land.Position + Vector3.new(0, 10, 0))
		end)
		Fx.fade(0, 0.6)
		Fx.caption("loc.base")
		titanLand(c, from, land, 3.4)
		c.wait(0.6)
		Fx.fade(1, 0.4, true)
	else
		titan:pose(K.TITAN_POSES.stand, 10)
		titan:snap()
		titanTo(land)
		Fx.caption("loc.base")
	end
	titan:pose(K.TITAN_POSES.stand, 6)
	titanTo(land)
	Director.cut(eyeOf(mortyLand), 70)
	Director.freeLook(true, { yaw = 1.6, pitchUp = 1.0, pitchDown = 0.5 })
	Audio.music("MusicLofi", 3)
	Fx.fade(0, 0.8)
	Fx.title("ch.11")
	c.check()
	local cmd = S.commander
	if cmd then
		cmd:lookAt(eyeOf(mortyLand).Position)
	end
	say(c, "Commander", "Добро пожаловать на базу Альянса. Отдыхай, малыш. Здесь безопасно.", "Welcome to the Alliance base. Get some rest, kid. You're safe here.")
	say(c, "MortyThought", "Почему, когда так говорят в кино, сразу всё взрывается?..", "Why is it that whenever someone says that in a movie, everything blows up?..", { auto = 1.6 })
	local cam, lens = S.cam, S.lens
	if cam and lens then
		cam:lookAt(eyeOf(mortyLand).Position)
		lens:lookAt(eyeOf(mortyLand).Position)
		task.spawn(function()
			cam:walkTo(mortyLand.Position + Vector3.new(-4, 0.45, -3), 6, mortyLand.Position)
		end)
		task.spawn(function()
			lens:walkTo(mortyLand.Position + Vector3.new(-1, 0.45, -5), 6, mortyLand.Position)
		end)
	end
	c.wait(1.6)
	say(c, "Cam", "Эй! Ты же тот самый Морти? Который пережил выстрел Титана?", "Hey! You're that Morty, right? The one who survived the Titan's blast?")
	say(c, "Morty", "Ну... типа того. Меня немножко отбросило.", "Uh... kind of. I got knocked back a little.")
	say(c, "Lens", "НЕМНОЖКО? Тебя было видно с орбиты!", "A LITTLE? We could see you from orbit!")
	say(c, "Cam", "Я Кэм. Это Линза. Пошли, покажем тебе базу. Ты голодный? У нас есть батарейки.", "I'm Cam. This is Lens. Come on, we'll show you the base. Hungry? We've got batteries.")
	say(c, "Morty", "Я... не ем батарейки.", "I... don't eat batteries.")
	say(c, "Lens", "Ничего, привыкнешь.", "Don't worry, you'll get used to it.")
	Dialogue.hide()

	-- WALK AND TALK -----------------------------------------------------------
	Director.freeLook(false)
	K.giveControl(c, mortyLand)
	api().objective("obj.friends")
	local walkPts = {}
	for i = 1, 4 do
		walkPts[i] = spot(sp, "Walk" .. i).Position
	end
	local friendsGo = true
	task.spawn(function()
		for i = 1, 4 do
			if not friendsGo then
				break
			end
			local wp = walkPts[i]
			if cam then
				task.spawn(function()
					cam:walkTo(wp + Vector3.new(-2.5, 0.45, 0), 6)
				end)
			end
			if lens then
				lens:walkTo(wp + Vector3.new(2.5, 0.45, 0), 6)
			end
			c.waitUntil(function()
				return not friendsGo or near(wp, 14)
			end, 30)
		end
	end)
	waitNear(c, walkPts[1], 10, 40)
	say(c, "Cam", "Тут раньше был целый город. Потом пришли туалеты.", "There used to be a whole city here. Then the toilets came.", { auto = 1.8 })
	say(c, "Morty", "Т-туалеты?!", "T-toilets?!", { auto = 1 })
	say(c, "Lens", "Скибиди. Они поют. Это хуже, чем звучит.", "Skibidi. They sing. It's worse than it sounds.", { auto = 2 })
	Dialogue.hide()
	waitNear(c, walkPts[2], 12, 40)
	-- the head in the cube blinks
	for _, e in partsWithAttr(W.curseHead, "CurseEye") do
		e.Color = rgb(255, 255, 255)
		task.delay(0.15, function()
			e.Color = rgb(255, 30, 20)
		end)
	end
	Audio.play("Glitch1", 0.4)
	say(c, "Lens", "Ты видел? Голова в кубе... моргнула.", "Did you see that? The head in the cube... blinked.", { auto = 1.6 })
	say(c, "Cam", "Тебе показалось. Из куба ещё никто не выходил.", "You're seeing things. Nothing's ever gotten out of the cube.", { auto = 1.8 })
	Dialogue.hide()
	waitNear(c, walkPts[3], 12, 40)
	friendsGo = false
	api().objective(nil)

	-- THE ATTACK ------------------------------------------------------------------
	api().gameplay(false)
	api().freeze(true)
	api().hideCharacter(true)
	local r = api().root()
	local mpos = if r then r.Position else walkPts[3]
	local eyePos = mpos + Vector3.new(0, 1.5, 0)
	Director.start()
	Director.freeLook(true, { yaw = 2.6, pitchUp = 1.2, pitchDown = 0.4 })
	Audio.music(nil, 0.2)
	local alarm = loop("OverheatBeep", workspace.CurrentCamera, 0.35, 0.55)
	local alarmLight = W.base:FindFirstChild("BaseAlarmLight", true) :: PointLight?
	connect(RunService.RenderStepped, function()
		if alarmLight then
			alarmLight.Brightness = if math.floor(os.clock() * 3) % 2 == 0 then 4 else 0.5
		end
	end)
	local bobbing = {}
	for i = 1, 10 do
		local ship = W.astro:FindFirstChild("AstroShip" .. i)
		local at = spot(sp, "Ship" .. i)
		if ship then
			ship:PivotTo(at)
			bobbing[ship] = at
			Fx.flash(rgb(230, 200, 255), 0.35, 0.02, 0.3)
			Fx.shockwave(at.Position, 40, 0.5, rgb(200, 140, 255))
			K.play3D("SonicBoom", at.Position, 0.9 + math.random() * 0.3)
			Director.shake(0.5, 0.4)
		end
		if i == 1 then
			Scenes.apply("CityAlarm")
			Director.track(function()
				return CFrame.lookAt(eyePos, at.Position)
			end)
			say(c, "Cam", "АСТРО! Это Астро-туалеты!", "ASTRO! It's the Astro toilets!", { auto = 0.8 })
			Director.freeLook(true)
		elseif i == 3 then
			say(c, "Lens", "Они телепортируются на скорости звука! Все на позиции!", "They teleport at the speed of sound! Everyone to your posts!", { auto = 0.8 })
		end
		c.wait(0.45)
	end
	Dialogue.hide()
	connect(RunService.RenderStepped, function()
		local t = os.clock()
		local k = 0
		for ship, at in bobbing do
			k += 1
			ship:PivotTo(at * CFrame.new(0, math.sin(t * 1.3 + k) * 2, 0) * CFrame.Angles(0, t * 0.6 + k, 0))
		end
	end)
	Audio.music("MusicAction", 1)
	-- everybody turns to the sky, the Titan raises his cannon
	for _, p in S.crowd do
		p:lookAt(spot(sp, "Ship1").Position)
	end
	titan:pose(TP.aimRight, 6)
	titan:lookAt(spot(sp, "Ship1").Position)
	say(c, "Commander", "Нас окружили! Держать периметр!", "We're surrounded! Hold the perimeter!", { auto = 1 })
	Dialogue.hide()
	c.wait(0.8)
	-- the real Rick
	local rick = P.rick
	local rickSpot = spot(sp, "RickPortal")
	local rp = openPortal(spot(sp, "PortalRick"), "green", 9)
	rick:visible(true)
	rick.glitch = 0
	rick.follow = nil
	rick:place(spot(sp, "PortalRick") * CFrame.new(0, -2.64, 0))
	rick:pose("stand")
	rick:snap()
	Director.freeLook(false)
	Director.track(function()
		local head = rick.model:FindFirstChild("Head") :: BasePart?
		return CFrame.lookAt(eyePos, if head then head.Position else rickSpot.Position)
	end)
	rick:walkTo(rickSpot.Position, 6, eyePos)
	rp.Close()
	rick:lookAt(eyePos)
	say(c, "Rick", "Морти! Вот ты где. Я тебя по всей мультивселенной ищу.", "Morty! There you are. I've been looking for you across the whole multiverse.")
	say(c, "Morty", "Р-Рик?! Ты... ты не глючишь!", "R-Rick?! You... you're not glitching!")
	say(c, "Rick", "А должен? *рыг* Слышал, меня тут один вирус косплеил. Безвкусно.", "Should I be? *burp* I heard some virus was cosplaying as me. Tacky.")
	Audio.play("Burp")
	Dialogue.hide()
	-- the mothership
	local mother = W.mother
	local far = spot(sp, "MothershipFar")
	local over = spot(sp, "Mothership")
	mother:PivotTo(far)
	Director.track(function()
		return CFrame.lookAt(eyePos, mother:GetPivot().Position)
	end)
	Director.fov(80, 3)
	K.play3D("RoarDeep", eyePos + Vector3.new(0, 200, 0), 0.35)
	local drone = loop("Drone", workspace.CurrentCamera, 0.6, 0.5)
	K.animate(5, function(a)
		mother:PivotTo(far:Lerp(over, a))
	end, "out")
	Director.shake(0.8, 3, 6)
	say(c, "Lens", "Мамочки... это их МАТЕРИНСКИЙ корабль!", "Oh no... that's their MOTHERSHIP!", { auto = 1 })
	local beamCore = mother:FindFirstChild("BeamCore") :: BasePart?
	K.play3D("ChargeLong", over.Position, 0.5)
	local charging = true
	task.spawn(function()
		local t0 = os.clock()
		while charging and c.alive() do
			local a = math.min(1, (os.clock() - t0) / 14)
			if beamCore then
				beamCore.Size = Vector3.new(30, 90, 90) * (1 + a * 0.6)
				local l = beamCore:FindFirstChildOfClass("PointLight")
				if l then
					l.Brightness = 4 + a * 20
					l.Range = 60
				end
			end
			RunService.RenderStepped:Wait()
		end
	end)
	say(c, "Commander", "Все в бункер! БЫСТРО!", "Everyone into the bunker! NOW!", { auto = 0.8 })
	Director.fov(70, 1)
	Director.track(function()
		local head = rick.model:FindFirstChild("Head") :: BasePart?
		return CFrame.lookAt(eyePos, if head then head.Position else rickSpot.Position)
	end)
	local homeCF = spot(sp, "PortalHome")
	local home = openPortal(homeCF, "green", 9)
	Audio.play("Click")
	say(c, "Rick", "Ну, нам пора. Морти, айда в Блипс-энд-Читц? Там новый автомат «Рой»!", "Well, time to go. Morty, how about Blips and Chitz? They've got a new Roy machine!")
	say(c, "Morty", "Рик, тут сейчас всё взорвётся!", "Rick, this whole place is about to blow up!")
	say(c, "Rick", "Вот именно поэтому нам и пора.", "Which is exactly why it's time to go.")
	if cam then
		cam:lookAt(eyePos)
	end
	say(c, "Cam", "Беги, Морти! Ещё увидимся!", "Run, Morty! We'll see you again!", { auto = 1 })
	say(c, "Lens", "Мы справимся! Наверное!", "We'll be fine! Probably!", { auto = 1 })
	Dialogue.hide()
	task.spawn(function()
		rick:walkTo(Vector3.new(homeCF.Position.X, rick.root.Position.Y, homeCF.Position.Z), 8)
		rick:visible(false)
	end)
	Director.fov(70, 0.5)
	K.giveControl(c, CFrame.lookAt(mpos, Vector3.new(homeCF.Position.X, mpos.Y, homeCF.Position.Z)))
	api().objective("obj.portal")
	waitNear(c, homeCF.Position, 3.6, 25)
	api().objective(nil)
	-- the beam comes down as the portal closes
	charging = false
	if beamCore then
		local center = land.Position
		local b = Fx.beam(beamCore.Position, Vector3.new(center.X, 0, center.Z), 40, rgb(210, 120, 255))
		task.delay(0.6, b.Destroy)
	end
	Fx.flash(rgb(230, 200, 255), 1, 0.05, 0.6)
	Audio.play("ExplosionBig", 0.7)
	Fx.fade(1, 0.2, true)
	home.Close()
	api().gameplay(false)
	api().freeze(true)
	K.stopLoop(alarm, 0.2)
	K.stopLoop(drone, 0.2)
	for _, conn in S.conns do
		conn:Disconnect()
	end
	table.clear(S.conns)
	Audio.music(nil, 0.5)
end

----------------------------------------------------------------------------
-- CHAPTER 12: Home (+ after the credits)
----------------------------------------------------------------------------
local CREDITS = {
	{ text = { ru = "РИК И МОРТИ: КОМНАТА МОРТИ", en = "RICK AND MORTY: MORTY'S ROOM" }, big = true },
	{ ru = "фан-игра", en = "a fan game" },
	"",
	{ text = { ru = "СЮЖЕТ", en = "STORY" }, big = true },
	{ ru = "придумал игрок", en = "made up by the player" },
	"",
	{ text = { ru = "В РОЛЯХ", en = "STARRING" }, big = true },
	{ ru = "Морти — ты", en = "Morty — you" },
	{ ru = "Рик (настоящий и не очень)", en = "Rick (the real one and not so much)" },
	{ ru = "Злой Морти — в одном глазу", en = "Evil Morty — in one eye" },
	{ ru = "Титан Спикермен 2.0", en = "Titan Speakerman 2.0" },
	{ ru = "Кэм и Линза", en = "Cam and Lens" },
	{ ru = "Кубокорова — в роли себя", en = "Cube Cow — as herself" },
	"",
	{ ru = "Ни один телефон не пострадал. Кроме одного.", en = "No phones were harmed. Except one." },
	"",
	{ text = { ru = "СПАСИБО ЗА ИГРУ!", en = "THANKS FOR PLAYING!" }, big = true },
}

local function ch12(c, _fresh: boolean)
	api().state("story")
	api().gameplay(false)
	Fx.black(1)
	Fx.stopGlitch()
	Scenes.apply("HomeNight", true)
	K.setPhoneOnNightstand(false)
	K.setDoor(false, true)
	api().setSleeping(false)
	local rick = P.rick
	rick.glitch = 0
	local portalCF = CFrame.lookAt(Vector3.new(6.6, 3.6, 2.6), Vector3.new(0, 3.6, 2.6))
	local mortyCF = CFrame.lookAt(Vector3.new(4.4, 3, 2.6), Vector3.new(-6, 3, -2))
	K.holdCharacterAt(c, mortyCF)
	api().hideCharacter(true)
	local portal = openPortal(portalCF, "green", 6.5)
	rick:visible(true)
	rick.follow = nil
	rick:place(CFrame.lookAt(Vector3.new(4.4, 3.36, 4.8), Vector3.new(3, 3.36, 2.6)))
	rick:pose("stand")
	rick:snap()
	local eye = eyeOf(mortyCF)
	Director.start()
	Director.cut(CFrame.lookAt(eye.Position, eye.Position + Vector3.new(-1, -0.1, -0.35)), 70)
	Director.freeLook(true, { yaw = 1.6, pitchUp = 0.8, pitchDown = 0.8 })
	Audio.play("Whoosh")
	Fx.flash(rgb(200, 255, 200), 0.7, 0.02, 0.6)
	Fx.fade(0, 0.6)
	Fx.caption("loc.home")
	Fx.title("ch.12")
	c.check()
	portal.Close()
	Audio.music("MusicNight", 3)
	rick:lookAt(eye.Position)
	say(c, "Rick", "Ну так что, Морти? Блипс-энд-Читц? Там новый автомат «Рой» — проживёшь целую жизнь за пять минут!", "So what do you say, Morty? Blips and Chitz? The new Roy machine — live a whole life in five minutes!")
	say(c, "Morty", "Нет, Рик. Я сегодня навидался такого... Я спать.", "No, Rick. I've seen enough today... I'm going to bed.")
	say(c, "Rick", "Пф-ф. Скучный ты, Морти. *рыг* Ладно. Спокойной ночи.", "Pfft. You're boring, Morty. *burp* Fine. Good night.")
	Audio.play("Burp")
	Dialogue.hide()
	-- Rick leaves through the door
	K.setDoor(true)
	task.spawn(function()
		rick:walkTo(Vector3.new(6.5, 3.36, 6.6), 6)
		rick:walkTo(Vector3.new(6.5, 3.36, 10.5), 6)
		rick:visible(false)
		K.setDoor(false)
	end)
	say(c, "MortyThought", "Взорвавшийся телефон. Титан. Щупальца. Туалеты из космоса... Обычный вторник.", "An exploding phone. A Titan. Tentacles. Toilets from space... Just a normal Tuesday.", { auto = 2.4 })
	Dialogue.hide()
	-- go to bed
	local bed = R.house:FindFirstChild("Bed")
	if bed then
		bed:SetAttribute("Interact", "Bed")
	end
	Director.freeLook(false)
	K.giveControl(c, mortyCF)
	api().objective("obj.bed")
	c.interact("Bed")
	api().objective(nil)
	if bed then
		bed:SetAttribute("Interact", nil)
	end
	api().gameplay(false)
	api().freeze(true)
	api().hideCharacter(true)
	Director.start()
	Audio.play("Cloth")
	local lying = K.eyeFromHead(api().headCore.CFrame)
	Director.move(lying, 1.6, "smooth", 70)
	Director.freeLook(true, { yaw = 1.2, pitchUp = 0.8, pitchDown = 0.6 })
	api().lids(0.35, 2.2)
	say(c, "MortyThought", "Надеюсь, завтра будет самый обычный, скучный день...", "I hope tomorrow is a totally normal, boring day...", { auto = 2.2 })
	Dialogue.hide()
	api().lids(0, 1.6)
	api().snore(true)
	c.wait(1.2)
	Fx.fade(1, 1.4, true)
	api().snore(false)

	-- CREDITS -----------------------------------------------------------------
	Audio.music("MusicDreamy", 2)
	Director.freeLook(false)
	Fx.credits(CREDITS)
	c.check()
	Audio.music(nil, 2)
	c.wait(1)

	-- AFTER THE CREDITS: meanwhile, in the garage ---------------------------------
	api().lids(1, 0)
	local term = R.lab:FindFirstChild("Terminal")
	local screen = term and term:FindFirstChild("Screen1") :: BasePart?
	local screen2 = term and term:FindFirstChild("Screen2") :: BasePart?
	local text1 = screen and screen:FindFirstChild("Text", true) :: TextLabel?
	local text2 = screen2 and screen2:FindFirstChild("Text", true) :: TextLabel?
	start.term1 = start.term1 or (text1 and text1.Text)
	start.term2 = start.term2 or (text2 and text2.Text)
	Scenes.apply("HomeNight", true)
	-- (the saucer is still lying on B137)
	K.saucerTo(CFrame.new(6014, -1.2, -6) * CFrame.Angles(math.rad(14), math.rad(70), math.rad(-11)))
	Graphics.SetLight("GarageLight", false)
	Graphics.SetLight("VatGlow", true)
	if screen then
		local view = screen.CFrame * CFrame.new(1.2, 0.3, -6.5)
		Director.cut(CFrame.lookAt(view.Position, screen.Position + Vector3.new(0, 0, 1)), 60)
	end
	Fx.fade(0, 1.2)
	Fx.caption("loc.later")
	c.wait(1.6)
	for _, pct in { 98, 87, 61, 34, 12 } do
		if text1 then
			text1.Text = ("CENTRAL FINITE CURVE\n> integrity: %d%%\n> resonance: RISING\n> source: S-0"):format(pct)
			text1.TextColor3 = if pct < 40 then rgb(255, 90, 80) else rgb(120, 255, 140)
		end
		Audio.play("RadarPing", if pct < 40 then 0.8 else 1)
		c.wait(0.9)
	end
	if text2 then
		text2.Text = "!! BREACH DETECTED !!\n> visitor: C-???\n> access: PRIME"
		text2.TextColor3 = rgb(255, 90, 80)
	end
	Audio.play("OverheatBeep", 0.8)
	Fx.glitch(0.4, 0.3)
	c.wait(1.2)
	-- a cold portal opens behind
	local prime = P.prime
	local labCenter = if screen then screen.Position + Vector3.new(9, -4.3, 0) else Vector3.new(-32, -9, -21)
	local pcf = CFrame.lookAt(labCenter + Vector3.new(0, 3.5, 3), labCenter + Vector3.new(-4, 3.5, 0))
	local pp = openPortal(pcf, "white", 7)
	if screen then
		Director.move(CFrame.lookAt(screen.Position + Vector3.new(6, 0.4, -4), pcf.Position), 1.4, "smooth", 55)
	end
	prime:visible(true)
	prime.follow = nil
	local primeFrom = Vector3.new(pcf.Position.X, labCenter.Y + 3.36, pcf.Position.Z)
	prime:place(CFrame.lookAt(primeFrom, primeFrom + pcf.LookVector))
	prime:pose("stand")
	prime:snap()
	local walkTo = labCenter + Vector3.new(-1.5, 3.36, 1)
	prime:walkTo(walkTo, 4)
	pp.Close()
	local primeHead = prime.model:FindFirstChild("Head") :: BasePart?
	if primeHead then
		prime:lookAt(Director.base().Position)
		Director.move(CFrame.lookAt(primeHead.Position + primeHead.CFrame.LookVector * 5 + Vector3.new(0.6, 0.2, 0), primeHead.Position), 1.2, "smooth", 42)
	end
	say(c, "RickPrime", "Здравствуй, C-137.", "Hello, C-137.")
	say(c, "RickPrime", "Спасибо, что позвонил.", "Thanks for calling.")
	Dialogue.hide()
	c.wait(0.6)
	Fx.fade(1, 0.15, true)
	Audio.play("Boom", 0.6)
	Fx.title("tbc")
	c.wait(0.8)
	-- tidy up the garage screens for the next run
	if text1 and start.term1 then
		text1.Text = start.term1
		text1.TextColor3 = rgb(120, 255, 140)
	end
	if text2 and start.term2 then
		text2.Text = start.term2
		text2.TextColor3 = rgb(120, 255, 140)
	end
	prime:place(start.prime)
	api().toMenu()
end

----------------------------------------------------------------------------
-- public
----------------------------------------------------------------------------
function StoryCurve.onSpeaker(who: string?)
	if not P then
		return
	end
	if P.evil then
		P.evil.talking = (who == "EvilMorty")
	end
	if P.prime then
		P.prime.talking = (who == "RickPrime")
	end
	for key, name in { cam = "Cam", lens = "Lens", commander = "Commander" } do
		local p = S[key]
		if p then
			p.talking = (who == name)
		end
	end
	S.titanTalking = (who == "Titan")
end

function StoryCurve.init(kit)
	K = kit
	R, P = kit.R, kit.P
	local worlds = workspace:WaitForChild("Worlds")
	W.silent = worlds:WaitForChild("SilentDimension")
	W.silentSpots = W.silent:WaitForChild("SilentSpots")
	W.bell = W.silent:WaitForChild("CurveBell")
	W.cracks = W.silent:WaitForChild("Cracks")
	W.j22 = worlds:WaitForChild("WorldJ22")
	W.d716 = worlds:WaitForChild("WorldD716")
	W.k9 = worlds:WaitForChild("WorldK9")
	W.base = worlds:WaitForChild("CameraBase")
	W.baseSpots = W.base:WaitForChild("BaseSpots")
	W.formation = W.base:WaitForChild("BaseFormation")
	W.shed = R.planet:WaitForChild("BunkerShed")
	W.astro = workspace:WaitForChild("Astro")
	W.mother = W.astro:WaitForChild("Mothership")
	W.curseHead = R.fight:WaitForChild("CurseHead")
	W.templates = Game:WaitForChild("Templates")

	P.evil = Puppet.new(R.cast:WaitForChild("EvilMorty"), "R6")
	P.prime = Puppet.new(R.cast:WaitForChild("RickPrime"), "R6")
	P.rickBeast = Puppet.new(R.fight:WaitForChild("RickBeast"), "Rig")
	P.evilBeast = Puppet.new(R.fight:WaitForChild("EvilBeast"), "Rig")
	P.pit = Puppet.new(R.fight:WaitForChild("PitTentacles"), "Rig")

	start.evil = P.evil.root.CFrame
	start.prime = P.prime.root.CFrame
	start.rickBeast = P.rickBeast.root.CFrame
	start.evilBeast = P.evilBeast.root.CFrame
	start.pit = P.pit.root.CFrame
	start.entity = P.entity.root.CFrame
	start.curseHead = W.curseHead:GetPivot()
	start.mother = W.mother:GetPivot()
	start.ships = {}
	for i = 1, 10 do
		local ship = W.astro:FindFirstChild("AstroShip" .. i)
		start.ships[i] = if ship then ship:GetPivot() else CFrame.new()
	end
	start.prongs = {}
	for _, p in partsWithAttr(W.bell, "BellProng") do
		start.prongs[p] = p.CFrame
	end
	start.shedDoor = {}
	local door = W.shed:FindFirstChild("ShedDoor")
	if door then
		for _, d in door:GetDescendants() do
			if d:IsA("BasePart") then
				start.shedDoor[d] = d.CFrame
			end
		end
	end
	-- Evil Morty wears his own angry brows: hide the default ones
	for _, n in { "BrowL", "BrowR" } do
		local p = P.evil.model:FindFirstChild(n, true)
		if p and p:IsA("BasePart") then
			p.Transparency = 1
		end
	end
	evilFace(false)

	-- the Titan's head speaker pulses when he talks; the Commander's screen flickers
	local eyeLight = R.titanModel:FindFirstChild("EyeLight", true) :: PointLight?
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		if eyeLight then
			eyeLight.Brightness = if S.titanTalking then 1.5 + math.abs(math.sin(t * 13)) * 6 else 1.5
		end
		local cmd = S.commander
		if cmd and cmd.talking then
			local scr = cmd.model:FindFirstChild("Screen", true) :: BasePart?
			if scr then
				local v = 0.75 + math.abs(math.sin(t * 17)) * 0.25
				scr.Color = Color3.new(0.67 * v, 0.82 * v, v)
			end
		end
	end)

	K.CH[7] = ch7
	K.CH[8] = ch8
	K.CH[9] = ch9
	K.CH[10] = ch10
	K.CH[11] = ch11
	K.CH[12] = ch12
end

function StoryCurve.reset()
	if not K then
		return
	end
	for _, conn in S.conns do
		conn:Disconnect()
	end
	table.clear(S.conns)
	for _, s in S.loops do
		if s and s.Parent then
			s:Destroy()
		end
	end
	table.clear(S.loops)
	closePortals()
	clearCrowd()
	holdCurseHead(false)
	W.curseHead:PivotTo(start.curseHead)
	hideBeasts()
	titanWounded(false)
	cannonCharge(0)
	shedVisible(false)
	shedDoor(0)
	resetSilent()
	placeShips(false)
	W.mother:PivotTo(start.mother)
	local beamCore = W.mother:FindFirstChild("BeamCore") :: BasePart?
	if beamCore then
		beamCore.Size = Vector3.new(30, 90, 90)
	end
	cityFx(false)
	for _, key in { "evil", "prime" } do
		local p = P[key]
		p.follow = nil
		p.walk = 0
		p.glitch = 0
		p:lookAt(nil)
		p:visible(true)
		p:place(start[key])
	end
	stopFollow(P.rick)
	evilFace(false)
	local hum = api().humanoid()
	if hum then
		hum.WalkSpeed = 9
	end
	local bed = R.house:FindFirstChild("Bed")
	if bed then
		bed:SetAttribute("Interact", nil)
	end
	for _, worldName in { "j22", "k9" } do
		local wm = W[worldName]
		if wm then
			K.emitters(wm, nil, false)
		end
	end
	local eyes = W.k9 and W.k9:FindFirstChild("SporeEyes")
	if eyes then
		for _, p in eyes:GetChildren() do
			if p:IsA("BasePart") then
				p.Transparency = 1
			end
		end
	end
	Fx.death(false)
	S.titanTalking = false
end

return StoryCurve
]]></string>
