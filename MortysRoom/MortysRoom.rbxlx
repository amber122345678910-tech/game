      <Item class="Humanoid" referent="6910">
        <Properties>
          <string name="Name">Humanoid</string>
          <token name="DisplayDistanceType">2</token>
          <token name="HealthDisplayType">2</token>
          <float name="HipHeight">0</float>
          <token name="RigType">0</token>
        </Properties>
        <Item class="Animator" referent="6911">
          <Properties>
            <string name="Name">Animator</string>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="6912">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- Minimal R6 animation script for the Morty StarterCharacter (uses Roblox's default R6 animations).
local character = script.Parent
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

local IDS = {
	idle = "rbxassetid://180435571",
	walk = "rbxassetid://180426354",
	jump = "rbxassetid://125750702",
	fall = "rbxassetid://180436148",
	climb = "rbxassetid://180436334",
	sit = "rbxassetid://178130996",
}

local tracks: { [string]: AnimationTrack } = {}
for name, id in IDS do
	local anim = Instance.new("Animation")
	anim.Name = name
	anim.AnimationId = id
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	if ok and track then
		tracks[name] = track
		track.Priority = if name == "idle" then Enum.AnimationPriority.Idle else Enum.AnimationPriority.Movement
	end
end

local current: AnimationTrack? = nil
local function play(name: string, fade: number?, speed: number?)
	local track = tracks[name]
	if not track then
		return
	end
	if current ~= track then
		if current then
			current:Stop(fade or 0.2)
		end
		current = track
		track:Play(fade or 0.2)
	end
	if speed then
		track:AdjustSpeed(speed)
	end
end

humanoid.Running:Connect(function(speed: number)
	if speed > 0.5 then
		play("walk", 0.2, speed / 14.5)
	else
		play("idle", 0.3, 1)
	end
end)
humanoid.Jumping:Connect(function(active: boolean)
	if active then
		play("jump", 0.1)
	end
end)
humanoid.FreeFalling:Connect(function(active: boolean)
	if active then
		play("fall", 0.2)
	end
end)
humanoid.Climbing:Connect(function(speed: number)
	play("climb", 0.1, speed / 5)
end)
humanoid.Seated:Connect(function(active: boolean)
	if active then
		play("sit", 0.4)
	end
end)

play("idle", 0)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="6913">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="6914">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="6915">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	GAME CONFIG  —  change things here.

	MenuStyle  : which main menu you see.   "Cinematic" | "Cartoon" | "Monitor" | "VHS" | "Notebook"
	Graphics   : starting graphics preset.  "Moonlight" | "Sunrise" | "Cartoon" | "Portal" | "Noir"
	ShowStylePicker : the little bar at the bottom of the menu that lets you flip
	                  through the variants. Set to false when you have picked your favourite.
]]
local Config = {}

Config.Title = "RICK AND MORTY"
Config.Subtitle = "WAKE UP, MORTY"
Config.Version = "v0.1"

Config.MenuStyle = "Cinematic"
Config.Graphics = "Moonlight"
Config.ShowStylePicker = true

Config.MenuStyles = { "Cinematic", "Cartoon", "Monitor", "VHS", "Notebook" }
Config.GraphicsPresets = { "Moonlight", "Sunrise", "Cartoon", "Portal", "Noir" }

-- Default values of the Settings page
Config.Defaults = {
	Music = 0.6,
	Sound = 0.8,
	Sensitivity = 1.0,
	FOV = 72,
	Brightness = 0,
	HeadBob = true,
	ShowBody = true,
	Language = "RU", -- "RU" or "EN" (dialogues and hints)
}

--[[
	SOUNDS
	All of these are public Roblox audio (licensed APM music, Pro Sound Effects
	library, official Roblox UI sounds, or files that ship with the Roblox client),
	so they play in any game. To use a different sound, paste another
	"rbxassetid://NUMBER" into Id. Volume is 0..1 (before the Settings sliders).
]]
Config.Sounds = {
	-- Menu music (each menu style picks one)
	MusicDreamy = { Id = "rbxassetid://9046435309", Volume = 0.45, Looped = true, Group = "Music" }, -- The Still, Sad Music Of Humanity (APM)
	MusicLofi = { Id = "rbxassetid://9043887091", Volume = 0.5, Looped = true, Group = "Music" }, -- Lo-fi Chill A (APM)
	MusicNight = { Id = "rbxassetid://9047105702", Volume = 0.5, Looped = true, Group = "Music" }, -- Light Dreamer (APM)
	MusicSynth = { Id = "rbxassetid://1837087135", Volume = 0.45, Looped = true, Group = "Music" }, -- Ambient Light (APM)

	-- Room
	Snore = { Id = "rbxassetid://9113862735", Volume = 0.55, Looped = true, Group = "SFX", RollOff = 26 }, -- Comic Snoring Male (PSE)
