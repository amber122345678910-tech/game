        <Item class="ModuleScript" referent="828">
          <Properties>
            <string name="Name">Cinematic</string>
            <string name="Source"><![CDATA[-- STYLE 1: "Cinematic" — quiet, film-like. Letterbox bars, thin type, slow push-in on sleeping Morty.
local Game = script.Parent.Parent
local UI = require(Game.UI)
local Config = require(Game.Config)

local Style = {}
Style.Name = "Cinematic"
Style.Music = "MusicDreamy"

local HEAD = Vector3.new(-8.15, 3.29, -6.65)
Style.Camera = {
	From = { Pos = Vector3.new(-3.4, 5.1, 0.9), Look = HEAD, Yaw = 13 },
	To = { Pos = Vector3.new(-4.9, 4.6, -2.4), Look = HEAD, Yaw = 13 },
	Duration = 30,
	FOV = 40,
	Focus = HEAD,
	Sway = 0.18,
}

local WHITE = Color3.fromRGB(238, 240, 246)
local DIM = Color3.fromRGB(150, 156, 172)
local ACCENT = Color3.fromRGB(151, 206, 76)
local LEFT = 150

function Style.Build(ctx)
	local api = {}

	local root = UI.full(ctx.Full, "Cinematic")
	local shade = UI.new("Frame", {
		Name = "Shade",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0.68, 1),
		Parent = root,
	}, { UI.gradient(nil, { 0.25, 0.55, 1 }, 0) })
	local topShade = UI.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 0.3),
		Parent = root,
	}, { UI.gradient(nil, { 0.5, 1 }, 90) })
	local barTop = UI.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 0),
		ZIndex = 10,
		Parent = root,
	})
	local barBottom = UI.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		ZIndex = 10,
		Parent = root,
	})

	local content = UI.new("CanvasGroup", {
		Name = "CinematicContent",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		Parent = ctx.Canvas,
	})

	UI.label({
		Text = UI.spaced(Config.Title),
		Font = Enum.Font.GothamMedium,
		TextSize = 20,
		TextColor3 = DIM,
		Position = UDim2.fromOffset(LEFT + 2, 236),
		Size = UDim2.fromOffset(900, 26),
		Parent = content,
	})
	UI.label({
		Text = Config.Subtitle,
		Font = Enum.Font.Oswald,
		TextSize = 104,
		TextColor3 = WHITE,
		Position = UDim2.fromOffset(LEFT - 4, 262),
		Size = UDim2.fromOffset(1000, 120),
		Parent = content,
	})
	local rule = UI.new("Frame", {
		BackgroundColor3 = ACCENT,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(LEFT, 392),
		Size = UDim2.fromOffset(0, 3),
		Parent = content,
	})

	local pages = UI.new("Frame", {
		Name = "Pages",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(LEFT, 440),
		Size = UDim2.fromOffset(760, 600),
		Parent = content,
	})

	UI.label({
		Text = Config.Version,
		Font = Enum.Font.GothamMedium,
		TextSize = 16,
		TextColor3 = DIM,
		TextTransparency = 0.3,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, LEFT, 1, -120),
		Size = UDim2.fromOffset(200, 20),
		Parent = content,
	})
	UI.label({
		Text = "↑ ↓  NAVIGATE      ENTER  SELECT",
		Font = Enum.Font.GothamMedium,
		TextSize = 16,
		TextColor3 = DIM,
		TextTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -LEFT, 1, -120),
		Size = UDim2.fromOffset(500, 20),
		Parent = content,
	})

	api.Theme = {
		Font = Enum.Font.GothamMedium,
		Text = WHITE,
		TextDim = DIM,
		Accent = ACCENT,
		Track = WHITE,
		TrackTransparency = 0.8,
		TrackHeight = 3,
		Knob = WHITE,
		KnobSize = 14,
		Corner = 2,
		RowHeight = 46,
		LabelSize = 21,
		Width = 700,
		ValueWidth = 90,
		Uppercase = true,
	}

	function api.NewPage(name: string)
		local page = UI.new("CanvasGroup", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = pages,
		}, { UI.list(4) })
		return page
	end

	function api.MakeButton(parent: Instance, text: string, order: number, kind: string)
		local big = kind == "primary"
		local button = UI.new("TextButton", {
			Name = text,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Text = "",
			Size = UDim2.fromOffset(560, if big then 70 else 56),
			LayoutOrder = order,
			Parent = parent,
		})
		local bar = UI.new("Frame", {
			BackgroundColor3 = ACCENT,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(0, 2),
			Parent = button,
		})
		local label = UI.label({
			Text = string.upper(text),
			Font = Enum.Font.GothamMedium,
			TextSize = if big then 42 elseif kind == "back" then 24 else 30,
			TextColor3 = WHITE,
			TextTransparency = 0.45,
			Size = UDim2.fromScale(1, 1),
			Parent = button,
		})
		local function setHover(on: boolean)
			UI.tween(bar, 0.28, { Size = UDim2.fromOffset(if on then 36 else 0, 2) }, Enum.EasingStyle.Quint)
			UI.tween(label, 0.28, {
				Position = UDim2.fromOffset(if on then 52 else 0, 0),
				TextTransparency = if on then 0 else 0.45,
				TextColor3 = if on and kind == "danger" then Color3.fromRGB(255, 140, 120) else WHITE,
			}, Enum.EasingStyle.Quint)
		end
		return button, setHover
	end

	function api.MakeHeading(parent: Instance, text: string, order: number)
		return UI.label({
			Text = string.upper(text),
			Font = Enum.Font.Oswald,
			TextSize = 48,
			TextColor3 = WHITE,
			Size = UDim2.fromOffset(700, 64),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.MakeText(parent: Instance, text: string, order: number)
		return UI.label({
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 22,
			TextColor3 = DIM,
			TextWrapped = true,
			Size = UDim2.fromOffset(680, 36),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.ShowPage(page: CanvasGroup, old: CanvasGroup?, instant: boolean?)
		if old then
			if instant then
				old.Visible = false
			else
				UI.tween(old, 0.18, { GroupTransparency = 1 })
				task.delay(0.18, function()
					old.Visible = false
				end)
			end
		end
		page.Visible = true
		if instant then
			page.GroupTransparency = 0
			page.Position = UDim2.fromOffset(0, 0)
		else
			page.GroupTransparency = 1
			page.Position = UDim2.fromOffset(-24, 0)
			UI.tween(page, 0.45, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint, nil, 0.12)
		end
	end

	function api.Intro()
		UI.tween(barTop, 1.4, { Size = UDim2.fromScale(1, 0.085) }, Enum.EasingStyle.Quint)
		UI.tween(barBottom, 1.4, { Size = UDim2.fromScale(1, 0.085) }, Enum.EasingStyle.Quint)
		content.Position = UDim2.fromOffset(-30, 0)
		UI.tween(content, 1.6, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint, nil, 0.4)
		UI.tween(rule, 1.2, { Size = UDim2.fromOffset(72, 3) }, Enum.EasingStyle.Quint, nil, 1.0)
	end

	function api.Outro(done: () -> ())
		UI.tween(content, 0.7, { GroupTransparency = 1, Position = UDim2.fromOffset(-30, 0) }, Enum.EasingStyle.Quint)
		UI.tween(shade, 1.2, { BackgroundTransparency = 1 })
		UI.tween(topShade, 1.2, { BackgroundTransparency = 1 })
		UI.tween(barTop, 1.4, { Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Quint, nil, 0.3)
		UI.tween(barBottom, 1.4, { Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Quint, nil, 0.3)
		task.delay(0.75, done)
	end

	function api.Destroy()
		root:Destroy()
		content:Destroy()
	end

	return api
end

return Style
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="829">
          <Properties>
            <string name="Name">Cartoon</string>
            <string name="Source"><![CDATA[-- STYLE 2: "Cartoon" — loud and bouncy, like the show. Chunky outlined buttons, swirling portal behind the logo.
local Game = script.Parent.Parent
local UI = require(Game.UI)
local Config = require(Game.Config)

local Style = {}
Style.Name = "Cartoon"
Style.Music = "MusicLofi"

Style.Camera = {
	From = { Pos = Vector3.new(0.6, 6.4, 7.2), Look = Vector3.new(-7.4, 2.6, -5.2), Yaw = 17 },
	To = { Pos = Vector3.new(2.4, 6.0, 7.0), Look = Vector3.new(-7.4, 2.6, -5.2), Yaw = 17 },
	Duration = 22,
	FOV = 60,
	Sway = 0.35,
}

local rgb = Color3.fromRGB
local INK = rgb(44, 28, 16)
local CREAM = rgb(252, 246, 226)
local FILLS = {
	primary = rgb(151, 206, 76),
	normal = rgb(92, 198, 224),
	danger = rgb(240, 120, 96),
	back = rgb(246, 222, 80),
}
local TILTS = { -2.5, 1.8, -1.2, 2.2, -1.8 }

local function splitTitle(title: string): (string, string)
	local words = string.split(title, " ")
	if #words < 2 then
		return "", title
	end
	local last = table.remove(words) :: string
	return table.concat(words, " "), last
end

function Style.Build(ctx)
	local api = {}
	local tick0 = os.clock()

	local content = UI.new("Frame", {
		Name = "CartoonContent",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = ctx.Canvas,
	})

	-- logo + portal ---------------------------------------------------------------
	local logo = UI.new("Frame", {
		Name = "Logo",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(70, 40),
		Size = UDim2.fromOffset(760, 330),
		Rotation = -4,
		Parent = content,
	})
	local logoScale = UI.new("UIScale", { Scale = 0, Parent = logo })

	local portal = UI.new("Frame", {
		Name = "Portal",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(330, 175),
		Size = UDim2.fromOffset(600, 380),
		Parent = logo,
	})
	local ringColors = {
		{ rgb(34, 110, 30), rgb(80, 170, 40) },
		{ rgb(90, 180, 40), rgb(160, 225, 80) },
		{ rgb(160, 225, 80), rgb(220, 250, 160) },
		{ rgb(225, 252, 190), rgb(250, 255, 235) },
	}
	local ringGradients = {}
	for i, cols in ringColors do
		local f = 1 - (i - 1) * 0.2
		local ring = UI.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(f, f),
			Parent = portal,
		}, { UI.round() })
		local g = UI.gradient({ cols[1], cols[2], cols[1], cols[2], cols[1] }, nil, i * 40)
		g.Parent = ring
		table.insert(ringGradients, g)
		if i == 1 then
			UI.stroke(10, rgb(120, 230, 60), 0.55, true).Parent = ring
		end
	end

	local line1, line2 = splitTitle(Config.Title)
	local function logoText(text: string, y: number, size: number)
		local shadow = UI.label({
			Text = text,
			Font = Enum.Font.LuckiestGuy,
			TextSize = size,
			TextColor3 = rgb(70, 40, 20),
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(9, y + 10),
			Size = UDim2.new(1, 0, 0, size + 10),
			Parent = logo,
		})
		UI.stroke(7, rgb(70, 40, 20)).Parent = shadow
		local main = UI.label({
			Text = text,
			Font = Enum.Font.LuckiestGuy,
			TextSize = size,
			TextColor3 = rgb(86, 204, 228),
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, size + 10),
			Parent = logo,
		})
		UI.stroke(7, rgb(206, 238, 80)).Parent = main
		return main
	end
	logoText(line1, 40, 92)
	logoText(line2, 120, 150)

	local tag = UI.new("Frame", {
		Name = "Tag",
		BackgroundColor3 = rgb(246, 222, 80),
		Position = UDim2.fromOffset(250, 290),
		Size = UDim2.fromOffset(340, 58),
		Rotation = 7,
		Parent = logo,
	}, { UI.corner(14), UI.stroke(4, INK, 0, true) })
	UI.label({
		Text = Config.Subtitle .. "!",
		Font = Enum.Font.LuckiestGuy,
		TextSize = 32,
		TextColor3 = INK,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = tag,
	})

	local pages = UI.new("Frame", {
		Name = "Pages",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(120, 420),
		Size = UDim2.fromOffset(760, 640),
		Parent = content,
	})

	api.Theme = {
		Font = Enum.Font.FredokaOne,
		Text = INK,
		TextDim = rgb(120, 92, 64),
		Accent = rgb(120, 190, 60),
		Track = INK,
		TrackTransparency = 0.82,
		TrackHeight = 10,
		Knob = Color3.new(1, 1, 1),
		KnobStroke = INK,
		KnobStrokeThickness = 3,
		KnobSize = 24,
		Corner = 5,
		RowHeight = 48,
		LabelSize = 26,
		Width = 640,
		ValueWidth = 80,
		Uppercase = false,
	}

	local mainScales = {}

	function api.NewPage(name: string)
		if name == "Main" then
			local page = UI.new("Frame", {
				Name = name,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Parent = pages,
			}, { UI.list(14) })
			return page
		end
		-- other pages live on a cream card
		local holder = UI.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(720, 630),
			Visible = false,
			Parent = pages,
		})
		UI.new("Frame", {
			BackgroundColor3 = INK,
			Position = UDim2.fromOffset(10, 12),
			Size = UDim2.fromScale(1, 1),
			Parent = holder,
		}, { UI.corner(30) })
		local card = UI.new("Frame", {
			Name = "Card",
			BackgroundColor3 = CREAM,
			Size = UDim2.fromScale(1, 1),
			Parent = holder,
		}, { UI.corner(30), UI.stroke(5, INK, 0, true), UI.padding(36, 22, 36, 22), UI.list(4) })
		holder:SetAttribute("Card", true)
		local scale = UI.new("UIScale", { Parent = holder })
		holder:SetAttribute("HasScale", true)
		return card, scale
	end

	function api.MakeButton(parent: Instance, text: string, order: number, kind: string)
		local big = kind == "primary"
		local h = if big then 100 elseif kind == "back" then 70 else 84
		local holder = UI.new("Frame", {
			Name = text,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(if kind == "back" then 260 else 400, h + 8),
			LayoutOrder = order,
			Rotation = TILTS[(order % #TILTS) + 1],
			Parent = parent,
		})
		local scale = UI.new("UIScale", { Parent = holder })
		if parent.Name == "Main" then
			scale.Scale = 0
			table.insert(mainScales, scale)
		end
		UI.new("Frame", {
			BackgroundColor3 = INK,
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 1, -8),
			Parent = holder,
		}, { UI.corner(26) })
		local face = UI.new("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = FILLS[kind] or FILLS.normal,
			Text = "",
			Size = UDim2.new(1, 0, 1, -8),
			Parent = holder,
		}, { UI.corner(26), UI.stroke(4, INK, 0, true) })
		UI.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(22, 10),
			Size = UDim2.new(0.45, 0, 0, 8),
			Parent = face,
		}, { UI.round() })
		UI.label({
			Text = string.upper(text),
			Font = Enum.Font.LuckiestGuy,
			TextSize = if big then 54 elseif kind == "back" then 34 else 42,
			TextColor3 = INK,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 4),
			Size = UDim2.fromScale(1, 1),
			Parent = face,
		})
		local baseRot = holder.Rotation
		local function setHover(on: boolean)
			UI.tween(face, 0.22, { Position = UDim2.fromOffset(0, if on then -5 else 0) }, Enum.EasingStyle.Back)
			UI.tween(holder, 0.22, { Rotation = if on then 0 else baseRot }, Enum.EasingStyle.Back)
			UI.tween(scale, 0.22, { Scale = if on then 1.06 else 1 }, Enum.EasingStyle.Back)
		end
		face.MouseButton1Down:Connect(function()
			UI.tween(face, 0.08, { Position = UDim2.fromOffset(0, 6) })
		end)
		face.MouseButton1Up:Connect(function()
			UI.tween(face, 0.15, { Position = UDim2.fromOffset(0, -5) }, Enum.EasingStyle.Back)
		end)
		return face, setHover
	end

	function api.MakeHeading(parent: Instance, text: string, order: number)
		return UI.label({
			Text = string.upper(text),
			Font = Enum.Font.LuckiestGuy,
			TextSize = 52,
			TextColor3 = INK,
			Size = UDim2.fromOffset(640, 70),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.MakeText(parent: Instance, text: string, order: number)
		return UI.label({
			Text = text,
			Font = Enum.Font.FredokaOne,
			TextSize = 24,
			TextColor3 = rgb(90, 66, 44),
			TextWrapped = true,
			Size = UDim2.fromOffset(640, 40),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.ShowPage(page: Frame, old: Frame?, instant: boolean?)
		local function holderOf(p: Instance): GuiObject
			return (if p.Name == "Card" then p.Parent else p) :: GuiObject
		end
		if old then
			holderOf(old).Visible = false
		end
		local h = holderOf(page)
		h.Visible = true
		page.Visible = true
		local scale = h:FindFirstChildOfClass("UIScale")
		if scale and not instant then
			scale.Scale = 0.6
			UI.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		if page.Name == "Main" and not instant then
			for _, s in mainScales do
				s.Scale = 1
			end
		end
	end

	function api.Intro()
		UI.tween(logoScale, 0.7, { Scale = 1 }, Enum.EasingStyle.Back, nil, 0.2)
		for i, s in mainScales do
			UI.tween(s, 0.45, { Scale = 1 }, Enum.EasingStyle.Back, nil, 0.5 + i * 0.09)
		end
	end

	function api.Outro(done: () -> ())
		for i, s in mainScales do
			UI.tween(s, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In, (i - 1) * 0.05)
		end
		UI.tween(logo, 0.6, { Position = UDim2.fromOffset(70, -420), Rotation = -14 }, Enum.EasingStyle.Back, Enum.EasingDirection.In, 0.15)
		task.delay(0.8, done)
	end

	function api.Update(_dt: number)
		local t = os.clock() - tick0
		for i, g in ringGradients do
			g.Rotation = (i * 40 + t * (40 + i * 25) * (if i % 2 == 0 then -1 else 1)) % 360
		end
		portal.Rotation = math.sin(t * 0.7) * 4
		portal.Size = UDim2.fromOffset(600 + math.sin(t * 2.1) * 14, 380 + math.cos(t * 1.7) * 10)
		logo.Position = UDim2.fromOffset(70, 40 + math.sin(t * 1.6) * 6)
	end

	function api.Destroy()
		content:Destroy()
	end

	return api
end

return Style
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="830">
          <Properties>
            <string name="Name">Monitor</string>
            <string name="Source"><![CDATA[-- STYLE 3: "Monitor" — the menu lives on Morty's old CRT computer. Green terminal text, scanlines, CRT power-on.
local Game = script.Parent.Parent
local UI = require(Game.UI)
local Config = require(Game.Config)

local Style = {}
Style.Name = "Monitor"
Style.Music = "MusicSynth"

local SCREEN = Vector3.new(8.09, 3.72, -3.8)
Style.Camera = {
	From = { Pos = Vector3.new(5.85, 4.1, -2.5), Look = SCREEN },
	To = { Pos = Vector3.new(6.1, 4.25, -3.15), Look = SCREEN },
	Duration = 18,
	FOV = 44,
	Focus = SCREEN,
	Sway = 0.08,
}

local rgb = Color3.fromRGB
local GREEN = rgb(120, 255, 150)
local GREEN_DIM = rgb(60, 170, 92)
local BG = rgb(6, 14, 10)

function Style.Build(ctx)
	local api = {}
	local t0 = os.clock()
	local house = workspace:WaitForChild("MortysHouse")
	local monitor = house:WaitForChild("Monitor")
	local screen = monitor:WaitForChild("Screen") :: BasePart
	local saver = screen:FindFirstChild("ScreenSaver") :: SurfaceGui?
	if saver then
		saver.Enabled = false
	end

	local sg = UI.new("SurfaceGui", {
		Name = "MonitorMenu",
		Adornee = screen,
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 260,
		LightInfluence = 0,
		Brightness = 1.8,
		ClipsDescendants = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = ctx.Gui.Parent,
	})

	local tube = UI.new("Frame", {
		Name = "Tube",
		BackgroundColor3 = BG,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 0.004),
		ClipsDescendants = true,
		Parent = sg,
	}, { UI.gradient({ rgb(14, 30, 20), BG }, nil, 90) })

	-- header bar
	local header = UI.new("Frame", {
		BackgroundColor3 = GREEN,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = tube,
	})
	UI.label({
		Text = " MORTY-OS 2.3",
		Font = Enum.Font.RobotoMono,
		TextSize = 17,
		TextColor3 = BG,
		Size = UDim2.fromScale(0.6, 1),
		Parent = header,
	})
	local clockLabel = UI.label({
		Text = "03:14",
		Font = Enum.Font.RobotoMono,
		TextSize = 17,
		TextColor3 = BG,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 0),
		Size = UDim2.fromScale(0.4, 1),
		Parent = header,
	})

	local titleBlock = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(22, 36),
		Size = UDim2.new(1, -44, 0, 70),
		Parent = tube,
	})
	local title = UI.label({
		Text = Config.Title,
		Font = Enum.Font.Arcade,
		TextSize = 30,
		TextColor3 = GREEN,
		Size = UDim2.new(1, 0, 0, 34),
		Parent = titleBlock,
	})
	UI.stroke(2, GREEN, 0.85).Parent = title
	local prompt = UI.label({
		Text = "> wake_up_morty.exe",
		Font = Enum.Font.RobotoMono,
		TextSize = 17,
		TextColor3 = GREEN_DIM,
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = titleBlock,
	})

	local pages = UI.new("Frame", {
		Name = "Pages",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(22, 112),
		Size = UDim2.new(1, -44, 1, -120),
		Parent = tube,
	})

	-- scanlines + flicker on top of everything
	local lines = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = tube })
	for y = 0, 400, 4 do
		UI.new("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, 2),
			ZIndex = 50,
			Parent = lines,
		})
	end
	local flicker = UI.new("Frame", {
		BackgroundColor3 = GREEN,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 51,
		Parent = tube,
	})
	local vignette = UI.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 49,
		Parent = tube,
	}, { UI.gradient(nil, { 0.35, 1, 1, 0.35 }, 0) })
	vignette.BackgroundTransparency = 0.2

	-- hint on the real screen
	local hint = UI.label({
		Text = "CLICK THE SCREEN",
		Font = Enum.Font.GothamMedium,
		TextSize = 16,
		TextColor3 = Color3.new(1, 1, 1),
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(400, 24),
		Parent = ctx.Canvas,
	})

	api.Theme = {
		Font = Enum.Font.RobotoMono,
		Text = GREEN,
		TextDim = GREEN_DIM,
		Accent = GREEN,
		RowHeight = 25,
		LabelSize = 16,
		Width = 446,
		ValueWidth = 70,
		Uppercase = true,
		Textual = true,
	}

	function api.NewPage(name: string)
		return UI.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = pages,
		}, { UI.list(2) })
	end

	function api.MakeButton(parent: Instance, text: string, order: number, kind: string)
		local button = UI.new("TextButton", {
			Name = text,
			AutoButtonColor = false,
			BackgroundColor3 = GREEN,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			Size = UDim2.fromOffset(300, if kind == "primary" then 36 else 30),
			LayoutOrder = order,
			Parent = parent,
		})
		local label = UI.label({
			Text = "  " .. string.upper(text),
			Font = Enum.Font.RobotoMono,
			TextSize = if kind == "primary" then 24 else 20,
			TextColor3 = GREEN,
			Size = UDim2.fromScale(1, 1),
			Parent = button,
		})
		local function setHover(on: boolean)
			button.BackgroundTransparency = if on then 0 else 1
			label.TextColor3 = if on then BG else GREEN
			label.Text = (if on then "> " else "  ") .. string.upper(text)
		end
		return button, setHover
	end

	function api.MakeHeading(parent: Instance, text: string, order: number)
		return UI.label({
			Text = "== " .. string.upper(text) .. " ==",
			Font = Enum.Font.RobotoMono,
			TextSize = 20,
			TextColor3 = GREEN,
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.MakeText(parent: Instance, text: string, order: number)
		return UI.label({
			Text = "- " .. text,
			Font = Enum.Font.RobotoMono,
			TextSize = 14,
			TextColor3 = GREEN_DIM,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 36),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.ShowPage(page: Frame, old: Frame?, _instant: boolean?)
		if old then
			old.Visible = false
		end
		page.Visible = true
		local isMain = page.Name == "Main"
		titleBlock.Visible = isMain
		pages.Position = UDim2.fromOffset(22, if isMain then 112 else 34)
		pages.Size = UDim2.new(1, -44, 1, if isMain then -120 else -40)
		flicker.BackgroundTransparency = 0.7
		UI.tween(flicker, 0.25, { BackgroundTransparency = 1 })
	end

	function api.Intro()
		UI.tween(tube, 0.18, { Size = UDim2.fromScale(1, 0.02) }, Enum.EasingStyle.Quad)
		task.delay(0.2, function()
			UI.tween(tube, 0.4, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)
		end)
		flicker.BackgroundTransparency = 0.2
		UI.tween(flicker, 0.9, { BackgroundTransparency = 1 }, nil, nil, 0.3)
		UI.tween(hint, 0.8, { TextTransparency = 0.4 }, nil, nil, 1.5)
	end

	function api.Outro(done: () -> ())
		UI.tween(hint, 0.3, { TextTransparency = 1 })
		UI.tween(tube, 0.18, { Size = UDim2.fromScale(1, 0.01) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.2, function()
			UI.tween(tube, 0.15, { Size = UDim2.fromScale(0.01, 0.01) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
		task.delay(0.4, done)
	end

	local blink = 0
	function api.Update(dt: number)
		blink += dt
		local on = math.floor(blink * 2) % 2 == 0
		prompt.Text = "> wake_up_morty.exe" .. (if on then "_" else " ")
		if math.random() < 0.02 then
			flicker.BackgroundTransparency = 0.94
			UI.tween(flicker, 0.12, { BackgroundTransparency = 1 })
		end
		local t = os.clock() - t0
		clockLabel.Text = string.format("03:%02d", 14 + math.floor(t / 60) % 45)
	end

	function api.Destroy()
		sg:Destroy()
		hint:Destroy()
		if saver then
			saver.Enabled = true
		end
	end

	return api
end

return Style
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="831">
          <Properties>
            <string name="Name">VHS</string>
            <string name="Source"><![CDATA[-- STYLE 4: "VHS" — an old camcorder tape of Morty sleeping. Pixel on-screen display, scanlines, tracking noise.
local Game = script.Parent.Parent
local UI = require(Game.UI)
local Config = require(Game.Config)

local Style = {}
Style.Name = "VHS"
Style.Music = "MusicNight"
Style.MenuBlur = 2

Style.Camera = {
	From = { Pos = Vector3.new(9.2, 7.9, 7.2), Look = Vector3.new(-7.0, 2.2, -5.2) },
	To = { Pos = Vector3.new(9.2, 7.9, 7.2), Look = Vector3.new(-2.0, 2.4, -7.2) },
	Duration = 16,
	FOV = 74,
	Sway = 0.5,
	Shake = 0.004,
}

local rgb = Color3.fromRGB
local WHITE = rgb(246, 246, 246)
local CYAN = rgb(90, 230, 255)
local FONT = Enum.Font.Arcade

local NAMES = {
	Play = "PLAY",
	Resume = "PLAY",
	Settings = "SETUP",
	Credits = "CREDITS",
	Quit = "EJECT",
	["Main Menu"] = "STOP",
	Back = "RETURN",
	Yes = "YES",
	No = "NO",
}

local function osd(parent: Instance, props): TextLabel
	-- text with a hard black drop shadow, like a real VCR on-screen display
	local shadowProps = table.clone(props)
	shadowProps.Name = "Shadow"
	shadowProps.TextColor3 = Color3.new(0, 0, 0)
	shadowProps.Position = UDim2.fromOffset(4, 4)
	shadowProps.Size = UDim2.fromScale(1, 1)
	shadowProps.ZIndex = 1
	shadowProps.Parent = nil
	local holder = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = props.Position,
		Size = props.Size,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		Parent = parent,
	})
	shadowProps.AnchorPoint = nil
	shadowProps.LayoutOrder = nil
	local s = UI.label(shadowProps)
	s.Parent = holder
	local mainProps = table.clone(props)
	mainProps.Position = UDim2.fromOffset(0, 0)
	mainProps.Size = UDim2.fromScale(1, 1)
	mainProps.AnchorPoint = nil
	mainProps.LayoutOrder = nil
	mainProps.ZIndex = 2
	mainProps.Parent = holder
	local m = UI.label(mainProps)
	return m
end

function Style.Build(ctx)
	local api = {}
	local t0 = os.clock()

	local fx = UI.full(ctx.Full, "VHSFx")
	-- scanlines
	local lines = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = fx })
	for i = 0, 300 do
		UI.new("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, i / 300),
			Size = UDim2.new(1, 0, 0, 1),
			ZIndex = 20,
			Parent = lines,
		})
	end
	local tracking = UI.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 1.2),
		Size = UDim2.new(1, 0, 0.05, 0),
		ZIndex = 21,
		Parent = fx,
	}, { UI.gradient(nil, { 1, 0.3, 0.7, 0.2, 1 }, 90) })
	local tint = UI.new("Frame", {
		BackgroundColor3 = rgb(30, 10, 60),
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 19,
		Parent = fx,
	})
	local edge = UI.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 18,
		Parent = fx,
	}, { UI.gradient(nil, { 0.2, 1, 1, 0.2 }, 0) })
	edge.BackgroundTransparency = 0.3

	local content = UI.new("CanvasGroup", {
		Name = "VHSContent",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		Parent = ctx.Canvas,
	})
	local playLabel = osd(content, {
		Text = "PLAY >",
		Font = FONT,
		TextSize = 34,
		TextColor3 = WHITE,
		Position = UDim2.fromOffset(110, 80),
		Size = UDim2.fromOffset(400, 40),
	})
	osd(content, {
		Text = "SP",
		Font = FONT,
		TextSize = 34,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -110, 0, 80),
		Size = UDim2.fromOffset(300, 40),
	})
	local dateLabel = osd(content, {
		Text = string.upper(os.date("%b. %d %Y") :: string),
		Font = FONT,
		TextSize = 28,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 110, 1, -80),
		Size = UDim2.fromOffset(600, 34),
	})
	local timeLabel = osd(content, {
		Text = "AM 3:14:00",
		Font = FONT,
		TextSize = 28,
		TextColor3 = WHITE,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 110, 1, -124),
		Size = UDim2.fromOffset(600, 34),
	})
	local counter = osd(content, {
		Text = "0:00:00",
		Font = FONT,
		TextSize = 28,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -110, 1, -80),
		Size = UDim2.fromOffset(400, 34),
	})
	local _ = dateLabel

	-- title with fake colour bleeding
	local titleY = 190
	for i, c in { rgb(255, 40, 80), rgb(40, 220, 255) } do
		UI.label({
			Text = Config.Title,
			Font = FONT,
			TextSize = 58,
			TextColor3 = c,
			TextTransparency = 0.45,
			Position = UDim2.fromOffset(110 + (if i == 1 then -4 else 4), titleY),
			Size = UDim2.fromOffset(1200, 70),
			Parent = content,
		})
	end
	osd(content, {
		Text = Config.Title,
		Font = FONT,
		TextSize = 58,
		TextColor3 = WHITE,
		Position = UDim2.fromOffset(110, titleY),
		Size = UDim2.fromOffset(1200, 70),
	})
	osd(content, {
		Text = "TAPE 03 - " .. Config.Subtitle,
		Font = FONT,
		TextSize = 22,
		TextColor3 = CYAN,
		Position = UDim2.fromOffset(114, titleY + 82),
		Size = UDim2.fromOffset(1200, 30),
	})

	local pages = UI.new("Frame", {
		Name = "Pages",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(110, 360),
		Size = UDim2.fromOffset(820, 560),
		Parent = content,
	})

	api.Theme = {
		Font = FONT,
		Text = WHITE,
		TextDim = rgb(176, 176, 190),
		Accent = CYAN,
		RowHeight = 40,
		LabelSize = 20,
		Width = 780,
		ValueWidth = 120,
		Uppercase = true,
		Textual = true,
	}

	function api.NewPage(name: string)
		return UI.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = pages,
		}, { UI.list(8) })
	end

	function api.MakeButton(parent: Instance, text: string, order: number, kind: string)
		local name = NAMES[text] or string.upper(text)
		local button = UI.new("TextButton", {
			Name = text,
			AutoButtonColor = false,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			Size = UDim2.fromOffset(460, if kind == "primary" then 58 else 50),
			LayoutOrder = order,
			Parent = parent,
		})
		local label = osd(button, {
			Text = "  " .. name,
			Font = FONT,
			TextSize = if kind == "primary" then 38 else 30,
			TextColor3 = WHITE,
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.fromScale(1, 1),
		})
		local shadow = label.Parent and label.Parent:FindFirstChild("Shadow") :: TextLabel?
		local function setHover(on: boolean)
			button.BackgroundTransparency = if on then 0 else 1
			label.TextColor3 = if on then Color3.new(0, 0, 0) else WHITE
			label.Text = (if on then "> " else "  ") .. name
			if shadow then
				shadow.Visible = not on
				shadow.Text = label.Text
			end
		end
		return button, setHover
	end

	function api.MakeHeading(parent: Instance, text: string, order: number)
		local holderLabel = osd(parent, {
			Text = string.upper(if text == "Settings" then "SETUP" else text),
			Font = FONT,
			TextSize = 36,
			TextColor3 = CYAN,
			Size = UDim2.fromOffset(780, 56),
			LayoutOrder = order,
		})
		return holderLabel.Parent
	end

	function api.MakeText(parent: Instance, text: string, order: number)
		local l = osd(parent, {
			Text = string.upper(text),
			Font = FONT,
			TextSize = 16,
			TextColor3 = WHITE,
			TextWrapped = true,
			Size = UDim2.fromOffset(780, 40),
			LayoutOrder = order,
		})
		return l.Parent
	end

	function api.ShowPage(page: Frame, old: Frame?, instant: boolean?)
		if old then
			old.Visible = false
		end
		page.Visible = true
		if not instant then
			tracking.Position = UDim2.fromScale(0, -0.05)
			UI.tween(tracking, 0.35, { Position = UDim2.fromScale(0, 1.1) }, Enum.EasingStyle.Linear)
		end
	end

	function api.Intro()
		UI.tween(content, 0.15, { GroupTransparency = 0 }, nil, nil, 0.2)
	end

	function api.Outro(done: () -> ())
		playLabel.Text = "STOP"
		UI.tween(content, 0.2, { GroupTransparency = 1 }, nil, nil, 0.35)
		task.delay(0.6, done)
	end

	local nextTrack = 2
	function api.Update(_dt: number)
		local t = os.clock() - t0
		local secs = 14 * 60 + math.floor(t)
		timeLabel.Text = string.format("AM 3:%02d:%02d", (secs // 60) % 60, secs % 60)
		counter.Text = string.format("0:%02d:%02d", (math.floor(t) // 60) % 60, math.floor(t) % 60)
		playLabel.TextTransparency = if math.floor(t * 1.5) % 2 == 0 then 0 else 0.15
		if t > nextTrack then
			nextTrack = t + 3 + math.random() * 5
			tracking.Position = UDim2.fromScale(0, -0.05)
			UI.tween(tracking, 0.9 + math.random() * 0.6, { Position = UDim2.fromScale(0, 1.1) }, Enum.EasingStyle.Linear)
		end
		content.Position = UDim2.fromOffset(if math.random() < 0.03 then math.random(-4, 4) else 0, 0)
		tint.BackgroundTransparency = 0.85 + math.random() * 0.03
	end

	function api.Destroy()
		fx:Destroy()
		content:Destroy()
	end

	return api
end

return Style
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="832">
          <Properties>
            <string name="Name">Notebook</string>
            <string name="Source"><![CDATA[-- STYLE 5: "Notebook" — a page torn from Morty's school notebook, taped over the screen. Handwriting and doodles.
local Game = script.Parent.Parent
local UI = require(Game.UI)
local Config = require(Game.Config)

local Style = {}
Style.Name = "Notebook"
Style.Music = "MusicLofi"

local HEAD = Vector3.new(-8.15, 3.29, -6.65)
Style.Camera = {
	From = { Pos = Vector3.new(3.6, 4.7, 0.2), Look = HEAD, Yaw = -15 },
	To = { Pos = Vector3.new(2.6, 4.5, -1.2), Look = HEAD, Yaw = -15 },
	Duration = 26,
	FOV = 48,
	Focus = HEAD,
	Sway = 0.2,
}

local rgb = Color3.fromRGB
local PAPER = rgb(252, 250, 242)
local INK = rgb(34, 34, 52)
local BLUE_INK = rgb(46, 66, 160)
local RED_INK = rgb(205, 52, 52)
local LINE = rgb(164, 194, 232)
local W, H = 620, 900

local function splitTitle(title: string): string
	-- "RICK AND MORTY" -> "Rick & Morty"
	local words = {}
	for _, w in string.split(string.lower(title), " ") do
		if w == "and" then
			table.insert(words, "&")
		else
			table.insert(words, string.upper(string.sub(w, 1, 1)) .. string.sub(w, 2))
		end
	end
	return table.concat(words, " ")
end

function Style.Build(ctx)
	local api = {}

	local content = UI.new("Frame", {
		Name = "NotebookContent",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = ctx.Canvas,
	})

	local sheetHolder = UI.new("Frame", {
		Name = "Sheet",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -120 + 900, 0.5, 0),
		Size = UDim2.fromOffset(W, H),
		Rotation = 9,
		Parent = content,
	})
	UI.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(14, 18),
		Size = UDim2.fromScale(1, 1),
		Parent = sheetHolder,
	}, { UI.corner(6) })
	local sheet = UI.new("Frame", {
		Name = "Paper",
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = sheetHolder,
	}, { UI.corner(6), UI.gradient({ rgb(255, 255, 255), rgb(240, 236, 224) }, nil, 70) })

	for y = 150, H - 30, 46 do
		UI.new("Frame", {
			BackgroundColor3 = LINE,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, 2),
			Parent = sheet,
		})
	end
	UI.new("Frame", {
		BackgroundColor3 = rgb(232, 128, 128),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(84, 0),
		Size = UDim2.new(0, 2, 1, 0),
		Parent = sheet,
	})
	for y = 60, H - 40, 76 do
		UI.new("Frame", {
			BackgroundColor3 = rgb(40, 36, 44),
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(26, y),
			Size = UDim2.fromOffset(22, 22),
			Parent = sheet,
		}, { UI.round() })
	end
	UI.new("Frame", {
		Name = "Tape",
		BackgroundColor3 = rgb(236, 222, 168),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(190, 50),
		Rotation = -5,
		Parent = sheetHolder,
	})

	-- title + doodles
	local title = UI.label({
		Text = splitTitle(Config.Title),
		Font = Enum.Font.PermanentMarker,
		TextSize = 66,
		TextColor3 = INK,
		Position = UDim2.fromOffset(104, 34),
		Size = UDim2.fromOffset(500, 80),
		Rotation = -2,
		Parent = sheet,
	})
	UI.new("Frame", {
		BackgroundColor3 = RED_INK,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(110, 112),
		Size = UDim2.fromOffset(380, 4),
		Rotation = -1.5,
		Parent = sheet,
	}, { UI.round() })
	UI.new("Frame", {
		BackgroundColor3 = RED_INK,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(130, 120),
		Size = UDim2.fromOffset(330, 3),
		Rotation = 0.8,
		Parent = sheet,
	}, { UI.round() })
	local subtitle = UI.label({
		Text = string.lower(Config.Subtitle) .. "!!",
		Font = Enum.Font.PatrickHand,
		TextSize = 38,
		TextColor3 = BLUE_INK,
		Position = UDim2.fromOffset(112, 140),
		Size = UDim2.fromOffset(460, 44),
		Rotation = -2,
		Parent = sheet,
	})
	local _ = title
	local _s = subtitle
	-- portal doodle
	local doodle = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(470, 200),
		Size = UDim2.fromOffset(110, 140),
		Rotation = 12,
		Parent = sheet,
	})
	for i, s in { 1, 0.72, 0.46, 0.22 } do
		UI.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + (i - 1) * 0.02, 0.5),
			Size = UDim2.fromScale(s, s),
			Parent = doodle,
		}, { UI.round(), UI.stroke(3, rgb(70, 160, 60), 0.05 * i, true) })
	end
	UI.label({
		Text = "z z Z",
		Font = Enum.Font.PatrickHand,
		TextSize = 34,
		TextColor3 = BLUE_INK,
		Position = UDim2.fromOffset(480, 760),
		Size = UDim2.fromOffset(120, 40),
		Rotation = -10,
		Parent = sheet,
	})

	local pages = UI.new("Frame", {
		Name = "Pages",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(110, 252),
		Size = UDim2.fromOffset(460, 620),
		Parent = sheet,
	})

	api.Theme = {
		Font = Enum.Font.PatrickHand,
		Text = INK,
		TextDim = rgb(96, 96, 128),
		Accent = RED_INK,
		Track = INK,
		TrackTransparency = 0.7,
		TrackHeight = 3,
		Knob = PAPER,
		KnobStroke = INK,
		KnobStrokeThickness = 2,
		KnobSize = 20,
		Corner = 2,
		RowHeight = 46,
		LabelSize = 30,
		Width = 450,
		ValueWidth = 72,
		Uppercase = false,
	}

	function api.NewPage(name: string)
		return UI.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = pages,
		}, { UI.list(if name == "Main" then 10 else 0) })
	end

	local tilt = { -1.5, 1, -0.5, 1.5, -1 }
	function api.MakeButton(parent: Instance, text: string, order: number, kind: string)
		local big = kind == "primary"
		local button = UI.new("TextButton", {
			Name = text,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Text = "",
			Size = UDim2.fromOffset(400, if big then 84 else 66),
			LayoutOrder = order,
			Rotation = tilt[(order % #tilt) + 1],
			Parent = parent,
		})
		local label = UI.label({
			Text = string.lower(text),
			Font = Enum.Font.PatrickHand,
			TextSize = if big then 66 elseif kind == "back" then 40 else 52,
			TextColor3 = if kind == "danger" then rgb(120, 40, 40) else INK,
			Position = UDim2.fromOffset(44, 0),
			Size = UDim2.new(1, -44, 1, 0),
			Parent = button,
		})
		local arrow = UI.label({
			Text = "→",
			Font = Enum.Font.PatrickHand,
			TextSize = 44,
			TextColor3 = RED_INK,
			TextTransparency = 1,
			Position = UDim2.fromOffset(-6, 0),
			Size = UDim2.fromOffset(40, 66),
			Parent = button,
		})
		local circle = UI.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 44 + label.TextBounds.X / 2, 0.5, 0),
			Size = UDim2.fromOffset(0, 0),
			Rotation = -4,
			Parent = button,
		}, { UI.round(), UI.stroke(3, RED_INK, 0, true) })
		local function setHover(on: boolean)
			local w = label.TextBounds.X + 46
			circle.Position = UDim2.new(0, 44 + label.TextBounds.X / 2, 0.5, 2)
			UI.tween(circle, 0.25, { Size = if on then UDim2.fromOffset(w, label.TextBounds.Y + 6) else UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
			UI.tween(arrow, 0.2, { TextTransparency = if on then 0 else 1, Position = UDim2.fromOffset(if on then 0 else -16, 0) })
			UI.tween(label, 0.2, { Position = UDim2.fromOffset(if on then 52 else 44, 0) })
		end
		return button, setHover
	end

	function api.MakeHeading(parent: Instance, text: string, order: number)
		return UI.label({
			Text = text,
			Font = Enum.Font.PermanentMarker,
			TextSize = 46,
			TextColor3 = INK,
			Size = UDim2.fromOffset(450, 62),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.MakeText(parent: Instance, text: string, order: number)
		return UI.label({
			Text = text,
			Font = Enum.Font.PatrickHand,
			TextSize = 28,
			TextColor3 = BLUE_INK,
			TextWrapped = true,
			Size = UDim2.fromOffset(450, 92),
			LayoutOrder = order,
			Parent = parent,
		})
	end

	function api.ShowPage(page: Frame, old: Frame?, instant: boolean?)
		if old then
			old.Visible = false
		end
		page.Visible = true
		if not instant then
			sheetHolder.Rotation = 2.8
			UI.tween(sheetHolder, 0.35, { Rotation = 2 }, Enum.EasingStyle.Back)
		end
	end

	function api.Intro()
		UI.tween(sheetHolder, 0.8, { Position = UDim2.new(1, -120, 0.5, 0), Rotation = 2 }, Enum.EasingStyle.Back, nil, 0.3)
	end

	function api.Outro(done: () -> ())
		UI.tween(sheetHolder, 0.6, { Position = UDim2.new(1, -120 + 1000, 0.5, 80), Rotation = 18 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.65, done)
	end

	function api.Destroy()
		content:Destroy()
	end

	return api
end

return Style
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="833">
        <Properties>
          <string name="Name">Remotes</string>
        </Properties>
        <Item class="RemoteFunction" referent="834">
          <Properties>
            <string name="Name">RequestSpawn</string>
          </Properties>
        </Item>
        <Item class="RemoteEvent" referent="835">
          <Properties>
            <string name="Name">ReleaseCharacter</string>
          </Properties>
        </Item>
        <Item class="RemoteEvent" referent="836">
          <Properties>
            <string name="Name">ReturnToMenu</string>
          </Properties>
