		},
		Rock = mc(48, 32, 72, BASALT),
		RockDark = mc(24, 14, 40, BASALT),
		Girder = mc(34, 22, 54, METAL),
		Chevron = mc(222, 112, 255, NEON),
		Trunk = mc(62, 42, 84, WOOD_SOLID),
		Leaves = mc(172, 82, 240, SP),
		Cloud = mc(150, 120, 200, SP),
		Bridge = mc(62, 42, 92, WOOD),
		GateNeon = Color3.fromRGB(230, 110, 255),
		Wave = Color3.fromRGB(200, 80, 255),
		Tint = Color3.fromRGB(236, 224, 255),
		SignText = Color3.fromRGB(240, 210, 255),
		SignStroke = Color3.fromRGB(60, 10, 90),
	},
}

local LevelConfig = {
	DefaultLocation = "Meadows",
	Locations = {
		Meadows = { DisplayName = "Bouncy Meadows", Seed = 7341 },
	} :: { [string]: { DisplayName: string, Seed: number } },

	-- Геометрия полосы (локальные координаты: старт в (0,0,0), полоса уходит в −Z).
	-- Полосы расходятся веером от хаба Sky Plaza: хаб в центре, позади стартовых площадок.
	LaneWidth = 92,
	MaxSlots = 9,
	Hub = {
		Center = Vector3.new(0, 0, 0),
		Radius = 150,
		TerraceRadius = 54,
		SpawnRadius = 112,
		LaneStartRadius = 330, -- центр стартовой площадки полосы от центра хаба
		FanStepDegrees = 20,
	},
	StartPadSize = Vector3.new(72, 6, 72),
	BaseLength = 760,
	LengthPerTier = 110,
	MaxLength = 1300,
	SpawnOffset = Vector3.new(0, 5, 14),

	WallStrengths = {
		{ Name = "Soft", RequiredSpeed = 60, Loot = 3, Thickness = 3 },
		{ Name = "Medium", RequiredSpeed = 100, Loot = 6, Thickness = 4 },
		{ Name = "Hard", RequiredSpeed = 140, Loot = 12, Thickness = 5 },
		{ Name = "Titan", RequiredSpeed = 185, Loot = 25, Thickness = 6 },
	} :: { WallStrength },
	Chest = {
		RequiredSpeed = 45,
		Loot = 40,
		Size = Vector3.new(7, 5.5, 5),
	},
	-- Золотая пиньята: плывёт поперёк полосы, огромный лут
	Pinata = {
		RequiredSpeed = 75,
		Loot = 600,
		Size = Vector3.new(6, 6, 6),
		AmplitudeMin = 22,
		AmplitudeMax = 32,
		FrequencyMin = 0.12,
		FrequencyMax = 0.2,
	},
	-- Кольцо ускорения: пролёт = +скорость и +комбо (сервер сам видит пролёт по сэмплам)
	BoostRing = {
		Speed = 120,
		Combo = 2,
		Radius = 9,
		Cooldown = 1.2,
		Spacing = 170,
	},

	-- Рост сложности/лута с каждым перерождением
	DurabilityGrowth = 1.3, -- прочность ×1.3 за тир (нужная скорость ×√1.3 ≈ ×1.14)
	LootGrowth = 2, -- лут ×2 за тир
	GongSpeed = { Base = 140, PerTier = 22, Max = 420 } :: TierCurve,
	GongCombo = { Base = 2, PerTier = 1, Max = 12 } :: TierCurve,
	RebirthBonus = 120,
	ObstacleRespawnTime = 10,

	Rebirth = {
		StartDelay = 1.1, -- пауза между ударом в Гонг и стартом волны
		TeleportDelay = 0.7, -- игрок переносится на старт, чтобы смотреть, как волна идёт на него
		WaveSpeed = 420,
		Cooldown = 6,
	},

	Themes = Themes,
}

function LevelConfig.GetTheme(tier: number): Theme
	local index = math.clamp(math.floor(tier) + 1, 1, #Themes)
	return Themes[index]
end

function LevelConfig.DurabilityMultiplier(tier: number): number
	return LevelConfig.DurabilityGrowth ^ math.max(tier, 0)
end

function LevelConfig.LootMultiplier(tier: number): number
	return LevelConfig.LootGrowth ^ math.max(tier, 0)
end

local function tierCurve(curve: TierCurve, tier: number): number
	return math.min(curve.Base + curve.PerTier * math.max(tier, 0), curve.Max)
end

-- Порог удара в Гонг: (минимальная скорость, минимальное комбо)
function LevelConfig.GongRequirement(tier: number): (number, number)
	return tierCurve(LevelConfig.GongSpeed, tier), math.floor(tierCurve(LevelConfig.GongCombo, tier))
end

function LevelConfig.LaneLength(tier: number): number
	return math.min(LevelConfig.BaseLength + LevelConfig.LengthPerTier * math.max(tier, 0), LevelConfig.MaxLength)
end

-- Угол полосы в веере: слот 1 по центру, дальше поочерёдно вправо/влево (0, +20, −20, +40, …)
function LevelConfig.SlotAngle(slot: number): number
	local index = math.max(math.floor(slot) - 1, 0)
	if index == 0 then
		return 0
	end
	local ring = math.ceil(index / 2)
	local sign = if index % 2 == 1 then 1 else -1
	return sign * ring * LevelConfig.Hub.FanStepDegrees
end

-- Направление «вперёд» полосы в мире (локальная −Z)
function LevelConfig.SlotDirection(slot: number): Vector3
	local angle = math.rad(LevelConfig.SlotAngle(slot))
	return Vector3.new(math.sin(angle), 0, -math.cos(angle))
end

function LevelConfig.SlotOrigin(slot: number): CFrame
	local direction = LevelConfig.SlotDirection(slot)
	local position = LevelConfig.Hub.Center + direction * LevelConfig.Hub.LaneStartRadius
	return CFrame.lookAt(position, position + direction)
end

-- Точка появления на хабе: на дорожке к своей полосе, лицом к ней
function LevelConfig.HubSpawn(slot: number): CFrame
	local direction = LevelConfig.SlotDirection(slot)
	local position = LevelConfig.Hub.Center + direction * LevelConfig.Hub.SpawnRadius + Vector3.new(0, 4.5, 0)
	return CFrame.lookAt(position, position + direction)
end

function LevelConfig.TierName(tier: number): string
	local theme = LevelConfig.GetTheme(tier)
	if tier >= #Themes then
		return string.format("%s +%d", theme.Name, tier - #Themes + 1)
	end
	return theme.Name
end

return LevelConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">PhysicsConfig</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Физические константы. Единицы: studs, секунды, «игровые» массы (база = 1).
-- Клиент и сервер читают один и тот же файл → валидация на сервере совпадает с симуляцией клиента.

export type StatCurve = {
	Base: number,
	PerLevel: number,
	Max: number,
}

local PhysicsConfig = {
	-- Фиксированный шаг клиентской симуляции (интерполяция рендера — на RenderStepped)
	FixedTimestep = 1 / 120,
	MaxSubstepsPerFrame = 8,

	-- Полёт
	FlightGravityScale = 0.82, -- доля workspace.Gravity в полёте (мультяшная «лёгкость»)
	AirDrag = 0.00042, -- квадратичное сопротивление: a = −c·|v|·v
	AirControlAcceleration = 48, -- подруливание WASD в воздухе
	MaxFlightSpeed = 640,
	FlightMass = 1, -- инерция тела при запуске (v = √(2E/m))

	-- Тело персонажа в кастомной физике = сфера
	BodyRadius = 2.3,
	BallVisualRadius = 2.75,
	SkinWidth = 0.05,
	GroundNormalMinY = 0.62,
	GroundProbeExtra = 0.35,
	LandSpeed = 38, -- ниже этой касательной скорости персонаж «приземляется» в обычную ходьбу
	SkidFriction = 1.9, -- 1/с, экспоненциальное затухание скорости при скольжении по земле
	WallSlideKeep = 0.55, -- доля касательной скорости после «шлепка» о стену без шара
	LaunchGroundGrace = 0.16, -- после выстрела земля не тормозит (иначе вертикальный старт гасится)

	-- Руки
	HandSpeed = 760,
	HandRetractSpeed = 980,
	HandArriveEpsilon = 0.75,
	MissReachFraction = 0.65,
	ArmRestLength = 3.4, -- естественная длина руки: от неё считается сохранение объёма (утончение)
	ArmBaseWidth = 1.05,
	ArmMinWidth = 0.24,
	ArmOutlineWidth = 0.3,
	AimAssistCos = math.cos(math.rad(5.5)),

	GrabRange = { Base = 140, PerLevel = 6, Max = 320 } :: StatCurve, -- Elasticity
	MaxStretch = { Base = 26, PerLevel = 1.25, Max = 90 } :: StatCurve, -- Elasticity
	Stiffness = { Base = 24, PerLevel = 1.15, Max = 140 } :: StatCurve, -- Spring Power (k одной резинки)
	Restitution = { Base = 0.84, PerLevel = 0.0045, Max = 0.985 } :: StatCurve, -- Spring Power
	ImpactMass = { Base = 1, PerLevel = 0.07, Max = 8 } :: StatCurve, -- Smash Mass

	-- Рогатка (натяжение на земле)
	DrawSpeed = 40, -- скорость оттягивания назад при зажатой кнопке
	DrawResistance = 0.65, -- чем сильнее натяжение, тем медленнее тянется (F = −kx ощущается руками)
	MinLaunchSpeed = 28,
	LaunchUpBias = 0.08,
	LaunchSpeedCap = 560,
	ChargeLeanDegrees = 24,

	-- Захват в воздухе (банджи): резинка укорачивается, пока кнопка зажата
	AirStiffnessScale = 0.55,
	AirRadialDamping = 1.6,
	AirRetractSpeed = 58,
	AirMinRestLength = 6,

	-- Пружинный шар и отскоки
	BallTangentKeep = 0.985,
	BounceMinNormalSpeed = 9,
	BouncySurfaceRestitution = 1.08, -- бамперы/бортики добавляют скорость (пинбол)
	BouncySurfaceMaxSpeed = 520,
	GongRestitution = 0.55,
	ComboRestTime = 0.4, -- сколько секунд стоять на земле, чтобы комбо сбросилось

	-- Предпросмотр траектории
	PreviewDuration = 2.4,
	PreviewStep = 1 / 25,
	PreviewKnotEvery = 3,
	PreviewMaxBounces = 3,
	PreviewRefreshInterval = 1 / 20,

	-- Мир
	KillY = -90,
	SupersonicSpeed = 260,

	CollisionGroups = {
		Characters = "StretchCharacters",
		Debris = "StretchDebris",
	},

	Tags = {
		Smashable = "StretchSmashable",
		Bouncy = "StretchBouncy",
		GrabPoint = "StretchGrabPoint",
		Gong = "StretchGong",
		BoostRing = "StretchBoostRing",
		Pinata = "StretchPinata",
		CapsuleMachine = "StretchCapsuleMachine",
	},

	-- Прокачка статов (меню — следующий шаг, цены нужны серверу уже сейчас)
	StatUpgrade = {
		MaxLevel = 60,
		BaseCost = 30,
		CostGrowth = 1.28,
	},

	-- Серверная валидация (допуски на пинг и дискретность сэмплов)
	Validation = {
		SpeedSlack = 1.35, -- заявленная скорость ≤ наблюдаемая·1.35 + SpeedFlat
		SpeedFlat = 25,
		ObservedWindow = 0.9, -- окно поиска максимальной скорости, с
		DistanceBase = 18,
		DistanceLatency = 0.45, -- + наблюдаемая скорость · 0.45 с
		PendingTimeout = 0.6, -- ожидание догоняющих сэмплов позиции
		HardSpeedCap = 1100,
		TeleportMinJump = 70,
		StrikesBeforePullback = 3,
		StrikeWindow = 8,
		ComboSlack = 2,
		SmashTokensPerSecond = 10,
		SmashTokenBurst = 16,
		TrackerCapacity = 128,
		MinSampleDt = 1 / 30,
		TurnMinSpeed = 45,
		TurnCos = math.cos(math.rad(38)),
		TurnCooldown = 0.07,
		RestSpeed = 12,
		RestTime = 0.5,
		ArmEventsPerSecond = 20,
	},
}

return PhysicsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Звуковой конфиг на огибающих.
-- Все ассеты — ТОЛЬКО в таблице Samples ниже. Каждый игровой звук (Cue) — это слои,
-- у каждого слоя своя огибающая: питч едет StartPitch → EndPitch за PitchCurveTime по кривой
-- (Spring — пружинный перелёт, Exp — резкий спад, Linear), громкость гаснет к нулю за DecayTime.
-- StretchAudioController пересчитывает огибающие каждый кадр RenderStepped.
--
-- Свой звук в один клик: замени путь в Samples на "rbxassetid://<id>". Fallbacks подставляет
-- другой сэмпл из этого же набора, если какой-то ассет не загрузился.

export type SampleName = "Swoosh" | "RocketWhoosh" | "Snap" | "Bass" | "Ping" | "Button" | "MetalHit" | "Victory" | "PageTurn"
export type GroupName = "Sfx" | "Resonance" | "Ui"
export type Curve = "Spring" | "Exp" | "Linear"

export type Layer = {
	Sample: SampleName,
	Volume: number,
	StartPitch: number,
	EndPitch: number,
	PitchCurveTime: number,
	DecayTime: number,
	Delay: number,
	Curve: Curve,
	NoteScaled: boolean, -- умножать питч на ступень пентатоники (комбо)
	Group: GroupName,
}

export type Cue = {
	Layers: { Layer },
}

local Samples: { [SampleName]: string } = {
	Swoosh = "rbxasset://sounds/swoosh.wav",
	RocketWhoosh = "rbxasset://sounds/Rocket whoosh 01.wav",
	Snap = "rbxasset://sounds/snap.mp3",
	Bass = "rbxasset://sounds/bass.mp3",
	Ping = "rbxasset://sounds/electronicpingshort.wav",
	Button = "rbxasset://sounds/button.wav",
	MetalHit = "rbxasset://sounds/metal_hit.mp3",
	Victory = "rbxasset://sounds/victory.wav",
	PageTurn = "rbxasset://sounds/pageturn.wav",
}

-- Сколько одновременных голосов держит каждый сэмпл (зерна натяжения и арпеджио — самые плотные)
local Polyphony: { [SampleName]: number } = {
	Swoosh = 8,
	RocketWhoosh = 4,
	Snap = 6,
	Bass = 6,
	Ping = 14,
	Button = 12,
	MetalHit = 4,
	Victory = 2,
	PageTurn = 3,
}

-- Если ассет не загрузился — по очереди пробуем замены (только из разрешённого набора)
local Fallbacks: { [SampleName]: { SampleName } } = {
	Swoosh = { "RocketWhoosh" },
	RocketWhoosh = { "Swoosh" },
	Snap = { "Button", "Swoosh" },
	Bass = { "RocketWhoosh", "Swoosh" },
	Ping = { "Button" },
	Button = { "Ping" },
	MetalHit = { "Ping", "Snap" },
	Victory = { "Ping" },
	PageTurn = { "Button", "Swoosh" },
}

local function layer(
	sample: SampleName,
	volume: number,
	startPitch: number,
	endPitch: number,
	pitchCurveTime: number,
	decayTime: number,
	curve: Curve,
	noteScaled: boolean,
	group: GroupName,
	delay: number?
): Layer
	return {
		Sample = sample,
		Volume = volume,
		StartPitch = startPitch,
		EndPitch = endPitch,
		PitchCurveTime = pitchCurveTime,
		DecayTime = decayTime,
		Delay = delay or 0,
		Curve = curve,
		NoteScaled = noteScaled,
		Group = group,
	}
end

local Cues: { [string]: Cue } = {
	-- «ПЬЮИНГ!»: старт с 0.75 ноты, пружинный взлёт до 1.25 ноты за 0.12 с
	Boing = {
		Layers = {
			layer("Ping", 0.9, 0.75, 1.25, 0.12, 0.42, "Spring", true, "Sfx"),
			layer("Button", 0.32, 0.75, 1.6, 0.1, 0.16, "Spring", true, "Sfx"),
		},
	},
	-- Пробитие: басовый кик 1.6 → 0.5 за 0.09 с + хрустящий верх
	Smash = {
		Layers = {
			layer("Bass", 1.35, 1.6, 0.5, 0.09, 0.45, "Exp", false, "Sfx"),
			layer("Snap", 0.9, 1.15, 0.95, 0.05, 0.24, "Exp", true, "Sfx"),
			layer("MetalHit", 0.7, 1.3, 1, 0.08, 0.5, "Exp", true, "Sfx", 0.01),
		},
	},
	-- Одна звонкая монетка (арпеджио собирает контроллер по ступеням пентатоники)
	Coin = {
		Layers = {
			layer("Ping", 0.75, 1, 1.06, 0.03, 0.08, "Linear", true, "Ui"),
		},
	},
	Launch = {
		Layers = {
			layer("Snap", 1.05, 1.3, 1, 0.06, 0.3, "Exp", false, "Sfx"),
			layer("Bass", 0.85, 1.15, 0.7, 0.12, 0.36, "Exp", false, "Sfx"),
			layer("Swoosh", 0.65, 0.9, 1.55, 0.25, 0.42, "Linear", false, "Sfx", 0.02),
		},
	},
	HandFire = {
		Layers = {
			layer("Swoosh", 0.45, 1.6, 2.2, 0.1, 0.18, "Linear", false, "Sfx"),
		},
	},
	HandAttach = {
		Layers = {
			layer("Button", 0.5, 1.7, 1.3, 0.05, 0.12, "Exp", false, "Sfx"),
			layer("Snap", 0.22, 2, 1.8, 0.04, 0.08, "Exp", false, "Sfx"),
		},
	},
	HandRelease = {
		Layers = {
