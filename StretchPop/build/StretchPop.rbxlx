		Post = mc(40, 26, 62, SP),
		Ring = mc(214, 92, 255, NEON),
		Bumper = mc(255, 64, 200, GLASS),
		Island = mc(48, 32, 76, SLATE),
		ChestBody = mc(62, 30, 94, SLATE),
		ChestTrim = mc(222, 112, 255, NEON),
		Gong = mc(140, 60, 255, GLASS),
