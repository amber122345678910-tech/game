            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">ElasticSlingshotController</string>
              <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · ElasticSlingshotController (клиент)
--
-- Управление
--   ЛКМ / ПКМ (геймпад L2 / R2) — выстрелить левой / правой рукой в точку под прицелом (Workspace:Raycast + аим-ассист).
--   Зажато на земле  → РОГАТКА: персонаж оттягивается назад от якорей, энергия E = Σ½·k·x² (закон Гука),
--                      на экране — 3D-дуга предпросмотра. Отпустил → v = √(2E/m) вдоль равнодействующей резинок.
--   Зажато в воздухе → БАНДЖИ: резинка укорачивается и тянет силой F = k·x (только натяжение), отпустил — летишь по инерции.
--   ПРОБЕЛ в полёте  → ПРУЖИННЫЙ ШАР: отскоки с сохранением импульса (e из Spring Power), каждый отскок = +1 комбо.
--   Удар о разрушаемое: E = ½·m·v² ≥ прочности → предсказанное пробитие без потери скорости, сервер подтверждает.
--
-- Архитектура кадра (RunService:BindToRenderStep, до камеры):
--   прицел → фиксированные подшаги физики 1/120 с (аккумулятор) → интерполяция prev→curr по alpha →
--   запись CFrame корня → руки (кривые Безье на Beam) → шар → дуга траектории → сигналы для HUD/аудио.
-- Физика тела в полёте — собственная: Spherecast-sweep (без туннелирования на 600 studs/s),
-- Humanoid в состоянии Physics, на земле управление возвращается Humanoid'у.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local GloveConfig = require(Shared.Config.GloveConfig)
local Bezier = require(Shared.Math.Bezier)
local Spring = require(Shared.Math.Spring)
local StretchPhysics = require(Shared.Physics.StretchPhysics)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local KineticVFX = require(Client.Effects.KineticVFX)
local ShoulderCamera = require(Client.Controllers.ShoulderCameraController)

local Tags = PhysicsConfig.Tags

local RENDER_STEP_NAME = "StretchPop_Slingshot"
local ACTION_LEFT = "StretchPop_LeftArm"
local ACTION_RIGHT = "StretchPop_RightArm"
local ACTION_BALL = "StretchPop_Ball"
local ACTION_PRIORITY = Enum.ContextActionPriority.High.Value

local TRAJECTORY_SEGMENTS = 28
local SMASH_MARKERS = 4
local PREDICTION_TIMEOUT = 3
local CHARGE_MAX_GROUND_SPEED = 30
local ANCHOR_BREAK_FACTOR = 1.7
local TELEPORT_DRIFT_MIN = 30
local GONG_CLIENT_COOLDOWN = 1.2
-- Скрытые детали риг-модели уводим далеко вниз: Highlight-обводка не должна рисовать невидимое
local HIDDEN_CFRAME = CFrame.new(0, -5000, 0)

local OUTLINE_COLOR = Color3.fromRGB(34, 22, 46)
local STRETCH_TINT = Color3.fromRGB(255, 236, 242)
local WHITE = Color3.new(1, 1, 1)
local AIM_VALID_COLOR = Color3.fromRGB(110, 255, 150)
local MARKER_COLORS: { [string]: Color3 } = {
	Solid = Color3.fromRGB(255, 255, 255),
	Block = Color3.fromRGB(255, 150, 60),
	Gong = Color3.fromRGB(255, 214, 64),
}

local HAND_SIDES: { Types.HandSide } = { "Left", "Right" }
local ARM_PART_NAMES: { [Types.HandSide]: { string } } = {
	Left = { "LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm" },
	Right = { "RightUpperArm", "RightLowerArm", "RightHand", "Right Arm" },
}

type HandPhase = "Idle" | "Flying" | "Attached" | "Retracting"
type ControllerState = "Walk" | "Charge" | "Air"
type ContactResult = "Pass" | "Bounce" | "Slide" | "Land"

type ArmRig = {
	Shoulder: Attachment,
	Middle: Attachment,
	Hand: Attachment,
	MainA: Beam,
	MainB: Beam,
	OutlineA: Beam,
	OutlineB: Beam,
	Glove: Part,
	Cuff: Part,
	Visible: boolean,
	LastTint: number,
}

type Hand = {
	Side: Types.HandSide,
	Sign: number,
	Phase: HandPhase,
	Held: boolean,
	AnchorPart: BasePart?,
	AnchorLocal: Vector3,
	AnchorWorld: Vector3,
	AnchorNormal: Vector3,
	Position: Vector3,
	RestLength: number,
	Missed: boolean,
	MissTarget: Vector3,
	Wobble: Spring.VectorSpring,
	Rig: ArmRig,
}

type AimInfo = {
	Valid: boolean,
	Point: Vector3,
	Normal: Vector3,
	Part: BasePart?,
}

type Prediction = {
	Restore: () -> (),
	ExpiresAt: number,
}

type PeerHand = {
	Active: boolean,
	Point: Vector3,
	Rig: ArmRig,
}

type PeerState = {
	Player: Player,
	Hands: { [Types.HandSide]: PeerHand },
	Ball: boolean,
	BallPart: Part,
	BodyHidden: boolean,
}

type Knot = {
	P: Vector3,
	V: Vector3,
	T: number,
	BreakAfter: boolean,
}

type PathEnd = {
	Position: Vector3,
	Normal: Vector3,
	Kind: string,
}

export type Signals = {
	StateChanged: Signal.Signal<string>,
	HandFired: Signal.Signal<Types.HandSide>,
	HandAttached: Signal.Signal<Types.HandSide>,
	HandReleased: Signal.Signal<Types.HandSide>,
	TensionChanged: Signal.Signal<number>,
	Launched: Signal.Signal<number, Vector3>,
	Bounced: Signal.Signal<number, number, Vector3>,
	Smashed: Signal.Signal<string, number, Vector3>,
	Splat: Signal.Signal<number>,
	GongStruck: Signal.Signal<number, number>,
	LootGained: Signal.Signal<number>,
	BallChanged: Signal.Signal<boolean>,
}

type ControllerFields = {
	Player: Player,
	Camera: ShoulderCamera.ShoulderCamera,
	Signals: Signals,

	Character: Model?,
	Humanoid: Humanoid?,
	Root: BasePart?,
	ShoulderOffsets: { [Types.HandSide]: Vector3 },
	RootHeight: number,
	ArmParts: { [Types.HandSide]: { BasePart } },
	ArmHidden: { [Types.HandSide]: boolean },
	BodyParts: { BasePart },
	BodyDecals: { Decal },
	BodyDirty: boolean,
	BodyHidden: boolean,
	FallTrack: AnimationTrack?,

	State: ControllerState,
	Hands: { [Types.HandSide]: Hand },
	Params: StretchPhysics.StretchParams,
	GloveColor: Color3,
	GloveMaterial: Enum.Material,

	SimPosition: Vector3,
	SimVelocity: Vector3,
	SimRotation: CFrame,
	PrevPosition: Vector3,
	PrevRotation: CFrame,
	RenderCFrame: CFrame,
	Accumulator: number,
	LastWritten: Vector3,
	LaunchGraceUntil: number,

	BallHeld: boolean,
	BallSink: boolean,
	BallActive: boolean,
	BallAxis: Vector3,
	BallSquash: Spring.NumberSpring,

	Tension: number,
	LastTensionSent: number,
	Combo: number,
	LandedAt: number?,
	GongCooldownUntil: number,
	Predictions: { [string]: Prediction },

	Aim: AimInfo,
	GrabPoints: { [BasePart]: boolean },
	CastParams: RaycastParams,
	AimParams: RaycastParams,
	PreviewParams: RaycastParams,
	PreviewTimer: number,

	RigModel: Model,
	PeerModel: Model,
	MarkerFolder: Folder,
	RigAnchor: Part,
	Highlight: Highlight,
	TrajectoryBeams: { Beam },
	TrajectoryAttachments: { Attachment },
	ImpactMarker: Part,
	AimMarker: Part,
	SmashMarkers: { Part },
	BallPart: Part,
	BallMesh: SpecialMesh,

	Peers: { [Player]: PeerState },
	Connections: { RBXScriptConnection },
	CharacterConnections: { RBXScriptConnection },
	Started: boolean,
}

local Controller = {}
Controller.__index = Controller

export type ElasticSlingshotController = typeof(setmetatable({} :: ControllerFields, Controller))

-- ── Геометрические помощники ───────────────────────────────────────────────

-- Кадр, у которого ось X направлена вдоль direction (для Attachment.Axis у Beam и осей цилиндров)
local function axisFrame(position: Vector3, direction: Vector3): CFrame
	local x = if direction.Magnitude > 1e-5 then direction.Unit else Vector3.xAxis
	local helper = if math.abs(x.Y) < 0.95 then Vector3.yAxis else Vector3.zAxis
	local z = x:Cross(helper).Unit
	local y = z:Cross(x)
	return CFrame.fromMatrix(position, x, y, z)
end

-- Поворот «смотреть вдоль direction» без вырождения при вертикальном векторе
local function lookRotation(direction: Vector3): CFrame
	local look = if direction.Magnitude > 1e-5 then direction.Unit else -Vector3.zAxis
	local up = if math.abs(look.Y) > 0.98 then Vector3.zAxis else Vector3.yAxis
	local right = look:Cross(up).Unit
	local trueUp = right:Cross(look)
	return CFrame.fromMatrix(Vector3.zero, right, trueUp, -look)
end

local function flatten(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function newPart(name: string, shape: Enum.PartType, size: Vector3, color: Color3, material: Enum.Material, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function newBeam(name: string, a0: Attachment, a1: Attachment, color: Color3, zOffset: number, parent: Instance): Beam
	local beam = Instance.new("Beam")
	beam.Name = name
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.FaceCamera = true
	beam.Segments = 16
	beam.LightInfluence = 0
	beam.LightEmission = 0
	beam.Color = ColorSequence.new(color)
	beam.Transparency = NumberSequence.new(0)
	beam.ZOffset = zOffset
	beam.Enabled = false
	beam.Parent = parent
	return beam
end

local function newAttachment(name: string, parent: Instance): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Parent = parent
	return attachment
end

local function createArmRig(anchor: Part, gloveParent: Instance, color: Color3, material: Enum.Material, label: string): ArmRig
	local shoulder = newAttachment(label .. "Shoulder", anchor)
	local middle = newAttachment(label .. "Middle", anchor)
	local hand = newAttachment(label .. "Hand", anchor)
	local glove = newPart(label .. "Glove", Enum.PartType.Ball, Vector3.one * 1.9, color, material, gloveParent)
	local cuff = newPart(label .. "Cuff", Enum.PartType.Cylinder, Vector3.new(0.55, 1.55, 1.55), WHITE, Enum.Material.SmoothPlastic, gloveParent)
	return {
		Shoulder = shoulder,
		Middle = middle,
		Hand = hand,
		MainA = newBeam(label .. "MainA", shoulder, middle, color, 0.08, anchor),
		MainB = newBeam(label .. "MainB", middle, hand, color, 0.08, anchor),
		OutlineA = newBeam(label .. "OutlineA", shoulder, middle, OUTLINE_COLOR, 0, anchor),
		OutlineB = newBeam(label .. "OutlineB", middle, hand, OUTLINE_COLOR, 0, anchor),
		Glove = glove,
		Cuff = cuff,
		Visible = false,
		LastTint = -1,
	}
end

local function setRigVisible(rig: ArmRig, visible: boolean)
	if rig.Visible == visible then
		return
	end
	rig.Visible = visible
	rig.MainA.Enabled = visible
	rig.MainB.Enabled = visible
	rig.OutlineA.Enabled = visible
	rig.OutlineB.Enabled = visible
	rig.Glove.Transparency = if visible then 0 else 1
	rig.Cuff.Transparency = if visible then 0 else 1
	if not visible then
		rig.Glove.CFrame = HIDDEN_CFRAME
		rig.Cuff.CFrame = HIDDEN_CFRAME
	end
end

local function destroyArmRig(rig: ArmRig)
	for _, instance in { rig.MainA, rig.MainB, rig.OutlineA, rig.OutlineB, rig.Shoulder, rig.Middle, rig.Hand, rig.Glove, rig.Cuff } :: { Instance } do
		instance:Destroy()
	end
end

-- Резиновая рука: кубика Безье плечо→кисть, делится де Кастельжо пополам на два Beam
-- (у Beam контрольные точки = Attachment ± Axis·CurveSize). Толщина — сохранение объёма:
-- w ∝ √(L₀/L), плюс дополнительное истончение середины при натяжении.
local function drawArm(
	rig: ArmRig,
	shoulder: Vector3,
	handPosition: Vector3,
	tension: number,
	wobble: Vector3,
	bodyFrame: CFrame,
	sign: number,
	color: Color3
)
	local span = handPosition - shoulder
	local spanLength = span.Magnitude
	local length = math.max(spanLength, 0.05)
	local direction = if spanLength > 1e-4 then span / spanLength else bodyFrame.LookVector
	local slack = 1 - tension
	local outward = (bodyFrame.RightVector * (0.55 * sign) + bodyFrame.LookVector * 0.45 + bodyFrame.UpVector * 0.15).Unit
	local reach = length * 0.32
	local blend = outward * (0.5 * slack + 0.15) + direction * (0.5 + 0.5 * tension)
	local p0 = shoulder
	local p1 = shoulder + blend.Unit * reach + wobble * (0.5 * slack)
	local p2 = handPosition - direction * reach + Vector3.new(0, -length * 0.16 * slack, 0) + wobble * slack
	local p3 = handPosition
	local _, a1, a2, middle, b1, b2, _ = Bezier.SplitCubic(p0, p1, p2, p3, 0.5)

	rig.Shoulder.WorldCFrame = axisFrame(p0, a1 - p0)
	rig.Middle.WorldCFrame = axisFrame(middle, b1 - middle)
	rig.Hand.WorldCFrame = axisFrame(p3, p3 - b2)
	local curve0 = (a1 - p0).Magnitude
	local curve1 = (middle - a2).Magnitude
	local curve2 = (b1 - middle).Magnitude
	local curve3 = (p3 - b2).Magnitude
	rig.MainA.CurveSize0, rig.MainA.CurveSize1 = curve0, curve1
	rig.OutlineA.CurveSize0, rig.OutlineA.CurveSize1 = curve0, curve1
	rig.MainB.CurveSize0, rig.MainB.CurveSize1 = curve2, curve3
	rig.OutlineB.CurveSize0, rig.OutlineB.CurveSize1 = curve2, curve3

	local volume = math.sqrt(PhysicsConfig.ArmRestLength / math.max(length, PhysicsConfig.ArmRestLength))
	local base = math.max(PhysicsConfig.ArmBaseWidth * volume * (1 - 0.35 * tension), PhysicsConfig.ArmMinWidth)
	local shoulderWidth = base * 1.15
	local middleWidth = math.max(base * (0.8 - 0.32 * tension), PhysicsConfig.ArmMinWidth * 0.8)
	local handWidth = base * 0.95
	local outline = PhysicsConfig.ArmOutlineWidth
	rig.MainA.Width0, rig.MainA.Width1 = shoulderWidth, middleWidth
	rig.MainB.Width0, rig.MainB.Width1 = middleWidth, handWidth
	rig.OutlineA.Width0, rig.OutlineA.Width1 = shoulderWidth + outline, middleWidth + outline
	rig.OutlineB.Width0, rig.OutlineB.Width1 = middleWidth + outline, handWidth + outline

	-- растянутая резина светлеет к середине (квантуем, чтобы не создавать ColorSequence каждый кадр)
	local tintStep = math.floor(tension * 20 + 0.5)
	if tintStep ~= rig.LastTint then
		rig.LastTint = tintStep
		local tinted = color:Lerp(STRETCH_TINT, tintStep / 20 * 0.45)
		rig.MainA.Color = ColorSequence.new(color, tinted)
		rig.MainB.Color = ColorSequence.new(tinted, color)
	end

	local tangent = p3 - b2
	local handAxis = if tangent.Magnitude > 1e-4 then tangent.Unit else direction
	rig.Glove.CFrame = axisFrame(p3, handAxis)
	rig.Cuff.CFrame = axisFrame(p3 - handAxis * 0.95, handAxis)
end

local function loadFallTrack(humanoid: Humanoid, character: Model): AnimationTrack?
	local animator = humanoid:FindFirstChildOfClass("Animator")
	local animate = character:FindFirstChild("Animate")
	if animator == nil or animate == nil then
		return nil
	end
	local fall = animate:FindFirstChild("fall")
	local animation = if fall then fall:FindFirstChildWhichIsA("Animation") else nil
	if animation == nil then
		return nil
	end
	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		return track
	end
	return nil
end

-- ── Конструктор ────────────────────────────────────────────────────────────

local function makeCastParams(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	params.RespectCanCollide = true -- предсказанно пробитые стены (CanCollide=false локально) пропускаются
	params.CollisionGroup = PhysicsConfig.CollisionGroups.Characters -- другие игроки и обломки не мешают
	return params
end

function Controller.new(camera: ShoulderCamera.ShoulderCamera): ElasticSlingshotController
	local player = Players.LocalPlayer
	local glove = GloveConfig.Get(GloveConfig.DefaultGlove)

	local rigModel = Instance.new("Model")
	rigModel.Name = "StretchPopRig_Local"
	local peerModel = Instance.new("Model")
	peerModel.Name = "StretchPopRig_Peers"
	local markerFolder = Instance.new("Folder")
	markerFolder.Name = "StretchPopMarkers"

	local rigAnchor = newPart("RigAnchor", Enum.PartType.Block, Vector3.one * 0.2, WHITE, Enum.Material.SmoothPlastic, rigModel)
	rigAnchor.CFrame = HIDDEN_CFRAME -- держатель Attachment'ов: их WorldCFrame от него не зависит

	local highlight = Instance.new("Highlight")
	highlight.Name = "CartoonOutline"
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.OutlineColor = OUTLINE_COLOR
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Adornee = rigModel
	highlight.Parent = rigModel

	local hands = {} :: { [Types.HandSide]: Hand }
	for _, side in HAND_SIDES do
		hands[side] = {
			Side = side,
			Sign = if side == "Left" then -1 else 1,
			Phase = "Idle",
			Held = false,
			AnchorPart = nil,
			AnchorLocal = Vector3.zero,
			AnchorWorld = Vector3.zero,
			AnchorNormal = Vector3.yAxis,
			Position = Vector3.zero,
			RestLength = 0,
			Missed = false,
			MissTarget = Vector3.zero,
			Wobble = Spring.Vector.new(Vector3.zero, 2.4, 0.28),
			Rig = createArmRig(rigAnchor, rigModel, glove.Color, glove.Material, side),
		}
	end

	local trajectoryBeams: { Beam } = {}
	local trajectoryAttachments: { Attachment } = {}
	for index = 1, TRAJECTORY_SEGMENTS do
		local a0 = newAttachment("Arc" .. index .. "A", rigAnchor)
		local a1 = newAttachment("Arc" .. index .. "B", rigAnchor)
		local beam = newBeam("Arc" .. index, a0, a1, WHITE, 0.05, markerFolder)
		beam.LightEmission = 0.8
		beam.Segments = 10
		table.insert(trajectoryBeams, beam)
		table.insert(trajectoryAttachments, a0)
		table.insert(trajectoryAttachments, a1)
	end

	local impactMarker = newPart("ImpactMarker", Enum.PartType.Cylinder, Vector3.new(0.2, 5, 5), WHITE, Enum.Material.Neon, markerFolder)
	local aimMarker = newPart("AimMarker", Enum.PartType.Cylinder, Vector3.new(0.15, 2.4, 2.4), AIM_VALID_COLOR, Enum.Material.Neon, markerFolder)
	local smashMarkers: { Part } = {}
	for index = 1, SMASH_MARKERS do
		table.insert(
			smashMarkers,
			newPart("SmashMarker" .. index, Enum.PartType.Ball, Vector3.one * 1.6, AIM_VALID_COLOR, Enum.Material.Neon, markerFolder)
		)
	end

	local ballDiameter = PhysicsConfig.BallVisualRadius * 2
	local ballPart = newPart("SpringBall", Enum.PartType.Block, Vector3.one * ballDiameter, glove.Color, glove.Material, rigModel)
	ballPart.CFrame = HIDDEN_CFRAME
	local ballMesh = Instance.new("SpecialMesh")
	ballMesh.MeshType = Enum.MeshType.Sphere
	ballMesh.Parent = ballPart
	for _, hand in hands do
		hand.Rig.Glove.CFrame = HIDDEN_CFRAME
		hand.Rig.Cuff.CFrame = HIDDEN_CFRAME
	end

	rigModel.Parent = workspace
	peerModel.Parent = workspace
	markerFolder.Parent = workspace

	local fields: ControllerFields = {
		Player = player,
		Camera = camera,
		Signals = {
			StateChanged = Signal.new(),
			HandFired = Signal.new(),
			HandAttached = Signal.new(),
			HandReleased = Signal.new(),
			TensionChanged = Signal.new(),
			Launched = Signal.new(),
			Bounced = Signal.new(),
			Smashed = Signal.new(),
			Splat = Signal.new(),
			GongStruck = Signal.new(),
			LootGained = Signal.new(),
			BallChanged = Signal.new(),
		},

		Character = nil,
		Humanoid = nil,
		Root = nil,
		ShoulderOffsets = { Left = Vector3.new(-1.5, 1, 0), Right = Vector3.new(1.5, 1, 0) },
		RootHeight = 3,
		ArmParts = { Left = {}, Right = {} },
		ArmHidden = { Left = false, Right = false },
		BodyParts = {},
		BodyDecals = {},
		BodyDirty = true,
		BodyHidden = false,
		FallTrack = nil,

		State = "Walk",
		Hands = hands,
		Params = StretchPhysics.Derive({ Elasticity = 0, SpringPower = 0, SmashMass = 0 }, GloveConfig.DefaultGlove),
		GloveColor = glove.Color,
		GloveMaterial = glove.Material,

		SimPosition = Vector3.zero,
		SimVelocity = Vector3.zero,
		SimRotation = CFrame.identity,
		PrevPosition = Vector3.zero,
		PrevRotation = CFrame.identity,
		RenderCFrame = CFrame.identity,
		Accumulator = 0,
		LastWritten = Vector3.zero,
		LaunchGraceUntil = 0,

		BallHeld = false,
		BallSink = false,
		BallActive = false,
		BallAxis = Vector3.xAxis,
		BallSquash = Spring.Number.new(0, 3.2, 0.32),

		Tension = 0,
		LastTensionSent = 0,
		Combo = 0,
		LandedAt = nil,
		GongCooldownUntil = 0,
		Predictions = {},

		Aim = { Valid = false, Point = Vector3.zero, Normal = Vector3.yAxis, Part = nil },
		GrabPoints = {},
		CastParams = makeCastParams(),
		AimParams = makeCastParams(),
		PreviewParams = makeCastParams(),
		PreviewTimer = 0,

		RigModel = rigModel,
		PeerModel = peerModel,
		MarkerFolder = markerFolder,
		RigAnchor = rigAnchor,
		Highlight = highlight,
		TrajectoryBeams = trajectoryBeams,
		TrajectoryAttachments = trajectoryAttachments,
		ImpactMarker = impactMarker,
		AimMarker = aimMarker,
		SmashMarkers = smashMarkers,
		BallPart = ballPart,
		BallMesh = ballMesh,

		Peers = {},
		Connections = {},
		CharacterConnections = {},
		Started = false,
	}
	return setmetatable(fields, Controller)
end

-- ── Публичные геттеры (для HUD и аудио следующего шага) ────────────────────

function Controller.GetState(self: ElasticSlingshotController): string
	return self.State
end

function Controller.GetSpeed(self: ElasticSlingshotController): number
	if self.State ~= "Walk" then
		return self.SimVelocity.Magnitude
	end
	local root = self.Root
	return if root then root.AssemblyLinearVelocity.Magnitude else 0
end

function Controller.GetTension(self: ElasticSlingshotController): number
	return self.Tension
end

function Controller.GetCombo(self: ElasticSlingshotController): number
	return self.Combo
end

function Controller.GetParams(self: ElasticSlingshotController): StretchPhysics.StretchParams
	return self.Params
end

-- ── Статы и перчатка из атрибутов игрока (сервер их реплицирует) ───────────

function Controller.RefreshParams(self: ElasticSlingshotController)
	local player = self.Player
	local function stat(name: string): number
		local value = player:GetAttribute(name)
		return if typeof(value) == "number" then value else 0
	end
	local gloveAttribute = player:GetAttribute("Glove")
	local gloveId = if typeof(gloveAttribute) == "string" then gloveAttribute else nil
	self.Params = StretchPhysics.Derive({
		Elasticity = stat("Stat_Elasticity"),
		SpringPower = stat("Stat_SpringPower"),
		SmashMass = stat("Stat_SmashMass"),
	}, gloveId)
	local glove = GloveConfig.Get(gloveId)
	self.GloveColor = glove.Color
	self.GloveMaterial = glove.Material
	for _, hand in self.Hands do
		hand.Rig.Glove.Color = glove.Color
		hand.Rig.Glove.Material = glove.Material
		hand.Rig.Cuff.Color = glove.Accent
		hand.Rig.LastTint = -1
	end
	self.BallPart.Color = glove.Color
	self.BallPart.Material = glove.Material
	for _, beam in self.TrajectoryBeams do
		beam.Color = ColorSequence.new(WHITE, glove.Color)
	end
end

-- ── Состояния ───────────────────────────────────────────────────────────────

function Controller.SetState(self: ElasticSlingshotController, state: ControllerState)
	if self.State == state then
		return
	end
	self.State = state
	self.Signals.StateChanged:Fire(state)
end

function Controller.AnyAttached(self: ElasticSlingshotController): boolean
	for _, hand in self.Hands do
		if hand.Phase == "Attached" then
			return true
		end
	end
	return false
end

function Controller.CollectBands(self: ElasticSlingshotController): { StretchPhysics.Band }
	local bands: { StretchPhysics.Band } = {}
	for _, hand in self.Hands do
		if hand.Phase == "Attached" then
			table.insert(bands, { Anchor = hand.AnchorWorld, Rest = hand.RestLength })
		end
	end
	return bands
end

function Controller.AttachedCentroid(self: ElasticSlingshotController): Vector3?
	local sum = Vector3.zero
	local count = 0
	for _, hand in self.Hands do
		if hand.Phase == "Attached" then
			sum += hand.AnchorWorld
			count += 1
		end
	end
	return if count > 0 then sum / count else nil
end

function Controller.BodyPosition(self: ElasticSlingshotController): Vector3
	if self.State ~= "Walk" then
		return self.SimPosition
	end
	local root = self.Root
	return if root then root.Position else self.SimPosition
end

function Controller.PlayFall(self: ElasticSlingshotController, playing: boolean)
	local humanoid, character = self.Humanoid, self.Character
	if playing and self.FallTrack == nil and humanoid and character then
		self.FallTrack = loadFallTrack(humanoid, character)
	end
	local track = self.FallTrack
	if track then
		if playing and not track.IsPlaying then
			track:Play(0.15)
		elseif not playing and track.IsPlaying then
			track:Stop(0.2)
		end
	end
end

function Controller.EnterCustom(self: ElasticSlingshotController, state: ControllerState, velocity: Vector3)
	local root, humanoid = self.Root, self.Humanoid
	if root == nil or humanoid == nil then
		return
	end
	if self.State == "Walk" then
		self.SimPosition = root.Position
		self.SimRotation = root.CFrame.Rotation
		self.PrevPosition = self.SimPosition
		self.PrevRotation = self.SimRotation
		self.Accumulator = 0
		self.LastWritten = root.Position
		self.LandedAt = nil
		humanoid.AutoRotate = false
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end
	self.SimVelocity = velocity
	self:SetState(state)
	self:PlayFall(state == "Air")
end

function Controller.ExitCustom(self: ElasticSlingshotController, grounded: boolean)
	if self.State == "Walk" then
		return
	end
	local humanoid, root = self.Humanoid, self.Root
	if root and not grounded then
		-- выходим в обычное падение: вертикально, с сохранением импульса
		local look = flatten(self.SimRotation.LookVector)
		if look.Magnitude < 1e-3 then
			look = self.Camera:GetFlatLook()
		end
		root.CFrame = CFrame.new(root.Position) * lookRotation(look.Unit)
		root.AssemblyLinearVelocity = self.SimVelocity
		root.AssemblyAngularVelocity = Vector3.zero
	end
	self:SetState("Walk")
	self:PlayFall(false)
	self.Tension = 0
	if humanoid then
		humanoid.AutoRotate = true
		humanoid:ChangeState(if grounded then Enum.HumanoidStateType.Landed else Enum.HumanoidStateType.Freefall)
	end
	if grounded then
		self.LandedAt = os.clock()
	end
end

-- Внешний телепорт / сброс сервером / смерть: прекращаем кастомную физику, руки домой.
function Controller.AbortCustom(self: ElasticSlingshotController)
	for _, hand in self.Hands do
		if hand.Phase == "Attached" then
			Net.ArmVisual:FireServer(hand.Side, false, nil)
			self.Signals.HandReleased:Fire(hand.Side)
		end
		if hand.Phase ~= "Idle" then
			hand.Phase = "Retracting"
			hand.AnchorPart = nil
		end
	end
	self.BallHeld = false
	self:ExitCustom(false)
end

function Controller.HardReset(self: ElasticSlingshotController, target: CFrame?)
	self:AbortCustom()
	self.Combo = 0
	self.Accumulator = 0
	local character, root = self.Character, self.Root
	if target and character and root then
		character:PivotTo(target)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		self.Camera:SnapBehind(target.LookVector)
	end
	if root then
		self.SimPosition = root.Position
		self.LastWritten = root.Position
	end
end

-- ── Руки: выстрел, захват, отпускание ──────────────────────────────────────

function Controller.ShoulderWorld(self: ElasticSlingshotController, side: Types.HandSide): Vector3
	return self.RenderCFrame:PointToWorldSpace(self.ShoulderOffsets[side])
end

function Controller.FireHand(self: ElasticSlingshotController, hand: Hand)
	if self.Root == nil or hand.Phase == "Attached" or hand.Phase == "Flying" then
		return
	end
	local shoulder = self:ShoulderWorld(hand.Side)
	if hand.Phase == "Idle" then
		hand.Position = shoulder
	end
	local aim = self.Aim
	local aimPart = aim.Part
	if aim.Valid and aimPart then
		-- точка видна с камеры; проверяем, не заслоняет ли что-то линию от плеча
		local point, part, normal = aim.Point, aimPart, aim.Normal
		local toPoint = point - shoulder
		local blocker = workspace:Raycast(shoulder, toPoint, self.CastParams)
		if blocker and blocker.Distance < toPoint.Magnitude - 0.5 then
			point, part, normal = blocker.Position, blocker.Instance, blocker.Normal
		end
		hand.AnchorPart = part
		hand.AnchorLocal = part.CFrame:PointToObjectSpace(point)
		hand.AnchorWorld = point
		hand.AnchorNormal = normal
		hand.Missed = false
	else
		local _, direction = self.Camera:GetAimRay()
		hand.AnchorPart = nil
		hand.Missed = true
		hand.MissTarget = shoulder + direction * (self.Params.GrabRange * PhysicsConfig.MissReachFraction)
	end
	hand.Phase = "Flying"
	self.Signals.HandFired:Fire(hand.Side)
end

function Controller.IsAnchorValid(self: ElasticSlingshotController, hand: Hand): boolean
	local part = hand.AnchorPart
	if part == nil or not part.CanCollide or not part:IsDescendantOf(workspace) then
		return false
	end
	local body = self:BodyPosition()
	local limit = (self.Params.GrabRange + self.Params.MaxStretch) * ANCHOR_BREAK_FACTOR
	return (part.CFrame:PointToWorldSpace(hand.AnchorLocal) - body).Magnitude <= limit
end

function Controller.AttachHand(self: ElasticSlingshotController, hand: Hand)
	local root, humanoid = self.Root, self.Humanoid
	if root == nil or humanoid == nil then
		return
	end
	hand.Phase = "Attached"
	local body = self:BodyPosition()
	local offset = hand.AnchorWorld - body
	hand.RestLength = math.max(offset.Magnitude, PhysicsConfig.AirMinRestLength)
	if offset.Magnitude > 1e-3 then
		hand.Wobble:Impulse(offset.Unit * 26)
	end
	Net.ArmVisual:FireServer(hand.Side, true, hand.AnchorWorld)
	self.Signals.HandAttached:Fire(hand.Side)
	KineticVFX.ImpactRing(hand.AnchorWorld, hand.AnchorNormal, 2.6, self.GloveColor)

	if self.State == "Walk" then
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		local groundSpeed = flatten(root.AssemblyLinearVelocity).Magnitude
		if grounded and groundSpeed < CHARGE_MAX_GROUND_SPEED then
			self:EnterCustom("Charge", Vector3.zero)
		else
			self:EnterCustom("Air", root.AssemblyLinearVelocity)
		end
	end
end

function Controller.DetachHand(self: ElasticSlingshotController, hand: Hand, snap: boolean)
	if hand.Phase == "Attached" then
		Net.ArmVisual:FireServer(hand.Side, false, nil)
		self.Signals.HandReleased:Fire(hand.Side)
	end
	if hand.Phase ~= "Idle" then
		hand.Phase = "Retracting"
	end
	hand.AnchorPart = nil
	if snap then
		-- «хлыст» резинки при отпускании
		local frame = self.RenderCFrame
		hand.Wobble:Impulse(frame.UpVector * 34 + frame.RightVector * (hand.Sign * 18))
	end
	if self.State == "Charge" and not self:AnyAttached() then
		self:ExitCustom(true)
	end
end

function Controller.ReleaseSlingshot(self: ElasticSlingshotController)
	local bands = self:CollectBands()
	local velocity, _, tension = StretchPhysics.SlingshotLaunch(self.SimPosition, bands, self.Params)
	local speed = velocity.Magnitude
	local launching = speed >= PhysicsConfig.MinLaunchSpeed
	if launching then
		-- сначала переводим в полёт, потом отпускаем резинки (иначе Charge без резинок вернёт в ходьбу)
		self.Combo = 0
		self.LaunchGraceUntil = os.clock() + PhysicsConfig.LaunchGroundGrace
		self.SimVelocity = velocity
		self:SetState("Air")
		self:PlayFall(true)
	end
	for _, hand in self.Hands do
		if hand.Phase == "Attached" then
			self:DetachHand(hand, true)
		end
	end
	if not launching then
		self:ExitCustom(true)
		return
	end
	self.Tension = 0
	self.Signals.Launched:Fire(speed, velocity)
	self.Camera:AddTrauma(0.18 + 0.35 * tension)
	self.Camera:Kick(10 * tension)
	KineticVFX.LaunchBurst(self.SimPosition, velocity / speed, self.GloveColor)
end

function Controller.OnArmPressed(self: ElasticSlingshotController, side: Types.HandSide)
	local hand = self.Hands[side]
	hand.Held = true
	self:FireHand(hand)
end

function Controller.OnArmReleased(self: ElasticSlingshotController, side: Types.HandSide)
	local hand = self.Hands[side]
	hand.Held = false
	if hand.Phase == "Attached" then
		if self.State == "Charge" then
			self:ReleaseSlingshot()
		else
			self:DetachHand(hand, true)
		end
	end
end

function Controller.HandTension(self: ElasticSlingshotController, hand: Hand): number
	if hand.Phase == "Attached" then
		local stretch = (hand.AnchorWorld - self:BodyPosition()).Magnitude - hand.RestLength
		return math.clamp(stretch / self.Params.MaxStretch, 0, 1)
	elseif hand.Phase == "Flying" then
		return 0.12
	end
	return 0
end

function Controller.UpdateHands(self: ElasticSlingshotController, dt: number)
	for _, side in HAND_SIDES do
		local hand = self.Hands[side]
		local shoulder = self:ShoulderWorld(side)
		if hand.Phase == "Flying" then
			local part = hand.AnchorPart
			local target = hand.MissTarget
			if not hand.Missed and part then
				target = part.CFrame:PointToWorldSpace(hand.AnchorLocal)
				hand.AnchorWorld = target
			end
			local toTarget = target - hand.Position
			local distance = toTarget.Magnitude
			local stepLength = PhysicsConfig.HandSpeed * dt
			if distance <= stepLength + PhysicsConfig.HandArriveEpsilon then
				hand.Position = target
				if hand.Missed or not hand.Held or not self:IsAnchorValid(hand) then
					hand.Phase = "Retracting"
					hand.AnchorPart = nil
					hand.Wobble:Impulse(Vector3.new(0, 18, 0))
				else
					self:AttachHand(hand)
				end
			else
				hand.Position += toTarget / distance * stepLength
			end
		elseif hand.Phase == "Attached" then
			local part = hand.AnchorPart
			if part and self:IsAnchorValid(hand) then
				hand.AnchorWorld = part.CFrame:PointToWorldSpace(hand.AnchorLocal)
				hand.Position = hand.AnchorWorld
			else
				-- якорь исчез (стену пробили, деталь удалили волной) — резинка лопается
				self:DetachHand(hand, true)
			end
		elseif hand.Phase == "Retracting" then
			local toShoulder = shoulder - hand.Position
			local distance = toShoulder.Magnitude
			local stepLength = PhysicsConfig.HandRetractSpeed * dt
			if distance <= stepLength + 1 then
				hand.Phase = "Idle"
				hand.Position = shoulder
			else
				hand.Position += toShoulder / distance * stepLength
			end
		else
			hand.Position = shoulder
		end
		hand.Wobble:Update(dt)
	end
end

-- ── Прицел ──────────────────────────────────────────────────────────────────

function Controller.UpdateAim(self: ElasticSlingshotController)
	local root = self.Root
	if root == nil then
		return
	end
	local origin, direction = self.Camera:GetAimRay()
	local body = self:BodyPosition()
	local range = self.Params.GrabRange
	local castLength = range + (origin - body).Magnitude + 8
	local aim = self.Aim
	aim.Valid = false
	aim.Part = nil

	local hit = workspace:Raycast(origin, direction * castLength, self.AimParams)
	if hit and (hit.Position - body).Magnitude <= range then
		aim.Valid = true
		aim.Point = hit.Position
		aim.Normal = hit.Normal
		aim.Part = hit.Instance
	else
		-- Аим-ассист: ближайшая к лучу точка захвата в конусе (кольца, арки)
		local best: BasePart? = nil
		local bestDot = PhysicsConfig.AimAssistCos
		for point in self.GrabPoints do
			local toPoint = point.Position - origin
			local distance = toPoint.Magnitude
			if distance > 1e-3 and (point.Position - body).Magnitude <= range then
				local alignment = direction:Dot(toPoint / distance)
				if alignment > bestDot then
					best = point
					bestDot = alignment
				end
			end
		end
		if best then
			local lineOfSight = workspace:Raycast(origin, (best.Position - origin) * 1.02, self.AimParams)
			if lineOfSight and lineOfSight.Instance == best then
				aim.Valid = true
				aim.Point = lineOfSight.Position
				aim.Normal = lineOfSight.Normal
				aim.Part = best
			end
		end
	end

	if aim.Valid then
		self.AimMarker.CFrame = axisFrame(aim.Point + aim.Normal * 0.08, aim.Normal)
		self.AimMarker.Transparency = 0.15
	else
		self.AimMarker.Transparency = 1
	end
end

-- ── Фиксированный шаг: рогатка на земле ────────────────────────────────────

function Controller.StepCharge(self: ElasticSlingshotController, dt: number)
	local bands = self:CollectBands()
	if #bands == 0 then
		return
	end
	local params = self.Params
	local position = self.SimPosition

	-- опора пропала (платформу снесло) → висим на резинках
	local support = workspace:Raycast(position, Vector3.new(0, -(self.RootHeight + 1.5), 0), self.CastParams)
	if support == nil then
		self.SimVelocity = Vector3.zero
		self:SetState("Air")
		self:PlayFall(true)
		return
	end

	local currentStretch = StretchPhysics.MaxBandStretch(position, bands)
	local moved = Vector3.zero
	if currentStretch < params.MaxStretch then
		local ratio = math.clamp(currentStretch / params.MaxStretch, 0, 1)
		-- чем сильнее натяжение, тем тяжелее тянуть (ощущение F = −kx)
		local drawSpeed = PhysicsConfig.DrawSpeed * (1 - PhysicsConfig.DrawResistance * ratio * ratio)
		local stepVector = -self.Camera:GetFlatLook() * (drawSpeed * dt)
		local candidate = position + stepVector
		local candidateStretch = StretchPhysics.MaxBandStretch(candidate, bands)
		if candidateStretch <= currentStretch + 1e-4 then
			-- шаг не натягивает резинку (якорь позади камеры) — стоим, а не скользим к якорю
			candidate = position
		elseif candidateStretch > params.MaxStretch then
			local fraction = (params.MaxStretch - currentStretch) / (candidateStretch - currentStretch)
			candidate = position + stepVector * math.clamp(fraction, 0, 1)
		end
		local sweep = candidate - position
		if sweep.Magnitude > 1e-4 then
			local blocked = workspace:Spherecast(position + Vector3.new(0, 0.6, 0), PhysicsConfig.BodyRadius * 0.75, sweep, self.CastParams)
			if blocked then
				candidate = position
			else
				local ground = workspace:Raycast(candidate + Vector3.new(0, 3, 0), Vector3.new(0, -(self.RootHeight + 7), 0), self.CastParams)
				if ground and ground.Normal.Y >= PhysicsConfig.GroundNormalMinY then
					candidate = Vector3.new(candidate.X, ground.Position.Y + self.RootHeight, candidate.Z)
				else
					candidate = position -- край: дальше не тянем, чтобы не сорваться
				end
			end
		end
		moved = candidate - position
		position = candidate
	end
	self.SimPosition = position
	self.SimVelocity = moved / dt

	local _, _, tension = StretchPhysics.SlingshotLaunch(position, bands, params)
	self.Tension = tension
	local centroid = self:AttachedCentroid() or position
	local toCentroid = flatten(centroid - position)
	local facing = if toCentroid.Magnitude > 0.5 then toCentroid.Unit else self.Camera:GetFlatLook()
	local lean = math.rad(PhysicsConfig.ChargeLeanDegrees) * tension
	self.SimRotation = lookRotation(facing) * CFrame.Angles(lean, 0, 0)
end

-- ── Фиксированный шаг: полёт, банджи, шар ──────────────────────────────────

function Controller.RegisterBounce(self: ElasticSlingshotController, point: Vector3, normal: Vector3, normalSpeed: number)
	self.Combo += 1
	self.BallAxis = normal
	self.BallSquash.Position = -0.42
	self.BallSquash.Velocity = 0
	KineticVFX.ImpactRing(point, normal, math.clamp(normalSpeed * 0.05, 3, 12), self.GloveColor)
	self.Camera:AddTrauma(math.clamp(normalSpeed / 500, 0.05, 0.3))
	self.Signals.Bounced:Fire(self.Combo, self.SimVelocity.Magnitude, point)
end

function Controller.PredictSmash(
	self: ElasticSlingshotController,
	part: BasePart,
	obstacleId: string,
	point: Vector3,
	velocity: Vector3,
	impactSpeed: number
)
	if self.Predictions[obstacleId] then
		return
	end
	local snapshot = KineticVFX.Snapshot(part)
	local restore = KineticVFX.PredictHide(part)
	self.Predictions[obstacleId] = { Restore = restore, ExpiresAt = os.clock() + PREDICTION_TIMEOUT }
	KineticVFX.SmashBurst(snapshot, point, velocity)
	self.Combo += 1
	self.Camera:AddTrauma(0.32)
	self.Camera:Kick(4)
	Net.SmashRequest:FireServer(obstacleId, velocity, point, impactSpeed, self.Combo)
	self.Signals.Smashed:Fire(snapshot.Kind, impactSpeed, point)
end

function Controller.StrikeGong(self: ElasticSlingshotController, gong: BasePart, point: Vector3, velocity: Vector3)
	local now = os.clock()
	if now < self.GongCooldownUntil then
		return
	end
	self.GongCooldownUntil = now + GONG_CLIENT_COOLDOWN
	local speed = velocity.Magnitude
	KineticVFX.GongStrike(gong, point, velocity)
	self.Camera:AddTrauma(0.6)
	self.Camera:Kick(6)
	self.Signals.GongStruck:Fire(speed, self.Combo)
	local slot = gong:GetAttribute("GongLaneSlot")
	if typeof(slot) == "number" and gong:GetAttribute("OwnerUserId") == self.Player.UserId then
		Net.GongStrike:FireServer(slot, velocity, speed, self.Combo)
	end
end

function Controller.ResolveContact(self: ElasticSlingshotController, hit: RaycastResult): ContactResult
	local part = hit.Instance
	local normal = hit.Normal
	local velocity = self.SimVelocity
	local normalSpeed = velocity:Dot(normal)
	if normalSpeed >= -0.01 then
		return "Slide"
	end
	local speed = velocity.Magnitude
	local impact = -normalSpeed

	if part:HasTag(Tags.Gong) then
		self:StrikeGong(part, hit.Position, velocity)
		self.SimVelocity = StretchPhysics.Reflect(velocity, normal, PhysicsConfig.GongRestitution, 0.8)
		return "Bounce"
	end

	if part:HasTag(Tags.Smashable) then
		local durability = part:GetAttribute("Durability")
		local obstacleId = part:GetAttribute("ObstacleId")
		local mine = part:GetAttribute("OwnerUserId") == self.Player.UserId
		if typeof(durability) == "number" and typeof(obstacleId) == "string" then
			local impactSpeed = StretchPhysics.ImpactSpeed(velocity, normal)
			if mine and StretchPhysics.CanSmash(durability, self.Params.ImpactMass, impactSpeed) then
				self:PredictSmash(part, obstacleId, hit.Position, velocity, impactSpeed)
				return "Pass" -- «не тормозя игрока»: скорость не меняется
			end
			local needed = StretchPhysics.SpeedToBreak(durability, self.Params.ImpactMass)
			KineticVFX.WallWobble(part, velocity, impactSpeed / needed)
		end
	end

	if part:HasTag(Tags.Bouncy) then
		local reflected = StretchPhysics.Reflect(velocity, normal, PhysicsConfig.BouncySurfaceRestitution, 1)
		self.SimVelocity = StretchPhysics.ClampSpeed(reflected, math.max(PhysicsConfig.BouncySurfaceMaxSpeed, speed))
		self:RegisterBounce(hit.Position, normal, impact)
		return "Bounce"
	end

	if self.BallActive then
		if impact > PhysicsConfig.BounceMinNormalSpeed then
			self.SimVelocity = StretchPhysics.Reflect(velocity, normal, self.Params.Restitution, PhysicsConfig.BallTangentKeep)
			self:RegisterBounce(hit.Position, normal, impact)
			return "Bounce"
		end
		self.SimVelocity = velocity - normal * normalSpeed -- катимся
		return "Slide"
	end

	if normal.Y >= PhysicsConfig.GroundNormalMinY then
		local tangent = velocity - normal * normalSpeed
		if tangent.Magnitude < PhysicsConfig.LandSpeed and os.clock() >= self.LaunchGraceUntil then
			return "Land"
		end
		self.SimVelocity = tangent
		if impact > 60 then
			self.Camera:AddTrauma(math.clamp(impact / 400, 0, 0.35))
			KineticVFX.ImpactRing(hit.Position, normal, 5, WHITE)
		end
		return "Slide"
	end

	-- Стена/потолок без шара: мультяшный «шлепок», теряем нормальную скорость и часть касательной
	self.SimVelocity = (velocity - normal * normalSpeed) * PhysicsConfig.WallSlideKeep
	if impact > 40 then
		self.Camera:AddTrauma(math.clamp(impact / 300, 0.1, 0.5))
		KineticVFX.ImpactRing(hit.Position, normal, 4 + impact * 0.02, WHITE)
		self.Signals.Splat:Fire(impact)
	end
	return "Slide"
end

function Controller.Land(self: ElasticSlingshotController, groundPoint: Vector3)
	local root = self.Root
	local flat = flatten(self.SimVelocity)
	local look = if flat.Magnitude > 1 then flat.Unit else flatten(self.SimRotation.LookVector)
	if look.Magnitude < 1e-3 then
		look = self.Camera:GetFlatLook()
	end
	local position = groundPoint + Vector3.new(0, self.RootHeight, 0)
	self.SimPosition = position
	self.SimRotation = lookRotation(look.Unit)
	self.PrevPosition = position
	self.PrevRotation = self.SimRotation
	if root then
		root.CFrame = CFrame.new(position) * self.SimRotation
		root.AssemblyLinearVelocity = StretchPhysics.ClampSpeed(flat, 50)
		root.AssemblyAngularVelocity = Vector3.zero
	end
	self.BallHeld = false
	self:ExitCustom(true)
end

-- Sweep сферой с разрешением до 4 контактов за подшаг. Возвращает true, если приземлились.
function Controller.MoveAndCollide(self: ElasticSlingshotController, dt: number): boolean
	local radius = PhysicsConfig.BodyRadius
	local position = self.SimPosition
	local remaining = dt
	for _ = 1, 4 do
		local displacement = self.SimVelocity * remaining
		local length = displacement.Magnitude
		if length < 1e-4 then
			break
		end
		local hit = workspace:Spherecast(position, radius, displacement, self.CastParams)
		if hit == nil then
			position += displacement
			break
		end
		local travel = math.max(hit.Distance - PhysicsConfig.SkinWidth, 0)
		position += displacement.Unit * travel
		remaining *= math.max(1 - travel / length, 0)
		self.SimPosition = position
		local result = self:ResolveContact(hit)
		if result == "Land" then
			self:Land(hit.Position)
			return true
		end
		if result ~= "Pass" then
			position += hit.Normal * PhysicsConfig.SkinWidth
		end
	end
	self.SimPosition = position
	return false
end

-- Скольжение по земле: экспоненциальное трение и мягкое приземление
function Controller.ApplyGroundContact(self: ElasticSlingshotController, dt: number)
	if os.clock() < self.LaunchGraceUntil then
		return
	end
	local probe = Vector3.new(0, -(PhysicsConfig.BodyRadius + PhysicsConfig.GroundProbeExtra), 0)
	local ground = workspace:Raycast(self.SimPosition, probe, self.CastParams)
	if ground == nil or ground.Normal.Y < PhysicsConfig.GroundNormalMinY then
		return
	end
	local velocity = self.SimVelocity
	local normal = ground.Normal
	local normalSpeed = velocity:Dot(normal)
	if normalSpeed > 2 then
		return -- отрываемся от земли
	end
	local friction = if self.BallActive then 0.35 else PhysicsConfig.SkidFriction
	local tangent = (velocity - normal * normalSpeed) * math.exp(-friction * dt)
	self.SimVelocity = tangent
	local landSpeed = if self.BallActive then PhysicsConfig.LandSpeed * 0.4 else PhysicsConfig.LandSpeed
	if tangent.Magnitude < landSpeed then
		self:Land(ground.Position)
	end
end

function Controller.UpdateFlightRotation(self: ElasticSlingshotController, dt: number)
	local velocity = self.SimVelocity
	local target = self.SimRotation
	local centroid = self:AttachedCentroid()
	if centroid then
		local toAnchor = centroid - self.SimPosition
		if toAnchor.Magnitude > 1 then
			target = lookRotation(toAnchor) * CFrame.Angles(math.rad(-25), 0, 0)
		end
	elseif velocity.Magnitude > 8 then
		-- поза «супергероя»: голова вперёд по скорости
		target = lookRotation(velocity) * CFrame.Angles(math.rad(-70), 0, 0)
	end
	self.SimRotation = self.SimRotation:Lerp(target, 1 - math.exp(-10 * dt))
end

function Controller.StepAir(self: ElasticSlingshotController, dt: number)
	local params = self.Params
	local velocity = self.SimVelocity
	local position = self.SimPosition
	local acceleration = StretchPhysics.Gravity() + StretchPhysics.Drag(velocity)
	local humanoid = self.Humanoid
	if humanoid then
		local move = flatten(humanoid.MoveDirection)
		if move.Magnitude > 0.05 then
			acceleration += move.Unit * PhysicsConfig.AirControlAcceleration
		end
	end
	local maxTension = 0
	for _, hand in self.Hands do
		if hand.Phase == "Attached" then
			-- резинка укорачивается, пока кнопка зажата → тянет к якорю (банджи)
			hand.RestLength = math.max(PhysicsConfig.AirMinRestLength, hand.RestLength - PhysicsConfig.AirRetractSpeed * dt)
			local force, stretch =
				StretchPhysics.BandForce(position, hand.AnchorWorld, hand.RestLength, params.AirStiffness, velocity, PhysicsConfig.AirRadialDamping)
			acceleration += force / params.FlightMass
			maxTension = math.max(maxTension, stretch / params.MaxStretch)
		end
	end
	self.Tension = math.clamp(maxTension, 0, 1)
	self.SimVelocity = StretchPhysics.ClampSpeed(velocity + acceleration * dt, PhysicsConfig.MaxFlightSpeed)
	if self:MoveAndCollide(dt) then
		return
	end
	self:ApplyGroundContact(dt)
	if self.State ~= "Air" then
		return
	end
	self:UpdateFlightRotation(dt)
end

function Controller.Simulate(self: ElasticSlingshotController, dt: number)
	if self.State == "Charge" then
		self:StepCharge(dt)
	elseif self.State == "Air" then
		self:StepAir(dt)
	end
end

-- ── Шар и скрытие тела ──────────────────────────────────────────────────────

function Controller.CollectBody(self: ElasticSlingshotController)
	local character = self.Character
	table.clear(self.BodyParts)
	table.clear(self.BodyDecals)
	if character then
		for _, descendant in character:GetDescendants() do
			if descendant:IsA("BasePart") then
				if descendant.Name ~= "HumanoidRootPart" then
					table.insert(self.BodyParts, descendant)
				end
			elseif descendant:IsA("Decal") then
				table.insert(self.BodyDecals, descendant)
			end
		end
	end
	self.BodyDirty = false
end

function Controller.ApplyArmVisibility(self: ElasticSlingshotController, side: Types.HandSide, hidden: boolean)
	self.ArmHidden[side] = hidden
	if self.BodyHidden then
		return
	end
	for _, part in self.ArmParts[side] do
		part.LocalTransparencyModifier = if hidden then 1 else 0
	end
end

function Controller.SetBodyHidden(self: ElasticSlingshotController, hidden: boolean)
	if self.BodyDirty then
		self:CollectBody()
	end
	self.BodyHidden = hidden
	local modifier = if hidden then 1 else 0
	for _, part in self.BodyParts do
		part.LocalTransparencyModifier = modifier
	end
	for _, decal in self.BodyDecals do
		decal.LocalTransparencyModifier = modifier
	end
	if not hidden then
		for _, side in HAND_SIDES do
			if self.ArmHidden[side] then
				for _, part in self.ArmParts[side] do
					part.LocalTransparencyModifier = 1
				end
			end
		end
	end
end

function Controller.UpdateBall(self: ElasticSlingshotController, dt: number)
	local shouldBall = self.BallHeld and self.State == "Air"
	if shouldBall ~= self.BallActive then
		self.BallActive = shouldBall
		self:SetBodyHidden(shouldBall)
		self.BallSquash:Snap(0)
		Net.ArmVisual:FireServer("Ball", shouldBall, nil)
		self.Signals.BallChanged:Fire(shouldBall)
		if shouldBall then
			KineticVFX.ImpactRing(self.RenderCFrame.Position, Vector3.yAxis, 5, self.GloveColor)
		end
	end
	if not self.BallActive then
		if self.BallPart.Transparency < 1 then
			self.BallPart.Transparency = 1
			self.BallPart.CFrame = HIDDEN_CFRAME
		end
		return
	end
	local velocity = self.SimVelocity
	local speed = velocity.Magnitude
	if speed > 5 and self.BallSquash.Position > -0.05 then
		local blended = self.BallAxis:Lerp(velocity / speed, 1 - math.exp(-14 * dt))
		self.BallAxis = if blended.Magnitude > 0.1 then blended.Unit else velocity / speed
	end
	-- растяжение вдоль скорости, сжатие при ударе; объём сохраняется (across = 1/√along)
	self.BallSquash.Target = math.clamp(speed / 600, 0, 0.32)
	local squash = self.BallSquash:Update(dt)
	local along = math.max(1 + squash, 0.35)
	local across = 1 / math.sqrt(along)
	self.BallPart.CFrame = axisFrame(self.RenderCFrame.Position, self.BallAxis)
	self.BallMesh.Scale = Vector3.new(along, across, across)
	self.BallPart.Transparency = 0
end

-- ── Рендер рук ──────────────────────────────────────────────────────────────

function Controller.RenderArms(self: ElasticSlingshotController)
	for _, side in HAND_SIDES do
		local hand = self.Hands[side]
		local active = hand.Phase ~= "Idle"
		setRigVisible(hand.Rig, active)
		if active ~= self.ArmHidden[side] then
			self:ApplyArmVisibility(side, active)
		end
		if active then
			drawArm(
				hand.Rig,
				self:ShoulderWorld(side),
				hand.Position,
				self:HandTension(hand),
				hand.Wobble.Position,
				self.RenderCFrame,
				hand.Sign,
				self.GloveColor
			)
		end
	end
end

-- ── Предпросмотр траектории ─────────────────────────────────────────────────

function Controller.PredictPath(
	self: ElasticSlingshotController,
	startPosition: Vector3,
	startVelocity: Vector3,
	ball: boolean
): ({ Knot }, PathEnd?, { Vector3 })
	local knots: { Knot } = { { P = startPosition, V = startVelocity, T = 0, BreakAfter = false } }
	local smashPoints: { Vector3 } = {}
	local filter: { Instance } = { self.RigModel, self.MarkerFolder, KineticVFX.GetFolder() }
	local character = self.Character
	if character then
		table.insert(filter, character)
	end
	self.PreviewParams.FilterDescendantsInstances = filter

	local stepTime = PhysicsConfig.PreviewStep
	local steps = math.floor(PhysicsConfig.PreviewDuration / stepTime)
	local radius = PhysicsConfig.BodyRadius
	local gravity = StretchPhysics.Gravity()
	local position, velocity = startPosition, startVelocity
	local bounces = 0
	local t = 0
	for index = 1, steps do
		velocity = StretchPhysics.ClampSpeed(velocity + (gravity + StretchPhysics.Drag(velocity)) * stepTime, PhysicsConfig.MaxFlightSpeed)
		local displacement = velocity * stepTime
		local hit = workspace:Spherecast(position, radius, displacement, self.PreviewParams)
		t += stepTime
		if hit then
			local travel = math.max(hit.Distance - PhysicsConfig.SkinWidth, 0)
			position += displacement.Unit * travel
			local part = hit.Instance
			local normal = hit.Normal
			if part:HasTag(Tags.Gong) then
				table.insert(knots, { P = position, V = velocity, T = t, BreakAfter = false })
				return knots, { Position = hit.Position, Normal = normal, Kind = "Gong" }, smashPoints
			end
			local smashable = false
			if part:HasTag(Tags.Smashable) and part:GetAttribute("OwnerUserId") == self.Player.UserId then
				local durability = part:GetAttribute("Durability")
				if typeof(durability) == "number" then
					smashable = StretchPhysics.CanSmash(durability, self.Params.ImpactMass, StretchPhysics.ImpactSpeed(velocity, normal))
				end
			end
			local bouncy = part:HasTag(Tags.Bouncy)
			if smashable then
				table.insert(smashPoints, hit.Position)
				table.insert(filter, part)
				self.PreviewParams.FilterDescendantsInstances = filter
				position += displacement.Unit * math.max(displacement.Magnitude - travel, 0)
			elseif (ball or bouncy) and bounces < PhysicsConfig.PreviewMaxBounces and -velocity:Dot(normal) > PhysicsConfig.BounceMinNormalSpeed then
				table.insert(knots, { P = position, V = velocity, T = t, BreakAfter = true })
				local restitution = if bouncy then PhysicsConfig.BouncySurfaceRestitution else self.Params.Restitution
				velocity = StretchPhysics.Reflect(velocity, normal, restitution, if bouncy then 1 else PhysicsConfig.BallTangentKeep)
				position += normal * PhysicsConfig.SkinWidth
				bounces += 1
				table.insert(knots, { P = position, V = velocity, T = t, BreakAfter = false })
			else
				table.insert(knots, { P = position, V = velocity, T = t, BreakAfter = false })
				local kind = if part:HasTag(Tags.Smashable) then "Block" else "Solid"
				return knots, { Position = hit.Position, Normal = normal, Kind = kind }, smashPoints
			end
		else
			position += displacement
		end
		if index % PhysicsConfig.PreviewKnotEvery == 0 then
			table.insert(knots, { P = position, V = velocity, T = t, BreakAfter = false })
		end
	end
	if knots[#knots].T < t then
		table.insert(knots, { P = position, V = velocity, T = t, BreakAfter = false })
	end
	return knots, nil, smashPoints
end

function Controller.HidePreview(self: ElasticSlingshotController)
	for _, beam in self.TrajectoryBeams do
		beam.Enabled = false
	end
	self.ImpactMarker.Transparency = 1
	for _, marker in self.SmashMarkers do
		marker.Transparency = 1
	end
end

-- Дуга из сегментов Эрмита → кубики Безье на Beam (для параболы без сопротивления — точно)
function Controller.DrawPath(self: ElasticSlingshotController, knots: { Knot }, pathEnd: PathEnd?, smashPoints: { Vector3 })
	local beamIndex = 0
	local totalTime = math.max(knots[#knots].T, 1e-3)
	for index = 1, #knots - 1 do
		local a, b = knots[index], knots[index + 1]
		local segmentTime = b.T - a.T
		if not a.BreakAfter and segmentTime > 1e-4 and beamIndex < TRAJECTORY_SEGMENTS then
			beamIndex += 1
			local beam = self.TrajectoryBeams[beamIndex]
			local startAttachment = self.TrajectoryAttachments[beamIndex * 2 - 1]
			local endAttachment = self.TrajectoryAttachments[beamIndex * 2]
			local c1, c2 = Bezier.FromHermite(a.P, a.V, b.P, b.V, segmentTime)
			startAttachment.WorldCFrame = axisFrame(a.P, c1 - a.P)
			endAttachment.WorldCFrame = axisFrame(b.P, b.P - c2)
			beam.CurveSize0 = (c1 - a.P).Magnitude
			beam.CurveSize1 = (b.P - c2).Magnitude
			local f0, f1 = a.T / totalTime, b.T / totalTime
			beam.Transparency = NumberSequence.new(0.05 + 0.7 * f0, 0.05 + 0.7 * f1)
			beam.Width0 = 0.6 - 0.32 * f0
			beam.Width1 = 0.6 - 0.32 * f1
			beam.Enabled = true
		end
	end
	for index = beamIndex + 1, TRAJECTORY_SEGMENTS do
		self.TrajectoryBeams[index].Enabled = false
	end

	local marker = self.ImpactMarker
	if pathEnd then
		marker.CFrame = axisFrame(pathEnd.Position + pathEnd.Normal * 0.1, pathEnd.Normal)
		marker.Color = MARKER_COLORS[pathEnd.Kind] or WHITE
		marker.Transparency = 0.2
	else
		marker.Transparency = 1
	end
	for index, smashMarker in self.SmashMarkers do
		local point = smashPoints[index]
		if point then
			smashMarker.CFrame = CFrame.new(point)
			smashMarker.Transparency = 0.1
		else
			smashMarker.Transparency = 1
		end
	end
end

function Controller.UpdatePreview(self: ElasticSlingshotController, dt: number)
	local charging = self.State == "Charge" and self.Tension > 0.02
	local grappling = self.State == "Air" and self:AnyAttached()
	if not charging and not grappling then
		self:HidePreview()
		self.PreviewTimer = 0
		return
	end
	self.PreviewTimer -= dt
	if self.PreviewTimer > 0 then
		return
	end
	self.PreviewTimer = PhysicsConfig.PreviewRefreshInterval
	local startVelocity = self.SimVelocity
	if charging then
		startVelocity = StretchPhysics.SlingshotLaunch(self.SimPosition, self:CollectBands(), self.Params)
	end
	local knots, pathEnd, smashPoints = self:PredictPath(self.SimPosition, startVelocity, self.BallHeld)
	self:DrawPath(knots, pathEnd, smashPoints)
end

-- ── Другие игроки (визуал по ретрансляции сервера) ─────────────────────────

function Controller.GetPeer(self: ElasticSlingshotController, player: Player): PeerState
	local existing = self.Peers[player]
	if existing then
		return existing
	end
	local glove = GloveConfig.Get(GloveConfig.DefaultGlove)
	local hands = {} :: { [Types.HandSide]: PeerHand }
	for _, side in HAND_SIDES do
		hands[side] = {
			Active = false,
			Point = Vector3.zero,
			Rig = createArmRig(self.RigAnchor, self.PeerModel, glove.Color, glove.Material, "Peer" .. player.UserId .. side),
		}
	end
	local ballPart = newPart(
		"PeerBall" .. player.UserId,
		Enum.PartType.Block,
		Vector3.one * PhysicsConfig.BallVisualRadius * 2,
		glove.Color,
		glove.Material,
		self.PeerModel
	)
	ballPart.CFrame = HIDDEN_CFRAME
	for _, hand in hands do
		hand.Rig.Glove.CFrame = HIDDEN_CFRAME
		hand.Rig.Cuff.CFrame = HIDDEN_CFRAME
	end
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = ballPart
	local peer: PeerState = {
		Player = player,
		Hands = hands,
		Ball = false,
		BallPart = ballPart,
		BodyHidden = false,
	}
	self.Peers[player] = peer
	return peer
end

function Controller.RemovePeer(self: ElasticSlingshotController, player: Player)
	local peer = self.Peers[player]
	if peer == nil then
		return
	end
	for _, hand in peer.Hands do
		destroyArmRig(hand.Rig)
	end
	peer.BallPart:Destroy()
	self.Peers[player] = nil
end

function Controller.OnPeerArmVisual(self: ElasticSlingshotController, player: Player, side: string, active: boolean, point: Vector3?)
	if player == self.Player then
		return
	end
	local peer = self:GetPeer(player)
	if side == "Ball" then
		peer.Ball = active
		return
	end
	local hand = if side == "Left" then peer.Hands.Left elseif side == "Right" then peer.Hands.Right else nil
	if hand then
		hand.Active = active
		if point then
			hand.Point = point
		end
	end
end

local function setCharacterHidden(character: Model, hidden: boolean)
	local modifier = if hidden then 1 else 0
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
			descendant.LocalTransparencyModifier = modifier
		elseif descendant:IsA("Decal") then
			descendant.LocalTransparencyModifier = modifier
		end
	end
end

function Controller.UpdatePeers(self: ElasticSlingshotController)
	for player, peer in self.Peers do
		if player.Parent == nil then
			self:RemovePeer(player)
			continue
		end
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		local gloveAttribute = player:GetAttribute("Glove")
		local glove = GloveConfig.Get(if typeof(gloveAttribute) == "string" then gloveAttribute else nil)
		if character == nil or root == nil or not root:IsA("BasePart") then
			for _, hand in peer.Hands do
				setRigVisible(hand.Rig, false)
			end
			peer.BallPart.Transparency = 1
			continue
		end
		local frame = root.CFrame
		for _, side in HAND_SIDES do
			local hand = peer.Hands[side]
			setRigVisible(hand.Rig, hand.Active)
			if hand.Active then
				local sign = if side == "Left" then -1 else 1
				local shoulder = frame:PointToWorldSpace(Vector3.new(sign * 1.5, 1.1, 0))
				local length = (hand.Point - shoulder).Magnitude
				hand.Rig.Glove.Color = glove.Color
				drawArm(hand.Rig, shoulder, hand.Point, math.clamp((length - 12) / 60, 0, 1), Vector3.zero, frame, sign, glove.Color)
			end
		end
		if peer.Ball ~= peer.BodyHidden then
			peer.BodyHidden = peer.Ball
			setCharacterHidden(character, peer.Ball)
		end
		if peer.Ball then
			local velocity = root.AssemblyLinearVelocity
			local axis = if velocity.Magnitude > 5 then velocity.Unit else Vector3.xAxis
			peer.BallPart.CFrame = axisFrame(frame.Position, axis)
			peer.BallPart.Color = glove.Color
			peer.BallPart.Transparency = 0
		elseif peer.BallPart.Transparency < 1 then
			peer.BallPart.Transparency = 1
			peer.BallPart.CFrame = HIDDEN_CFRAME
		end
	end
end

-- ── Персонаж ────────────────────────────────────────────────────────────────

function Controller.UnbindCharacter(self: ElasticSlingshotController)
	for _, connection in self.CharacterConnections do
		connection:Disconnect()
	end
	table.clear(self.CharacterConnections)
	local track = self.FallTrack
	if track then
		track:Stop(0)
		track:Destroy()
	end
	self.FallTrack = nil
	self.Character = nil
	self.Humanoid = nil
	self.Root = nil
	self.State = "Walk"
	self.BallActive = false
	self.BallHeld = false
	self.BodyHidden = false
	for _, hand in self.Hands do
		hand.Phase = "Idle"
		hand.Held = false
		hand.AnchorPart = nil
		setRigVisible(hand.Rig, false)
	end
	self.ArmHidden.Left = false
	self.ArmHidden.Right = false
	self.BallPart.Transparency = 1
	self.AimMarker.Transparency = 1
	self:HidePreview()
end

function Controller.BindCharacter(self: ElasticSlingshotController, character: Model)
	self:UnbindCharacter()
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if humanoid == nil or root == nil or not humanoid:IsA("Humanoid") or not root:IsA("BasePart") then
		return
	end
	if self.Player.Character ~= character then
		return
	end
	local isR15 = humanoid.RigType == Enum.HumanoidRigType.R15
	local torso = character:WaitForChild(if isR15 then "UpperTorso" else "Torso", 5)

	self.Character = character
	self.Humanoid = humanoid
	self.Root = root
	self.RootHeight = if isR15 then humanoid.HipHeight + root.Size.Y * 0.5 else root.Size.Y * 0.5 + 2

	if torso and torso:IsA("BasePart") then
		local torsoInRoot = root.CFrame:ToObjectSpace(torso.CFrame)
		for _, side in HAND_SIDES do
			local sign = if side == "Left" then -1 else 1
			self.ShoulderOffsets[side] = torsoInRoot:PointToWorldSpace(Vector3.new(sign * torso.Size.X * 0.5, torso.Size.Y * 0.28, 0))
		end
	end

	for _, side in HAND_SIDES do
		local list: { BasePart } = {}
		for _, name in ARM_PART_NAMES[side] do
			local part = character:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				table.insert(list, part)
			end
		end
		self.ArmParts[side] = list
	end
	self.BodyDirty = true

	local filter: { Instance } = { character, self.RigModel, self.PeerModel, self.MarkerFolder, KineticVFX.GetFolder() }
	self.CastParams.FilterDescendantsInstances = filter
	self.AimParams.FilterDescendantsInstances = filter

	self.RenderCFrame = root.CFrame
	self.SimPosition = root.Position
	self.LastWritten = root.Position
	self.Accumulator = 0
	self.Combo = 0

	table.insert(
		self.CharacterConnections,
		humanoid.Died:Connect(function()
			self:AbortCustom()
			self:UnbindCharacter()
		end)
	)
	table.insert(
		self.CharacterConnections,
		character.DescendantAdded:Connect(function()
			self.BodyDirty = true
		end)
	)
end

-- ── Кадр ────────────────────────────────────────────────────────────────────

function Controller.ExpirePredictions(self: ElasticSlingshotController, now: number)
	for obstacleId, prediction in self.Predictions do
		if now > prediction.ExpiresAt then
			prediction.Restore()
			self.Predictions[obstacleId] = nil
		end
	end
end

function Controller.OnRenderStep(self: ElasticSlingshotController, frameDt: number)
	local dt = math.min(frameDt, 0.1)
	local now = os.clock()
	self:UpdatePeers()

	local root, humanoid = self.Root, self.Humanoid
	if root == nil or humanoid == nil or humanoid.Health <= 0 or root.Parent == nil then
		self.AimMarker.Transparency = 1
		self:HidePreview()
		return
	end

	self:ExpirePredictions(now)
	self:UpdateAim()

	if self.State == "Walk" then
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		local landedAt = self.LandedAt
		if landedAt and grounded and now - landedAt > PhysicsConfig.ComboRestTime then
			self.Combo = 0
			self.LandedAt = nil
		end
		if self.BallHeld and not grounded then
			self:EnterCustom("Air", root.AssemblyLinearVelocity)
		end
	else
		-- кто-то (сервер, сброс, спавн) переставил персонажа — не спорим с ним
		local drift = (root.Position - self.LastWritten).Magnitude
		if drift > math.max(TELEPORT_DRIFT_MIN, self.SimVelocity.Magnitude * dt * 4 + 12) then
			self:AbortCustom()
		end
	end

	if self.State ~= "Walk" then
		local fixed = PhysicsConfig.FixedTimestep
		self.Accumulator += dt
		local steps = 0
		while self.Accumulator >= fixed and steps < PhysicsConfig.MaxSubstepsPerFrame do
			self.PrevPosition = self.SimPosition
			self.PrevRotation = self.SimRotation
			self:Simulate(fixed)
			self.Accumulator -= fixed
			steps += 1
			if self.State == "Walk" then
				break
			end
		end
		if steps >= PhysicsConfig.MaxSubstepsPerFrame then
			self.Accumulator = 0 -- защита от «спирали смерти» на просадках FPS
		end
	end

	if self.State ~= "Walk" then
		local alpha = math.clamp(self.Accumulator / PhysicsConfig.FixedTimestep, 0, 1)
		local position = self.PrevPosition:Lerp(self.SimPosition, alpha)
		local rotation = self.PrevRotation:Lerp(self.SimRotation, alpha)
		local frame = CFrame.new(position) * rotation
		root.CFrame = frame
		root.AssemblyLinearVelocity = self.SimVelocity
		root.AssemblyAngularVelocity = Vector3.zero
		self.LastWritten = position
		self.RenderCFrame = frame
	else
		self.RenderCFrame = root.CFrame
		self.SimPosition = root.Position
	end

	self:UpdateHands(dt)
	self:UpdateBall(dt)
	self:RenderArms()
	self:UpdatePreview(dt)

	local speed = self:GetSpeed()
	self.Camera:SetSpeed(speed)
	if self.State == "Walk" then
		self.Tension = 0
	end
	if math.abs(self.Tension - self.LastTensionSent) > 0.01 then
		self.LastTensionSent = self.Tension
		self.Signals.TensionChanged:Fire(self.Tension)
	end
end

-- ── Ввод ────────────────────────────────────────────────────────────────────

function Controller.BindInput(self: ElasticSlingshotController)
	local function armAction(side: Types.HandSide)
		return function(_: string, inputState: Enum.UserInputState, _: InputObject): Enum.ContextActionResult
			if inputState == Enum.UserInputState.Begin then
				if self.Camera:IsMouseFree() then
					return Enum.ContextActionResult.Pass -- курсор освобождён (ALT): клики идут в интерфейс
				end
				self:OnArmPressed(side)
				return Enum.ContextActionResult.Sink
			elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
				self:OnArmReleased(side)
				return Enum.ContextActionResult.Sink
			end
			return Enum.ContextActionResult.Pass
		end
	end

	ContextActionService:BindActionAtPriority(
		ACTION_LEFT,
		armAction("Left"),
		false,
		ACTION_PRIORITY,
		Enum.UserInputType.MouseButton1,
		Enum.KeyCode.ButtonL2
	)
	ContextActionService:BindActionAtPriority(
		ACTION_RIGHT,
		armAction("Right"),
		false,
		ACTION_PRIORITY,
		Enum.UserInputType.MouseButton2,
		Enum.KeyCode.ButtonR2
	)
	ContextActionService:BindActionAtPriority(ACTION_BALL, function(_: string, inputState: Enum.UserInputState, _: InputObject): Enum.ContextActionResult
		if inputState == Enum.UserInputState.Begin then
			local humanoid = self.Humanoid
			local airborne = self.State ~= "Walk" or (humanoid ~= nil and humanoid.FloorMaterial == Enum.Material.Air)
			if airborne then
				self.BallHeld = true
				self.BallSink = true
				return Enum.ContextActionResult.Sink
			end
			self.BallSink = false
			return Enum.ContextActionResult.Pass -- на земле пробел = обычный прыжок
		elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			self.BallHeld = false
			local sunk = self.BallSink
			self.BallSink = false
			return if sunk then Enum.ContextActionResult.Sink else Enum.ContextActionResult.Pass
		end
		return Enum.ContextActionResult.Pass
	end, false, ACTION_PRIORITY, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
end

-- ── Запуск / остановка ──────────────────────────────────────────────────────

function Controller.Start(self: ElasticSlingshotController)
	if self.Started then
		return
	end
	self.Started = true
	self:RefreshParams()

	local player = self.Player
	table.insert(
		self.Connections,
		player.AttributeChanged:Connect(function(attribute: string)
			if string.sub(attribute, 1, 5) == "Stat_" or attribute == "Glove" then
				self:RefreshParams()
			end
		end)
	)

	for _, instance in CollectionService:GetTagged(Tags.GrabPoint) do
		if instance:IsA("BasePart") then
			self.GrabPoints[instance] = true
		end
	end
	table.insert(
		self.Connections,
		CollectionService:GetInstanceAddedSignal(Tags.GrabPoint):Connect(function(instance: Instance)
			if instance:IsA("BasePart") then
				self.GrabPoints[instance] = true
			end
		end)
	)
	table.insert(
		self.Connections,
		CollectionService:GetInstanceRemovedSignal(Tags.GrabPoint):Connect(function(instance: Instance)
			if instance:IsA("BasePart") then
				self.GrabPoints[instance] = nil
			end
		end)
	)

	table.insert(
		self.Connections,
		Net.SmashResult.OnClientEvent:Connect(function(obstacleId: string, accepted: boolean, loot: number, _reason: string?)
			local prediction = self.Predictions[obstacleId]
			self.Predictions[obstacleId] = nil
			if accepted then
				if loot > 0 then
					self.Signals.LootGained:Fire(loot)
				end
			elseif prediction then
				prediction.Restore() -- сервер не подтвердил: стена возвращается
			end
		end)
	)
	table.insert(
		self.Connections,
		Net.ControllerReset.OnClientEvent:Connect(function(target: CFrame?)
			self:HardReset(target)
		end)
	)
	table.insert(
		self.Connections,
		Net.PeerArmVisual.OnClientEvent:Connect(function(peer: Player, side: string, active: boolean, point: Vector3?)
			self:OnPeerArmVisual(peer, side, active, point)
		end)
	)
	table.insert(
		self.Connections,
		Players.PlayerRemoving:Connect(function(leaving: Player)
			self:RemovePeer(leaving)
		end)
	)
	table.insert(
		self.Connections,
		player.CharacterAdded:Connect(function(character: Model)
			self:BindCharacter(character)
		end)
	)
	local character = player.Character
	if character then
		task.spawn(function()
			self:BindCharacter(character)
		end)
	end

	self:BindInput()
	RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Input.Value + 5, function(dt: number)
		self:OnRenderStep(dt)
	end)
end

function Controller.Destroy(self: ElasticSlingshotController)
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
	ContextActionService:UnbindAction(ACTION_LEFT)
	ContextActionService:UnbindAction(ACTION_RIGHT)
	ContextActionService:UnbindAction(ACTION_BALL)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	self:AbortCustom()
	self:UnbindCharacter()
	for player in self.Peers do
		self:RemovePeer(player)
	end
	local signals: { [string]: any } = self.Signals :: any
	for _, signal in signals do
		signal:DisconnectAll()
	end
	self.RigModel:Destroy()
	self.PeerModel:Destroy()
	self.MarkerFolder:Destroy()
	self.Started = false
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">KineticLevelClient</string>
              <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Клиентская сторона KineticLevelAndRebirthService.
-- • Пробития других игроков → те же Squash & Stretch-эффекты (свои уже показаны предсказанием).
-- • Волна перерождения: фронт + поп-анимация деталей, которые сервер снимает/ставит при проходе фронта.
-- • Вердикт Гонга: празднование или «пшик»; в Studio — подсказка, чего не хватило.
-- • Локальный цветовой оттенок мира по тиру своей полосы.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)
local LevelConfig = require(Shared.Config.LevelConfig)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local KineticVFX = require(Client.Effects.KineticVFX)

local SMASH_RENDER_DISTANCE = 700
local WAVE_RENDER_DISTANCE = 1600
local CELEBRATION_COLOR = Color3.fromRGB(255, 214, 64)

local GONG_REASONS: { [string]: string } = {
	too_slow = "мало скорости",
	combo_too_low = "мало комбо (отскоки шаром / пробития)",
	speed_unverified = "сервер не подтвердил скорость",
	combo_unverified = "сервер не подтвердил комбо",
	too_far = "сервер не увидел тебя у Гонга",
	cooldown = "Гонг ещё звенит, подожди",
	wave_in_progress = "волна ещё идёт",
	not_your_lane = "это Гонг чужой полосы",
	lane_changed = "полоса уже перестроилась",
	no_gong = "Гонг ещё не появился",
}

type ActiveWave = {
	Connections: { RBXScriptConnection },
}

local KineticLevelClient = {}

local player = Players.LocalPlayer
local waves: { [number]: ActiveWave } = {}
local tint: ColorCorrectionEffect? = nil
local started = false

local function laneModel(slot: number): Model?
	local world = workspace:FindFirstChild("StretchPopWorld")
	local lanes = if world then world:FindFirstChild("Lanes") else nil
	local lane = if lanes then lanes:FindFirstChild("Lane_" .. slot) else nil
	if lane and lane:IsA("Model") then
		return lane
	end
	return nil
end

local function ownGong(): BasePart?
	local slot = player:GetAttribute("LaneSlot")
	if typeof(slot) ~= "number" then
		return nil
	end
	local lane = laneModel(slot)
	local mutable = if lane then lane:FindFirstChild("Mutable") else nil
	local gong = if mutable then mutable:FindFirstChild("GongDisc") else nil
	if gong and gong:IsA("BasePart") then
		return gong
	end
	return nil
end

local function cameraDistance(position: Vector3): number
	local camera = workspace.CurrentCamera
	if camera == nil then
		return math.huge
	end
	return (camera.CFrame.Position - position).Magnitude
end

local function isLanePiece(instance: Instance): boolean
	local parent = instance.Parent
	return instance:IsA("BasePart") and parent ~= nil and (parent.Name == "Mutable" or parent.Name == "Obstacles")
end

local function applyTint(tier: number)
	local effect = tint
	if effect == nil then
		return
	end
	local theme = LevelConfig.GetTheme(tier)
	TweenService:Create(effect, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { TintColor = theme.Tint }):Play()
end

local function stopWave(slot: number)
	local wave = waves[slot]
	if wave == nil then
		return
	end
	for _, connection in wave.Connections do
		connection:Disconnect()
	end
	waves[slot] = nil
end

local function onRebirthWave(info: Types.RebirthWaveInfo)
	local isMine = info.OwnerUserId == player.UserId
	if not isMine and cameraDistance(info.LaneOrigin.Position) > WAVE_RENDER_DISTANCE then
		return
	end
	KineticVFX.RebirthWave(info)
	local lane = laneModel(info.Slot)
	if lane == nil then
		return
	end
	stopWave(info.Slot)
	local wave: ActiveWave = { Connections = {} }
	waves[info.Slot] = wave
	table.insert(
		wave.Connections,
		lane.DescendantAdded:Connect(function(descendant: Instance)
			if isLanePiece(descendant) then
				KineticVFX.PopIn(descendant :: BasePart)
			end
		end)
	)
	table.insert(
		wave.Connections,
		lane.DescendantRemoving:Connect(function(descendant: Instance)
			if isLanePiece(descendant) then
				KineticVFX.PopOut(descendant :: BasePart)
			end
		end)
	)
	local untilStart = math.max(info.StartServerTime - workspace:GetServerTimeNow(), 0)
	local duration = (info.EndZ - info.OriginZ) / info.Speed
	task.delay(untilStart + duration + 1.5, function()
		if waves[info.Slot] == wave then
			stopWave(info.Slot)
		end
	end)
end

local function onObstacleSmashed(
	smasherUserId: number,
	_slot: number,
	_obstacleId: string,
	snapshot: Types.SmashSnapshot,
	point: Vector3,
	velocity: Vector3
)
	if smasherUserId == player.UserId then
		return -- уже показано предсказанием
	end
	if cameraDistance(point) <= SMASH_RENDER_DISTANCE then
		KineticVFX.SmashBurst(snapshot, point, velocity)
	end
end

local function onGongResult(accepted: boolean, reason: string, needSpeed: number, needCombo: number, speed: number, combo: number)
	KineticVFX.GongVerdict(ownGong(), accepted, CELEBRATION_COLOR)
	if RunService:IsStudio() then
		if accepted then
			print(string.format("[StretchPop] REBIRTH! Скорость %d, комбо %d — локация перерождается", math.floor(speed), combo))
		else
			print(
				string.format(
					"[StretchPop] Гонг не засчитан: %s (скорость %d / %d, комбо %d / %d)",
					GONG_REASONS[reason] or reason,
					math.floor(speed),
					math.floor(needSpeed),
					combo,
					needCombo
				)
			)
		end
	end
end

function KineticLevelClient.Start()
	if started then
		return
	end
	started = true

	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "StretchPopTierTint"
	effect.TintColor = Color3.new(1, 1, 1)
	effect.Parent = Lighting
	tint = effect
	local tier = player:GetAttribute("LocationTier")
	applyTint(if typeof(tier) == "number" then tier else 0)
	player:GetAttributeChangedSignal("LocationTier"):Connect(function()
		local value = player:GetAttribute("LocationTier")
		applyTint(if typeof(value) == "number" then value else 0)
	end)

	Net.ObstacleSmashed.OnClientEvent:Connect(onObstacleSmashed)
	Net.RebirthWave.OnClientEvent:Connect(onRebirthWave)
	Net.GongResult.OnClientEvent:Connect(onGongResult)
end

return KineticLevelClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">ShoulderCameraController</string>
              <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Камера «из-за плеча» с захваченной мышью.
-- Нужна потому, что ПКМ занята правой рукой: стандартная камера Roblox вращается по ПКМ.
-- • Мышь в центре (крестик рисует HUD). SetMouseFree освобождает курсор — так HUD открывает
--   панель прокачки по Tab / Alt / кнопке, не споря с камерой за клавиши.
-- • Дистанция и FOV пружинят от скорости полёта (Hooke-пружины), тряска по модели trauma².
-- • Столкновение камеры со стенами через Spherecast; другие игроки и обломки игнорируются группой.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Spring = require(Shared.Math.Spring)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)

local UserGameSettings = UserSettings():GetService("UserGameSettings")

local RENDER_STEP_NAME = "StretchPop_ShoulderCamera"
local LOCKED_MOUSE_ICON = "rbxasset://textures/MouseLockedCursor.png"

local BASE_FOV = 70
local FOV_SPEED_BOOST = 24
local BASE_DISTANCE = 12
local SPEED_DISTANCE = 8
local SPEED_FOR_MAX_EFFECT = 420
local SHOULDER_OFFSET = 2.1
local HEIGHT_OFFSET = 1.1
local FOCUS_HEIGHT = 2.2
local MOUSE_RADIANS_PER_PIXEL = 0.0042
local GAMEPAD_YAW_RATE = 3.4
local GAMEPAD_PITCH_RATE = 2.4
local GAMEPAD_DEADZONE = 0.15
local PITCH_MIN = math.rad(-72)
local PITCH_MAX = math.rad(68)
local MAX_FOCUS_LAG = 9
local COLLISION_RADIUS = 0.7
local MIN_CAMERA_DISTANCE = 1.2
local TRAUMA_DECAY = 1.7
local SHAKE_MAX_ANGLE = math.rad(3.2)
local SHAKE_MAX_OFFSET = 0.45
local SHAKE_FREQUENCY = 22
local FOV_KICK_GAIN = 18

type CameraFields = {
	Player: Player,
	Yaw: number,
	Pitch: number,
	Distance: Spring.NumberSpring,
	Fov: Spring.NumberSpring,
	Focus: Spring.VectorSpring,
	LastFocus: Vector3,
	NeedsSnap: boolean,
	SpeedHint: number,
	Trauma: number,
	Seed: number,
	MouseFree: boolean,
	GamepadLook: Vector2,
	CastParams: RaycastParams,
	FilteredCharacter: Model?,
	Connections: { RBXScriptConnection },
	Started: boolean,
}

local ShoulderCamera = {}
ShoulderCamera.__index = ShoulderCamera

export type ShoulderCamera = typeof(setmetatable({} :: CameraFields, ShoulderCamera))

function ShoulderCamera.new(): ShoulderCamera
	local castParams = RaycastParams.new()
	castParams.FilterType = Enum.RaycastFilterType.Exclude
	castParams.IgnoreWater = true
	castParams.RespectCanCollide = true
	castParams.CollisionGroup = PhysicsConfig.CollisionGroups.Characters

	local fields: CameraFields = {
		Player = Players.LocalPlayer,
		Yaw = 0,
		Pitch = math.rad(-12),
		Distance = Spring.Number.new(BASE_DISTANCE, 2.2, 0.9),
		Fov = Spring.Number.new(BASE_FOV, 3, 0.55),
		Focus = Spring.Vector.new(Vector3.zero, 9, 1),
		LastFocus = Vector3.zero,
		NeedsSnap = true,
		SpeedHint = 0,
		Trauma = 0,
		Seed = math.random() * 100,
		MouseFree = false,
		GamepadLook = Vector2.zero,
		CastParams = castParams,
		FilteredCharacter = nil,
		Connections = {},
		Started = false,
	}
	return setmetatable(fields, ShoulderCamera)
end

function ShoulderCamera.SetSpeed(self: ShoulderCamera, speed: number)
	self.SpeedHint = speed
end

-- Тряска: trauma ∈ [0,1], визуально — trauma² (мелкие удары почти не трясут, крупные — сильно)
function ShoulderCamera.AddTrauma(self: ShoulderCamera, amount: number)
	self.Trauma = math.clamp(self.Trauma + amount, 0, 1)
end

-- Импульс FOV в градусах (пружина сама вернёт обратно с мультяшным перелётом)
function ShoulderCamera.Kick(self: ShoulderCamera, degrees: number)
	self.Fov:Impulse(degrees * FOV_KICK_GAIN)
end

function ShoulderCamera.GetAimRay(self: ShoulderCamera): (Vector3, Vector3)
	local camera = workspace.CurrentCamera
	local cframe = camera.CFrame
	return cframe.Position, cframe.LookVector
end

function ShoulderCamera.GetFlatLook(self: ShoulderCamera): Vector3
	return Vector3.new(-math.sin(self.Yaw), 0, -math.cos(self.Yaw))
end

function ShoulderCamera.IsMouseFree(self: ShoulderCamera): boolean
	return self.MouseFree
end

-- Освободить (true) или снова захватить (false) курсор. Пока курсор свободен, камера не крутится,
-- а клики ЛКМ/ПКМ уходят в интерфейс (контроллер рогатки пропускает их).
function ShoulderCamera.SetMouseFree(self: ShoulderCamera, free: boolean)
	self.MouseFree = free
end

-- Развернуть камеру за спину по направлению взгляда персонажа (спавн, телепорт).
function ShoulderCamera.SnapBehind(self: ShoulderCamera, lookVector: Vector3)
	local flat = Vector3.new(lookVector.X, 0, lookVector.Z)
	if flat.Magnitude > 1e-3 then
		flat = flat.Unit
		self.Yaw = math.atan2(-flat.X, -flat.Z)
	end
	self.Pitch = math.rad(-12)
	self.NeedsSnap = true
end

function ShoulderCamera.Update(self: ShoulderCamera, dt: number)
	local camera = workspace.CurrentCamera
	if camera == nil then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	-- Ввод: мышь (захвачена в центре) и правый стик геймпада
	local free = self.MouseFree or GuiService.MenuIsOpen or UserInputService:GetFocusedTextBox() ~= nil
	if free then
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if UserInputService.MouseIcon ~= "" then
			UserInputService.MouseIcon = ""
		end
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		if UserInputService.MouseIcon ~= LOCKED_MOUSE_ICON then
			UserInputService.MouseIcon = LOCKED_MOUSE_ICON
		end
		local delta = UserInputService:GetMouseDelta()
		local sensitivity = UserGameSettings.MouseSensitivity
		self.Yaw -= delta.X * MOUSE_RADIANS_PER_PIXEL * sensitivity
		self.Pitch -= delta.Y * MOUSE_RADIANS_PER_PIXEL * sensitivity
	end
	local stick = self.GamepadLook
	if not free and stick.Magnitude > GAMEPAD_DEADZONE then
		self.Yaw -= stick.X * GAMEPAD_YAW_RATE * dt
		self.Pitch += stick.Y * GAMEPAD_PITCH_RATE * dt
	end
	self.Pitch = math.clamp(self.Pitch, PITCH_MIN, PITCH_MAX)
	self.Yaw %= 2 * math.pi

	-- Фокус: пружинное следование за корнем персонажа с ограничением отставания
	local character = self.Player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if character and root and root:IsA("BasePart") then
		if self.FilteredCharacter ~= character then
			self.FilteredCharacter = character
			self.CastParams.FilterDescendantsInstances = { character }
		end
		local target = root.Position + Vector3.new(0, FOCUS_HEIGHT, 0)
		if self.NeedsSnap then
			self.NeedsSnap = false
			self.Focus:Snap(target)
		end
		self.Focus.Target = target
		self.Focus:Update(dt)
		local lag = self.Focus.Position - target
		if lag.Magnitude > MAX_FOCUS_LAG then
			self.Focus.Position = target + lag.Unit * MAX_FOCUS_LAG
		end
		self.LastFocus = self.Focus.Position
	end
	local focus = self.LastFocus

	-- Скорость → дальше и шире (ощущение разгона)
	local speedAlpha = math.clamp(self.SpeedHint / SPEED_FOR_MAX_EFFECT, 0, 1)
	self.Distance.Target = BASE_DISTANCE + SPEED_DISTANCE * speedAlpha
	self.Fov.Target = BASE_FOV + FOV_SPEED_BOOST * speedAlpha ^ 0.8
	local distance = self.Distance:Update(dt)
	local fov = self.Fov:Update(dt)

	local rotation = CFrame.fromEulerAnglesYXZ(self.Pitch, self.Yaw, 0)
	local offset = rotation:VectorToWorldSpace(Vector3.new(SHOULDER_OFFSET, HEIGHT_OFFSET, distance))
	local position = focus + offset
	local hit = workspace:Spherecast(focus, COLLISION_RADIUS, offset, self.CastParams)
	if hit then
		position = focus + offset.Unit * math.max(hit.Distance - 0.2, MIN_CAMERA_DISTANCE)
	end

	-- Тряска (шум Перлина, затухание trauma)
	local shake = self.Trauma * self.Trauma
	local cframe = CFrame.new(position) * rotation
	if shake > 1e-4 then
		local t = os.clock() * SHAKE_FREQUENCY
		local seed = self.Seed
		local shakeRotation = CFrame.Angles(
			SHAKE_MAX_ANGLE * shake * math.noise(t, 1.3, seed),
			SHAKE_MAX_ANGLE * shake * math.noise(t, 7.1, seed),
			SHAKE_MAX_ANGLE * 0.6 * shake * math.noise(t, 13.7, seed)
		)
		local shakeOffset = Vector3.new(math.noise(t, 21.3, seed), math.noise(t, 31.9, seed), 0) * (SHAKE_MAX_OFFSET * shake)
		cframe = cframe * CFrame.new(shakeOffset) * shakeRotation
	end
	self.Trauma = math.max(0, self.Trauma - TRAUMA_DECAY * dt)

	camera.CFrame = cframe
	camera.Focus = CFrame.new(focus)
	camera.FieldOfView = math.clamp(fov, 40, 115)
end

function ShoulderCamera.Start(self: ShoulderCamera)
	if self.Started then
		return
	end
	self.Started = true

	table.insert(
		self.Connections,
		UserInputService.InputChanged:Connect(function(input: InputObject)
			if input.KeyCode == Enum.KeyCode.Thumbstick2 then
				self.GamepadLook = Vector2.new(input.Position.X, input.Position.Y)
			end
		end)
	)
	table.insert(
		self.Connections,
		self.Player.CharacterAdded:Connect(function(character: Model)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if root and root:IsA("BasePart") then
				self:SnapBehind(root.CFrame.LookVector)
			end
		end)
	)

	RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		self:Update(dt)
	end)
end

function ShoulderCamera.Destroy(self: ShoulderCamera)
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIcon = ""
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
	end
	self.Started = false
end

return ShoulderCamera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">StretchAudioController</string>
              <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · StretchAudioController — процедурный и гармонический звук.
-- Все ассеты и частоты — в Shared/Config/SoundConfig; здесь только «как звучит физика»:
--   • Натяжение рогатки: луп резины, PlaybackSpeed/громкость/EQ-фильтр идут за Tension (сглажено пружиной),
--     плюс гранулярный «скрип» — короткие зёрна, частота которых растёт с натяжением.
--   • Launched: хлёсткий отстрел; полёт: свист ветра, модулированный скоростью (+ трепет и сверхзвук).
--   • Bounced/Smashed: питч удара по ступеням мажорной пентатоники от текущего Combo — серия ударов играет мелодию.
--   • Гонг и волна перерождения: глубокий резонанс через ReverbSoundEffect + EchoSoundEffect группы Resonance,
--     мажорный аккорд-«страм» на успех и протяжный свип питча на всю длину волны.
--   • Интерфейс: клики, открытие панели, покупка (арпеджио) и отказ.

local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)
local SoundConfig = require(Shared.Config.SoundConfig)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local Spring = require(Shared.Math.Spring)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ElasticSlingshotController = require(Client.Controllers.ElasticSlingshotController)
local ShoulderCamera = require(Client.Controllers.ShoulderCameraController)
local StretchHUDController = require(Client.Controllers.StretchHUDController)

type Voice = {
	Sound: Sound,
	BusyUntil: number,
}

type Bank = {
	Name: string,
	Def: SoundConfig.SoundDef,
	Voices: { Voice },
	Next: number,
}

type Loop = {
	Sound: Sound,
	Equalizer: EqualizerSoundEffect,
	Playing: boolean,
}

type Sweep = {
	Voice: Voice,
	StartsAt: number,
	Duration: number,
	FromPitch: number,
	ToPitch: number,
	Volume: number,
	Started: boolean,
}

type ScheduledNote = {
	At: number,
	Bank: string,
	Pitch: number,
	Volume: number,
}

type AudioFields = {
	Player: Player,
	Slingshot: ElasticSlingshotController.ElasticSlingshotController,
	Camera: ShoulderCamera.ShoulderCamera,
	Hud: StretchHUDController.StretchHUDController?,
	Folder: Folder,
	Groups: { [SoundConfig.SoundGroupName]: SoundGroup },
	Banks: { [string]: Bank },
	StretchLoop: Loop,
	WindLoop: Loop,
	TensionTarget: number,
	TensionSmoothed: Spring.NumberSpring,
	SpeedSmoothed: Spring.NumberSpring,
	CreakTimer: number,
	Sweeps: { Sweep },
	Schedule: { ScheduledNote },
	Random: Random,
	Connections: { any },
	Started: boolean,
}

local Audio = {}
Audio.__index = Audio

export type StretchAudioController = typeof(setmetatable({} :: AudioFields, Audio))

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function createSound(def: SoundConfig.SoundDef, name: string, group: SoundGroup, parent: Instance): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = def.Id
	sound.Volume = def.Volume
	sound.PlaybackSpeed = def.Pitch
	sound.Looped = def.Looped
	sound.SoundGroup = group
	sound.Parent = parent
	return sound
end

local function createGroup(name: SoundConfig.SoundGroupName, parent: Instance): SoundGroup
	local group = Instance.new("SoundGroup")
	group.Name = "StretchPop_" .. name
	group.Volume = SoundConfig.MasterVolume * SoundConfig.GroupVolumes[name]
	if name == "Resonance" then
		local settings = SoundConfig.Resonance
		local reverb = Instance.new("ReverbSoundEffect")
		reverb.DecayTime = settings.DecayTime
		reverb.Density = settings.Density
		reverb.Diffusion = settings.Diffusion
		reverb.DryLevel = settings.DryLevel
		reverb.WetLevel = settings.WetLevel
		reverb.Priority = 1
		reverb.Parent = group
		local echo = Instance.new("EchoSoundEffect")
		echo.Delay = settings.EchoDelay
		echo.Feedback = settings.EchoFeedback
		echo.DryLevel = settings.EchoDryLevel
		echo.WetLevel = settings.EchoWetLevel
		echo.Priority = 2
		echo.Parent = group
	end
	group.Parent = parent
	return group
end

local function createLoop(def: SoundConfig.SoundDef, name: string, group: SoundGroup, parent: Instance): Loop
	local sound = createSound(def, name, group, parent)
	sound.Looped = true
	sound.Volume = 0
	local equalizer = Instance.new("EqualizerSoundEffect")
	equalizer.LowGain = 0
	equalizer.MidGain = 0
	equalizer.HighGain = 0
	equalizer.Parent = sound
	return { Sound = sound, Equalizer = equalizer, Playing = false }
end

function Audio.new(
	slingshot: ElasticSlingshotController.ElasticSlingshotController,
	camera: ShoulderCamera.ShoulderCamera,
	hud: StretchHUDController.StretchHUDController?
): StretchAudioController
	local folder = Instance.new("Folder")
	folder.Name = "StretchPopAudio"
	folder.Parent = SoundService

	local groups = {} :: { [SoundConfig.SoundGroupName]: SoundGroup }
	for _, groupName in { "Sfx", "Resonance", "Ui" } :: { SoundConfig.SoundGroupName } do
		groups[groupName] = createGroup(groupName, SoundService)
	end

	local banks: { [string]: Bank } = {}
	for name, def in SoundConfig.Sounds do
		if not def.Looped then
			local voices: { Voice } = {}
			for index = 1, math.max(def.Voices, 1) do
				table.insert(voices, { Sound = createSound(def, name .. index, groups[def.Group], folder), BusyUntil = 0 })
			end
			banks[name] = { Name = name, Def = def, Voices = voices, Next = 1 }
		end
	end

	local stretchDef = SoundConfig.Sounds.StretchLoop
	local windDef = SoundConfig.Sounds.WindLoop
	local fields: AudioFields = {
		Player = Players.LocalPlayer,
		Slingshot = slingshot,
		Camera = camera,
		Hud = hud,
		Folder = folder,
		Groups = groups,
		Banks = banks,
		StretchLoop = createLoop(stretchDef, "StretchLoop", groups[stretchDef.Group], folder),
		WindLoop = createLoop(windDef, "WindLoop", groups[windDef.Group], folder),
		TensionTarget = 0,
		TensionSmoothed = Spring.Number.new(0, SoundConfig.Tension.Smoothing, 1),
		SpeedSmoothed = Spring.Number.new(0, SoundConfig.Wind.Smoothing, 1),
		CreakTimer = 0,
		Sweeps = {},
		Schedule = {},
		Random = Random.new(),
		Connections = {},
		Started = false,
	}
	return setmetatable(fields, Audio)
end

-- ── Воспроизведение ─────────────────────────────────────────────────────────

-- Свободный голос банка (или самый старый — «кража голоса», как в синтезаторах)
function Audio.TakeVoice(self: StretchAudioController, bank: Bank): Voice
	local now = os.clock()
	local count = #bank.Voices
	for offset = 0, count - 1 do
		local index = ((bank.Next - 1 + offset) % count) + 1
		local voice = bank.Voices[index]
		if voice.BusyUntil <= now then
			bank.Next = (index % count) + 1
			return voice
		end
	end
	local voice = bank.Voices[bank.Next]
	bank.Next = (bank.Next % count) + 1
	return voice
end

-- pitch и volume — множители к значениям слота из SoundConfig
function Audio.Play(self: StretchAudioController, bankName: string, pitch: number, volume: number): Voice?
	local bank = self.Banks[bankName]
	if bank == nil or volume <= 0 then
		return nil
	end
	local voice = self:TakeVoice(bank)
	local jitter = 1 + self.Random:NextNumber(-SoundConfig.Impact.PitchJitter, SoundConfig.Impact.PitchJitter)
	local sound = voice.Sound
	sound:Stop()
	sound.Looped = false
	sound.PlaybackSpeed = bank.Def.Pitch * pitch * jitter
	sound.Volume = bank.Def.Volume * volume
	sound.TimePosition = 0
	sound:Play()
	voice.BusyUntil = os.clock() + 0.35 / math.max(pitch, 0.1)
	return voice
end

-- Нота мажорной пентатоники: step 0 = тоника, дальше вверх по ладу
function Audio.PlayNote(self: StretchAudioController, bankName: string, step: number, volume: number)
	local ratio = SoundConfig.SemitoneRatio(SoundConfig.PentatonicSemitones(step))
	self:Play(bankName, ratio, volume)
end

function Audio.ScheduleNotes(self: StretchAudioController, bankName: string, semitones: { number }, spacing: number, basePitch: number, volume: number)
	local now = os.clock()
	for index, semitone in semitones do
		table.insert(self.Schedule, {
			At = now + (index - 1) * spacing,
			Bank = bankName,
			Pitch = basePitch * SoundConfig.SemitoneRatio(semitone),
			Volume = volume,
		})
	end
end

function Audio.StartSweep(self: StretchAudioController, bankName: string, startsAt: number, duration: number, fromPitch: number, toPitch: number, volume: number)
	local bank = self.Banks[bankName]
	if bank == nil then
		return
	end
	local voice = self:TakeVoice(bank)
	voice.BusyUntil = startsAt + duration + 0.5
	table.insert(self.Sweeps, {
		Voice = voice,
		StartsAt = startsAt,
		Duration = math.max(duration, 0.1),
		FromPitch = fromPitch,
		ToPitch = toPitch,
		Volume = volume,
		Started = false,
	})
end

local function impactVolume(speed: number): number
	local settings = SoundConfig.Impact
	return math.clamp(speed / settings.SpeedForFullVolume, settings.MinVolumeScale, 1.25)
end

-- ── Реакции на игру ─────────────────────────────────────────────────────────

function Audio.OnBounced(self: StretchAudioController, combo: number, speed: number)
	self:PlayNote("Bounce", combo - 1, impactVolume(speed))
end

function Audio.OnSmashed(self: StretchAudioController, kind: string, speed: number)
	local step = math.max(self.Slingshot:GetCombo() - 1, 0)
	local volume = impactVolume(speed)
	self:PlayNote("Smash", step, volume)
	local ratio = SoundConfig.SemitoneRatio(SoundConfig.PentatonicSemitones(step))
	self:Play("SmashLayer", ratio, volume * 0.8)
	if kind == "Chest" then
		self:ScheduleNotes("Coin", SoundConfig.Arpeggio, SoundConfig.ArpeggioStep, 1, 0.9)
	end
end

function Audio.OnLaunched(self: StretchAudioController, speed: number)
	local strength = math.clamp(speed / 250, 0.45, 1.3)
	self:Play("Snap", 0.9 + 0.25 * strength, strength)
	self.TensionTarget = 0
	self.TensionSmoothed:Snap(0) -- резина отпущена: гул обрывается сразу, щелчок «съедает» хвост
end

function Audio.OnGongStruck(self: StretchAudioController)
	self:Play("Gong", 1, 1)
	self:Play("GongLayer", 1, 0.8)
end

function Audio.OnGongResult(self: StretchAudioController, accepted: boolean)
	if accepted then
		-- мажорный аккорд-«страм» с резонансом поверх удара
		self:ScheduleNotes("Gong", SoundConfig.GongChord, SoundConfig.ChordStrum, 1, 0.85)
	else
		self:Play("Gong", SoundConfig.SemitoneRatio(-5), 0.6)
		self:Play("UiError", 1, 0.8)
	end
end

function Audio.OnRebirthWave(self: StretchAudioController, info: Types.RebirthWaveInfo)
	if info.OwnerUserId ~= self.Player.UserId then
		return
	end
	local delay = math.max(info.StartServerTime - workspace:GetServerTimeNow(), 0)
	local duration = (info.EndZ - info.OriginZ) / info.Speed
	local startsAt = os.clock() + delay
	self:StartSweep("WaveSweep", startsAt, duration, 0.5, 1.8, 1)
	-- в конце волны — восходящее арпеджио пентатоники через октаву
	local finale = { 0, 2, 4, 7, 9, 12, 14, 16 }
	for index, semitone in finale do
		table.insert(self.Schedule, {
			At = startsAt + duration + (index - 1) * SoundConfig.ArpeggioStep,
			Bank = "Coin",
			Pitch = SoundConfig.SemitoneRatio(semitone),
			Volume = 0.9,
		})
	end
end

-- ── Кадр: лупы, гранулы, свипы, расписание ─────────────────────────────────

function Audio.UpdateLoop(self: StretchAudioController, loop: Loop, volume: number, pitch: number, highGain: number, midGain: number)
	local sound = loop.Sound
	if volume > 0.004 then
		if not loop.Playing then
			loop.Playing = true
			sound:Play()
		end
		sound.Volume = volume
		sound.PlaybackSpeed = math.max(pitch, 0.05)
		loop.Equalizer.HighGain = highGain
		loop.Equalizer.MidGain = midGain
	elseif loop.Playing then
		loop.Playing = false
		sound.Volume = 0
		sound:Stop()
	end
end

function Audio.OnRenderStep(self: StretchAudioController, dt: number)
	local now = os.clock()
	local step = math.min(dt, 0.1)

	-- Натяжение: громкость ∝ tension^curve, питч и «открытие» верхов растут вместе с ним
	local tensionConfig = SoundConfig.Tension
	local stretchDef = SoundConfig.Sounds.StretchLoop
	local charging = self.Slingshot:GetState() ~= "Walk"
	self.TensionSmoothed.Target = if charging then self.TensionTarget else 0
	local tension = math.clamp(self.TensionSmoothed:Update(step), 0, 1)
	self:UpdateLoop(
		self.StretchLoop,
		stretchDef.Volume * tensionConfig.VolumeMax * tension ^ tensionConfig.VolumeCurve,
		stretchDef.Pitch * lerp(tensionConfig.PitchMin, tensionConfig.PitchMax, tension),
		lerp(tensionConfig.HighGainMin, tensionConfig.HighGainMax, tension),
		tensionConfig.MidGainMax * tension
	)
	-- Гранулярный скрип: зёрна всё чаще и выше по мере натяжения
	if tension > tensionConfig.CreakThreshold then
		local amount = (tension - tensionConfig.CreakThreshold) / (1 - tensionConfig.CreakThreshold)
		local interval = 1 / lerp(tensionConfig.CreakRateMin, tensionConfig.CreakRateMax, amount)
		self.CreakTimer = math.min(self.CreakTimer + step, interval * 2)
		if self.CreakTimer >= interval then
			self.CreakTimer -= interval
			local jitter = self.Random:NextNumber(-tensionConfig.CreakPitchJitter, tensionConfig.CreakPitchJitter)
			self:Play("Creak", 1 + 0.35 * amount + jitter, 0.4 + 0.6 * amount)
		end
	else
		self.CreakTimer = 0
	end

	-- Ветер: только в полёте, от сглаженной скорости; на сверхзвуке — прибавка и трепет
	local windConfig = SoundConfig.Wind
	local windDef = SoundConfig.Sounds.WindLoop
	local flying = self.Slingshot:GetState() == "Air"
	self.SpeedSmoothed.Target = if flying then self.Slingshot:GetSpeed() else 0
	local speed = math.max(self.SpeedSmoothed:Update(step), 0)
	local alpha = math.clamp((speed - windConfig.SpeedMin) / (windConfig.SpeedForMax - windConfig.SpeedMin), 0, 1)
	local boost = if speed >= PhysicsConfig.SupersonicSpeed then windConfig.SupersonicBoost * alpha else 0
	local flutter = 1 + windConfig.FlutterDepth * math.sin(now * windConfig.FlutterRate * 2 * math.pi) * alpha
	self:UpdateLoop(
		self.WindLoop,
		windDef.Volume * (windConfig.VolumeMax * alpha ^ 1.3 + boost),
		windDef.Pitch * lerp(windConfig.PitchMin, windConfig.PitchMax, alpha) * flutter,
		lerp(windConfig.HighGainMin, windConfig.HighGainMax, alpha),
		0
	)

	-- Свипы (волна перерождения): питч скользит по ease-in-out, громкость — мягкая вспышка
	local index = 1
	while index <= #self.Sweeps do
		local sweep = self.Sweeps[index]
		if now < sweep.StartsAt then
			index += 1
		else
			local sound = sweep.Voice.Sound
			if not sweep.Started then
				sweep.Started = true
				sound:Stop()
				sound.Looped = true
				sound.TimePosition = 0
				sound:Play()
			end
			local t = (now - sweep.StartsAt) / sweep.Duration
			if t >= 1 then
				sound:Stop()
				sound.Looped = false
				table.remove(self.Sweeps, index)
			else
				local eased = t * t * (3 - 2 * t)
				local def = SoundConfig.Sounds.WaveSweep
				-- From/To — абсолютный PlaybackSpeed свипа (питч слота задаёт только одиночные проигрывания)
				sound.PlaybackSpeed = lerp(sweep.FromPitch, sweep.ToPitch, eased)
				sound.Volume = def.Volume * sweep.Volume * math.sin(math.pi * t) ^ 0.6
				index += 1
			end
		end
	end

	-- Расписание нот (аккорды, арпеджио)
	local noteIndex = 1
	while noteIndex <= #self.Schedule do
		local note = self.Schedule[noteIndex]
		if now >= note.At then
			self:Play(note.Bank, note.Pitch, note.Volume)
			table.remove(self.Schedule, noteIndex)
		else
			noteIndex += 1
		end
	end
end

-- ── Запуск / остановка ──────────────────────────────────────────────────────

function Audio.Start(self: StretchAudioController)
	if self.Started then
		return
	end
	self.Started = true
	local signals = self.Slingshot.Signals
	local connections = self.Connections

	table.insert(
		connections,
		signals.TensionChanged:Connect(function(tension: number)
			self.TensionTarget = tension
		end)
	)
	table.insert(
		connections,
		signals.Launched:Connect(function(speed: number, _velocity: Vector3)
			self:OnLaunched(speed)
		end)
	)
	table.insert(
		connections,
		signals.HandFired:Connect(function(_side: Types.HandSide)
			self:Play("HandFire", 1, 1)
		end)
	)
	table.insert(
		connections,
		signals.HandAttached:Connect(function(_side: Types.HandSide)
			self:Play("HandAttach", 1, 1)
		end)
	)
	table.insert(
		connections,
		signals.HandReleased:Connect(function(_side: Types.HandSide)
			self:Play("HandRelease", 1, 1)
		end)
	)
	table.insert(
		connections,
		signals.Bounced:Connect(function(combo: number, speed: number, _point: Vector3)
			self:OnBounced(combo, speed)
		end)
	)
	table.insert(
		connections,
		signals.Smashed:Connect(function(kind: string, speed: number, _point: Vector3)
			self:OnSmashed(kind, speed)
		end)
	)
	table.insert(
		connections,
		signals.Splat:Connect(function(impact: number)
			self:Play("Splat", 1 - math.min(impact / 600, 0.3), math.clamp(impact / 300, 0.4, 1))
		end)
	)
	table.insert(
		connections,
		signals.GongStruck:Connect(function(_speed: number, _combo: number)
			self:OnGongStruck()
		end)
	)
	table.insert(
		connections,
		signals.LootGained:Connect(function(_loot: number)
			self:ScheduleNotes("Coin", { 7, 12, 16 }, 0.06, 1, 0.7)
		end)
	)
	table.insert(
		connections,
		signals.BallChanged:Connect(function(active: boolean)
			self:Play("BallToggle", if active then 1.25 else 0.85, 0.9)
		end)
	)

	table.insert(
		connections,
		Net.GongResult.OnClientEvent:Connect(function(accepted: boolean)
			self:OnGongResult(accepted)
		end)
	)
	table.insert(
		connections,
		Net.RebirthWave.OnClientEvent:Connect(function(info: Types.RebirthWaveInfo)
			self:OnRebirthWave(info)
		end)
	)

	local hud = self.Hud
	if hud then
		table.insert(
			connections,
			hud.Signals.UiClick:Connect(function()
				self:Play("UiClick", 1, 1)
			end)
		)
		table.insert(
			connections,
			hud.Signals.PanelToggled:Connect(function(open: boolean)
				self:Play("UiOpen", if open then 1.2 else 0.85, 1)
			end)
		)
		table.insert(
			connections,
			hud.Signals.Purchase:Connect(function(success: boolean, _reason: string)
				if success then
					self:ScheduleNotes("Coin", SoundConfig.Arpeggio, SoundConfig.ArpeggioStep, 1, 1)
				else
					self:Play("UiError", 1, 1)
				end
			end)
		)
	end

	table.insert(
		connections,
		RunService.RenderStepped:Connect(function(dt: number)
			self:OnRenderStep(dt)
		end)
	)
end

function Audio.Destroy(self: StretchAudioController)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	table.clear(self.Sweeps)
	table.clear(self.Schedule)
	self.Folder:Destroy()
	for _, group in self.Groups do
		group:Destroy()
	end
	self.Started = false
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">StretchHUDController</string>
              <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · StretchHUDController — тактильный мультяшный интерфейс.
-- Всё строится кодом (без ассетов): шрифт FredokaOne, сочные UIGradient, толстые UIStroke-контуры,
-- и каждая анимация — пружина по закону Гука из Shared.Math.Spring (Spring.Number / Spring.Vector).
--
--   • Прицел + кольцо натяжения рогатки (TensionChanged): цвет зелёный→жёлтый→красный, на 100% — дрожь.
--   • Пружинный спидометр (slingshot:GetSpeed()): стрелка с перелётом, на SupersonicSpeed — неон и пламя.
--   • Счётчик комбо, подпрыгивающий на каждом Bounced/Smashed, и подсказка порога Гонга.
--   • 3D-цифры скорости и лута, летящие по параболе (BillboardGui), слова «BOING!» на отскоках.
--   • Баннер перерождения (RebirthWave) и подсказка «чего не хватило» (GongResult).
--   • Панель прокачки 3 статов с превью через StretchPhysics.Derive и витрина перчаток GloveConfig.
--     Открывается Tab / Alt / кнопкой на экране / Y на геймпаде; курсор камеры освобождается.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local LevelConfig = require(Shared.Config.LevelConfig)
local GloveConfig = require(Shared.Config.GloveConfig)
local Spring = require(Shared.Math.Spring)
local StretchPhysics = require(Shared.Physics.StretchPhysics)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local ElasticSlingshotController = require(Client.Controllers.ElasticSlingshotController)
local ShoulderCamera = require(Client.Controllers.ShoulderCameraController)

-- ── Стиль ──────────────────────────────────────────────────────────────────

local FONT = Enum.Font.FredokaOne
local INK = Color3.fromRGB(28, 18, 48)
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 214, 64)
local GOLD_DARK = Color3.fromRGB(255, 136, 28)
local GREEN = Color3.fromRGB(110, 240, 120)
local GREEN_DARK = Color3.fromRGB(30, 170, 80)
local RED = Color3.fromRGB(255, 86, 98)
local RED_DARK = Color3.fromRGB(190, 30, 70)
local GRAY = Color3.fromRGB(150, 150, 170)
local GRAY_DARK = Color3.fromRGB(80, 80, 104)
local NEON_PINK = Color3.fromRGB(255, 64, 200)
local NEON_CYAN = Color3.fromRGB(64, 240, 255)
local NEON_YELLOW = Color3.fromRGB(255, 250, 120)
local PANEL_TOP = Color3.fromRGB(96, 70, 210)
local PANEL_BOTTOM = Color3.fromRGB(46, 26, 118)
local CARD_TOP = Color3.fromRGB(132, 108, 236)
local CARD_BOTTOM = Color3.fromRGB(78, 52, 176)
local SPEEDO_TOP = Color3.fromRGB(58, 64, 140)
local SPEEDO_BOTTOM = Color3.fromRGB(26, 22, 70)
local TENSION_LOW = Color3.fromRGB(110, 255, 140)
local TENSION_MID = Color3.fromRGB(255, 226, 80)
local TENSION_HIGH = Color3.fromRGB(255, 70, 70)

local REFERENCE_HEIGHT = 900
local RING_SEGMENTS = 32
local RING_RADIUS = 34
local GAUGE_TICKS = 21
local GAUGE_RADIUS = 96
local GAUGE_MAX_SPEED = 420
local FLAME_COUNT = 9
local MAX_POPUPS = 14
local POPUP_GRAVITY = Vector3.new(0, -55, 0)
local ACTION_TOGGLE = "StretchPop_TogglePanel"
local SUPERSONIC_OFF_MARGIN = 20
local REQUEST_TIMEOUT = 2

type StatInfo = {
	Title: string,
	Subtitle: string,
	Letter: string,
	Color: Color3,
}

local STAT_ORDER: { Types.StatName } = { "Elasticity", "SpringPower", "SmashMass" }
local STAT_INFO: { [Types.StatName]: StatInfo } = {
	Elasticity = { Title = "ELASTICITY", Subtitle = "Растяжимость", Letter = "E", Color = Color3.fromRGB(255, 120, 200) },
	SpringPower = { Title = "SPRING POWER", Subtitle = "Сила пружины", Letter = "S", Color = Color3.fromRGB(80, 220, 255) },
	SmashMass = { Title = "SMASH MASS", Subtitle = "Ударная масса", Letter = "M", Color = Color3.fromRGB(255, 170, 60) },
}

local REASON_TEXT: { [string]: string } = {
	not_enough_coins = "Не хватает монет",
	max_level = "Максимальный уровень",
	rate_limited = "Слишком быстро!",
	no_profile = "Профиль ещё грузится",
	already_owned = "Уже куплено",
	not_owned = "Сначала купи",
	unknown_glove = "Нет такой перчатки",
	timeout = "Сервер не ответил",
	too_slow = "мало скорости",
	combo_too_low = "мало комбо",
	speed_unverified = "сервер не подтвердил скорость",
	combo_unverified = "сервер не подтвердил комбо",
	too_far = "сервер не увидел тебя у Гонга",
	cooldown = "Гонг ещё звенит",
	wave_in_progress = "волна ещё идёт",
	not_your_lane = "это чужой Гонг",
	lane_changed = "полоса уже перестроилась",
	no_gong = "Гонг ещё не появился",
}

local BOUNCE_WORDS = { "BOING!", "POP!", "BAM!", "ZOING!", "BOP!", "SPROING!" }

-- ── Типы ────────────────────────────────────────────────────────────────────

type RingSegment = {
	Frame: Frame,
	Lit: boolean,
	Bucket: number,
}

type Popup = {
	Gui: BillboardGui,
	Attachment: Attachment,
	Label: TextLabel,
	Stroke: UIStroke,
	Scale: UIScale,
	ScaleSpring: Spring.NumberSpring,
	Tilt: Spring.NumberSpring,
	Origin: Vector3,
	Velocity: Vector3,
	Born: number,
	Life: number,
}

type StatCard = {
	Stat: Types.StatName,
	Order: number,
	Root: Frame,
	Scale: UIScale,
	Pop: Spring.NumberSpring,
	Shake: Spring.VectorSpring,
	Level: TextLabel,
	Preview: TextLabel,
	BarFill: Frame,
	Button: TextButton,
	ButtonGradient: UIGradient,
	Cost: TextLabel,
	Message: TextLabel,
	MessageUntil: number,
	PendingUntil: number,
}

type GloveCard = {
	Id: string,
	Def: GloveConfig.GloveDef,
	Root: Frame,
	Scale: UIScale,
	Pop: Spring.NumberSpring,
	Shake: Spring.VectorSpring,
	Button: TextButton,
	ButtonGradient: UIGradient,
	Stroke: UIStroke,
	Message: TextLabel,
	MessageUntil: number,
	PendingUntil: number,
}

type Banner = {
	Root: Frame,
	Scale: UIScale,
	Gradient: UIGradient,
	Title: TextLabel,
	Subtitle: TextLabel,
	Rays: Frame,
	ScaleSpring: Spring.NumberSpring,
	Shake: Spring.VectorSpring,
	HideAt: number,
	Showing: boolean,
	BasePosition: UDim2,
}

export type HudSignals = {
	UiClick: Signal.Signal<>,
	PanelToggled: Signal.Signal<boolean>,
	Purchase: Signal.Signal<boolean, string>,
}

type HudFields = {
	Player: Player,
	Slingshot: ElasticSlingshotController.ElasticSlingshotController,
	Camera: ShoulderCamera.ShoulderCamera,
	Signals: HudSignals,
	Gui: ScreenGui,
	Root: Frame,
	RootScale: UIScale,
	ViewportKey: Vector2,

	Reticle: Frame,
	ReticleScale: UIScale,
	Dot: Frame,
	DotScale: UIScale,
	DotPop: Spring.NumberSpring,
	Segments: { RingSegment },
	TensionSpring: Spring.NumberSpring,
	TensionTarget: number,
	Jitter: Spring.VectorSpring,

	Speedo: Frame,
	SpeedoGradient: UIGradient,
	SpeedoStroke: UIStroke,
	SpeedoScale: UIScale,
	SpeedPop: Spring.NumberSpring,
	SpeedText: TextLabel,
	NeedlePivot: Frame,
	NeedleSpring: Spring.NumberSpring,
	Ticks: { Frame },
	LitTicks: number,
	Neon: boolean,
	NeonSpring: Spring.NumberSpring,
	NeonBucket: number,
	SupersonicLabel: TextLabel,
	SupersonicScale: UIScale,
	FlameHolder: Frame,
	Flames: { Frame },
	LastSpeedShown: number,

	Combo: Frame,
	ComboText: TextLabel,
	ComboGradient: UIGradient,
	ComboScale: UIScale,
	ComboPop: Spring.NumberSpring,
	ComboTilt: Spring.NumberSpring,
	ComboVisible: Spring.NumberSpring,
	ComboKick: Spring.VectorSpring,
	ComboShown: number,
	GongHint: TextLabel,
	GongHintText: string,

	CoinsText: TextLabel,
	CoinsScale: UIScale,
	CoinsPop: Spring.NumberSpring,
	CoinsShown: number,
	CoinsTarget: number,

	PopupFolder: Folder,
	PopupAnchor: Part,
	Popups: { Popup },
	LastSmashPoint: Vector3?,
	LastSmashAt: number,
	LastBounceWordAt: number,

	Banner: Banner,

	Panel: Frame,
	PanelScale: UIScale,
	PanelSpring: Spring.NumberSpring,
	PanelOpen: boolean,
	PanelDirty: boolean,
	PanelCoins: TextLabel,
	StatCards: { [Types.StatName]: StatCard },
	GloveCards: { [string]: GloveCard },
	GloveOrder: { string },
	RecordsText: TextLabel,
	OfflineText: TextLabel,
	MenuButton: TextButton,
	OwnedLocal: { [string]: boolean },
	Snapshot: Types.ProfileSnapshot?,

	Random: Random,
	Connections: { RBXScriptConnection },
	Started: boolean,
}

local HUD = {}
HUD.__index = HUD

export type StretchHUDController = typeof(setmetatable({} :: HudFields, HUD))

-- ── Помощники построения ───────────────────────────────────────────────────

local function addCorner(parent: GuiObject, radius: UDim): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = parent
	return corner
end

local function addStroke(parent: GuiObject, thickness: number, color: Color3, mode: Enum.ApplyStrokeMode): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = thickness
	stroke.Color = color
	stroke.ApplyStrokeMode = mode
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = parent
	return stroke
end

-- Вертикальный градиент сверху вниз
local function addGradient(parent: GuiObject, top: Color3, bottom: Color3): UIGradient
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(top, bottom)
	gradient.Rotation = 90
	gradient.Parent = parent
	return gradient
end

local function addScale(parent: GuiObject, value: number): UIScale
	local scale = Instance.new("UIScale")
	scale.Scale = value
	scale.Parent = parent
	return scale
end

local function newFrame(name: string, parent: Instance, size: UDim2, position: UDim2, anchor: Vector2, color: Color3, transparency: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = size
	frame.Position = position
	frame.AnchorPoint = anchor
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency
	frame.BorderSizePixel = 0
	frame.Parent = parent
	return frame
end

local function newLabel(
	name: string,
	parent: Instance,
	text: string,
	size: UDim2,
	position: UDim2,
	anchor: Vector2,
	color: Color3,
	inkThickness: number
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.AnchorPoint = anchor
	label.BackgroundTransparency = 1
	label.Font = FONT
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	if inkThickness > 0 then
		addStroke(label, inkThickness, INK, Enum.ApplyStrokeMode.Contextual)
	end
	return label
end

local function newButton(
	name: string,
	parent: Instance,
	text: string,
	size: UDim2,
	position: UDim2,
	anchor: Vector2,
	top: Color3,
	bottom: Color3
): (TextButton, UIGradient)
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.Position = position
	button.AnchorPoint = anchor
	button.BackgroundColor3 = WHITE
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = FONT
	button.Text = text
	button.TextColor3 = WHITE
	button.TextScaled = true
	button.Parent = parent
	addCorner(button, UDim.new(0, 14))
	addStroke(button, 3, INK, Enum.ApplyStrokeMode.Border)
	addStroke(button, 2.5, INK, Enum.ApplyStrokeMode.Contextual)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.18, 0)
	padding.PaddingBottom = UDim.new(0.18, 0)
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.Parent = button
	return button, addGradient(button, top, bottom)
end

local function setGradient(gradient: UIGradient, top: Color3, bottom: Color3)
	gradient.Color = ColorSequence.new(top, bottom)
end

local function formatNumber(value: number): string
	local integer = math.floor(math.max(value, 0) + 0.5)
	local text = tostring(integer)
	local result = ""
	while #text > 3 do
		result = " " .. string.sub(text, -3) .. result
		text = string.sub(text, 1, -4)
	end
	return text .. result
end

local function tensionColor(tension: number): Color3
	if tension < 0.6 then
		return TENSION_LOW:Lerp(TENSION_MID, tension / 0.6)
	end
	return TENSION_MID:Lerp(TENSION_HIGH, math.clamp((tension - 0.6) / 0.4, 0, 1))
end

local function gaugeColor(fraction: number): Color3
	if fraction < 0.5 then
		return TENSION_LOW:Lerp(TENSION_MID, fraction / 0.5)
	end
	return TENSION_MID:Lerp(TENSION_HIGH, (fraction - 0.5) / 0.5)
end

local function comboColors(combo: number): (Color3, Color3)
	if combo >= 10 then
		return NEON_PINK, Color3.fromRGB(150, 60, 255)
	elseif combo >= 5 then
		return GOLD, GOLD_DARK
	end
	return Color3.fromRGB(150, 245, 255), Color3.fromRGB(60, 150, 255)
end

local function attributeNumber(player: Player, name: string): number
	local value = player:GetAttribute(name)
	return if typeof(value) == "number" then value else 0
end

local function currentStats(player: Player): Types.PhysicalStats
	return {
		Elasticity = attributeNumber(player, "Stat_Elasticity"),
		SpringPower = attributeNumber(player, "Stat_SpringPower"),
		SmashMass = attributeNumber(player, "Stat_SmashMass"),
	}
end

local function statLevel(stats: Types.PhysicalStats, stat: Types.StatName): number
	if stat == "Elasticity" then
		return stats.Elasticity
	elseif stat == "SpringPower" then
		return stats.SpringPower
	end
	return stats.SmashMass
end

local function withStat(stats: Types.PhysicalStats, stat: Types.StatName, level: number): Types.PhysicalStats
	return {
		Elasticity = if stat == "Elasticity" then level else stats.Elasticity,
		SpringPower = if stat == "SpringPower" then level else stats.SpringPower,
		SmashMass = if stat == "SmashMass" then level else stats.SmashMass,
	}
end

-- Превью роста параметров: сравниваем Derive текущего и следующего уровня
local function statPreview(stat: Types.StatName, stats: Types.PhysicalStats, gloveId: string?): string
	local level = statLevel(stats, stat)
	local now = StretchPhysics.Derive(stats, gloveId)
	if level >= PhysicsConfig.StatUpgrade.MaxLevel then
		if stat == "Elasticity" then
			return string.format("Натяжение %.1f · Дальность %d\nМАКСИМУМ", now.MaxStretch, math.floor(now.GrabRange + 0.5))
		elseif stat == "SpringPower" then
			return string.format("Запуск %d st/s · Упругость %.3f\nМАКСИМУМ", math.floor(StretchPhysics.MaxLaunchSpeed(now) + 0.5), now.Restitution)
		end
		return string.format("Ударная масса %.2f\nМАКСИМУМ", now.ImpactMass)
	end
	local nextParams = StretchPhysics.Derive(withStat(stats, stat, level + 1), gloveId)
	if stat == "Elasticity" then
		return string.format(
			"Натяжение %.1f → %.1f\nДальность %d → %d",
			now.MaxStretch,
			nextParams.MaxStretch,
			math.floor(now.GrabRange + 0.5),
			math.floor(nextParams.GrabRange + 0.5)
		)
	elseif stat == "SpringPower" then
		return string.format(
			"Запуск %d → %d st/s\nУпругость %.3f → %.3f",
			math.floor(StretchPhysics.MaxLaunchSpeed(now) + 0.5),
			math.floor(StretchPhysics.MaxLaunchSpeed(nextParams) + 0.5),
			now.Restitution,
			nextParams.Restitution
		)
	end
	local gain = (nextParams.ImpactMass / now.ImpactMass - 1) * 100
	return string.format("Ударная масса %.2f → %.2f\nЭнергия удара +%.1f%%", now.ImpactMass, nextParams.ImpactMass, gain)
end

-- ── Конструктор ────────────────────────────────────────────────────────────

function HUD.new(
	slingshot: ElasticSlingshotController.ElasticSlingshotController,
	camera: ShoulderCamera.ShoulderCamera
): StretchHUDController
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "StretchPopHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5

	-- Root масштабируется под высоту экрана; размер 1/scale, чтобы после UIScale ровно покрыть экран
	local root = newFrame("Root", gui, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 1)
	local rootScale = addScale(root, 1)

	local popupFolder = Instance.new("Folder")
	popupFolder.Name = "StretchPopPopups"
	popupFolder.Parent = playerGui
	local popupAnchor = Instance.new("Part")
	popupAnchor.Name = "StretchPopPopupAnchor"
	popupAnchor.Anchored = true
	popupAnchor.CanCollide = false
	popupAnchor.CanQuery = false
	popupAnchor.CanTouch = false
	popupAnchor.Transparency = 1
	popupAnchor.Size = Vector3.one * 0.2
	popupAnchor.CFrame = CFrame.new(0, -5000, 0)
	popupAnchor.Parent = workspace

	local fields = {
		Player = player,
		Slingshot = slingshot,
		Camera = camera,
		Signals = {
			UiClick = Signal.new(),
			PanelToggled = Signal.new(),
			Purchase = Signal.new(),
		},
		Gui = gui,
		Root = root,
		RootScale = rootScale,
		ViewportKey = Vector2.zero,
		TensionSpring = Spring.Number.new(0, 9, 0.85),
		TensionTarget = 0,
		Jitter = Spring.Vector.new(Vector3.zero, 18, 0.35),
		DotPop = Spring.Number.new(0, 5, 0.3),
		SpeedPop = Spring.Number.new(0, 4.5, 0.3),
		NeedleSpring = Spring.Number.new(180, 3, 0.36),
		LitTicks = -1,
		Neon = false,
		NeonSpring = Spring.Number.new(0, 3.5, 0.7),
		NeonBucket = -1,
		LastSpeedShown = -1,
		ComboPop = Spring.Number.new(0, 5, 0.28),
		ComboTilt = Spring.Number.new(0, 4, 0.25),
		ComboVisible = Spring.Number.new(0, 4, 0.6),
		ComboKick = Spring.Vector.new(Vector3.zero, 6, 0.3),
		ComboShown = 0,
		GongHintText = "",
		CoinsPop = Spring.Number.new(0, 5, 0.3),
		CoinsShown = attributeNumber(player, "Coins"),
		CoinsTarget = attributeNumber(player, "Coins"),
		PopupFolder = popupFolder,
		PopupAnchor = popupAnchor,
		Popups = {},
		LastSmashPoint = nil,
		LastSmashAt = -math.huge,
		LastBounceWordAt = -math.huge,
		PanelSpring = Spring.Number.new(0, 3.2, 0.55),
		PanelOpen = false,
		PanelDirty = true,
		StatCards = {},
		GloveCards = {},
		GloveOrder = {},
		OwnedLocal = { [GloveConfig.DefaultGlove] = true },
		Snapshot = nil,
		Random = Random.new(),
		Connections = {},
		Started = false,
	}
	local self = setmetatable(fields :: any, HUD) :: StretchHUDController
	self:BuildReticle()
	self:BuildSpeedometer()
	self:BuildCombo()
	self:BuildCoins()
	self:BuildBanner()
	self:BuildPanel()
	self:BuildMenuButton()
	gui.Parent = playerGui
	return self
end

-- ── Прицел и кольцо натяжения ──────────────────────────────────────────────

function HUD.BuildReticle(self: StretchHUDController)
	local reticle = newFrame("Reticle", self.Root, UDim2.fromOffset(120, 120), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 1)
	self.Reticle = reticle
	self.ReticleScale = addScale(reticle, 1)
	local segments: { RingSegment } = {}
	for index = 0, RING_SEGMENTS - 1 do
		-- сегменты по часовой от 12 часов; длинная ось — по касательной к окружности
		local angle = -90 + index * 360 / RING_SEGMENTS
		local radians = math.rad(angle)
		local segment = newFrame(
			"Segment" .. index,
			reticle,
			UDim2.fromOffset(9, 4),
			UDim2.new(0.5, math.cos(radians) * RING_RADIUS, 0.5, math.sin(radians) * RING_RADIUS),
			Vector2.new(0.5, 0.5),
			INK,
			0.55
		)
		segment.Rotation = angle + 90
		addCorner(segment, UDim.new(0.5, 0))
		table.insert(segments, { Frame = segment, Lit = false, Bucket = -1 })
	end
	self.Segments = segments
	local dot = newFrame("Dot", reticle, UDim2.fromOffset(9, 9), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 0)
	addCorner(dot, UDim.new(0.5, 0))
	addStroke(dot, 2, INK, Enum.ApplyStrokeMode.Border)
	self.Dot = dot
	self.DotScale = addScale(dot, 1)
end

function HUD.UpdateReticle(self: StretchHUDController, dt: number, now: number)
	self.TensionSpring.Target = self.TensionTarget
	local tension = math.clamp(self.TensionSpring:Update(dt), 0, 1)
	local lit = math.floor(tension * RING_SEGMENTS + 0.5)
	local maxed = self.TensionTarget >= 0.995
	local color = if maxed and math.floor(now * 16) % 2 == 0 then WHITE else tensionColor(tension)
	local bucket = math.floor(tension * 24) + (if maxed then 100 + math.floor(now * 16) % 2 else 0)
	for index, segment in self.Segments do
		local shouldLight = index <= lit
		if segment.Lit ~= shouldLight or (shouldLight and segment.Bucket ~= bucket) then
			segment.Lit = shouldLight
			segment.Bucket = bucket
			segment.Frame.BackgroundColor3 = if shouldLight then color else INK
			segment.Frame.BackgroundTransparency = if shouldLight then 0 else 0.55
			segment.Frame.Size = if shouldLight then UDim2.fromOffset(11, 5) else UDim2.fromOffset(9, 4)
		end
	end
	-- На 100% натяжения кольцо мелко дрожит: пружина гоняется за случайной целью
	if maxed then
		local rng = self.Random
		self.Jitter.Target = Vector3.new(rng:NextNumber(-2.6, 2.6), rng:NextNumber(-2.6, 2.6), 0)
	else
		self.Jitter.Target = Vector3.zero
	end
	local jitter = self.Jitter:Update(dt)
	self.Reticle.Position = UDim2.new(0.5, jitter.X, 0.5, jitter.Y)
	self.ReticleScale.Scale = 1 + tension * 0.12 + (if maxed then 0.05 * math.sin(now * 32) else 0)

	local aimValid = self.Slingshot.Aim.Valid
	self.Dot.BackgroundColor3 = if aimValid then GREEN else WHITE
	self.DotScale.Scale = 1 + self.DotPop:Update(dt) + (if aimValid then 0.15 else 0)
	self.Reticle.Visible = not self.PanelOpen
end

-- ── Спидометр ───────────────────────────────────────────────────────────────

function HUD.BuildSpeedometer(self: StretchHUDController)
	local flameHolder = newFrame(
		"Flames",
		self.Root,
		UDim2.fromOffset(320, 110),
		UDim2.new(0.5, 0, 1, -166),
		Vector2.new(0.5, 1),
		WHITE,
		1
	)
	flameHolder.ZIndex = 1
	local flames: { Frame } = {}
	for index = 1, FLAME_COUNT do
		local flame = newFrame(
			"Flame" .. index,
			flameHolder,
			UDim2.fromOffset(30, 60),
			UDim2.new((index - 0.5) / FLAME_COUNT, 0, 1, 18),
			Vector2.new(0.5, 1),
			WHITE,
			0
		)
		flame.ZIndex = 1
		addCorner(flame, UDim.new(0.5, 0))
		local gradient = addGradient(flame, Color3.fromRGB(255, 255, 210), Color3.fromRGB(255, 70, 20))
		gradient.Transparency = NumberSequence.new(0.05, 0.35)
		table.insert(flames, flame)
	end
	flameHolder.Visible = false
	self.FlameHolder = flameHolder
	self.Flames = flames

	local speedo = newFrame("Speedometer", self.Root, UDim2.fromOffset(320, 170), UDim2.new(0.5, 0, 1, -16), Vector2.new(0.5, 1), WHITE, 0)
	speedo.ZIndex = 2
	addCorner(speedo, UDim.new(0, 26))
	self.SpeedoGradient = addGradient(speedo, SPEEDO_TOP, SPEEDO_BOTTOM)
	self.SpeedoStroke = addStroke(speedo, 4, WHITE, Enum.ApplyStrokeMode.Border)
	self.SpeedoScale = addScale(speedo, 1)
	self.Speedo = speedo

	local centerX, centerY = 160, 132
	local ticks: { Frame } = {}
	for index = 0, GAUGE_TICKS - 1 do
		local fraction = index / (GAUGE_TICKS - 1)
		local angle = 180 + 180 * fraction
		local radians = math.rad(angle)
		local tick = newFrame(
			"Tick" .. index,
			speedo,
			UDim2.fromOffset(if index % 5 == 0 then 18 else 12, 5),
			UDim2.fromOffset(centerX + math.cos(radians) * GAUGE_RADIUS, centerY + math.sin(radians) * GAUGE_RADIUS),
			Vector2.new(0.5, 0.5),
			gaugeColor(fraction),
			0.6
		)
		tick.Rotation = angle
		tick.ZIndex = 3
		addCorner(tick, UDim.new(0.5, 0))
		table.insert(ticks, tick)
	end
	self.Ticks = ticks

	-- Стрелка: квадратный «шарнир» в центре шкалы, внутри — стрелка от центра вправо; крутим шарнир
	local pivot = newFrame("NeedlePivot", speedo, UDim2.fromOffset(GAUGE_RADIUS * 2, GAUGE_RADIUS * 2), UDim2.fromOffset(centerX, centerY), Vector2.new(0.5, 0.5), WHITE, 1)
	pivot.Rotation = 180
	pivot.ZIndex = 4
	local needle = newFrame("Needle", pivot, UDim2.fromOffset(GAUGE_RADIUS - 10, 7), UDim2.fromScale(0.5, 0.5), Vector2.new(0, 0.5), Color3.fromRGB(255, 90, 90), 0)
	needle.ZIndex = 4
	addCorner(needle, UDim.new(0.5, 0))
	addStroke(needle, 2, INK, Enum.ApplyStrokeMode.Border)
	addGradient(needle, Color3.fromRGB(255, 160, 140), Color3.fromRGB(220, 40, 70))
	self.NeedlePivot = pivot
	local hub = newFrame("Hub", speedo, UDim2.fromOffset(22, 22), UDim2.fromOffset(centerX, centerY), Vector2.new(0.5, 0.5), WHITE, 0)
	hub.ZIndex = 5
	addCorner(hub, UDim.new(0.5, 0))
	addStroke(hub, 3, INK, Enum.ApplyStrokeMode.Border)

	local speedText = newLabel("Speed", speedo, "0", UDim2.fromOffset(150, 50), UDim2.new(0.5, 0, 1, -30), Vector2.new(0.5, 1), WHITE, 3.5)
	speedText.ZIndex = 6
	self.SpeedText = speedText
	local units = newLabel("Units", speedo, "STUDS/S", UDim2.fromOffset(110, 20), UDim2.new(0.5, 0, 1, -8), Vector2.new(0.5, 1), Color3.fromRGB(200, 210, 255), 2)
	units.ZIndex = 6

	local supersonic = newLabel(
		"Supersonic",
		speedo,
		"SUPERSONIC!",
		UDim2.fromOffset(300, 44),
		UDim2.new(0.5, 0, 0, -12),
		Vector2.new(0.5, 1),
		NEON_YELLOW,
		4
	)
	supersonic.ZIndex = 7
	addGradient(supersonic, NEON_YELLOW, NEON_PINK)
	supersonic.Visible = false
	self.SupersonicLabel = supersonic
	self.SupersonicScale = addScale(supersonic, 0)
end

function HUD.UpdateSpeedometer(self: StretchHUDController, dt: number, now: number)
	local speed = self.Slingshot:GetSpeed()
	local fraction = math.clamp(speed / GAUGE_MAX_SPEED, 0, 1)

	self.NeedleSpring.Target = 180 + 180 * math.min(speed / GAUGE_MAX_SPEED, 1.04)
	self.NeedlePivot.Rotation = self.NeedleSpring:Update(dt)

	local lit = math.floor(fraction * (GAUGE_TICKS - 1) + 0.5) + (if speed > 1 then 1 else 0)
	if lit ~= self.LitTicks then
		self.LitTicks = lit
		for index, tick in self.Ticks do
			tick.BackgroundTransparency = if index <= lit then 0 else 0.6
		end
	end

	local shown = math.floor(speed + 0.5)
	if shown ~= self.LastSpeedShown then
		self.LastSpeedShown = shown
		self.SpeedText.Text = tostring(shown)
	end

	-- Сверхзвук с гистерезисом, чтобы режим не мигал на границе
	local threshold = PhysicsConfig.SupersonicSpeed
	if not self.Neon and speed >= threshold then
		self.Neon = true
		self.SpeedPop:Impulse(6)
		self.SupersonicScale.Scale = 0.2
	elseif self.Neon and speed < threshold - SUPERSONIC_OFF_MARGIN then
		self.Neon = false
	end
	self.NeonSpring.Target = if self.Neon then 1 else 0
	local neon = math.clamp(self.NeonSpring:Update(dt), 0, 1)
	local bucket = math.floor(neon * 40 + 0.5)
	if bucket ~= self.NeonBucket then
		self.NeonBucket = bucket
		local alpha = bucket / 40
		setGradient(self.SpeedoGradient, SPEEDO_TOP:Lerp(NEON_PINK, alpha), SPEEDO_BOTTOM:Lerp(Color3.fromRGB(20, 40, 120), alpha))
		self.SpeedoStroke.Color = WHITE:Lerp(NEON_CYAN, alpha)
		self.SpeedText.TextColor3 = WHITE:Lerp(NEON_YELLOW, alpha)
	end
	self.SpeedoStroke.Thickness = 4 + 3 * neon + (if neon > 0.5 then math.sin(now * 18) * 1.2 else 0)
	self.SpeedoScale.Scale = 1 + self.SpeedPop:Update(dt) * 0.8 + neon * 0.04

	self.SupersonicLabel.Visible = neon > 0.03
	if self.SupersonicLabel.Visible then
		local target = neon * (1 + 0.07 * math.sin(now * 12))
		self.SupersonicScale.Scale += (target - self.SupersonicScale.Scale) * math.min(dt * 14, 1)
		self.SupersonicLabel.Rotation = math.sin(now * 7) * 4
	end

	-- Мультяшное пламя: языки пламени дрожат шумом Перлина, высота растёт со скоростью
	self.FlameHolder.Visible = neon > 0.03
	if self.FlameHolder.Visible then
		local overdrive = math.clamp((speed - threshold) / 160, 0, 1)
		for index, flame in self.Flames do
			local flicker = math.noise(index * 1.7, now * 7.5)
			local height = (46 + 40 * overdrive + 26 * flicker) * neon
			flame.Size = UDim2.fromOffset(26 + 6 * math.noise(index, now * 5), math.max(height, 2))
			flame.Rotation = math.noise(index * 3.1, now * 4) * 14
		end
	end
end

-- ── Комбо и подсказка Гонга ────────────────────────────────────────────────

function HUD.BuildCombo(self: StretchHUDController)
	local combo = newFrame("Combo", self.Root, UDim2.fromOffset(200, 110), UDim2.new(0.5, 178, 1, -36), Vector2.new(0, 1), WHITE, 1)
	self.Combo = combo
	self.ComboScale = addScale(combo, 0.01)
	local text = newLabel("Count", combo, "x0", UDim2.new(1, 0, 0.72, 0), UDim2.fromScale(0, 0), Vector2.zero, WHITE, 5)
	text.TextXAlignment = Enum.TextXAlignment.Left
	self.ComboText = text
	self.ComboGradient = addGradient(text, comboColors(1))
	local caption = newLabel("Caption", combo, "COMBO", UDim2.new(0.7, 0, 0.3, 0), UDim2.fromScale(0, 0.7), Vector2.zero, WHITE, 3)
	caption.TextXAlignment = Enum.TextXAlignment.Left

	local hint = newLabel("GongHint", self.Root, "", UDim2.fromOffset(240, 46), UDim2.new(0.5, -178, 1, -40), Vector2.new(1, 1), WHITE, 3)
	hint.RichText = true
	hint.TextXAlignment = Enum.TextXAlignment.Right
	self.GongHint = hint
end

function HUD.UpdateCombo(self: StretchHUDController, dt: number)
	local combo = self.Slingshot:GetCombo()
	if combo ~= self.ComboShown then
		if combo > self.ComboShown then
			self.ComboPop:Impulse(7 + math.min(combo, 20) * 0.35)
			self.ComboTilt:Impulse((if self.Random:NextNumber() < 0.5 then -1 else 1) * 90)
			self.ComboKick:Impulse(Vector3.new(0, -400, 0))
		end
		self.ComboShown = combo
		if combo > 0 then
			self.ComboText.Text = "x" .. combo
			local top, bottom = comboColors(combo)
			setGradient(self.ComboGradient, top, bottom)
		end
	end
	self.ComboVisible.Target = if combo > 0 then 1 else 0
	local visible = math.clamp(self.ComboVisible:Update(dt), 0, 1.3)
	local pop = self.ComboPop:Update(dt)
	self.ComboScale.Scale = math.max(visible * (1 + pop), 0.001)
	self.Combo.Rotation = self.ComboTilt:Update(dt) * 4
	local kick = self.ComboKick:Update(dt)
	self.Combo.Position = UDim2.new(0.5, 178 + kick.X, 1, -36 + kick.Y)
	self.Combo.Visible = visible > 0.01

	-- Подсказка порога Гонга с живой отметкой: что уже набрано
	local tier = attributeNumber(self.Player, "LocationTier")
	local needSpeed, needCombo = LevelConfig.GongRequirement(tier)
	local speedOk = self.Slingshot:GetSpeed() >= needSpeed
	local comboOk = combo >= needCombo
	local text = string.format(
		'ГОНГ: <font color="%s">≥%d st/s</font> · <font color="%s">x%d</font>',
		if speedOk then "#6EF078" else "#FFFFFF",
		math.floor(needSpeed),
		if comboOk then "#6EF078" else "#FFFFFF",
		needCombo
	)
	if text ~= self.GongHintText then
		self.GongHintText = text
		self.GongHint.Text = text
	end
end

-- ── Монеты ──────────────────────────────────────────────────────────────────

function HUD.BuildCoins(self: StretchHUDController)
	local coins = newFrame("Coins", self.Root, UDim2.fromOffset(240, 64), UDim2.new(1, -24, 0, 24), Vector2.new(1, 0), WHITE, 0)
	addCorner(coins, UDim.new(0, 20))
	addGradient(coins, Color3.fromRGB(70, 56, 160), Color3.fromRGB(36, 22, 96))
	addStroke(coins, 4, WHITE, Enum.ApplyStrokeMode.Border)
	self.CoinsScale = addScale(coins, 1)
	local icon = newFrame("Icon", coins, UDim2.fromOffset(44, 44), UDim2.new(0, 10, 0.5, 0), Vector2.new(0, 0.5), WHITE, 0)
	addCorner(icon, UDim.new(0.5, 0))
	addGradient(icon, GOLD, GOLD_DARK)
	addStroke(icon, 3, INK, Enum.ApplyStrokeMode.Border)
	newLabel("Glyph", icon, "$", UDim2.fromScale(0.8, 0.8), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 2.5)
	local amount = newLabel("Amount", coins, formatNumber(self.CoinsShown), UDim2.new(1, -72, 0.72, 0), UDim2.new(0, 62, 0.5, 0), Vector2.new(0, 0.5), GOLD, 3.5)
	amount.TextXAlignment = Enum.TextXAlignment.Left
	self.CoinsText = amount
end

function HUD.UpdateCoins(self: StretchHUDController, dt: number)
	local target = attributeNumber(self.Player, "Coins")
	if target > self.CoinsTarget then
		self.CoinsPop:Impulse(6)
	end
	self.CoinsTarget = target
	if math.abs(self.CoinsShown - target) > 0.5 then
		self.CoinsShown += (target - self.CoinsShown) * (1 - math.exp(-9 * dt))
	else
		self.CoinsShown = target
	end
	local text = formatNumber(self.CoinsShown)
	if self.CoinsText.Text ~= text then
		self.CoinsText.Text = text
		if self.PanelOpen then
			self.PanelCoins.Text = formatNumber(target)
		end
	end
	self.CoinsScale.Scale = 1 + self.CoinsPop:Update(dt)
end

-- ── 3D-цифры по параболе ───────────────────────────────────────────────────

function HUD.SpawnPopup(self: StretchHUDController, text: string, position: Vector3, top: Color3, bottom: Color3, pixelHeight: number)
	if #self.Popups >= MAX_POPUPS then
		local oldest = table.remove(self.Popups, 1)
		if oldest then
			oldest.Gui:Destroy()
			oldest.Attachment:Destroy()
		end
	end
	local rng = self.Random
	local attachment = Instance.new("Attachment")
	attachment.Name = "Popup"
	attachment.Parent = self.PopupAnchor
	attachment.WorldCFrame = CFrame.new(position)

	local gui = Instance.new("BillboardGui")
	gui.Name = "Popup"
	gui.Adornee = attachment
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 900
	gui.Size = UDim2.fromOffset(pixelHeight * 4, pixelHeight * 1.5)
	gui.Parent = self.PopupFolder

	local label = newLabel("Text", gui, text, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 0)
	local stroke = addStroke(label, math.max(pixelHeight / 14, 2.5), INK, Enum.ApplyStrokeMode.Contextual)
	addGradient(label, top, bottom)
	local scale = addScale(label, 0.01)
	local scaleSpring = Spring.Number.new(0, 3.4, 0.38)
	scaleSpring.Target = 1
	local tilt = Spring.Number.new(rng:NextNumber(-16, 16), 3, 0.4)
	tilt.Target = 0

	table.insert(self.Popups, {
		Gui = gui,
		Attachment = attachment,
		Label = label,
		Stroke = stroke,
		Scale = scale,
		ScaleSpring = scaleSpring,
		Tilt = tilt,
		Origin = position,
		Velocity = Vector3.new(rng:NextNumber(-9, 9), rng:NextNumber(24, 32), rng:NextNumber(-9, 9)),
		Born = os.clock(),
		Life = rng:NextNumber(1.05, 1.3),
	})
end

function HUD.UpdatePopups(self: StretchHUDController, dt: number, now: number)
	local index = 1
	while index <= #self.Popups do
		local popup = self.Popups[index]
		local age = now - popup.Born
		if age >= popup.Life then
			popup.Gui:Destroy()
			popup.Attachment:Destroy()
			table.remove(self.Popups, index)
		else
			-- p(t) = p0 + v0·t + ½·g·t²
			local position = popup.Origin + popup.Velocity * age + POPUP_GRAVITY * (0.5 * age * age)
			popup.Attachment.WorldCFrame = CFrame.new(position)
			popup.Scale.Scale = math.max(popup.ScaleSpring:Update(dt), 0.01)
			popup.Label.Rotation = popup.Tilt:Update(dt)
			local fadeStart = popup.Life * 0.65
			local fade = if age > fadeStart then (age - fadeStart) / (popup.Life - fadeStart) else 0
			popup.Label.TextTransparency = fade
			popup.Stroke.Transparency = fade
			index += 1
		end
	end
end

function HUD.PlayerHeadPosition(self: StretchHUDController): Vector3
	local character = self.Player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		return root.Position + Vector3.new(0, 4, 0)
	end
	local origin = self.Camera:GetAimRay()
	return origin
end

-- ── Баннер ──────────────────────────────────────────────────────────────────

function HUD.BuildBanner(self: StretchHUDController)
	local basePosition = UDim2.fromScale(0.5, 0.2)
	local root = newFrame("Banner", self.Root, UDim2.fromOffset(620, 140), basePosition, Vector2.new(0.5, 0.5), WHITE, 0)
	root.ZIndex = 20
	root.Visible = false
	addCorner(root, UDim.new(0, 30))
	local gradient = addGradient(root, GOLD, GOLD_DARK)
	addStroke(root, 6, WHITE, Enum.ApplyStrokeMode.Border)

	local rays = newFrame("Rays", root, UDim2.fromOffset(760, 760), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 1)
	rays.ZIndex = 19
	for index = 0, 11 do
		local ray = newFrame("Ray" .. index, rays, UDim2.fromOffset(760, 26), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 0.82)
		ray.Rotation = index * 15
		ray.ZIndex = 19
		addCorner(ray, UDim.new(0.5, 0))
	end

	local title = newLabel("Title", root, "REBIRTH!", UDim2.new(1, -40, 0.62, 0), UDim2.new(0.5, 0, 0, 6), Vector2.new(0.5, 0), WHITE, 6)
	title.ZIndex = 21
	addGradient(title, WHITE, Color3.fromRGB(255, 236, 160))
	local subtitle = newLabel("Subtitle", root, "", UDim2.new(1, -40, 0.3, 0), UDim2.new(0.5, 0, 1, -10), Vector2.new(0.5, 1), WHITE, 3.5)
	subtitle.ZIndex = 21

	self.Banner = {
		Root = root,
		Scale = addScale(root, 0.01),
		Gradient = gradient,
		Title = title,
		Subtitle = subtitle,
		Rays = rays,
		ScaleSpring = Spring.Number.new(0, 2.8, 0.42),
		Shake = Spring.Vector.new(Vector3.zero, 7, 0.22),
		HideAt = 0,
		Showing = false,
		BasePosition = basePosition,
	}
end

function HUD.ShowBanner(
	self: StretchHUDController,
	title: string,
	subtitle: string,
	top: Color3,
	bottom: Color3,
	duration: number,
	celebratory: boolean
)
	local banner = self.Banner
	banner.Title.Text = title
	banner.Subtitle.Text = subtitle
	setGradient(banner.Gradient, top, bottom)
	banner.Rays.Visible = celebratory
	banner.Root.Visible = true
	banner.Showing = true
	banner.HideAt = os.clock() + duration
	banner.ScaleSpring.Position = 0.05
	banner.ScaleSpring.Velocity = 0
	banner.ScaleSpring.Target = 1
	if not celebratory then
		banner.Shake:Impulse(Vector3.new(900, 0, 0)) -- «нет-нет»: тряска вбок
	end
end

function HUD.UpdateBanner(self: StretchHUDController, dt: number, now: number)
	local banner = self.Banner
	if not banner.Root.Visible then
		return
	end
	if banner.Showing and now >= banner.HideAt then
		banner.Showing = false
		banner.ScaleSpring.Target = 0
	end
	local scale = banner.ScaleSpring:Update(dt)
	banner.Scale.Scale = math.max(scale, 0.01)
	local shake = banner.Shake:Update(dt)
	banner.Root.Position = banner.BasePosition + UDim2.fromOffset(shake.X, shake.Y)
	banner.Rays.Rotation = (now * 25) % 360
	if not banner.Showing and scale < 0.03 then
		banner.Root.Visible = false
	end
end

-- ── Панель прокачки и витрина перчаток ─────────────────────────────────────

function HUD.BuildStatCard(self: StretchHUDController, parent: Instance, stat: Types.StatName, order: number): StatCard
	local info = STAT_INFO[stat]
	local card = newFrame(stat, parent, UDim2.fromOffset(430, 124), UDim2.fromOffset(0, (order - 1) * 136), Vector2.zero, WHITE, 0)
	addCorner(card, UDim.new(0, 20))
	addGradient(card, CARD_TOP, CARD_BOTTOM)
	addStroke(card, 3.5, INK, Enum.ApplyStrokeMode.Border)
	local scale = addScale(card, 1)

	local icon = newFrame("Icon", card, UDim2.fromOffset(64, 64), UDim2.fromOffset(14, 14), Vector2.zero, WHITE, 0)
	addCorner(icon, UDim.new(0.5, 0))
	addGradient(icon, info.Color:Lerp(WHITE, 0.35), info.Color)
	addStroke(icon, 3, INK, Enum.ApplyStrokeMode.Border)
	newLabel("Letter", icon, info.Letter, UDim2.fromScale(0.7, 0.7), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 3)

	local title = newLabel("Title", card, info.Title, UDim2.fromOffset(200, 26), UDim2.fromOffset(90, 10), Vector2.zero, WHITE, 3)
	title.TextXAlignment = Enum.TextXAlignment.Left
	local level = newLabel("Level", card, "Lv 0", UDim2.fromOffset(70, 26), UDim2.fromOffset(296, 10), Vector2.new(1, 0), GOLD, 3)
	level.TextXAlignment = Enum.TextXAlignment.Right
	local subtitle = newLabel("Subtitle", card, info.Subtitle, UDim2.fromOffset(200, 16), UDim2.fromOffset(16, 84), Vector2.zero, Color3.fromRGB(220, 214, 255), 2)
	subtitle.Size = UDim2.fromOffset(70, 16)
	local preview = newLabel("Preview", card, "", UDim2.fromOffset(206, 44), UDim2.fromOffset(90, 40), Vector2.zero, Color3.fromRGB(236, 232, 255), 2)
	preview.TextXAlignment = Enum.TextXAlignment.Left
	preview.TextYAlignment = Enum.TextYAlignment.Top

	local bar = newFrame("Bar", card, UDim2.fromOffset(206, 12), UDim2.fromOffset(90, 96), Vector2.zero, INK, 0.35)
	addCorner(bar, UDim.new(0.5, 0))
	local fill = newFrame("Fill", bar, UDim2.fromScale(0, 1), UDim2.fromScale(0, 0), Vector2.zero, WHITE, 0)
	addCorner(fill, UDim.new(0.5, 0))
	addGradient(fill, info.Color:Lerp(WHITE, 0.4), info.Color)

	local buttonButton, buttonGradient = newButton(
		"Upgrade",
		card,
		"",
		UDim2.fromOffset(112, 84),
		UDim2.new(1, -12, 0.5, 0),
		Vector2.new(1, 0.5),
		GREEN,
		GREEN_DARK
	)
	local caption = newLabel("Caption", buttonButton, "UPGRADE", UDim2.fromScale(1, 0.34), UDim2.fromScale(0.5, 0), Vector2.new(0.5, 0), WHITE, 2)
	caption.ZIndex = 2
	local cost = newLabel("Cost", buttonButton, "", UDim2.fromScale(1, 0.58), UDim2.fromScale(0.5, 1), Vector2.new(0.5, 1), GOLD, 2.5)
	cost.ZIndex = 2

	local message = newLabel("Message", card, "", UDim2.fromOffset(300, 22), UDim2.new(0, 90, 1, -2), Vector2.new(0, 1), WHITE, 2.5)
	message.TextXAlignment = Enum.TextXAlignment.Left
	message.Visible = false

	local statCard: StatCard = {
		Stat = stat,
		Order = order,
		Root = card,
		Scale = scale,
		Pop = Spring.Number.new(0, 5, 0.3),
		Shake = Spring.Vector.new(Vector3.zero, 9, 0.2),
		Level = level,
		Preview = preview,
		BarFill = fill,
		Button = buttonButton,
		ButtonGradient = buttonGradient,
		Cost = cost,
		Message = message,
		MessageUntil = 0,
		PendingUntil = 0,
	}
	table.insert(
		self.Connections,
		buttonButton.Activated:Connect(function()
			self.Signals.UiClick:Fire()
			self:RequestUpgrade(statCard)
		end)
	)
	return statCard
end

function HUD.BuildGloveCard(self: StretchHUDController, parent: Instance, glove: GloveConfig.GloveDef, order: number): GloveCard
	local card = newFrame(glove.Id, parent, UDim2.fromOffset(196, 128), UDim2.fromOffset(0, 0), Vector2.zero, WHITE, 0)
	card.LayoutOrder = order
	addCorner(card, UDim.new(0, 20))
	addGradient(card, CARD_TOP, CARD_BOTTOM)
	local stroke = addStroke(card, 3.5, INK, Enum.ApplyStrokeMode.Border)
	local scale = addScale(card, 1)

	local swatch = newFrame("Swatch", card, UDim2.fromOffset(54, 54), UDim2.fromOffset(12, 12), Vector2.zero, WHITE, 0)
	addCorner(swatch, UDim.new(0.5, 0))
	addGradient(swatch, glove.Color:Lerp(WHITE, 0.45), glove.Color)
	addStroke(swatch, 3, INK, Enum.ApplyStrokeMode.Border)
	local shine = newFrame("Shine", swatch, UDim2.fromOffset(14, 10), UDim2.fromOffset(12, 10), Vector2.zero, WHITE, 0.25)
	addCorner(shine, UDim.new(0.5, 0))

	local name = newLabel("Name", card, glove.DisplayName, UDim2.fromOffset(112, 30), UDim2.fromOffset(74, 10), Vector2.zero, WHITE, 2.5)
	name.TextXAlignment = Enum.TextXAlignment.Left
	local bonusText = if glove.ImpactMassBonus > 0 then string.format("+%d%% удара", math.floor(glove.ImpactMassBonus * 100 + 0.5)) else "Классика"
	local bonus = newLabel("Bonus", card, bonusText, UDim2.fromOffset(112, 20), UDim2.fromOffset(74, 42), Vector2.zero, glove.Accent, 2)
	bonus.TextXAlignment = Enum.TextXAlignment.Left

	local actionButton, actionGradient = newButton(
		"Action",
		card,
		"",
		UDim2.fromOffset(172, 40),
		UDim2.new(0.5, 0, 1, -10),
		Vector2.new(0.5, 1),
		GREEN,
		GREEN_DARK
	)
	local message = newLabel("Message", card, "", UDim2.fromOffset(172, 16), UDim2.new(0.5, 0, 0, 62), Vector2.new(0.5, 0), WHITE, 2)
	message.Visible = false

	local gloveCard: GloveCard = {
		Id = glove.Id,
		Def = glove,
		Root = card,
		Scale = scale,
		Pop = Spring.Number.new(0, 5, 0.3),
		Shake = Spring.Vector.new(Vector3.zero, 9, 0.2),
		Button = actionButton,
		ButtonGradient = actionGradient,
		Stroke = stroke,
		Message = message,
		MessageUntil = 0,
		PendingUntil = 0,
	}
	table.insert(
		self.Connections,
		actionButton.Activated:Connect(function()
			self.Signals.UiClick:Fire()
			self:RequestGlove(gloveCard)
		end)
	)
	return gloveCard
end

function HUD.BuildPanel(self: StretchHUDController)
	local panel = newFrame("UpgradePanel", self.Root, UDim2.fromOffset(900, 548), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), WHITE, 0)
	panel.ZIndex = 30
	panel.Visible = false
	addCorner(panel, UDim.new(0, 30))
	addGradient(panel, PANEL_TOP, PANEL_BOTTOM)
	addStroke(panel, 6, WHITE, Enum.ApplyStrokeMode.Border)
	self.Panel = panel
	self.PanelScale = addScale(panel, 0.01)

	local title = newLabel("Title", panel, "ПРОКАЧКА  •  ПЕРЧАТКИ", UDim2.fromOffset(520, 48), UDim2.fromOffset(28, 16), Vector2.zero, WHITE, 4.5)
	title.TextXAlignment = Enum.TextXAlignment.Left
	addGradient(title, WHITE, Color3.fromRGB(255, 226, 150))

	local coinBox = newFrame("CoinBox", panel, UDim2.fromOffset(200, 46), UDim2.new(1, -84, 0, 18), Vector2.new(1, 0), INK, 0.4)
	addCorner(coinBox, UDim.new(0, 16))
	local coinIcon = newFrame("Icon", coinBox, UDim2.fromOffset(32, 32), UDim2.new(0, 8, 0.5, 0), Vector2.new(0, 0.5), WHITE, 0)
	addCorner(coinIcon, UDim.new(0.5, 0))
	addGradient(coinIcon, GOLD, GOLD_DARK)
	addStroke(coinIcon, 2.5, INK, Enum.ApplyStrokeMode.Border)
	local panelCoins = newLabel("Amount", coinBox, "0", UDim2.new(1, -54, 0.8, 0), UDim2.new(0, 48, 0.5, 0), Vector2.new(0, 0.5), GOLD, 3)
	panelCoins.TextXAlignment = Enum.TextXAlignment.Left
	self.PanelCoins = panelCoins

	local close = newButton("Close", panel, "X", UDim2.fromOffset(52, 52), UDim2.new(1, -16, 0, 14), Vector2.new(1, 0), RED, RED_DARK)
	table.insert(
		self.Connections,
		close.Activated:Connect(function()
			self.Signals.UiClick:Fire()
			self:SetPanelOpen(false)
		end)
	)

	local statsHeader = newLabel("StatsHeader", panel, "ФИЗИКА", UDim2.fromOffset(200, 26), UDim2.fromOffset(28, 74), Vector2.zero, Color3.fromRGB(255, 226, 150), 3)
	statsHeader.TextXAlignment = Enum.TextXAlignment.Left
	local statsColumn = newFrame("Stats", panel, UDim2.fromOffset(430, 400), UDim2.fromOffset(24, 104), Vector2.zero, WHITE, 1)
	for order, stat in STAT_ORDER do
		self.StatCards[stat] = self:BuildStatCard(statsColumn, stat, order)
	end

	local glovesHeader = newLabel("GlovesHeader", panel, "ПЕРЧАТКИ", UDim2.fromOffset(200, 26), UDim2.fromOffset(474, 74), Vector2.zero, Color3.fromRGB(255, 226, 150), 3)
	glovesHeader.TextXAlignment = Enum.TextXAlignment.Left
	local glovesScroll = Instance.new("ScrollingFrame")
	glovesScroll.Name = "Gloves"
	glovesScroll.Size = UDim2.fromOffset(410, 400)
	glovesScroll.Position = UDim2.fromOffset(470, 104)
	glovesScroll.BackgroundTransparency = 1
	glovesScroll.BorderSizePixel = 0
	glovesScroll.ScrollBarThickness = 8
	glovesScroll.ScrollBarImageColor3 = WHITE
	glovesScroll.CanvasSize = UDim2.fromOffset(0, 0)
	glovesScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	glovesScroll.ScrollingDirection = Enum.ScrollingDirection.Y
	glovesScroll.Parent = panel
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(196, 128)
	grid.CellPadding = UDim2.fromOffset(10, 10)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = glovesScroll
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingLeft = UDim.new(0, 4)
	padding.Parent = glovesScroll

	local gloves: { GloveConfig.GloveDef } = {}
	for _, glove in GloveConfig.Gloves do
		table.insert(gloves, glove)
	end
	table.sort(gloves, function(a: GloveConfig.GloveDef, b: GloveConfig.GloveDef): boolean
		if a.Price == b.Price then
			return a.Id < b.Id
		end
		return a.Price < b.Price
	end)
	for order, glove in gloves do
		self.GloveCards[glove.Id] = self:BuildGloveCard(glovesScroll, glove, order)
		table.insert(self.GloveOrder, glove.Id)
	end

	local records = newLabel("Records", panel, "", UDim2.new(1, -56, 0, 24), UDim2.new(0.5, 0, 1, -12), Vector2.new(0.5, 1), Color3.fromRGB(220, 214, 255), 2.5)
	self.RecordsText = records
	local offline = newLabel("Offline", panel, "", UDim2.fromOffset(420, 20), UDim2.new(0, 560, 0, 70), Vector2.new(0, 0), Color3.fromRGB(255, 200, 120), 2)
	offline.TextXAlignment = Enum.TextXAlignment.Left
	self.OfflineText = offline
end

