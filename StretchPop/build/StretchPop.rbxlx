        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">LevelBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Процедурная полоса препятствий.
-- GenerateLayout — чистая детерминированная функция (seed локации + тир → одинаковая трасса),
-- Build* — превращение описания в анкерные детали с атрибутами и тегами для клиента и сервера.
-- Локальные координаты полосы: старт в (0,0,0), верх пола на Y = 0, полоса уходит в −Z,
-- +Z смотрит на хаб Sky Plaza (туда ведёт мост от стартовой площадки).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local LevelConfig = require(Shared.Config.LevelConfig)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local StretchPhysics = require(Shared.Physics.StretchPhysics)
local PinataMotion = require(Shared.Physics.PinataMotion)
local ToyModels = require(Shared.Visual.ToyModels)

local Tags = PhysicsConfig.Tags

export type PieceKind =
	"Floor"
	| "Stripe"
	| "Rail"
	| "Post"
	| "Ring"
	| "Arch"
	| "Bumper"
	| "BumperBall"
	| "Island"
	| "GongBase"
	| "GongFrame"
	| "GongDisc"
	| "GongSign"
	| "Foundation"
	| "FoundationDeep"
	| "RockSpike"
	| "Girder"
	| "Chevron"
	| "BoostRing"
	| "DecorIsland"
	| "Cloud"
	| "DecorRing"

export type PieceSpec = {
	Kind: PieceKind,
	LocalCFrame: CFrame,
	Size: Vector3,
	Shape: Enum.PartType,
	Seed: number?,
	Scale: number?,
}

export type ObstacleSpec = {
	Id: string,
	Kind: "Wall" | "Chest" | "Pinata",
	Strength: string,
	LocalCFrame: CFrame,
	Size: Vector3,
	RequiredSpeed: number, -- для подсказок: скорость пробития при m = 1
	Durability: number, -- энергия ½mv², нужная для пробития
	Loot: number,
	Motion: PinataMotion.MotionSpec?, -- только у пиньят
}

export type RingSpec = {
	Id: string,
	LocalCFrame: CFrame,
	Radius: number,
}

export type Gap = {
	From: number, -- ближняя к старту граница (больше, т.к. ось −Z)
	To: number,
}

export type LaneLayout = {
	LocationId: string,
	Tier: number,
	Seed: number,
	Length: number,
	Pieces: { PieceSpec },
	Obstacles: { ObstacleSpec },
	Rings: { RingSpec },
	Gaps: { Gap },
	GongLocalCFrame: CFrame,
}

export type BuildContext = {
	Origin: CFrame,
	Theme: LevelConfig.Theme,
	Slot: number,
	Tier: number,
	OwnerUserId: number,
	OwnerName: string,
	BestSpeed: number,
}

export type LaneHandles = {
	Model: Model,
	Static: Folder,
	Mutable: Folder,
	ObstacleFolder: Folder,
	StartPad: BasePart,
	StartSign: BasePart,
	GateSign: BasePart,
	Gong: BasePart?,
	Obstacles: { [string]: BasePart },
}

type BeatKind = "Wall" | "Chests" | "Bumpers" | "Anchors" | "Island"

type Bounds = {
	Min: Vector3,
	Max: Vector3,
}

local BLOCK = Enum.PartType.Block
local BALL = Enum.PartType.Ball
local CYLINDER = Enum.PartType.Cylinder
local WEDGE = Enum.PartType.Wedge
local NEON = Enum.Material.Neon

-- «Мешок» тактов (как 7-bag в тетрисе): на каждые 8 тактов гарантированно 3 стены,
-- 2 россыпи сундуков, бамперы, якоря и остров — трасса разнообразна при любом seed.
local BEAT_BAG: { BeatKind } = { "Wall", "Wall", "Wall", "Chests", "Chests", "Bumpers", "Anchors", "Island" }

local LevelBuilder = {}

local function isOverGap(gaps: { Gap }, z: number, margin: number): boolean
	for _, gap in gaps do
		if z <= gap.From + margin and z >= gap.To - margin then
			return true
		end
	end
	return false
end

local function shuffle<T>(list: { T }, rng: Random)
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
end

-- Мировой AABB повернутого бокса
local function boundsOf(cframe: CFrame, size: Vector3): Bounds
	local half = size * 0.5
	local right, up, look = cframe.RightVector, cframe.UpVector, cframe.LookVector
	local extent = Vector3.new(
		math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z,
		math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z,
		math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
	)
	return { Min = cframe.Position - extent, Max = cframe.Position + extent }
end

local function boundsOverlap(a: Bounds, b: Bounds, margin: number): boolean
	return a.Min.X - margin < b.Max.X
		and a.Max.X + margin > b.Min.X
		and a.Min.Y - margin < b.Max.Y
		and a.Max.Y + margin > b.Min.Y
		and a.Min.Z - margin < b.Max.Z
		and a.Max.Z + margin > b.Min.Z
end

function LevelBuilder.GenerateLayout(locationId: string, tier: number): LaneLayout
	local location = LevelConfig.Locations[locationId] or LevelConfig.Locations[LevelConfig.DefaultLocation]
	local seed = location.Seed * 31 + tier * 7919
	local rng = Random.new(seed)
	local length = LevelConfig.LaneLength(tier)
	local width = LevelConfig.LaneWidth
	local halfWidth = width / 2
	local durabilityMultiplier = LevelConfig.DurabilityMultiplier(tier)
	local lootMultiplier = LevelConfig.LootMultiplier(tier)
	local chestSize = LevelConfig.Chest.Size
	local strengths = LevelConfig.WallStrengths

	local pieces: { PieceSpec } = {}
	local obstacles: { ObstacleSpec } = {}
	local rings: { RingSpec } = {}
	local gaps: { Gap } = {}
	local occupied: { Bounds } = {}
	local obstacleIndex = 0

	local function claim(cframe: CFrame, size: Vector3, margin: number): boolean
		local bounds = boundsOf(cframe, size)
		for _, other in occupied do
			if boundsOverlap(bounds, other, margin) then
				return false
			end
		end
		table.insert(occupied, bounds)
		return true
	end

	local function addPiece(kind: PieceKind, cframe: CFrame, size: Vector3, shape: Enum.PartType)
		table.insert(pieces, { Kind = kind, LocalCFrame = cframe, Size = size, Shape = shape })
	end

	local function addDecor(kind: PieceKind, cframe: CFrame, scale: number)
		table.insert(pieces, {
			Kind = kind,
			LocalCFrame = cframe,
			Size = Vector3.one * scale,
			Shape = BLOCK,
			Seed = rng:NextInteger(1, 2 ^ 20),
			Scale = scale,
		})
	end

	local function addFloorSegment(zStart: number, zEnd: number)
		local segmentLength = zStart - zEnd
		local zCenter = (zStart + zEnd) * 0.5
		addPiece("Floor", CFrame.new(0, -3, zCenter), Vector3.new(width, 6, segmentLength), BLOCK)
		-- Бортики-пружины по краям: цилиндр вдоль Z (ось цилиндра = локальная X → поворот на 90° вокруг Y)
		for _, side in { -1, 1 } do
			addPiece(
				"Rail",
				CFrame.new(side * (halfWidth + 2.5), 2.2, zCenter) * CFrame.Angles(0, math.rad(90), 0),
				Vector3.new(segmentLength, 5, 5),
				CYLINDER
			)
		end
		-- Массивное основание: скальный пласт, глубинная порода, стальные балки и сталактиты
		addPiece("Foundation", CFrame.new(0, -13, zCenter), Vector3.new(width + 6, 14, segmentLength), BLOCK)
		addPiece("FoundationDeep", CFrame.new(0, -27, zCenter), Vector3.new(width - 16, 14, math.max(segmentLength - 12, 6)), BLOCK)
		for _, side in { -1, 1 } do
			addPiece("Girder", CFrame.new(side * (halfWidth - 9), -7.5, zCenter), Vector3.new(2.6, 3, segmentLength), BLOCK)
		end
		local beamZ = zStart - 12
		while beamZ > zEnd + 6 do
			addPiece("Girder", CFrame.new(0, -7.2, beamZ), Vector3.new(width - 14, 2.2, 2.6), BLOCK)
			beamZ -= 40
		end
		for _ = 1, math.max(1, math.floor(segmentLength / 45)) do
			local spikeHeight = rng:NextNumber(10, 18)
			addPiece(
				"RockSpike",
				CFrame.new(rng:NextNumber(-halfWidth + 14, halfWidth - 14), -34 - spikeHeight * 0.5, rng:NextNumber(zEnd + 6, zStart - 6))
					* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), math.pi),
				Vector3.new(rng:NextNumber(7, 12), spikeHeight, rng:NextNumber(7, 12)),
				WEDGE
			)
		end
		-- Разметка: белые полосы и неоновые шевроны «>>>» по центру
		local stripeZ = zStart - 20
		while stripeZ > zEnd + 4 do
			for _, side in { -1, 1 } do
				addPiece("Stripe", CFrame.new(side * (halfWidth - 3), 0.1, stripeZ), Vector3.new(2, 0.2, 14), BLOCK)
			end
			stripeZ -= 40
		end
		local chevronZ = zStart - 30
		while chevronZ > zEnd + 10 do
			for index = 0, 2 do
				local tip = chevronZ - index * 3.4
				for _, side in { -1, 1 } do
					addPiece(
						"Chevron",
						CFrame.new(side * 1.72, 0.09, tip + 2.46) * CFrame.Angles(0, side * math.rad(35), 0),
						Vector3.new(1.1, 0.14, 6),
						BLOCK
					)
				end
			end
			chevronZ -= 48
		end
	end

	local function addPost(x: number, z: number, height: number)
		addPiece("Post", CFrame.new(x, height * 0.5, z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(height, 3.2, 3.2), CYLINDER)
		addPiece("Ring", CFrame.new(x, height + 1.8, z), Vector3.new(4.6, 4.6, 4.6), BALL)
	end

	local function addArch(z: number, y: number)
		addPiece("Arch", CFrame.new(0, y, z), Vector3.new(width - 12, 2.4, 2.4), BLOCK)
		for _, x in { -width * 0.25, 0, width * 0.25 } do
			addPiece("Ring", CFrame.new(x, y - 3, z), Vector3.new(4.2, 4.2, 4.2), BALL)
		end
	end

	local function addWall(strengthIndex: number, x: number, z: number, wallWidth: number, height: number)
		local strength = strengths[strengthIndex]
		local cframe = CFrame.new(x, height * 0.5, z)
		local size = Vector3.new(wallWidth, height, strength.Thickness)
		if not claim(cframe, size, 0.1) then
			return
		end
		obstacleIndex += 1
		table.insert(obstacles, {
			Id = string.format("T%d-%d", tier, obstacleIndex),
			Kind = "Wall",
			Strength = strength.Name,
			LocalCFrame = cframe,
			Size = size,
			RequiredSpeed = strength.RequiredSpeed * math.sqrt(durabilityMultiplier),
			Durability = StretchPhysics.DurabilityFromSpeed(strength.RequiredSpeed, durabilityMultiplier),
			Loot = math.max(1, math.floor(strength.Loot * lootMultiplier * math.sqrt(wallWidth / (width - 2)) + 0.5)),
			Motion = nil,
		})
	end

	local function addChest(x: number, y: number, z: number, yaw: number): boolean
		local cframe = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0)
		-- запас под крышку/обручи сундука
		if not claim(cframe, chestSize + Vector3.new(1.2, 2.2, 1.2), 1.5) then
			return false
		end
		obstacleIndex += 1
		table.insert(obstacles, {
			Id = string.format("T%d-%d", tier, obstacleIndex),
			Kind = "Chest",
			Strength = "Chest",
			LocalCFrame = cframe,
			Size = chestSize,
			RequiredSpeed = LevelConfig.Chest.RequiredSpeed * math.sqrt(durabilityMultiplier),
			Durability = StretchPhysics.DurabilityFromSpeed(LevelConfig.Chest.RequiredSpeed, durabilityMultiplier),
			Loot = math.floor(LevelConfig.Chest.Loot * lootMultiplier + 0.5),
			Motion = nil,
		})
		return true
	end

	local function strengthFor(progress: number): number
		local raw = progress * 3.1 + rng:NextNumber() * 1.3 + math.min(tier, 6) * 0.3
		return math.clamp(math.floor(raw) + 1, 1, #strengths)
	end

	-- 1) Взлётная полоса (с провалами начиная с Cyber-Slime)
	local runwayStart = -LevelConfig.StartPadSize.Z * 0.5
	local runwayEnd = -(length - 40)
	local gapChance = if tier >= 2 then math.min(0.14 * (tier - 1), 0.42) else 0
	local z = runwayStart
	while z > runwayEnd + 1 do
		local segmentEnd = math.max(z - rng:NextInteger(90, 150), runwayEnd)
		addFloorSegment(z, segmentEnd)
		z = segmentEnd
		if gapChance > 0 and z > runwayEnd + 170 and rng:NextNumber() < gapChance then
			local gapLength = rng:NextInteger(40, 60 + 8 * math.min(tier, 6))
			table.insert(gaps, { From = z, To = z - gapLength })
			addPost(-halfWidth + 6, z - 3, 40)
			addPost(halfWidth - 6, z - 3, 40)
			addArch(z - gapLength * 0.5, 48)
			z -= gapLength
		end
	end

	-- 2) «Вилка» рогатки сразу за стартом
	addPost(-16, -50, 30)
	addPost(16, -50, 30)

	-- 3) Такты препятствий
	local cursor = -110
	local beatLimit = runwayEnd + 60
	local bag: { BeatKind } = {}
	while cursor > beatLimit do
		local progress = math.clamp(-cursor / length, 0, 1)
		local beat: BeatKind
		if isOverGap(gaps, cursor, 14) then
			beat = "Island" -- над провалом — только парящие острова-ступеньки (мешок не тратится)
		else
			if #bag == 0 then
				bag = table.clone(BEAT_BAG)
				shuffle(bag, rng)
			end
			beat = table.remove(bag) :: BeatKind
		end

		if beat == "Wall" then
			local height = rng:NextInteger(24, 32)
			if rng:NextNumber() < 0.38 then
				-- Три панели разной прочности: игрок выбирает, куда бить
				local center = strengthFor(progress)
				local order = { math.max(center - 1, 1), center, math.min(center + 1, #strengths) }
				shuffle(order, rng)
				local panelWidth = (width - 2) / 3
				for i, strengthIndex in order do
					addWall(strengthIndex, -halfWidth + 1 + panelWidth * (i - 0.5), cursor, panelWidth - 0.4, height)
				end
			else
				addWall(strengthFor(progress), 0, cursor, width - 2, height)
			end
		elseif beat == "Chests" then
			for _ = 1, rng:NextInteger(2, 4) do
				for _ = 1, 10 do
					local x = rng:NextNumber(-halfWidth + 10, halfWidth - 10)
					local yaw = math.rad(rng:NextNumber(-25, 25))
					if addChest(x, chestSize.Y * 0.5, cursor + rng:NextNumber(-12, 12), yaw) then
						break
					end
				end
			end
		elseif beat == "Bumpers" then
			local placed: { Vector3 } = {}
			for _ = 1, rng:NextInteger(3, 6) do
				for _ = 1, 8 do
					local x = rng:NextNumber(-halfWidth + 9, halfWidth - 9)
					local bz = cursor + rng:NextNumber(-16, 16)
					local candidate = Vector3.new(x, 0, bz)
					local free = true
					for _, other in placed do
						if (other - candidate).Magnitude < 13 then
							free = false
							break
						end
					end
					if free and not claim(CFrame.new(x, 12, bz), Vector3.new(12, 30, 12), 0.5) then
						free = false
					end
					if free then
						table.insert(placed, candidate)
						if rng:NextNumber() < 0.6 then
							local height = rng:NextInteger(9, 15)
							local diameter = rng:NextInteger(6, 9)
							addPiece(
								"Bumper",
								CFrame.new(x, height * 0.5, bz) * CFrame.Angles(0, 0, math.rad(90)),
								Vector3.new(height, diameter, diameter),
								CYLINDER
							)
						else
							local diameter = rng:NextInteger(7, 11)
							addPiece("BumperBall", CFrame.new(x, rng:NextInteger(9, 26), bz), Vector3.new(diameter, diameter, diameter), BALL)
						end
						break
					end
				end
			end
		elseif beat == "Anchors" then
			local height = rng:NextInteger(34, 48)
			addPost(-halfWidth + 6, cursor, height)
			addPost(halfWidth - 6, cursor, height)
			if rng:NextNumber() < 0.55 then
				addArch(cursor, height + 2)
			end
		else -- Island
			local x = rng:NextNumber(-halfWidth + 16, halfWidth - 16)
			local y = rng:NextInteger(18, 30)
			addPiece("Island", CFrame.new(x, y, cursor), Vector3.new(24, 4, 24), BLOCK)
			addChest(x + rng:NextNumber(-5, 5), y + 2 + chestSize.Y * 0.5, cursor + rng:NextNumber(-5, 5), math.rad(rng:NextNumber(-30, 30)))
			addPiece("Ring", CFrame.new(x, y + 16, cursor), Vector3.new(4.6, 4.6, 4.6), BALL)
		end
		cursor -= rng:NextInteger(58, 86)
	end

	-- 4) Кольца ускорения в воздухе (не внутри стен и прочих препятствий)
	local ringConfig = LevelConfig.BoostRing
	local ringZ = -160 - rng:NextNumber(0, 30)
	local ringIndex = 0
	while ringZ > runwayEnd + 110 do
		for _ = 1, 8 do
			local cframe = CFrame.new(rng:NextNumber(-halfWidth + 18, halfWidth - 18), rng:NextNumber(18, 34), ringZ)
			if claim(cframe, Vector3.new(ringConfig.Radius * 2 + 2, ringConfig.Radius * 2 + 2, 4), 1) then
				ringIndex += 1
				local id = string.format("R%d-%d", tier, ringIndex)
				table.insert(rings, { Id = id, LocalCFrame = cframe, Radius = ringConfig.Radius })
				table.insert(pieces, {
					Kind = "BoostRing",
					LocalCFrame = cframe,
					Size = Vector3.new(0.6, ringConfig.Radius * 2, ringConfig.Radius * 2),
					Shape = CYLINDER,
					Seed = ringIndex,
					Scale = ringConfig.Radius,
				})
				break
			end
			ringZ -= 6
		end
		ringZ -= ringConfig.Spacing + rng:NextNumber(-20, 20)
	end

	-- 5) Золотые пиньяты: плывут поперёк полосы, коридор движения резервируется целиком
	local pinataConfig = LevelConfig.Pinata
	local pinataCount = math.min(1 + tier // 2, 3)
	for index = 1, pinataCount do
		local fraction = (index - 0.5) / pinataCount
		for _ = 1, 10 do
			local pz = -(length * (0.32 + 0.52 * fraction)) + rng:NextNumber(-20, 20)
			local amplitude = math.min(rng:NextNumber(pinataConfig.AmplitudeMin, pinataConfig.AmplitudeMax), halfWidth - pinataConfig.Size.X)
			local motion: PinataMotion.MotionSpec = {
				Amplitude = amplitude,
				Frequency = rng:NextNumber(pinataConfig.FrequencyMin, pinataConfig.FrequencyMax),
				Phase = rng:NextNumber(0, math.pi * 2),
			}
			local cframe = CFrame.new(0, rng:NextNumber(14, 24), pz)
			if pz > runwayEnd + 60 and claim(cframe, PinataMotion.SweepSize(pinataConfig.Size, motion), 1) then
				obstacleIndex += 1
				table.insert(obstacles, {
					Id = string.format("T%d-%d", tier, obstacleIndex),
					Kind = "Pinata",
					Strength = "Pinata",
					LocalCFrame = cframe,
					Size = pinataConfig.Size,
					RequiredSpeed = pinataConfig.RequiredSpeed * math.sqrt(durabilityMultiplier),
					Durability = StretchPhysics.DurabilityFromSpeed(pinataConfig.RequiredSpeed, durabilityMultiplier),
					Loot = math.floor(pinataConfig.Loot * lootMultiplier + 0.5),
					Motion = motion,
				})
				break
			end
		end
	end

	-- 6) Окружение вдоль трассы: парящие островки с деревьями, облака, декоративные кольца.
	--    Начинаем дальше от старта, где веер полос уже разошёлся и соседям не тесно.
	local decorZ = -360 - rng:NextNumber(0, 40)
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	while decorZ > -length + 20 do
		addDecor(
			"DecorIsland",
			CFrame.new(side * (halfWidth + 36 + rng:NextNumber(0, 14)), rng:NextNumber(-24, 16), decorZ) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
			rng:NextNumber(0.8, 1.25)
		)
		if rng:NextNumber() < 0.35 then
			addDecor("DecorRing", CFrame.new(-side * (halfWidth + 30), rng:NextNumber(40, 62), decorZ - 40) * CFrame.Angles(0, math.pi / 2, 0), rng:NextNumber(7, 10))
		end
		side = -side
		decorZ -= rng:NextNumber(110, 160)
	end
	local cloudZ = -120 - rng:NextNumber(0, 60)
	while cloudZ > -length - 80 do
		local cloudSide = if rng:NextNumber() < 0.5 then -1 else 1
		addDecor("Cloud", CFrame.new(cloudSide * rng:NextNumber(halfWidth + 40, halfWidth + 130), rng:NextNumber(60, 130), cloudZ), rng:NextNumber(0.8, 1.6))
		if rng:NextNumber() < 0.4 then
			addDecor("Cloud", CFrame.new(-cloudSide * rng:NextNumber(halfWidth + 30, halfWidth + 90), rng:NextNumber(-80, -50), cloudZ - 60), rng:NextNumber(1, 1.8))
		end
		cloudZ -= rng:NextNumber(150, 230)
	end

	-- 7) Гонг Эволюции (диск смотрит на старт: ось цилиндра вдоль Z)
	local gongZ = -length
	addPiece("GongBase", CFrame.new(0, -3, gongZ + 10), Vector3.new(76, 6, 60), BLOCK)
	addPiece("Foundation", CFrame.new(0, -13, gongZ + 10), Vector3.new(80, 14, 64), BLOCK)
	addPiece("FoundationDeep", CFrame.new(0, -27, gongZ + 10), Vector3.new(56, 14, 44), BLOCK)
	addPiece("GongFrame", CFrame.new(-21, 24, gongZ - 8), Vector3.new(4, 48, 4), BLOCK)
	addPiece("GongFrame", CFrame.new(21, 24, gongZ - 8), Vector3.new(4, 48, 4), BLOCK)
	addPiece("GongFrame", CFrame.new(0, 49, gongZ - 8), Vector3.new(46, 4, 4), BLOCK)
	local gongCFrame = CFrame.new(0, 24, gongZ - 8) * CFrame.Angles(0, math.rad(90), 0)
	addPiece("GongDisc", gongCFrame, Vector3.new(2.6, 34, 34), CYLINDER)
	addPiece("GongSign", CFrame.new(0, 58, gongZ - 8), Vector3.new(46, 10, 1), BLOCK)

	return {
		LocationId = locationId,
		Tier = tier,
		Seed = seed,
		Length = length,
		Pieces = pieces,
		Obstacles = obstacles,
		Rings = rings,
		Gaps = gaps,
		GongLocalCFrame = gongCFrame,
	}
end

-- ── Построение деталей ─────────────────────────────────────────────────────

local function makePart(name: string, shape: Enum.PartType, size: Vector3, cframe: CFrame, look: LevelConfig.MaterialColor): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape -- форму ставим до размера: Ball принудительно делает размер равным
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.CanCollide = true
	part.CanQuery = true
	part.CanTouch = false
	part.Material = look.Material
	part.Color = look.Color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function makeDecor(
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	cframe: CFrame,
	look: LevelConfig.MaterialColor,
	parent: Instance
): Part
	local part = makePart(name, shape, size, cframe, look)
	part.CanCollide = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = parent
	return part
end

local function neon(color: Color3): LevelConfig.MaterialColor
	return { Color = color, Material = NEON }
end

local function lookFor(kind: string, theme: LevelConfig.Theme, strength: string?): LevelConfig.MaterialColor
	if kind == "Floor" or kind == "GongBase" or kind == "StartPad" then
		return theme.Floor
	elseif kind == "Stripe" then
		return theme.Stripe
	elseif kind == "Rail" then
		return theme.Rail
	elseif kind == "Post" or kind == "Arch" or kind == "GatePillar" then
		return theme.Post
	elseif kind == "Ring" then
		return theme.Ring
	elseif kind == "Bumper" or kind == "BumperBall" then
		return theme.Bumper
	elseif kind == "Island" then
		return theme.Island
	elseif kind == "GongFrame" or kind == "GongSign" or kind == "StartSign" or kind == "GateArch" or kind == "GateSign" then
		return theme.GongFrame
	elseif kind == "GongDisc" then
		return theme.Gong
	elseif kind == "Chest" then
		return theme.ChestBody
	elseif kind == "Wall" then
		return theme.Walls[strength or "Soft"] or theme.Walls.Soft
	elseif kind == "Foundation" then
		return theme.Rock
	elseif kind == "FoundationDeep" or kind == "RockSpike" then
		return theme.RockDark
	elseif kind == "Girder" then
		return theme.Girder
	elseif kind == "Chevron" then
		return theme.Chevron
	elseif kind == "BridgeDeck" or kind == "BridgeRail" or kind == "BridgePost" then
		return theme.Bridge
	elseif kind == "BridgePlank" then
		return { Color = theme.Bridge.Color:Lerp(Color3.new(0, 0, 0), 0.35), Material = theme.Bridge.Material }
	elseif kind == "GateNeon" or kind == "BoostRing" then
		return neon(theme.GateNeon)
	end
	return theme.Floor
end

local function attachSign(part: BasePart, text: string, theme: LevelConfig.Theme, face: Enum.NormalId, neonStyle: boolean)
	local existing = part:FindFirstChild("SignGui")
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 36
	gui.LightInfluence = 0
	gui.Brightness = if neonStyle then 2.2 else 1.4

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = if neonStyle then theme.GateNeon:Lerp(Color3.new(1, 1, 1), 0.55) else theme.SignText
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = if neonStyle then 4 else 5
	stroke.Color = if neonStyle then theme.GateNeon else theme.SignStroke
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label

	gui.Parent = part
end

function LevelBuilder.GongSignText(tier: number): string
	local speed, combo = LevelConfig.GongRequirement(tier)
	return string.format(
		"ГОНГ ЭВОЛЮЦИИ  ·  %s → %s\nСКОРОСТЬ ≥ %d   ·   КОМБО ≥ %d",
		LevelConfig.TierName(tier),
		LevelConfig.TierName(tier + 1),
		math.floor(speed),
		combo
	)
end

function LevelBuilder.GateSignText(ownerName: string, tier: number, bestSpeed: number): string
	return string.format("%s  •  %s  •  РЕКОРД %d st/s", ownerName, LevelConfig.TierName(tier), math.floor(bestSpeed + 0.5))
end

local START_SIGN_TEXT = "ЛКМ / ПКМ — выстрелить левой / правой рукой\n"
	.. "Держи на земле — натянуть рогатку, отпусти — ПОЛЁТ\n"
	.. "Держи в воздухе — резинка тянет к точке\n"
	.. "ПРОБЕЛ в полёте — пружинный шар • кольца = BOOST\n"
	.. "Бей стены, сундуки и пиньяты • TAB / ALT — меню"

local function buildToy(toy: ToyModels.Toy, cframe: CFrame, parent: Instance, localZ: number): BasePart
	ToyModels.Place(toy, cframe)
	toy.Model:SetAttribute("LocalZ", localZ)
	toy.Model.Parent = parent
	local primary = toy.Model.PrimaryPart
	if primary == nil then
		error("ToyModels вернул модель без PrimaryPart")
	end
	return primary
end

function LevelBuilder.BuildPiece(spec: PieceSpec, context: BuildContext, parent: Instance): BasePart
	local kind = spec.Kind
	local theme = context.Theme
	local world = context.Origin * spec.LocalCFrame
	local localZ = spec.LocalCFrame.Position.Z

	-- Составной декор окружения — модельки ToyModels (без коллизий)
	if kind == "DecorIsland" or kind == "Cloud" or kind == "DecorRing" then
		local rng = Random.new(spec.Seed or 1)
		local scale = spec.Scale or 1
		if kind == "Cloud" then
			return buildToy(ToyModels.Cloud(scale, theme.Cloud.Color, rng), world, parent, localZ)
		elseif kind == "DecorRing" then
			return buildToy(ToyModels.Ring(scale, theme.GateNeon, 16), world, parent, localZ)
		end
		local island = ToyModels.Island(9 * scale, theme.Floor.Color, theme.Rock.Color, theme.RockDark.Color)
		for index = 1, rng:NextInteger(1, 3) do
			local tree = ToyModels.Tree(0.7 * scale, theme.Trunk.Color, theme.Trunk.Material, theme.Leaves.Color, theme.Leaves.Material, rng)
			local angle = index * 2.1 + rng:NextNumber()
			ToyModels.Attach(island, tree, CFrame.new(math.cos(angle) * 4 * scale, 0, math.sin(angle) * 4 * scale))
		end
		return buildToy(island, world, parent, localZ)
	end

	local part = makePart(kind, spec.Shape, spec.Size, world, lookFor(kind, theme, nil))
	part:SetAttribute("PieceKind", kind)
	part:SetAttribute("LocalZ", localZ)
	if kind == "Stripe" or kind == "Chevron" then
		part.CanCollide = false
		part.CanQuery = false
		part.CastShadow = false
	elseif kind == "Foundation" or kind == "FoundationDeep" or kind == "RockSpike" or kind == "Girder" then
		-- основание под полом — визуальная масса, не мешает запросам и физике
		part.CanCollide = false
		part.CanQuery = false
	elseif kind == "Rail" or kind == "Bumper" or kind == "BumperBall" then
		part:AddTag(Tags.Bouncy)
	elseif kind == "Ring" then
		part:AddTag(Tags.GrabPoint)
		part.CastShadow = false
	elseif kind == "Arch" then
		part:AddTag(Tags.GrabPoint)
	elseif kind == "BoostRing" then
		-- невидимый «диск-триггер» + светящийся обод из сегментов; пролёт считают клиент и сервер геометрически
		part.Transparency = 1
		part.CanCollide = false
		part.CanQuery = false
		part.CastShadow = false
		part.CFrame = world * CFrame.Angles(0, math.rad(90), 0) -- ось цилиндра (X) вдоль оси полосы
		part:AddTag(Tags.BoostRing)
		part:SetAttribute("RingId", string.format("R%d-%d", context.Tier, spec.Seed or 0))
		part:SetAttribute("Radius", spec.Scale or LevelConfig.BoostRing.Radius)
		part:SetAttribute("OwnerUserId", context.OwnerUserId)
		local radius = spec.Scale or LevelConfig.BoostRing.Radius
		local ring = ToyModels.Ring(radius, theme.GateNeon, 18)
		ToyModels.Place(ring, world)
		for _, segment in ring.Model:GetChildren() do
			segment.Parent = part
		end
		ring.Model:Destroy()
		makeDecor("Glow", CYLINDER, Vector3.new(0.3, radius * 2 - 1, radius * 2 - 1), world * CFrame.Angles(0, math.rad(90), 0), neon(theme.GateNeon), part).Transparency = 0.82
	elseif kind == "GongDisc" then
		part:AddTag(Tags.Gong)
		part:SetAttribute("GongLaneSlot", context.Slot)
		part:SetAttribute("OwnerUserId", context.OwnerUserId)
		-- Локальная −X диска смотрит на старт: туда кладём светящееся «яблочко»
		makeDecor("Bullseye", CYLINDER, Vector3.new(0.6, 22, 22), part.CFrame * CFrame.new(-1.4, 0, 0), theme.Ring, part)
	elseif kind == "GongSign" then
		part.CanQuery = false
		attachSign(part, LevelBuilder.GongSignText(context.Tier), theme, Enum.NormalId.Back, false)
	end
	part.Parent = parent
	return part
end

local function buildPinataDecor(part: BasePart, theme: LevelConfig.Theme)
	local cframe = part.CFrame
	local radius = part.Size.X * 0.5
	local gold: LevelConfig.MaterialColor = { Color = Color3.fromRGB(255, 206, 50), Material = Enum.Material.Foil }
	-- пять лучей звезды в плоскости, обращённой к старту
	for index = 1, 5 do
		local angle = index / 5 * math.pi * 2
		local direction = Vector3.new(math.sin(angle), math.cos(angle), 0)
		local tipCFrame = cframe * ToyModels.AxisFrame(direction * (radius + 1.2), direction)
		makeDecor("Point", Enum.PartType.Wedge, Vector3.new(3, 1.2, 2.2), tipCFrame, gold, part)
	end
	-- бумажные «оборки»: три неоновых пояса
	for index, color in { Color3.fromRGB(255, 90, 170), Color3.fromRGB(80, 220, 255), Color3.fromRGB(150, 255, 90) } do
		makeDecor("Frill", CYLINDER, Vector3.new(0.5, radius * 2 + 0.5, radius * 2 + 0.5), cframe * CFrame.new(0, (index - 2) * 1.5, 0) * CFrame.Angles(0, 0, math.pi / 2), neon(color), part)
	end
	-- мордочка
	for _, side in { -1, 1 } do
		makeDecor("Eye", BALL, Vector3.one * 1.1, cframe * CFrame.new(side * 0.9, 0.6, radius - 0.2), { Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic }, part)
		makeDecor("Pupil", BALL, Vector3.one * 0.55, cframe * CFrame.new(side * 0.9, 0.55, radius + 0.25), { Color = Color3.fromRGB(28, 32, 56), Material = Enum.Material.SmoothPlastic }, part)
	end
	makeDecor("Glow", BALL, Vector3.one * (radius * 2 + 2.4), cframe, { Color = theme.GateNeon, Material = Enum.Material.ForceField }, part).Transparency = 0.3
end

function LevelBuilder.BuildObstacle(spec: ObstacleSpec, context: BuildContext, parent: Instance): BasePart
	local look = if spec.Kind == "Pinata" then { Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Foil } else lookFor(spec.Kind, context.Theme, spec.Strength)
	local shape = if spec.Kind == "Pinata" then BALL else BLOCK
	local part = makePart(spec.Kind, shape, spec.Size, context.Origin * spec.LocalCFrame, look)
	part:AddTag(Tags.Smashable)
	part:SetAttribute("ObstacleId", spec.Id)
	part:SetAttribute("ObstacleKind", spec.Kind)
	part:SetAttribute("Strength", spec.Strength)
	part:SetAttribute("Durability", spec.Durability)
	part:SetAttribute("RequiredSpeed", spec.RequiredSpeed)
	part:SetAttribute("Loot", spec.Loot)
	part:SetAttribute("LaneSlot", context.Slot)
	part:SetAttribute("OwnerUserId", context.OwnerUserId)
	part:SetAttribute("LocalZ", spec.LocalCFrame.Position.Z)

	if spec.Kind == "Chest" then
		local size = spec.Size
		local trim = context.Theme.ChestTrim
		makeDecor("Lid", BLOCK, Vector3.new(size.X + 0.4, 1.4, size.Z + 0.4), part.CFrame * CFrame.new(0, size.Y * 0.5 + 0.7, 0), look, part)
		for _, x in { -size.X * 0.32, size.X * 0.32 } do
			makeDecor("Band", BLOCK, Vector3.new(0.7, size.Y + 1.6, size.Z + 0.25), part.CFrame * CFrame.new(x, 0.7, 0), trim, part)
		end
		makeDecor("Lock", BLOCK, Vector3.new(1.4, 1.6, 0.6), part.CFrame * CFrame.new(0, size.Y * 0.2, -size.Z * 0.5 - 0.3), trim, part)
		makeDecor("Lock", BLOCK, Vector3.new(1.4, 1.6, 0.6), part.CFrame * CFrame.new(0, size.Y * 0.2, size.Z * 0.5 + 0.3), trim, part)
	elseif spec.Kind == "Pinata" then
		local motion = spec.Motion
		if motion then
			part:AddTag(Tags.Pinata)
			part:SetAttribute("BaseCFrame", part.CFrame)
			part:SetAttribute("Amplitude", motion.Amplitude)
			part:SetAttribute("Frequency", motion.Frequency)
			part:SetAttribute("Phase", motion.Phase)
		end
		buildPinataDecor(part, context.Theme)
	end

	part.Parent = parent
	return part
end

local function buildGate(context: BuildContext, static: Folder): BasePart
	local origin = context.Origin
	local theme = context.Theme
	local halfWidth = LevelConfig.LaneWidth / 2
	local gateZ = -30
	for _, side in { -1, 1 } do
		local pillar = makeDecor("GatePillar", CYLINDER, Vector3.new(40, 4.6, 4.6), origin * CFrame.new(side * (halfWidth + 5), 20, gateZ) * CFrame.Angles(0, 0, math.pi / 2), lookFor("GatePillar", theme, nil), static)
		pillar:SetAttribute("PieceKind", "GatePillar")
		local cap = makeDecor("GateNeon", BALL, Vector3.one * 5.6, origin * CFrame.new(side * (halfWidth + 5), 41.5, gateZ), lookFor("GateNeon", theme, nil), static)
		cap:SetAttribute("PieceKind", "GateNeon")
	end
	local arch = makeDecor("GateArch", BLOCK, Vector3.new(LevelConfig.LaneWidth + 16, 5, 5), origin * CFrame.new(0, 43, gateZ), lookFor("GateArch", theme, nil), static)
	arch:SetAttribute("PieceKind", "GateArch")
	for _, y in { 40.2, 45.8 } do
		local strip = makeDecor("GateNeon", BLOCK, Vector3.new(LevelConfig.LaneWidth + 12, 0.7, 5.4), origin * CFrame.new(0, y, gateZ), lookFor("GateNeon", theme, nil), static)
		strip:SetAttribute("PieceKind", "GateNeon")
	end
	local sign = makeDecor("GateSign", BLOCK, Vector3.new(LevelConfig.LaneWidth - 18, 8, 0.8), origin * CFrame.new(0, 34.5, gateZ), lookFor("GateSign", theme, nil), static)
	sign:SetAttribute("PieceKind", "GateSign")
	attachSign(sign, LevelBuilder.GateSignText(context.OwnerName, context.Tier, context.BestSpeed), theme, Enum.NormalId.Back, true)
	return sign
end

-- Мост от стартовой площадки к краю хаба (локальная +Z полосы смотрит на хаб)
local function buildBridge(context: BuildContext, static: Folder)
	local origin = context.Origin
	local theme = context.Theme
	local hub = LevelConfig.Hub
	local startZ = LevelConfig.StartPadSize.Z * 0.5 - 1
	local endZ = hub.LaneStartRadius - hub.Radius + 4
	local length = endZ - startZ
	local centerZ = (startZ + endZ) * 0.5
	local deck = makePart("BridgeDeck", BLOCK, Vector3.new(16, 2, length), origin * CFrame.new(0, -1, centerZ), lookFor("BridgeDeck", theme, nil))
	deck:SetAttribute("PieceKind", "BridgeDeck")
	deck.Parent = static
	local plankZ = startZ + 4
	while plankZ < endZ - 2 do
		local plank = makeDecor("BridgePlank", BLOCK, Vector3.new(16.4, 0.3, 0.6), origin * CFrame.new(0, 0.05, plankZ), lookFor("BridgePlank", theme, nil), static)
		plank:SetAttribute("PieceKind", "BridgePlank")
		plankZ += 6
	end
	for _, side in { -1, 1 } do
		local postZ = startZ + 2
		while postZ <= endZ do
			local post = makeDecor("BridgePost", CYLINDER, Vector3.new(5, 0.9, 0.9), origin * CFrame.new(side * 8, 2.5, postZ) * CFrame.Angles(0, 0, math.pi / 2), lookFor("BridgePost", theme, nil), static)
			post:SetAttribute("PieceKind", "BridgePost")
			postZ += 12
		end
		local rope = makePart("BridgeRail", CYLINDER, Vector3.new(length, 0.7, 0.7), origin * CFrame.new(side * 8, 4.6, centerZ) * CFrame.Angles(0, math.rad(90), 0), lookFor("BridgeRail", theme, nil))
		rope:SetAttribute("PieceKind", "BridgeRail")
		rope:AddTag(Tags.GrabPoint)
		rope.Parent = static
	end
end

function LevelBuilder.CreateLane(layout: LaneLayout, context: BuildContext, parent: Instance): LaneHandles
	local model = Instance.new("Model")
	model.Name = "Lane_" .. context.Slot
	model:SetAttribute("LaneSlot", context.Slot)
	model:SetAttribute("OwnerUserId", context.OwnerUserId)
	model:SetAttribute("Tier", layout.Tier)

	local static = Instance.new("Folder")
	static.Name = "Static"
	static.Parent = model
	local mutable = Instance.new("Folder")
	mutable.Name = "Mutable"
	mutable.Parent = model
	local obstacleFolder = Instance.new("Folder")
	obstacleFolder.Name = "Obstacles"
	obstacleFolder.Parent = model

	local padSize = LevelConfig.StartPadSize
	local startPad = makePart("StartPad", BLOCK, padSize, context.Origin * CFrame.new(0, -padSize.Y * 0.5, 0), context.Theme.Floor)
	startPad:SetAttribute("PieceKind", "StartPad")
	startPad.Parent = static
	local padRock = makeDecor("Foundation", BLOCK, padSize + Vector3.new(4, 10, 4), context.Origin * CFrame.new(0, -padSize.Y - 5, 0), context.Theme.Rock, static)
	padRock:SetAttribute("PieceKind", "Foundation")

	local startSign = makePart(
		"StartSign",
		BLOCK,
		Vector3.new(26, 14, 1),
		context.Origin * CFrame.new(-24, 11, -14) * CFrame.Angles(0, math.rad(40), 0),
		context.Theme.GongFrame
	)
	startSign:SetAttribute("PieceKind", "StartSign")
	startSign.CanQuery = false
	attachSign(startSign, START_SIGN_TEXT, context.Theme, Enum.NormalId.Back, false)
	startSign.Parent = static

	local gateSign = buildGate(context, static)
	buildBridge(context, static)

	local gong: BasePart? = nil
	for _, spec in layout.Pieces do
		local part = LevelBuilder.BuildPiece(spec, context, mutable)
		if spec.Kind == "GongDisc" then
			gong = part
		end
	end

	local obstacles: { [string]: BasePart } = {}
	for _, spec in layout.Obstacles do
		obstacles[spec.Id] = LevelBuilder.BuildObstacle(spec, context, obstacleFolder)
	end

	model.Parent = parent
	return {
		Model = model,
		Static = static,
		Mutable = mutable,
		ObstacleFolder = obstacleFolder,
		StartPad = startPad,
		StartSign = startSign,
		GateSign = gateSign,
		Gong = gong,
		Obstacles = obstacles,
	}
end

-- Перекраска статичных деталей (старт, ворота, мост) под новый тир.
function LevelBuilder.ApplyTheme(part: BasePart, theme: LevelConfig.Theme)
	local kind = part:GetAttribute("PieceKind")
	if typeof(kind) ~= "string" then
		return
	end
	local look = lookFor(kind, theme, nil)
	part.Color = look.Color
	part.Material = look.Material
	if kind == "StartSign" then
		attachSign(part, START_SIGN_TEXT, theme, Enum.NormalId.Back, false)
	end
end

-- Пересоздать вывеску в стиле нового тира (после волны перерождения)
function LevelBuilder.RefreshGateSign(sign: BasePart, text: string, theme: LevelConfig.Theme)
	attachSign(sign, text, theme, Enum.NormalId.Back, true)
end

function LevelBuilder.UpdateGateSign(sign: BasePart, text: string)
	local gui = sign:FindFirstChild("SignGui")
	local label = if gui then gui:FindFirstChild("Text") else nil
	if label and label:IsA("TextLabel") and label.Text ~= text then
		label.Text = text
	end
end

function LevelBuilder.StartCFrame(slot: number): CFrame
	local origin = LevelConfig.SlotOrigin(slot)
	local position = origin:PointToWorldSpace(LevelConfig.SpawnOffset)
	return CFrame.lookAt(position, position + origin.LookVector)
end

function LevelBuilder.HubSpawnCFrame(slot: number): CFrame
	return LevelConfig.HubSpawn(slot)
end

return LevelBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">LobbyBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · LobbyBuilder: хаб Sky Plaza в центре веера полос.
-- Полосы уходят от хаба наружу (углы −80°…+80° в −Z половине мира), их мосты причаливают
-- к краю острова. Задняя (+Z) половина — площадь отдыха: Капсульная площадь с тремя
-- автоматами-гачей и Подиум чемпионов с кубками и тремя табло лидеров.
--
-- Уровни: травяной диск-остров (верх Y = 0) → кольцевые ступени → центральная терраса
-- (Y = 6) с фонтаном и гигантской рогаткой-монументом. Снизу — многоярусное скальное
-- основание с валунами, вокруг — парящие островки с деревьями, облака и неоновые кольца.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local LevelConfig = require(Shared.Config.LevelConfig)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local BuddyConfig = require(Shared.Config.BuddyConfig)
local ToyModels = require(Shared.Visual.ToyModels)

export type BoardKind = "Speed" | "Combo" | "Rebirths"

export type SlotGate = {
	Barrier: BasePart, -- светящаяся завеса: закрыта, пока у слота нет полосы
	Sign: BasePart, -- табличка над входом «ПОЛОСА • Ник» / «СВОБОДНО»
}

export type LobbyHandles = {
	Model: Model,
	Machines: { [string]: BasePart }, -- capsuleId → корпус автомата (ProximityPrompt + тег)
	Boards: { [BoardKind]: BasePart }, -- экраны табло (SurfaceGui вешает LeaderboardService)
	PodiumTops: { CFrame }, -- верх ступеней подиума: 1-е, 2-е, 3-е место
	SlotGates: { [number]: SlotGate },
}

local RGB = Color3.fromRGB
local BLOCK = Enum.PartType.Block
local BALL = Enum.PartType.Ball
local CYLINDER = Enum.PartType.Cylinder
local WEDGE = Enum.PartType.Wedge
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local FONT = Enum.Font.FredokaOne

local Palette = {
	Grass = RGB(118, 214, 104),
	GrassDark = RGB(84, 178, 86),
	Dirt = RGB(176, 124, 86),
	Rock = RGB(150, 128, 114),
	RockDark = RGB(102, 86, 84),
	TileA = RGB(252, 238, 210),
	TileB = RGB(234, 206, 166),
	PathBed = RGB(206, 176, 136),
	Curb = RGB(248, 250, 255),
	Ink = RGB(28, 32, 56),
	LampPost = RGB(62, 68, 108),
	LampLight = RGB(255, 236, 170),
	Blue = RGB(66, 136, 255),
	Gold = RGB(255, 196, 40),
	Silver = RGB(206, 218, 236),
	Bronze = RGB(214, 132, 72),
	Water = RGB(110, 198, 255),
	Trunk = RGB(150, 98, 60),
	Leaves = RGB(96, 206, 110),
	Cloud = RGB(250, 252, 255),
}

local Plaza = {
	CapsuleAngle = 150, -- градусы в системе LevelConfig.SlotDirection (0 = вдоль первой полосы)
	PodiumAngle = 210,
	PlazaRadius = 98, -- центр площадки от центра хаба
	PlazaSize = 31,
	PathWidth = 16,
	StepHeight = 1.5,
	TerraceTop = 6,
}

local LobbyBuilder = {}

-- ── Примитивы ───────────────────────────────────────────────────────────────

local function direction(angleDegrees: number): Vector3
	local angle = math.rad(angleDegrees)
	return Vector3.new(math.sin(angle), 0, -math.cos(angle))
end

-- Кадр на земле хаба: позиция по полярным координатам, LookVector — к центру хаба
local function facingCenter(angleDegrees: number, radius: number, y: number): CFrame
	local position = LevelConfig.Hub.Center + direction(angleDegrees) * radius + Vector3.new(0, y, 0)
	local center = Vector3.new(LevelConfig.Hub.Center.X, position.Y, LevelConfig.Hub.Center.Z)
	return CFrame.lookAt(position, center)
end

local function makePart(parent: Instance, name: string, shape: Enum.PartType, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = true
	part.CanQuery = true
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function decor(parent: Instance, name: string, shape: Enum.PartType, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): Part
	local part = makePart(parent, name, shape, size, cframe, color, material)
	part.CanCollide = false
	part.CanQuery = false
	part.CastShadow = false
	return part
end

-- Вертикальный цилиндр (ось Roblox-цилиндра — X, кладём её вверх)
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)

local function disc(parent: Instance, name: string, radius: number, height: number, center: Vector3, color: Color3, material: Enum.Material, solid: boolean): Part
	local size = Vector3.new(height, radius * 2, radius * 2)
	local cframe = CFrame.new(center) * UPRIGHT
	return if solid then makePart(parent, name, CYLINDER, size, cframe, color, material) else decor(parent, name, CYLINDER, size, cframe, color, material)
end

local function addLight(part: BasePart, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = part
end

local function addSurfaceText(part: BasePart, face: Enum.NormalId, text: string, textColor: Color3, strokeColor: Color3, pixelsPerStud: number): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui_" .. face.Name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.Brightness = 1.6
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = FONT
	label.Text = text
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = textColor
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.PaddingTop = UDim.new(0.1, 0)
	padding.PaddingBottom = UDim.new(0.1, 0)
	padding.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Color = strokeColor
	stroke.Thickness = 4
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return label
end

local function addBillboard(part: BasePart, title: string, subtitle: string, color: Color3, offsetY: number, maxDistance: number)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Billboard"
	billboard.Size = UDim2.fromScale(18, 6)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = maxDistance
	billboard.AlwaysOnTop = false
	billboard.Parent = part
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.fromScale(1, 0.62)
	titleLabel.Font = FONT
	titleLabel.Text = title
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = Color3.new(1, 1, 1)
	titleLabel.Parent = billboard
	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Palette.Ink
	titleStroke.Thickness = 3
	titleStroke.Parent = titleLabel
	local subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Position = UDim2.fromScale(0, 0.6)
	subtitleLabel.Size = UDim2.fromScale(1, 0.4)
	subtitleLabel.Font = FONT
	subtitleLabel.Text = subtitle
	subtitleLabel.TextScaled = true
	subtitleLabel.TextColor3 = color
	subtitleLabel.Parent = billboard
	local subtitleStroke = Instance.new("UIStroke")
	subtitleStroke.Color = Palette.Ink
	subtitleStroke.Thickness = 2.5
	subtitleStroke.Parent = subtitleLabel
end

local function placeToy(toy: ToyModels.Toy, cframe: CFrame, parent: Instance): Model
	ToyModels.Place(toy, cframe)
	toy.Model.Parent = parent
	return toy.Model
end

-- ── Остров и уровни ─────────────────────────────────────────────────────────

local function buildIsland(model: Model, rng: Random)
	local hub = LevelConfig.Hub
	local center = hub.Center
	local radius = hub.Radius
	local ground = disc(model, "HubGrass", radius, 4, center + Vector3.new(0, -2, 0), Palette.Grass, SMOOTH, true)
	ground:SetAttribute("PieceKind", "HubGround")
	disc(model, "HubGrassLip", radius + 1.2, 1.4, center + Vector3.new(0, -3.4, 0), Palette.GrassDark, SMOOTH, false)
	disc(model, "HubDirt", radius - 1, 6, center + Vector3.new(0, -7, 0), Palette.Dirt, Enum.Material.Slate, false)

	-- многоярусное скальное основание, сужающееся книзу
	local tiers = { { 0.94, 10, -15 }, { 0.78, 12, -26 }, { 0.6, 12, -37 }, { 0.4, 12, -48 }, { 0.22, 10, -58 } }
	for index, tierInfo in tiers do
		local color = if index % 2 == 1 then Palette.Rock else Palette.RockDark
		disc(model, "HubRock" .. index, radius * tierInfo[1], tierInfo[2], center + Vector3.new(0, tierInfo[3], 0), color, Enum.Material.Slate, false)
	end
	decor(model, "HubRockTip", BALL, Vector3.one * radius * 0.26, CFrame.new(center + Vector3.new(0, -66, 0)), Palette.RockDark, Enum.Material.Rock)

	-- валуны по краю основания — рваный «органический» силуэт
	for index = 1, 16 do
		local angle = index / 16 * 360 + rng:NextNumber(-6, 6)
		local boulderRadius = radius * rng:NextNumber(0.72, 0.9)
		local size = rng:NextNumber(14, 24)
		local position = center + direction(angle) * boulderRadius + Vector3.new(0, rng:NextNumber(-34, -14), 0)
		decor(model, "Boulder", BALL, Vector3.one * size, CFrame.new(position), if index % 3 == 0 then Palette.RockDark else Palette.Rock, Enum.Material.Rock)
	end
	-- свисающие «сталактиты»
	for index = 1, 10 do
		local angle = index / 10 * 360 + 18
		local position = center + direction(angle) * radius * rng:NextNumber(0.3, 0.55) + Vector3.new(0, -62, 0)
		local length = rng:NextNumber(12, 22)
		decor(model, "Stalactite", CYLINDER, Vector3.new(length, 5, 5), CFrame.new(position - Vector3.new(0, length * 0.5, 0)) * UPRIGHT, Palette.RockDark, Enum.Material.Rock)
		decor(model, "StalactiteTip", BALL, Vector3.one * 5, CFrame.new(position - Vector3.new(0, length, 0)), Palette.RockDark, Enum.Material.Rock)
	end

	-- кустики-кочки по траве (между дорожками)
	for index = 1, 26 do
		local angle = rng:NextNumber(0, 360)
		local distance = rng:NextNumber(72, radius - 10)
		local position = center + direction(angle) * distance
		local onLaneAxis = false
		for slot = 1, LevelConfig.MaxSlots do
			if math.abs(((angle - LevelConfig.SlotAngle(slot) + 540) % 360) - 180) < 9 then
				onLaneAxis = true
			end
		end
		local nearPlaza = math.abs(angle - Plaza.CapsuleAngle) < 26 or math.abs(angle - Plaza.PodiumAngle) < 26
		if not onLaneAxis and not nearPlaza then
			local size = rng:NextNumber(3, 5.5)
			decor(model, "Bush", BALL, Vector3.one * size, CFrame.new(position + Vector3.new(0, size * 0.25, 0)), Palette.GrassDark:Lerp(Palette.Leaves, rng:NextNumber()), SMOOTH)
			if index % 4 == 0 then
				decor(model, "Flower", BALL, Vector3.one * 0.9, CFrame.new(position + Vector3.new(0, size * 0.62, 0)), RGB(255, 120, 170), NEON)
			end
		end
	end
end

local function buildTerrace(model: Model)
	local hub = LevelConfig.Hub
	local center = hub.Center
	local stepCount = math.floor(Plaza.TerraceTop / Plaza.StepHeight + 0.5)
	-- круговые ступени: каждая на 1.5 stud выше, гуманоид шагает без прыжка
	for step = 1, stepCount do
		local top = step * Plaza.StepHeight
		local radius = hub.TerraceRadius + (stepCount - step) * 4
		local color = if step == stepCount then Palette.TileA else Palette.Curb:Lerp(Palette.TileB, (stepCount - step) / stepCount)
		local part = disc(model, "TerraceStep" .. step, radius, Plaza.StepHeight, center + Vector3.new(0, top - Plaza.StepHeight * 0.5, 0), color, SMOOTH, true)
		part:SetAttribute("PieceKind", "Terrace")
	end
	local top = Plaza.TerraceTop
	-- узор плитки на террасе: два концентрических кольца
	disc(model, "TerraceInlay", hub.TerraceRadius - 6, 0.12, center + Vector3.new(0, top + 0.06, 0), Palette.TileB, SMOOTH, false)
	disc(model, "TerraceInlayInner", hub.TerraceRadius - 10, 0.14, center + Vector3.new(0, top + 0.07, 0), Palette.TileA, SMOOTH, false)
	disc(model, "TerraceTrim", hub.TerraceRadius + 0.3, 0.5, center + Vector3.new(0, top - 0.2, 0), Palette.Blue, NEON, false)

	-- фонтан: бортик, вода, струи
	disc(model, "FountainRim", 17, 2.2, center + Vector3.new(0, top + 1.1, 0), Palette.Curb, SMOOTH, true)
	disc(model, "FountainWater", 15.6, 0.4, center + Vector3.new(0, top + 2.05, 0), Palette.Water, Enum.Material.Glass, false).Transparency = 0.25
	disc(model, "FountainGlow", 15.8, 0.15, center + Vector3.new(0, top + 1.9, 0), Palette.Water, NEON, false).Transparency = 0.5
	for index = 1, 6 do
		local angle = index / 6 * 360
		local spout = center + direction(angle) * 11 + Vector3.new(0, top + 3.5, 0)
		decor(model, "Jet", CYLINDER, Vector3.new(3, 0.8, 0.8), CFrame.new(spout) * UPRIGHT, Palette.Water, NEON).Transparency = 0.35
		decor(model, "JetDrop", BALL, Vector3.one * 1.2, CFrame.new(spout + Vector3.new(0, 1.8, 0)), Palette.Water, NEON).Transparency = 0.2
	end

	-- монумент: гигантская рогатка с неоновым жгутом посреди фонтана
	local monument = ToyModels.Slingshot(RGB(255, 80, 160))
	ToyModels.Scale(monument, 6.5)
	local statue = placeToy(monument, CFrame.new(center + Vector3.new(0, top + 2 + 2.4 * 6.5, 0)) * CFrame.Angles(0, math.pi, 0), model)
	statue.Name = "SlingshotMonument"
	local primary = statue.PrimaryPart
	if primary then
		addBillboard(primary, "SKY PLAZA", "STRETCH-POP", Palette.Gold, 34, 900)
	end

	-- фонари по кромке террасы
	for index = 1, 8 do
		local angle = index / 8 * 360 + 22.5
		local base = center + direction(angle) * (hub.TerraceRadius - 3) + Vector3.new(0, top, 0)
		local post = decor(model, "TerraceLampPost", CYLINDER, Vector3.new(8, 0.9, 0.9), CFrame.new(base + Vector3.new(0, 4, 0)) * UPRIGHT, Palette.LampPost, SMOOTH)
		post.CanCollide = true
		local bulb = decor(model, "TerraceLamp", BALL, Vector3.one * 2.4, CFrame.new(base + Vector3.new(0, 8.8, 0)), Palette.LampLight, NEON)
		decor(model, "TerraceLampCap", CYLINDER, Vector3.new(0.5, 2.8, 2.8), CFrame.new(base + Vector3.new(0, 10.1, 0)) * UPRIGHT, Palette.LampPost, SMOOTH)
		if index % 2 == 0 then
			addLight(bulb, Palette.LampLight, 18, 1.3)
		end
	end
end

-- ── Дорожки, бордюры, фонари ────────────────────────────────────────────────

local function buildLamp(model: Model, position: Vector3, withLight: boolean)
	local post = makePart(model, "LampPost", CYLINDER, Vector3.new(9, 0.8, 0.8), CFrame.new(position + Vector3.new(0, 4.5, 0)) * UPRIGHT, Palette.LampPost, SMOOTH)
	post.CanQuery = false
	decor(model, "LampFoot", CYLINDER, Vector3.new(0.8, 2, 2), CFrame.new(position + Vector3.new(0, 0.4, 0)) * UPRIGHT, Palette.LampPost, SMOOTH)
	local bulb = decor(model, "LampBulb", BALL, Vector3.one * 2.2, CFrame.new(position + Vector3.new(0, 9.6, 0)), Palette.LampLight, NEON)
	decor(model, "LampCap", CYLINDER, Vector3.new(0.45, 2.6, 2.6), CFrame.new(position + Vector3.new(0, 10.8, 0)) * UPRIGHT, Palette.LampPost, SMOOTH)
	if withLight then
		addLight(bulb, Palette.LampLight, 16, 1.2)
	end
end

-- Плиточная дорожка от fromRadius до toRadius по лучу angle
local function buildPath(model: Model, angleDegrees: number, fromRadius: number, toRadius: number, lamps: boolean)
	local center = LevelConfig.Hub.Center
	local dir = direction(angleDegrees)
	local right = dir:Cross(Vector3.yAxis).Unit
	local length = toRadius - fromRadius
	local mid = center + dir * (fromRadius + length * 0.5)
	local frame = CFrame.lookAt(mid, mid + dir)
	local width = Plaza.PathWidth
	decor(model, "PathBed", BLOCK, Vector3.new(width + 1, 0.3, length), frame * CFrame.new(0, 0.15, 0), Palette.PathBed, SMOOTH)
	local row = 0
	local tileLength = 5.6
	local distance = fromRadius + tileLength * 0.5 + 0.4
	while distance < toRadius - tileLength * 0.5 do
		for column = 0, 1 do
			local offset = (column - 0.5) * (width * 0.5)
			local position = center + dir * distance + right * offset + Vector3.new(0, 0.34, 0)
			local color = if (row + column) % 2 == 0 then Palette.TileA else Palette.TileB
			decor(model, "Tile", BLOCK, Vector3.new(width * 0.5 - 0.5, 0.12, tileLength - 0.5), CFrame.lookAt(position, position + dir), color, SMOOTH)
		end
		row += 1
		distance += tileLength
	end
	for _, side in { -1, 1 } do
		decor(model, "Curb", BLOCK, Vector3.new(1.2, 0.8, length), frame * CFrame.new(side * (width * 0.5 + 0.6), 0.4, 0), Palette.Curb, SMOOTH)
		if lamps then
			local lampDistance = fromRadius + 12
			local index = 0
			while lampDistance < toRadius - 6 do
				index += 1
				buildLamp(model, center + dir * lampDistance + right * side * (width * 0.5 + 3), index % 2 == 1)
				lampDistance += 30
			end
		end
	end
end

-- Бордюр по кромке острова с проёмами под мосты всех слотов
local function buildRim(model: Model)
	local hub = LevelConfig.Hub
	local center = hub.Center
	local radius = hub.Radius - 1
	local gapHalf = math.deg(math.asin((Plaza.PathWidth * 0.5 + 1.5) / radius))
	local segments = 90
	for index = 0, segments - 1 do
		local a0 = index / segments * 360
		local a1 = (index + 1) / segments * 360
		local mid = (a0 + a1) * 0.5
		local blocked = false
		for slot = 1, LevelConfig.MaxSlots do
			local slotAngle = LevelConfig.SlotAngle(slot)
			if math.abs(((mid - slotAngle + 540) % 360) - 180) < gapHalf + 2 then
				blocked = true
			end
		end
		if not blocked then
			local p0 = center + direction(a0) * radius
			local p1 = center + direction(a1) * radius
			local chord = (p1 - p0).Magnitude
			local position = (p0 + p1) * 0.5
			local frame = CFrame.lookAt(position + Vector3.new(0, 1.3, 0), position + Vector3.new(0, 1.3, 0) + (p1 - p0).Unit)
			local curb = makePart(model, "RimCurb", BLOCK, Vector3.new(1.8, 2.6, chord + 0.2), frame, Palette.Curb, SMOOTH)
			curb.CanQuery = true
			decor(model, "RimNeon", BLOCK, Vector3.new(1.9, 0.35, chord + 0.25), frame * CFrame.new(0, 1.35, 0), Palette.Blue, NEON)
		end
	end
end

-- Вход на мост слота: арка с табличкой + завеса, пока полосы нет
local function buildSlotGate(model: Model, slot: number): SlotGate
	local hub = LevelConfig.Hub
	local angle = LevelConfig.SlotAngle(slot)
	local dir = direction(angle)
	local right = dir:Cross(Vector3.yAxis).Unit
	local gateCenter = hub.Center + dir * (hub.Radius - 6)
	local halfWidth = Plaza.PathWidth * 0.5 + 1.6
	for _, side in { -1, 1 } do
		local base = gateCenter + right * side * halfWidth
		local pillar = makePart(model, "GatePillar", CYLINDER, Vector3.new(14, 1.8, 1.8), CFrame.new(base + Vector3.new(0, 7, 0)) * UPRIGHT, Palette.Curb, SMOOTH)
		pillar.CanQuery = false
		decor(model, "GatePillarNeon", BALL, Vector3.one * 2.6, CFrame.new(base + Vector3.new(0, 14.6, 0)), Palette.Gold, NEON)
	end
	local beamFrame = CFrame.lookAt(gateCenter + Vector3.new(0, 13.4, 0), gateCenter + Vector3.new(0, 13.4, 0) - dir)
	decor(model, "GateBeam", BLOCK, Vector3.new(halfWidth * 2 + 2, 1.6, 1.6), beamFrame, Palette.Ink, SMOOTH)
	local sign = decor(model, "SlotSign", BLOCK, Vector3.new(halfWidth * 2 - 1, 3.6, 0.5), beamFrame * CFrame.new(0, -2.6, 0), Palette.Blue, SMOOTH)
	sign:SetAttribute("Slot", slot)
	addSurfaceText(sign, Enum.NormalId.Front, "СВОБОДНО", Color3.new(1, 1, 1), Palette.Ink, 40)
	addSurfaceText(sign, Enum.NormalId.Back, "SKY PLAZA", Color3.new(1, 1, 1), Palette.Ink, 40)

	local barrier = makePart(model, "SlotBarrier", BLOCK, Vector3.new(halfWidth * 2, 10, 0.6), CFrame.lookAt(gateCenter + Vector3.new(0, 5, 0), gateCenter + Vector3.new(0, 5, 0) - dir), Palette.Blue, Enum.Material.ForceField)
	barrier.Transparency = 0.2
	barrier.CastShadow = false
	barrier:SetAttribute("Slot", slot)
	return { Barrier = barrier, Sign = sign }
end

-- ── Капсульная площадь ──────────────────────────────────────────────────────

local function buildPlazaFloor(model: Model, angleDegrees: number, accent: Color3): CFrame
	local frame = facingCenter(angleDegrees, Plaza.PlazaRadius, 0)
	local center = frame.Position
	local floor = disc(model, "PlazaFloor", Plaza.PlazaSize, Plaza.StepHeight, center + Vector3.new(0, Plaza.StepHeight * 0.5, 0), Palette.TileA, SMOOTH, true)
	floor:SetAttribute("PieceKind", "Plaza")
	disc(model, "PlazaRing", Plaza.PlazaSize - 4, 0.12, center + Vector3.new(0, Plaza.StepHeight + 0.06, 0), Palette.TileB, SMOOTH, false)
	disc(model, "PlazaCore", Plaza.PlazaSize - 9, 0.14, center + Vector3.new(0, Plaza.StepHeight + 0.07, 0), Palette.TileA, SMOOTH, false)
	disc(model, "PlazaTrim", Plaza.PlazaSize + 0.4, 0.45, center + Vector3.new(0, Plaza.StepHeight - 0.1, 0), accent, NEON, false)
	return frame + Vector3.new(0, Plaza.StepHeight, 0)
end

local function buildMachine(model: Model, def: BuddyConfig.CapsuleDef, frame: CFrame, rng: Random): BasePart
	-- frame: точка на полу, LookVector — к игроку
	local machine = Instance.new("Model")
	machine.Name = "CapsuleMachine_" .. def.Id
	machine.Parent = model
	local glow = def.GlowColor
	local bodyColor = def.TopColor:Lerp(Palette.Ink, if def.Id == "Void" then 0.55 else 0.12)
	local trim = def.BottomColor

	decor(machine, "Pedestal", CYLINDER, Vector3.new(2, 13, 13), frame * CFrame.new(0, 1, 0) * UPRIGHT, trim, SMOOTH).CanCollide = true
	decor(machine, "PedestalNeon", CYLINDER, Vector3.new(0.4, 13.5, 13.5), frame * CFrame.new(0, 2.1, 0) * UPRIGHT, glow, NEON)
	local body = makePart(machine, "Body", BLOCK, Vector3.new(9, 9, 9), frame * CFrame.new(0, 6.5, 0), bodyColor, SMOOTH)
	body:AddTag(PhysicsConfig.Tags.CapsuleMachine)
	body:SetAttribute("CapsuleId", def.Id)
	body:SetAttribute("Price", def.Price)
	-- лицевая панель (−Z модели = LookVector = к игроку)
	decor(machine, "Panel", BLOCK, Vector3.new(7, 6.2, 0.4), frame * CFrame.new(0, 6.9, -4.6), Palette.Ink, SMOOTH)
	decor(machine, "CoinSlot", BLOCK, Vector3.new(0.5, 1.6, 0.3), frame * CFrame.new(2.2, 8.4, -4.85), glow, NEON)
	decor(machine, "Knob", CYLINDER, Vector3.new(0.6, 2.6, 2.6), frame * CFrame.new(-0.9, 8.1, -4.9) * CFrame.Angles(0, math.pi / 2, 0), trim, SMOOTH)
	decor(machine, "KnobGrip", BLOCK, Vector3.new(0.35, 2.2, 0.5), frame * CFrame.new(-0.9, 8.1, -5.3), Palette.Ink, SMOOTH)
	decor(machine, "Chute", BLOCK, Vector3.new(3.2, 2.2, 0.6), frame * CFrame.new(0, 4.4, -4.85), RGB(10, 12, 24), SMOOTH)
	decor(machine, "ChuteFlap", BLOCK, Vector3.new(3, 0.4, 0.7), frame * CFrame.new(0, 5.5, -4.9), glow, NEON)
	for _, side in { -1, 1 } do
		decor(machine, "SideStripe", BLOCK, Vector3.new(0.3, 9.2, 1.2), frame * CFrame.new(side * 4.55, 6.5, -3.4), glow, NEON)
	end
	-- купол с капсулами
	decor(machine, "DomeRim", CYLINDER, Vector3.new(1, 11, 11), frame * CFrame.new(0, 11.5, 0) * UPRIGHT, Palette.Silver, Enum.Material.Metal)
	local dome = decor(machine, "Dome", BALL, Vector3.one * 11.6, frame * CFrame.new(0, 15.4, 0), RGB(224, 242, 255), Enum.Material.Glass)
	dome.Transparency = 0.62
	for index = 1, 7 do
		local capsule = ToyModels.Capsule(def.Id)
		ToyModels.Scale(capsule, 1.05)
		local angle = index / 7 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local spread = if index == 7 then 0 else 2.6
		local local_ = CFrame.new(math.cos(angle) * spread, 13.4 + (if index == 7 then 2.4 else rng:NextNumber(0, 0.8)), math.sin(angle) * spread)
			* CFrame.Angles(rng:NextNumber(-0.8, 0.8), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.8, 0.8))
		placeToy(capsule, frame * local_, machine)
	end
	local crown = decor(machine, "Crown", BALL, Vector3.one * 3, frame * CFrame.new(0, 21.6, 0), glow, NEON)
	addLight(crown, glow, 22, 2)
	decor(machine, "CrownBase", CYLINDER, Vector3.new(0.8, 4, 4), frame * CFrame.new(0, 20.6, 0) * UPRIGHT, Palette.Silver, Enum.Material.Metal)

	addBillboard(body, def.DisplayName, string.format("%d монет", def.Price), glow, 13, 140)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HatchPrompt"
	prompt.ActionText = "Открыть капсулу"
	prompt.ObjectText = string.format("%s • %d", def.DisplayName, def.Price)
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 13
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = body
	return body
end

local function buildCapsulePlaza(model: Model, rng: Random): { [string]: BasePart }
	local plaza = Instance.new("Model")
	plaza.Name = "CapsulePlaza"
	plaza.Parent = model
	local frame = buildPlazaFloor(plaza, Plaza.CapsuleAngle, RGB(170, 110, 255))
	local machines: { [string]: BasePart } = {}
	local order = { "Basic", "Golden", "Void" }
	for index, capsuleId in order do
		local def = BuddyConfig.Capsules[capsuleId]
		if def then
			-- дуга из трёх автоматов на дальней стороне площади, все смотрят на вход
			local offset = (index - 2) * 17
			local depth = -(math.abs(index - 2) * 4) + 12
			local spot = (frame * CFrame.new(offset, 0, depth)).Position
			-- лицом (LookVector = передняя панель) ко входу на площадь со стороны террасы
			local target = frame.Position + frame.LookVector * 24
			machines[capsuleId] = buildMachine(plaza, def, CFrame.lookAt(spot, Vector3.new(target.X, spot.Y, target.Z)), rng)
		end
	end
	local signPost = frame * CFrame.new(0, 0, 26)
	local board = decor(plaza, "PlazaSign", BLOCK, Vector3.new(30, 6, 0.8), signPost * CFrame.new(0, 27, 0) * CFrame.Angles(0, math.pi, 0), RGB(150, 90, 255), SMOOTH)
	addSurfaceText(board, Enum.NormalId.Back, "КАПСУЛЬНАЯ ПЛОЩАДЬ", Color3.new(1, 1, 1), Palette.Ink, 30)
	addSurfaceText(board, Enum.NormalId.Front, "КАПСУЛЬНАЯ ПЛОЩАДЬ", Color3.new(1, 1, 1), Palette.Ink, 30)
	for _, side in { -1, 1 } do
		decor(plaza, "PlazaSignPost", CYLINDER, Vector3.new(27, 1.2, 1.2), signPost * CFrame.new(side * 13, 13.5, 0) * UPRIGHT, Palette.Ink, SMOOTH)
	end
	return machines
end

-- ── Подиум чемпионов ────────────────────────────────────────────────────────

local function buildPodium(model: Model): ({ [BoardKind]: BasePart }, { CFrame })
	local podium = Instance.new("Model")
	podium.Name = "ChampionsPodium"
	podium.Parent = model
	local frame = buildPlazaFloor(podium, Plaza.PodiumAngle, Palette.Gold)

	-- ступени: 1-е место по центру и выше всех, 2-е слева, 3-е справа (с точки зрения смотрящего)
	local steps = {
		{ Place = 1, Offset = 0, Height = 8, Color = Palette.Gold, Label = "1" },
		{ Place = 2, Offset = -9.5, Height = 5.5, Color = Palette.Silver, Label = "2" },
		{ Place = 3, Offset = 9.5, Height = 3.5, Color = Palette.Bronze, Label = "3" },
	}
	local tops: { CFrame } = {}
	for _, info in steps do
		-- frame смотрит на центр хаба; подиум «лицом» к центру → смотрящий стоит у −Z/LookVector
		local base = frame * CFrame.new(-info.Offset, 0, 2)
		local block = makePart(podium, "PodiumStep" .. info.Place, BLOCK, Vector3.new(9, info.Height, 9), base * CFrame.new(0, info.Height * 0.5, 0), Palette.Curb, SMOOTH)
		decor(podium, "PodiumTrim", BLOCK, Vector3.new(9.3, 0.6, 9.3), base * CFrame.new(0, info.Height - 0.2, 0), info.Color, NEON)
		local label = decor(podium, "PodiumNumber", BLOCK, Vector3.new(5, 4, 0.3), base * CFrame.new(0, info.Height * 0.5, -4.65), info.Color, SMOOTH)
		addSurfaceText(label, Enum.NormalId.Front, info.Label, Color3.new(1, 1, 1), Palette.Ink, 40)
		local trophy = ToyModels.Trophy(info.Color)
		ToyModels.Scale(trophy, if info.Place == 1 then 2.2 else 1.8)
		placeToy(trophy, base * CFrame.new(0, info.Height + 1.8 * (if info.Place == 1 then 2.2 else 1.8), 2.2), podium)
		local glow = decor(podium, "TrophyGlow", BALL, Vector3.one * 1.2, base * CFrame.new(0, info.Height + 9, 2.2), info.Color, NEON)
		glow.Transparency = 0.6
		addLight(glow, info.Color, 14, 1.6)
		tops[info.Place] = base * CFrame.new(0, info.Height, -1.5)
		block:SetAttribute("PodiumPlace", info.Place)
	end

	-- три табло полукругом за подиумом
	local boards: { [BoardKind]: BasePart } = {}
	local boardInfo: { { Kind: BoardKind, Offset: number, Yaw: number, Accent: Color3 } } = {
		{ Kind = "Speed", Offset = -25, Yaw = -22, Accent = Palette.Blue },
		{ Kind = "Combo", Offset = 0, Yaw = 0, Accent = RGB(255, 90, 150) },
		{ Kind = "Rebirths", Offset = 25, Yaw = 22, Accent = Palette.Gold },
	}
	for _, info in boardInfo do
		local base = frame * CFrame.new(-info.Offset, 0, 17 - math.abs(info.Offset) * 0.28) * CFrame.Angles(0, math.rad(-info.Yaw), 0)
		for _, side in { -1, 1 } do
			makePart(podium, "BoardLeg", CYLINDER, Vector3.new(8, 1.4, 1.4), base * CFrame.new(side * 8, 4, 0.6) * UPRIGHT, Palette.Ink, SMOOTH).CanQuery = false
		end
		decor(podium, "BoardUnderlay", BLOCK, Vector3.new(23.4, 27.4, 1), base * CFrame.new(0, 21.6, 1.2), RGB(195, 206, 230), SMOOTH)
		decor(podium, "BoardFrame", BLOCK, Vector3.new(22.6, 26.6, 1.1), base * CFrame.new(0, 22, 0.8), Palette.Ink, SMOOTH)
		local screen = decor(podium, "Board_" .. info.Kind, BLOCK, Vector3.new(21, 25, 0.4), base * CFrame.new(0, 22, 0.15), RGB(248, 250, 255), SMOOTH)
		screen:SetAttribute("BoardKind", info.Kind)
		local cap = decor(podium, "BoardCap", BLOCK, Vector3.new(23.6, 1, 1.6), base * CFrame.new(0, 35.4, 0.8), info.Accent, NEON)
		addLight(cap, info.Accent, 20, 1.4)
		boards[info.Kind] = screen
	end

	-- арка-баннер над входом на подиум (проход под ней свободен)
	local signFrame = frame * CFrame.new(0, 15, -20)
	local sign = decor(podium, "PodiumSign", BLOCK, Vector3.new(28, 5, 0.8), signFrame, Palette.Gold, SMOOTH)
	for _, side in { -1, 1 } do
		decor(podium, "PodiumSignPost", CYLINDER, Vector3.new(17.5, 1.2, 1.2), signFrame * CFrame.new(side * 13, -6.25, 0) * UPRIGHT, Palette.Ink, SMOOTH)
	end
	addSurfaceText(sign, Enum.NormalId.Front, "ПОДИУМ ЧЕМПИОНОВ", Color3.new(1, 1, 1), Palette.Ink, 30)
	addSurfaceText(sign, Enum.NormalId.Back, "ПОДИУМ ЧЕМПИОНОВ", Color3.new(1, 1, 1), Palette.Ink, 30)
	return boards, tops
end

-- ── Окружение ───────────────────────────────────────────────────────────────

local function buildEnvironment(model: Model, rng: Random)
	local environment = Instance.new("Folder")
	environment.Name = "Environment"
	environment.Parent = model
	local center = LevelConfig.Hub.Center

	-- Парящие острова в задней полусфере (полосы — спереди, там тесно)
	local islandAngles = { 104, 128, 163, 197, 232, 256 }
	for index, angle in islandAngles do
		local radius = rng:NextNumber(12, 19)
		local island = ToyModels.Island(radius, Palette.Grass, Palette.Rock, Palette.RockDark)
		for tree = 1, rng:NextInteger(2, 4) do
			local treeAngle = tree / 4 * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
			local spot = rng:NextNumber(0.2, 0.62) * radius
			local toy = ToyModels.Tree(rng:NextNumber(0.85, 1.25), Palette.Trunk, Enum.Material.Wood, Palette.Leaves:Lerp(RGB(255, 170, 210), if tree % 3 == 0 then 0.55 else 0), SMOOTH, rng)
			ToyModels.Attach(island, toy, CFrame.new(math.cos(treeAngle) * spot, 0, math.sin(treeAngle) * spot) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
		end
		local distance = rng:NextNumber(205, 262)
		local height = if index % 2 == 0 then rng:NextNumber(14, 34) else rng:NextNumber(-30, -8)
		placeToy(island, CFrame.new(center + direction(angle) * distance + Vector3.new(0, height, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), environment)
	end

	-- Облака: высоко над полосами и глубоко под ними (не мешают полёту)
	for index = 1, 18 do
		local angle = rng:NextNumber(0, 360)
		local distance = rng:NextNumber(170, 460)
		local height = if index % 3 == 0 then rng:NextNumber(-130, -90) else rng:NextNumber(100, 160)
		local cloud = ToyModels.Cloud(rng:NextNumber(1, 2), Palette.Cloud, rng)
		placeToy(cloud, CFrame.new(center + direction(angle) * distance + Vector3.new(0, height, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), environment)
	end

	-- Неоновые кольца над задней половиной хаба
	local ringColors = { RGB(80, 220, 255), RGB(255, 110, 200), RGB(255, 210, 70), RGB(150, 255, 110), RGB(180, 120, 255) }
	for index, color in ringColors do
		local angle = 120 + index * 24
		local ring = ToyModels.Ring(rng:NextNumber(8, 13), color, 20)
		local position = center + direction(angle) * rng:NextNumber(150, 200) + Vector3.new(0, rng:NextNumber(36, 64), 0)
		placeToy(ring, CFrame.lookAt(position, center + Vector3.new(0, position.Y, 0)) * CFrame.Angles(0, 0, rng:NextNumber(-0.4, 0.4)), environment)
	end
end

-- ── Публичное API ───────────────────────────────────────────────────────────

function LobbyBuilder.Build(parent: Instance): LobbyHandles
	local rng = Random.new(20261107)
	local model = Instance.new("Model")
	model.Name = "SkyPlaza"

	buildIsland(model, rng)
	buildTerrace(model)

	local terraceFoot = LevelConfig.Hub.TerraceRadius + 13
	local hubEdge = LevelConfig.Hub.Radius - 2
	local gates: { [number]: SlotGate } = {}
	for slot = 1, LevelConfig.MaxSlots do
		buildPath(model, LevelConfig.SlotAngle(slot), terraceFoot, hubEdge, true)
		gates[slot] = buildSlotGate(model, slot)
	end
	-- площади примыкают прямо к нижней ступени террасы; к смотровой ведёт отдельная дорожка
	buildPath(model, 180, terraceFoot, hubEdge - 6, true)
	buildRim(model)

	local machines = buildCapsulePlaza(model, rng)
	local boards, tops = buildPodium(model)
	buildEnvironment(model, rng)

	-- смотровая площадка в конце задней дорожки: перила и бинокль-«пружина»
	local lookout = facingCenter(180, LevelConfig.Hub.Radius - 12, 0)
	decor(model, "LookoutDeck", CYLINDER, Vector3.new(0.3, 22, 22), lookout * CFrame.new(0, 0.3, 0) * UPRIGHT, Palette.TileB, SMOOTH)
	local spring = ToyModels.Spring(RGB(255, 90, 120))
	ToyModels.Scale(spring, 2.2)
	placeToy(spring, lookout * CFrame.new(0, 4, 4), model)

	model.Parent = parent
	return {
		Model = model,
		Machines = machines,
		Boards = boards,
		PodiumTops = tops,
		SlotGates = gates,
	}
end

-- Слот занят полосой → завеса исчезает, на табличке ник владельца
function LobbyBuilder.SetSlotOwner(handles: LobbyHandles, slot: number, ownerName: string?)
	local gate = handles.SlotGates[slot]
	if gate == nil then
		return
	end
	local open = ownerName ~= nil
	gate.Barrier.CanCollide = not open
	gate.Barrier.Transparency = if open then 1 else 0.2
	local gui = gate.Sign:FindFirstChild("Gui_Front")
	local label = if gui then gui:FindFirstChild("Text") else nil
	if label and label:IsA("TextLabel") then
		label.Text = if ownerName then "ПОЛОСА • " .. ownerName else "СВОБОДНО"
	end
	gate.Sign.Color = if open then Palette.Gold else Palette.Blue
end

LobbyBuilder.Palette = Palette

return LobbyBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="49">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Точка входа сервера. Порядок важен:
-- данные → мир/валидация → хаб Sky Plaza → прогрессия, гача и табло → ретрансляция визуала.

local Players = game:GetService("Players")

-- Персонаж появляется только после загрузки профиля и постройки полосы (см. KineticLevelAndRebirthService)
Players.CharacterAutoLoads = false

local Server = script.Parent
local PlayerDataService = require(Server.Services.PlayerDataService)
local KineticLevelAndRebirthService = require(Server.Services.KineticLevelAndRebirthService)
local ProgressionService = require(Server.Services.ProgressionService)
local StretchReplicationService = require(Server.Services.StretchReplicationService)
local LeaderboardService = require(Server.Services.LeaderboardService)
local LobbyBuilder = require(Server.Level.LobbyBuilder)

PlayerDataService.Init()
KineticLevelAndRebirthService.Init()

-- Хаб строится до первых игроков: полосы причаливают мостами к его краю
local lobby = LobbyBuilder.Build(KineticLevelAndRebirthService.GetWorldFolder())
KineticLevelAndRebirthService.LaneChanged:Connect(function(slot: number, owner: Player?)
	LobbyBuilder.SetSlotOwner(lobby, slot, if owner then (owner.DisplayName ~= "" and owner.DisplayName or owner.Name) else nil)
end)
for _, player in Players:GetPlayers() do
	local slot = KineticLevelAndRebirthService.GetLaneSlot(player)
	if slot then
		LobbyBuilder.SetSlotOwner(lobby, slot, player.DisplayName ~= "" and player.DisplayName or player.Name)
	end
end

ProgressionService.Init()
ProgressionService.BindCapsuleMachines(lobby.Machines)
LeaderboardService.Init(lobby)
StretchReplicationService.Init()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">KineticLevelAndRebirthService</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · KineticLevelAndRebirthService (сервер)
--
-- 1) Полосы: каждому игроку — своя полоса (слот) на тире его профиля.
-- 2) Пробитие: клиент предсказывает разрушение, сервер проверяет
--      • наблюдаемую скорость (по собственным сэмплам позиции, а не по словам клиента),
--      • дистанцию до препятствия с поправкой на пинг,
--      • энергию E = ½·m·v² ≥ прочности (m — ударная масса из статов/перчатки),
--      • лимит частоты; затем ломает деталь для всех, начисляет лут, планирует респаун.
--    Проверка «отложенная»: если сэмплы позиции ещё не догнали RemoteEvent, запрос ждёт до 0.6 с.
-- 3) Гонг Эволюции: порог скорости + комбо (комбо сверяется с отскоками, которые сервер сам
--    видит по резким разворотам траектории, и с подтверждёнными пробитиями).
--    Успех → Rebirth локации: тир +1, волна трансформации идёт по полосе, детали
--    заменяются в момент прохода фронта (по расписанию), множители лута и сложность растут.
-- 4) Античит-минимум: детект телепортов/сверхскоростей с откатом на последнюю честную позицию,
--    респаун при падении в бездну.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local LevelConfig = require(Shared.Config.LevelConfig)
local StretchPhysics = require(Shared.Physics.StretchPhysics)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local ProfileTemplate = require(Shared.Data.ProfileTemplate)
local PinataMotion = require(Shared.Physics.PinataMotion)

local Server = script.Parent.Parent
local PlayerDataService = require(Server.Services.PlayerDataService)
local LevelBuilder = require(Server.Level.LevelBuilder)

local Validation = PhysicsConfig.Validation
local GROUPS = PhysicsConfig.CollisionGroups

type Sample = {
	T: number,
	P: Vector3,
}

type Tracker = {
	Samples: { Sample },
	Head: number, -- индекс самого нового сэмпла
	Count: number,
	LastDir: Vector3,
	LastDirSpeed: number,
	LastTurnAt: number,
	Turns: number, -- серверные «отскоки» за текущий забег
	RunSmashes: number, -- подтверждённые пробития за забег
	SlowSince: number?,
	IgnoreUntil: number,
	Strikes: number,
	FirstStrikeAt: number,
	LastTrusted: CFrame?,
	LastKillRespawn: number,
	Tokens: number,
	TokensAt: number,
	LastGongAt: number,
	RunBoosts: number, -- пролёты колец ускорения за забег (каждое даёт +BoostRing.Combo к комбо)
	RingCooldowns: { [string]: number },
	LastTeleportAt: number,
}

type WorldRing = {
	Id: string,
	Center: Vector3,
	Normal: Vector3,
	Radius: number,
}

type LaneState = {
	Slot: number,
	Owner: Player,
	OwnerName: string,
	Rings: { WorldRing },
	Origin: CFrame,
	Handles: LevelBuilder.LaneHandles,
	Layout: LevelBuilder.LaneLayout,
	Tier: number,
	LocationId: string,
	Obstacles: { [string]: ObstacleRecord },
	Gong: BasePart?,
	WaveActiveUntil: number,
	Generation: number,
	Alive: boolean,
}

type ObstacleRecord = {
	Id: string,
	Part: BasePart,
	Spec: LevelBuilder.ObstacleSpec,
	Lane: LaneState,
	Broken: boolean,
}

type PendingRequest = {
	Kind: "Smash" | "Gong",
	Player: Player,
	Lane: LaneState,
	Generation: number,
	ObstacleId: string,
	ImpactVelocity: Vector3,
	ImpactPoint: Vector3,
	ClaimedSpeed: number,
	Combo: number,
	Deadline: number,
	LastReason: string,
}

type Job = {
	At: number,
	Run: () -> (),
}

type Verdict = "Accept" | "Reject" | "Wait"

local KineticLevelAndRebirthService = {
	-- (slot, владелец или nil) — полоса появилась/исчезла: хаб открывает проход и пишет ник
	LaneChanged = Signal.new() :: Signal.Signal<number, Player?>,
	-- (игрок, новый тир) — засчитан удар в Гонг Эволюции
	Rebirthed = Signal.new() :: Signal.Signal<Player, number>,
}

local world: Folder
local lanesFolder: Folder
local brokenStorage: Folder

local lanesBySlot: { [number]: LaneState } = {}
local lanesByPlayer: { [Player]: LaneState } = {}
local trackers: { [Player]: Tracker } = {}
local pending: { PendingRequest } = {}
local jobs: { Job } = {}
local characterConnections: { [Player]: { RBXScriptConnection } } = {}
local initialized = false

-- ── Расписание (отсортированный список задач, разбираемый на Heartbeat) ─────

local function schedule(at: number, run: () -> ())
	local job: Job = { At = at, Run = run }
	local low, high = 1, #jobs
	while low <= high do
		local mid = (low + high) // 2
		if jobs[mid].At <= at then
			low = mid + 1
		else
			high = mid - 1
		end
	end
	table.insert(jobs, low, job)
end

local function runDueJobs(now: number)
	local due = 0
	for index, job in jobs do
		if job.At > now then
			break
		end
		due = index
	end
	if due == 0 then
		return
	end
	local count = #jobs
	local ready = table.move(jobs, 1, due, 1, table.create(due))
	table.move(jobs, due + 1, count, 1)
	for index = count - due + 1, count do
		jobs[index] = nil
	end
	for _, job in ready do
		local ok, err = pcall(job.Run)
		if not ok then
			warn("[StretchPop] job failed: " .. tostring(err))
		end
	end
end

-- ── Трекер движения ─────────────────────────────────────────────────────────

local function newTracker(): Tracker
	local now = os.clock()
	return {
		Samples = table.create(Validation.TrackerCapacity),
		Head = 0,
		Count = 0,
		LastDir = Vector3.zero,
		LastDirSpeed = 0,
		LastTurnAt = 0,
		Turns = 0,
		RunSmashes = 0,
		SlowSince = nil,
		IgnoreUntil = now + 1.5,
		Strikes = 0,
		FirstStrikeAt = 0,
		LastTrusted = nil,
		LastKillRespawn = 0,
		Tokens = Validation.SmashTokenBurst,
		TokensAt = now,
		LastGongAt = 0,
		RunBoosts = 0,
		RingCooldowns = {},
		LastTeleportAt = 0,
	}
end

-- k-й по новизне сэмпл (0 = самый новый)
local function sampleAt(tracker: Tracker, k: number): Sample
	local capacity = Validation.TrackerCapacity
	local index = ((tracker.Head - 1 - k) % capacity) + 1
	return tracker.Samples[index]
end

local function pushSample(tracker: Tracker, t: number, position: Vector3)
	local capacity = Validation.TrackerCapacity
	tracker.Head = (tracker.Head % capacity) + 1
	tracker.Samples[tracker.Head] = { T = t, P = position }
	tracker.Count = math.min(tracker.Count + 1, capacity)
end

local function resetTracker(tracker: Tracker, position: Vector3?, ignoreFor: number)
	local now = os.clock()
	tracker.Head = 0
	tracker.Count = 0
	table.clear(tracker.Samples)
	tracker.IgnoreUntil = now + ignoreFor
	tracker.LastDir = Vector3.zero
	tracker.LastDirSpeed = 0
	tracker.SlowSince = nil
	tracker.Turns = 0
	tracker.RunSmashes = 0
	tracker.RunBoosts = 0
	if position then
		pushSample(tracker, now, position)
	end
end

-- Максимальная скорость по сэмплам за окно (пары с шагом ≥ 1/30 с, чтобы не ловить шум).
local function recentMaxSpeed(tracker: Tracker, now: number, window: number): number
	local best = 0
	for i = 0, tracker.Count - 1 do
		local newer = sampleAt(tracker, i)
		if now - newer.T > window then
			break
		end
		for j = i + 1, tracker.Count - 1 do
			local older = sampleAt(tracker, j)
			local dt = newer.T - older.T
			if dt >= Validation.MinSampleDt then
				if dt <= 0.5 then
					local speed = (newer.P - older.P).Magnitude / dt
					if speed > best then
						best = speed
					end
				end
				break
			end
		end
	end
	return best
end

-- Расстояние от точки до OBB детали.
local function distanceToPart(point: Vector3, cframe: CFrame, size: Vector3): number
	local localPoint = cframe:PointToObjectSpace(point)
	local half = size * 0.5
	local clamped = Vector3.new(
		math.clamp(localPoint.X, -half.X, half.X),
		math.clamp(localPoint.Y, -half.Y, half.Y),
		math.clamp(localPoint.Z, -half.Z, half.Z)
	)
	return (localPoint - clamped).Magnitude
end

local function minRecentDistance(tracker: Tracker, now: number, window: number, cframe: CFrame, size: Vector3): number
	local best = math.huge
	for i = 0, tracker.Count - 1 do
		local sample = sampleAt(tracker, i)
		if now - sample.T > window then
			break
		end
		local distance = distanceToPart(sample.P, cframe, size)
		if distance < best then
			best = distance
		end
	end
	return best
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	if character == nil then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function currentParams(player: Player): StretchPhysics.StretchParams?
	local profile = PlayerDataService.Get(player)
	if profile == nil then
		return nil
	end
	return StretchPhysics.Derive(profile.Stats, profile.Gloves.Equipped, ProfileTemplate.EquippedBuddies(profile))
end

-- Кольца полосы в мировых координатах (плоскость кольца ⟂ оси полосы)
local function worldRings(origin: CFrame, layout: LevelBuilder.LaneLayout): { WorldRing }
	local rings: { WorldRing } = {}
	for _, ring in layout.Rings do
		local cframe = origin * ring.LocalCFrame
		table.insert(rings, { Id = ring.Id, Center = cframe.Position, Normal = cframe.LookVector, Radius = ring.Radius })
	end
	return rings
end

-- ── Телепорты (всегда через клиента-владельца физики + страховка сервером) ──

local function teleportPlayer(player: Player, target: CFrame)
	local tracker = trackers[player]
	if tracker then
		resetTracker(tracker, target.Position, 1.5)
	end
	Net.ControllerReset:FireClient(player, target)
	local character = player.Character
	if character then
		task.delay(0.35, function()
			local root = getRoot(player)
			if root and player.Character == character and (root.Position - target.Position).Magnitude > 25 then
				character:PivotTo(target)
			end
		end)
	end
end

local function respawnAtLaneStart(player: Player)
	local lane = lanesByPlayer[player]
	if lane == nil then
		return
	end
	teleportPlayer(player, LevelBuilder.StartCFrame(lane.Slot))
end

local function updateTracker(player: Player, tracker: Tracker, now: number)
	local root = getRoot(player)
	if root == nil then
		return
	end
	local position = root.Position

	if position.Y < PhysicsConfig.KillY and now - tracker.LastKillRespawn > 1 then
		tracker.LastKillRespawn = now
		respawnAtLaneStart(player)
		return
	end

	if tracker.Count > 0 then
		local newest = sampleAt(tracker, 0)
		if (position - newest.P).Magnitude < 0.02 and now - newest.T < 0.25 then
			return -- новых данных физики от клиента ещё нет
		end
	end
	pushSample(tracker, now, position)
	if now < tracker.IgnoreUntil then
		tracker.LastTrusted = root.CFrame
		return
	end

	local reference: Sample? = nil
	for k = 1, tracker.Count - 1 do
		local sample = sampleAt(tracker, k)
		if now - sample.T >= Validation.MinSampleDt then
			reference = sample
			break
		end
	end
	if reference == nil then
		return
	end

	local dt = now - reference.T
	local delta = position - reference.P
	local distance = delta.Magnitude
	local speed = distance / dt

	if distance > Validation.TeleportMinJump and speed > Validation.HardSpeedCap then
		if now - tracker.FirstStrikeAt > Validation.StrikeWindow then
			tracker.Strikes = 0
			tracker.FirstStrikeAt = now
		end
		tracker.Strikes += 1
		local trusted = tracker.LastTrusted
		if tracker.Strikes >= Validation.StrikesBeforePullback and trusted then
			tracker.Strikes = 0
			warn(string.format("[StretchPop] %s: подозрительное перемещение %.0f studs/s — откат", player.Name, speed))
			teleportPlayer(player, trusted)
		else
			resetTracker(tracker, position, 0)
		end
		return
	end

	tracker.LastTrusted = root.CFrame

	-- Пролёт колец ускорения сервер видит сам: отрезок между сэмплами пересекает плоскость кольца
	local lane = lanesByPlayer[player]
	if lane and tracker.Count >= 2 then
		local previous = sampleAt(tracker, 1).P
		for _, ring in lane.Rings do
			local before = (previous - ring.Center):Dot(ring.Normal)
			local after = (position - ring.Center):Dot(ring.Normal)
			if before * after < 0 then
				local hit = previous:Lerp(position, before / (before - after))
				if (hit - ring.Center).Magnitude <= ring.Radius * 1.35 and now >= (tracker.RingCooldowns[ring.Id] or 0) then
					tracker.RingCooldowns[ring.Id] = now + LevelConfig.BoostRing.Cooldown
					tracker.RunBoosts += 1
				end
			end
		end
	end

	if speed > Validation.TurnMinSpeed then
		local direction = delta / distance
		if
			tracker.LastDirSpeed > Validation.TurnMinSpeed
			and direction:Dot(tracker.LastDir) < Validation.TurnCos
			and now - tracker.LastTurnAt > Validation.TurnCooldown
		then
			tracker.Turns += 1
			tracker.LastTurnAt = now
		end
		tracker.LastDir = direction
		tracker.LastDirSpeed = speed
	end

	if speed < Validation.RestSpeed then
		local slowSince = tracker.SlowSince
		if slowSince == nil then
			tracker.SlowSince = now
		elseif now - slowSince > Validation.RestTime then
			tracker.Turns = 0
			tracker.RunSmashes = 0
			tracker.RunBoosts = 0
			tracker.LastDirSpeed = 0
		end
	else
		tracker.SlowSince = nil
	end
end

local function consumeToken(tracker: Tracker, now: number): boolean
	tracker.Tokens = math.min(
		Validation.SmashTokenBurst,
		tracker.Tokens + (now - tracker.TokensAt) * Validation.SmashTokensPerSecond
	)
	tracker.TokensAt = now
	if tracker.Tokens < 1 then
		return false
	end
	tracker.Tokens -= 1
	return true
end

-- ── Полосы ──────────────────────────────────────────────────────────────────

local function bestSpeedOf(player: Player, locationId: string): number
	local profile = PlayerDataService.Get(player)
	return if profile then ProfileTemplate.GetLocation(profile, locationId).BestSpeed else 0
end

local function buildContext(lane: LaneState, tier: number): LevelBuilder.BuildContext
	return {
		Origin = lane.Origin,
		Theme = LevelConfig.GetTheme(tier),
		Slot = lane.Slot,
		Tier = tier,
		OwnerUserId = lane.Owner.UserId,
		OwnerName = lane.OwnerName,
		BestSpeed = bestSpeedOf(lane.Owner, lane.LocationId),
	}
end

local function registerObstacle(lane: LaneState, spec: LevelBuilder.ObstacleSpec, part: BasePart)
	lane.Obstacles[spec.Id] = {
		Id = spec.Id,
		Part = part,
		Spec = spec,
		Lane = lane,
		Broken = false,
	}
end

local function allocateSlot(): number?
	for slot = 1, LevelConfig.MaxSlots do
		if lanesBySlot[slot] == nil then
			return slot
		end
	end
	return nil
end

local function createLaneFor(player: Player, profile: Types.PlayerProfile): LaneState?
	local slot = allocateSlot()
	if slot == nil then
		return nil
	end
	local locationId = profile.ActiveLocation
	local progress = PlayerDataService.GetLocation(profile, locationId)
	local tier = progress.Tier
	local layout = LevelBuilder.GenerateLayout(locationId, tier)
	local origin = LevelConfig.SlotOrigin(slot)
	local ownerName = player.DisplayName ~= "" and player.DisplayName or player.Name
	local context: LevelBuilder.BuildContext = {
		Origin = origin,
		Theme = LevelConfig.GetTheme(tier),
		Slot = slot,
		Tier = tier,
		OwnerUserId = player.UserId,
		OwnerName = ownerName,
		BestSpeed = progress.BestSpeed,
	}
	local handles = LevelBuilder.CreateLane(layout, context, lanesFolder)
	local lane: LaneState = {
		Slot = slot,
		Owner = player,
		OwnerName = ownerName,
		Rings = worldRings(origin, layout),
		Origin = origin,
		Handles = handles,
		Layout = layout,
		Tier = tier,
		LocationId = locationId,
		Obstacles = {},
		Gong = handles.Gong,
		WaveActiveUntil = 0,
		Generation = 1,
		Alive = true,
	}
	for _, spec in layout.Obstacles do
		local part = handles.Obstacles[spec.Id]
		if part then
			registerObstacle(lane, spec, part)
		end
	end
	lanesBySlot[slot] = lane
	lanesByPlayer[player] = lane
	player:SetAttribute("LaneSlot", slot)
	KineticLevelAndRebirthService.LaneChanged:Fire(slot, player)
	return lane
end

local function destroyLane(lane: LaneState)
	lane.Alive = false
	for _, record in lane.Obstacles do
		record.Part:Destroy()
	end
	table.clear(lane.Obstacles)
	lane.Handles.Model:Destroy()
	if lanesBySlot[lane.Slot] == lane then
		lanesBySlot[lane.Slot] = nil
		KineticLevelAndRebirthService.LaneChanged:Fire(lane.Slot, nil)
	end
	if lanesByPlayer[lane.Owner] == lane then
		lanesByPlayer[lane.Owner] = nil
	end
end

-- ── Пробитие ────────────────────────────────────────────────────────────────

local function snapshotOf(record: ObstacleRecord): Types.SmashSnapshot
	local part = record.Part
	return {
		CFrame = part.CFrame,
		Size = part.Size,
		Color = part.Color,
		Material = part.Material,
		Kind = record.Spec.Kind,
	}
end

local function evaluateSmash(request: PendingRequest, tracker: Tracker, now: number): (Verdict, string)
	local lane = request.Lane
	if not lane.Alive or lane.Generation ~= request.Generation then
		return "Reject", "lane_changed"
	end
	local record = lane.Obstacles[request.ObstacleId]
	if record == nil then
		return "Reject", "unknown_obstacle"
	end
	if record.Broken then
		return "Reject", "already_broken"
	end
	local params = currentParams(request.Player)
	if params == nil then
		return "Reject", "no_profile"
	end
	local claimed = math.min(request.ClaimedSpeed, request.ImpactVelocity.Magnitude + 1, PhysicsConfig.MaxFlightSpeed)
	if not StretchPhysics.CanSmash(record.Spec.Durability * 0.98, params.ImpactMass, claimed) then
		return "Reject", "too_weak"
	end
	local observed = recentMaxSpeed(tracker, now, Validation.ObservedWindow)
	if claimed > observed * Validation.SpeedSlack + Validation.SpeedFlat then
		return "Wait", "speed_unverified"
	end
	local reach = Validation.DistanceBase + observed * Validation.DistanceLatency
	-- пиньята плывёт поперёк полосы: проверяем расстояние до всего её «коридора» движения
	local checkSize = record.Part.Size
	local motion = record.Spec.Motion
	if motion then
		checkSize = PinataMotion.SweepSize(checkSize, motion)
	end
	local distance = minRecentDistance(tracker, now, Validation.ObservedWindow, record.Part.CFrame, checkSize)
	if distance > reach then
		return "Wait", "too_far"
	end
	return "Accept", "ok"
end

local function applySmash(request: PendingRequest, tracker: Tracker)
	local lane = request.Lane
	local record = lane.Obstacles[request.ObstacleId]
	if record == nil or record.Broken then
		return
	end
	local snapshot = snapshotOf(record)
	record.Broken = true
	record.Part.Parent = brokenStorage
	tracker.RunSmashes += 1

	-- лут × множитель экипированных бадди (та же формула, что у клиента в StretchPhysics.Derive)
	local params = currentParams(request.Player)
	local loot = math.max(1, math.floor(record.Spec.Loot * (if params then params.CoinMultiplier else 1) + 0.5))
	local kind = record.Spec.Kind
	local speed = request.ClaimedSpeed
	PlayerDataService.Update(request.Player, function(profile)
		profile.Coins += loot
		profile.Records.LootEarned += loot
		if kind == "Chest" then
			profile.Records.ChestsOpened += 1
		elseif kind == "Pinata" then
			profile.Records.PinatasPopped += 1
		else
			profile.Records.WallsSmashed += 1
		end
		profile.Records.TopSpeed = math.max(profile.Records.TopSpeed, speed)
		local location = PlayerDataService.GetLocation(profile, lane.LocationId)
		location.BestSpeed = math.max(location.BestSpeed, speed)
	end)

	Net.SmashResult:FireClient(request.Player, record.Id, true, loot, nil)
	Net.ObstacleSmashed:FireAllClients(
		request.Player.UserId,
		lane.Slot,
		record.Id,
		snapshot,
		request.ImpactPoint,
		request.ImpactVelocity
	)

	local generation = lane.Generation
	schedule(os.clock() + LevelConfig.ObstacleRespawnTime, function()
		if lane.Alive and lane.Generation == generation and record.Broken and lane.Obstacles[record.Id] == record then
			record.Broken = false
			record.Part.Parent = lane.Handles.ObstacleFolder
		end
	end)
end

-- ── Гонг Эволюции и мутация локации ────────────────────────────────────────

local function evaluateGong(request: PendingRequest, tracker: Tracker, now: number): (Verdict, string)
	local lane = request.Lane
	if not lane.Alive or lane.Generation ~= request.Generation then
		return "Reject", "lane_changed"
	end
	if now < lane.WaveActiveUntil then
		return "Reject", "wave_in_progress"
	end
	local gong = lane.Gong
	if gong == nil or gong.Parent == nil then
		return "Reject", "no_gong"
	end
	local needSpeed, needCombo = LevelConfig.GongRequirement(lane.Tier)
	local claimed = math.min(request.ClaimedSpeed, request.ImpactVelocity.Magnitude + 1, PhysicsConfig.MaxFlightSpeed)
	if claimed < needSpeed then
		return "Reject", "too_slow"
	end
	if request.Combo < needCombo then
		return "Reject", "combo_too_low"
	end
	local observed = recentMaxSpeed(tracker, now, Validation.ObservedWindow)
	if claimed > observed * Validation.SpeedSlack + Validation.SpeedFlat then
		return "Wait", "speed_unverified"
	end
	if request.Combo > tracker.Turns + tracker.RunSmashes + LevelConfig.BoostRing.Combo * tracker.RunBoosts + Validation.ComboSlack then
		return "Wait", "combo_unverified"
	end
	local reach = Validation.DistanceBase + 10 + observed * Validation.DistanceLatency
	if minRecentDistance(tracker, now, Validation.ObservedWindow, gong.CFrame, gong.Size) > reach then
		return "Wait", "too_far"
	end
	return "Accept", "ok"
end

local function partLocalZ(lane: LaneState, instance: Instance): number
	local stored = instance:GetAttribute("LocalZ")
	if typeof(stored) == "number" then
		return stored
	end
	if instance:IsA("BasePart") then
		return lane.Origin:PointToObjectSpace(instance.Position).Z
	elseif instance:IsA("Model") then
		return lane.Origin:PointToObjectSpace(instance:GetPivot().Position).Z
	end
	return 0
end

local function runMutationWave(lane: LaneState, newTier: number)
	local player = lane.Owner
	local oldLayout = lane.Layout
	local newLayout = LevelBuilder.GenerateLayout(lane.LocationId, newTier)
	lane.Generation += 1
	local generation = lane.Generation
	lane.Tier = newTier
	lane.Layout = newLayout
	lane.Rings = worldRings(lane.Origin, newLayout)

	local rebirth = LevelConfig.Rebirth
	local now = os.clock()
	local waveStart = now + rebirth.StartDelay
	local originZ = -math.max(oldLayout.Length, newLayout.Length) - 40
	local endZ = LevelConfig.StartPadSize.Z * 0.5 + 30
	local speed = rebirth.WaveSpeed
	local duration = (endZ - originZ) / speed
	lane.WaveActiveUntil = waveStart + duration + 0.5

	local function timeAt(localZ: number): number
		return waveStart + math.max(localZ - originZ, 0) / speed
	end

	local waveInfo: Types.RebirthWaveInfo = {
		Slot = lane.Slot,
		OwnerUserId = player.UserId,
		Tier = newTier,
		LaneOrigin = lane.Origin,
		OriginZ = originZ,
		EndZ = endZ,
		Speed = speed,
		StartServerTime = workspace:GetServerTimeNow() + rebirth.StartDelay,
		LaneWidth = LevelConfig.LaneWidth,
	}
	Net.RebirthWave:FireAllClients(waveInfo)

	-- Игрок смотрит со старта, как волна идёт на него
	schedule(now + rebirth.TeleportDelay, function()
		if lane.Alive and lane.Generation == generation and player.Parent == Players then
			teleportPlayer(player, LevelBuilder.StartCFrame(lane.Slot))
		end
	end)

	-- Снос старых деталей в момент прохода фронта
	for _, child in lane.Handles.Mutable:GetChildren() do
		if child:IsA("BasePart") or child:IsA("Model") then
			local instance = child
			schedule(timeAt(partLocalZ(lane, instance)), function()
				if lane.Alive and lane.Generation == generation then
					instance:Destroy()
				end
			end)
		end
	end
	local oldRecords = lane.Obstacles
	lane.Obstacles = {}
	for _, record in oldRecords do
		local part = record.Part
		schedule(timeAt(record.Spec.LocalCFrame.Position.Z), function()
			if lane.Alive and lane.Generation == generation then
				part:Destroy()
			end
		end)
	end
	lane.Gong = nil

	-- Новые детали появляются сразу за фронтом
	local context = buildContext(lane, newTier)
	for _, spec in newLayout.Pieces do
		schedule(timeAt(spec.LocalCFrame.Position.Z) + 0.05, function()
			if lane.Alive and lane.Generation == generation then
				local part = LevelBuilder.BuildPiece(spec, context, lane.Handles.Mutable)
				if spec.Kind == "GongDisc" then
					lane.Gong = part
				end
			end
		end)
	end
	for _, spec in newLayout.Obstacles do
		schedule(timeAt(spec.LocalCFrame.Position.Z) + 0.05, function()
			if lane.Alive and lane.Generation == generation then
				local part = LevelBuilder.BuildObstacle(spec, context, lane.Handles.ObstacleFolder)
				registerObstacle(lane, spec, part)
			end
		end)
	end

	-- Финал волны: перекраска старта, атрибут тира полосы
	schedule(waveStart + duration, function()
		if lane.Alive and lane.Generation == generation then
			for _, child in lane.Handles.Static:GetChildren() do
				if child:IsA("BasePart") then
					LevelBuilder.ApplyTheme(child, context.Theme)
				end
			end
			LevelBuilder.RefreshGateSign(lane.Handles.GateSign, LevelBuilder.GateSignText(lane.OwnerName, newTier, bestSpeedOf(player, lane.LocationId)), context.Theme)
			lane.Handles.Model:SetAttribute("Tier", newTier)
		end
	end)
end

local function applyGong(request: PendingRequest, tracker: Tracker)
	local lane = request.Lane
	local player = request.Player
	local newTier = lane.Tier + 1
	local params = currentParams(player)
	local bonus = math.floor(LevelConfig.RebirthBonus * LevelConfig.LootMultiplier(newTier) * (if params then params.CoinMultiplier else 1) + 0.5)
	local speed = request.ClaimedSpeed
	local combo = request.Combo
	tracker.LastGongAt = os.clock()

	PlayerDataService.Update(player, function(profile)
		local location = PlayerDataService.GetLocation(profile, lane.LocationId)
		location.Tier = newTier
		location.Rebirths += 1
		location.BestSpeed = math.max(location.BestSpeed, speed)
		location.BestCombo = math.max(location.BestCombo, combo)
		profile.TotalRebirths += 1
		profile.Coins += bonus
		profile.Records.LootEarned += bonus
		profile.Records.TopSpeed = math.max(profile.Records.TopSpeed, speed)
		profile.Records.LongestCombo = math.max(profile.Records.LongestCombo, combo)
	end)

	local needSpeed, needCombo = LevelConfig.GongRequirement(newTier - 1)
	Net.GongResult:FireClient(player, true, "rebirth", needSpeed, needCombo, speed, combo)
	runMutationWave(lane, newTier)
	KineticLevelAndRebirthService.Rebirthed:Fire(player, newTier)
end

local function rejectRequest(request: PendingRequest, reason: string)
	if request.Kind == "Smash" then
		Net.SmashResult:FireClient(request.Player, request.ObstacleId, false, 0, reason)
	else
		local lane = request.Lane
		local needSpeed, needCombo = LevelConfig.GongRequirement(lane.Tier)
		Net.GongResult:FireClient(request.Player, false, reason, needSpeed, needCombo, request.ClaimedSpeed, request.Combo)
	end
end

local function processPending(now: number)
	local index = 1
	while index <= #pending do
		local request = pending[index]
		local tracker = trackers[request.Player]
		local verdict: Verdict
		local reason: string
		if tracker == nil or request.Player.Parent ~= Players then
			verdict, reason = "Reject", "left"
		elseif request.Kind == "Smash" then
			verdict, reason = evaluateSmash(request, tracker, now)
		else
			verdict, reason = evaluateGong(request, tracker, now)
		end
		request.LastReason = reason
		if verdict == "Wait" and now < request.Deadline then
			index += 1
		else
			pending[index] = pending[#pending]
			pending[#pending] = nil
			if verdict == "Accept" and tracker then
				if request.Kind == "Smash" then
					applySmash(request, tracker)
				else
					applyGong(request, tracker)
				end
			elseif request.Player.Parent == Players then
				rejectRequest(request, reason)
			end
		end
	end
end

-- ── Сетевые обработчики (все аргументы клиента — недоверенные) ─────────────

local function isSaneNumber(value: unknown, minValue: number, maxValue: number): boolean
	return typeof(value) == "number" and value == value and value >= minValue and value <= maxValue
end

local function onSmashRequest(player: Player, obstacleId: unknown, impactVelocity: unknown, impactPoint: unknown, impactSpeed: unknown, combo: unknown)
	if typeof(obstacleId) ~= "string" or #obstacleId == 0 or #obstacleId > 48 then
		return
	end
	if typeof(impactVelocity) ~= "Vector3" or not StretchPhysics.IsFiniteVector(impactVelocity, 1e4) then
		return
	end
	if typeof(impactPoint) ~= "Vector3" or not StretchPhysics.IsFiniteVector(impactPoint, 1e6) then
		return
	end
	if not isSaneNumber(impactSpeed, 0, 1e4) or not isSaneNumber(combo, 0, 1e4) then
		return
	end
	local tracker = trackers[player]
	local lane = lanesByPlayer[player]
	if tracker == nil or lane == nil then
		return
	end
	local now = os.clock()
	if not consumeToken(tracker, now) then
		Net.SmashResult:FireClient(player, obstacleId, false, 0, "rate_limited")
		return
	end
	local record = lane.Obstacles[obstacleId]
	if record == nil or record.Broken then
		Net.SmashResult:FireClient(player, obstacleId, false, 0, if record then "already_broken" else "unknown_obstacle")
		return
	end
	for _, request in pending do
		if request.Player == player and request.Kind == "Smash" and request.ObstacleId == obstacleId then
			return -- дубликат уже в очереди
		end
	end
	table.insert(pending, {
		Kind = "Smash",
		Player = player,
		Lane = lane,
		Generation = lane.Generation,
		ObstacleId = obstacleId,
		ImpactVelocity = impactVelocity,
		ImpactPoint = impactPoint,
		ClaimedSpeed = impactSpeed :: number,
		Combo = math.floor(combo :: number),
		Deadline = now + Validation.PendingTimeout,
		LastReason = "queued",
	})
end

local function onGongStrike(player: Player, slot: unknown, impactVelocity: unknown, impactSpeed: unknown, combo: unknown)
	if not isSaneNumber(slot, 1, LevelConfig.MaxSlots) then
		return
	end
	if typeof(impactVelocity) ~= "Vector3" or not StretchPhysics.IsFiniteVector(impactVelocity, 1e4) then
		return
	end
	if not isSaneNumber(impactSpeed, 0, 1e4) or not isSaneNumber(combo, 0, 1e4) then
		return
	end
	local tracker = trackers[player]
	local lane = lanesByPlayer[player]
	if tracker == nil or lane == nil then
		return
	end
	local now = os.clock()
	local claimedSpeed = impactSpeed :: number
	local claimedCombo = math.floor(combo :: number)
	if lane.Slot ~= slot then
		local needSpeed, needCombo = LevelConfig.GongRequirement(lane.Tier)
		Net.GongResult:FireClient(player, false, "not_your_lane", needSpeed, needCombo, claimedSpeed, claimedCombo)
		return
	end
	if now - tracker.LastGongAt < LevelConfig.Rebirth.Cooldown then
		local needSpeed, needCombo = LevelConfig.GongRequirement(lane.Tier)
		Net.GongResult:FireClient(player, false, "cooldown", needSpeed, needCombo, claimedSpeed, claimedCombo)
		return
	end
	for _, request in pending do
		if request.Player == player and request.Kind == "Gong" then
			return
		end
	end
	tracker.LastGongAt = now - LevelConfig.Rebirth.Cooldown + 1 -- антиспам: следующая попытка не раньше чем через 1 с
	table.insert(pending, {
		Kind = "Gong",
		Player = player,
		Lane = lane,
		Generation = lane.Generation,
		ObstacleId = "",
		ImpactVelocity = impactVelocity,
		ImpactPoint = Vector3.zero,
		ClaimedSpeed = claimedSpeed,
		Combo = claimedCombo,
		Deadline = now + Validation.PendingTimeout,
		LastReason = "queued",
	})
end

local TELEPORT_COOLDOWN = 1.5

local function onTeleportRequest(player: Player, target: unknown)
	if target ~= "Start" and target ~= "Hub" then
		return
	end
	local tracker = trackers[player]
	local lane = lanesByPlayer[player]
	if tracker == nil or lane == nil then
		return
	end
	local now = os.clock()
	if now - tracker.LastTeleportAt < TELEPORT_COOLDOWN then
		Net.TeleportRequest:FireClient(player, target, false)
		return
	end
	tracker.LastTeleportAt = now
	teleportPlayer(player, if target == "Start" then LevelBuilder.StartCFrame(lane.Slot) else LevelBuilder.HubSpawnCFrame(lane.Slot))
	Net.TeleportRequest:FireClient(player, target, true)
end

-- ── Персонажи ───────────────────────────────────────────────────────────────

local function assignCollisionGroup(instance: Instance)
	if instance:IsA("BasePart") then
		instance.CollisionGroup = GROUPS.Characters
	end
end

local function disconnectCharacter(player: Player)
	local connections = characterConnections[player]
	if connections then
		for _, connection in connections do
			connection:Disconnect()
		end
	end
	characterConnections[player] = nil
end

local function onCharacterAdded(player: Player, character: Model)
	disconnectCharacter(player)
	local connections: { RBXScriptConnection } = {}
	characterConnections[player] = connections

	for _, descendant in character:GetDescendants() do
		assignCollisionGroup(descendant)
	end
	table.insert(connections, character.DescendantAdded:Connect(assignCollisionGroup))

	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		table.insert(
			connections,
			humanoid.Died:Connect(function()
				task.delay(Players.RespawnTime, function()
					if player.Parent == Players and player.Character == character then
						player:LoadCharacter()
					end
				end)
			end)
		)
	end

	local root = character:WaitForChild("HumanoidRootPart", 10)
	local lane = lanesByPlayer[player]
	if root and lane and player.Character == character then
		-- появляемся на хабе Sky Plaza, на дорожке к своей полосе
		local start = LevelBuilder.HubSpawnCFrame(lane.Slot)
		character:PivotTo(start)
		-- Клиент-владелец физики ставит персонажа сам; сервер перепроверит через 0.35 с
		teleportPlayer(player, start)
	end
end

local function onPlayerAdded(player: Player)
	local profile = PlayerDataService.WaitFor(player, 60)
	if profile == nil or player.Parent ~= Players then
		return
	end
	if lanesByPlayer[player] then
		return
	end
	trackers[player] = newTracker()
	local lane = createLaneFor(player, profile)
	if lane == nil then
		player:Kick("STRETCH-POP: на сервере нет свободных полос, зайди на другой сервер.")
		return
	end
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	else
		player:LoadCharacter()
	end
end

local function onPlayerRemoving(player: Player)
	disconnectCharacter(player)
	local lane = lanesByPlayer[player]
	if lane then
		destroyLane(lane)
	end
	trackers[player] = nil
	for index = #pending, 1, -1 do
		if pending[index].Player == player then
			table.remove(pending, index)
		end
	end
end

local function setupCollisionGroups()
	for _, name in { GROUPS.Characters, GROUPS.Debris } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Characters, GROUPS.Characters, false)
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Characters, GROUPS.Debris, false)
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Debris, GROUPS.Debris, false)
end

-- ── Публичное API ───────────────────────────────────────────────────────────

function KineticLevelAndRebirthService.GetLaneSlot(player: Player): number?
	local lane = lanesByPlayer[player]
	return if lane then lane.Slot else nil
end

function KineticLevelAndRebirthService.GetObservedSpeed(player: Player): number
	local tracker = trackers[player]
	if tracker == nil then
		return 0
	end
	return recentMaxSpeed(tracker, os.clock(), 0.3)
end

function KineticLevelAndRebirthService.GetWorldFolder(): Folder
	return world
end

function KineticLevelAndRebirthService.GetLaneTier(player: Player): number?
	local lane = lanesByPlayer[player]
	return if lane then lane.Tier else nil
end

function KineticLevelAndRebirthService.Init()
	if initialized then
		return
	end
	initialized = true
	setupCollisionGroups()

	local existingWorld = workspace:FindFirstChild("StretchPopWorld")
	if existingWorld then
		existingWorld:Destroy()
	end
	world = Instance.new("Folder")
	world.Name = "StretchPopWorld"
	lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = world
	world.Parent = workspace

	brokenStorage = Instance.new("Folder")
	brokenStorage.Name = "StretchPopBroken"
	brokenStorage.Parent = ServerStorage

	Net.SmashRequest.OnServerEvent:Connect(onSmashRequest)
	Net.GongStrike.OnServerEvent:Connect(onGongStrike)
	Net.TeleportRequest.OnServerEvent:Connect(onTeleportRequest)

	-- Вывеска владельца на воротах полосы: ник • тир • рекорд скорости
	PlayerDataService.ProfileChanged:Connect(function(player: Player, profile: Types.PlayerProfile)
		local lane = lanesByPlayer[player]
		if lane then
			local best = ProfileTemplate.GetLocation(profile, lane.LocationId).BestSpeed
			LevelBuilder.UpdateGateSign(lane.Handles.GateSign, LevelBuilder.GateSignText(lane.OwnerName, lane.Tier, best))
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for player, tracker in trackers do
			updateTracker(player, tracker, now)
		end
		processPending(now)
		runDueJobs(now)
	end)
end

return KineticLevelAndRebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · LeaderboardService (сервер)
-- Три табло на Подиуме чемпионов: ТОП СКОРОСТИ, ТОП КОМБО, ТОП РЕБЁРТОВ.
--
-- Источник данных — подтверждённые сервером рекорды профиля (скорость засчитывается только
-- из проверенных пробитий и ударов в гонг, поэтому накрутить её нельзя).
--   • «Живые» значения игроков на сервере обновляют табло почти сразу (дебаунс 2 с).
--   • Глобальный рейтинг — OrderedDataStore: запись max(старое, новое) раз в 90 с и при выходе,
--     чтение топ-10 раз в 60 с. Все вызовы в pcall; при недоступности DataStore (Studio без
--     доступа к API, сбой сервиса) табло работает в режиме «рейтинг сервера».
-- Топ-3 по скорости стоят на подиуме: табличка с ником и рекордом + статуя аватара
-- (Players:CreateHumanoidModelFromUserId, если доступно).

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)

local Server = script.Parent.Parent
local PlayerDataService = require(Server.Services.PlayerDataService)
local LobbyBuilder = require(Server.Level.LobbyBuilder)

type BoardKind = LobbyBuilder.BoardKind

export type Entry = {
	UserId: number,
	Name: string,
	Value: number,
}

type RowGui = {
	Frame: Frame,
	Rank: TextLabel,
	Badge: Frame,
	Name: TextLabel,
	Value: TextLabel,
}

type Board = {
	Kind: BoardKind,
	Title: string,
	Unit: string,
	Accent: Color3,
	StoreName: string,
	Store: OrderedDataStore?,
	Global: { Entry },
	Written: { [number]: number },
	Rows: { RowGui },
	Footer: TextLabel?,
	Top: { Entry },
}

local BOARD_SIZE = 10
local READ_INTERVAL = 60
local WRITE_INTERVAL = 90
local LIVE_DEBOUNCE = 2
local STORE_VERSION = "v1"

local RGB = Color3.fromRGB
local INK = RGB(28, 32, 56)
local CREAM = RGB(248, 250, 255)
local CARD = RGB(232, 240, 255)
local UNDERLAY = RGB(195, 206, 230)
local MEDALS = { RGB(255, 196, 40), RGB(206, 218, 236), RGB(214, 132, 72) }
local FONT = Enum.Font.FredokaOne

local LeaderboardService = {}

local boards: { Board } = {}
local boardByKind: { [BoardKind]: Board } = {}
local nameCache: { [number]: string } = {}
local lobby: LobbyBuilder.LobbyHandles? = nil
local podiumFolder: Folder? = nil
local podiumUsers: { number } = {}
local podiumGeneration = 0
local liveDue = 0
local initialized = false

local function valueOf(kind: BoardKind, profile: Types.PlayerProfile): number
	if kind == "Speed" then
		return math.floor(profile.Records.TopSpeed + 0.5)
	elseif kind == "Combo" then
		return math.floor(profile.Records.LongestCombo)
	end
	return math.floor(profile.TotalRebirths)
end

local function formatValue(board: Board, value: number): string
	return string.format("%d %s", value, board.Unit)
end

local function nameFor(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName ~= "" and player.DisplayName or player.Name
		return nameCache[userId]
	end
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local name = if ok and typeof(result) == "string" then result else "Игрок " .. userId
	nameCache[userId] = name
	return name
end

-- ── Отрисовка табло ─────────────────────────────────────────────────────────

local function corner(parent: Instance, radius: number)
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius)
	ui.Parent = parent
end

local function stroke(parent: Instance, thickness: number, color: Color3)
	local ui = Instance.new("UIStroke")
	ui.Thickness = thickness
	ui.Color = color
	ui.LineJoinMode = Enum.LineJoinMode.Round
	ui.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ui.Parent = parent
end

local function textStroke(label: TextLabel, thickness: number)
	local ui = Instance.new("UIStroke")
	ui.Thickness = thickness
	ui.Color = INK
	ui.LineJoinMode = Enum.LineJoinMode.Round
	ui.Parent = label
end

local function label(parent: Instance, name: string, text: string, color: Color3, alignment: Enum.TextXAlignment): TextLabel
	local item = Instance.new("TextLabel")
	item.Name = name
	item.BackgroundTransparency = 1
	item.Font = FONT
	item.Text = text
	item.TextColor3 = color
	item.TextScaled = true
	item.TextXAlignment = alignment
	item.Parent = parent
	return item
end

local function buildBoardGui(board: Board, screen: BasePart)
	local existing = screen:FindFirstChild("LeaderboardGui")
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "LeaderboardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 26
	gui.LightInfluence = 0
	gui.Brightness = 1.2
	gui.Parent = screen

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundColor3 = CREAM
	body.Size = UDim2.fromScale(1, 1)
	body.BorderSizePixel = 0
	body.Parent = gui

	-- шапка: цветная плашка с подложкой, наклон −1°
	local headerShadow = Instance.new("Frame")
	headerShadow.Name = "HeaderShadow"
	headerShadow.BackgroundColor3 = UNDERLAY
	headerShadow.Position = UDim2.new(0.04, 0, 0.025, 8)
	headerShadow.Size = UDim2.fromScale(0.92, 0.13)
	headerShadow.Rotation = -1
	headerShadow.Parent = body
	corner(headerShadow, 18)
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundColor3 = board.Accent
	header.Position = UDim2.fromScale(0.04, 0.025)
	header.Size = UDim2.fromScale(0.92, 0.13)
	header.Rotation = -1
	header.Parent = body
	corner(header, 18)
	stroke(header, 5, INK)
	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.BackgroundColor3 = Color3.new(1, 1, 1)
	shine.BackgroundTransparency = 0.6
	shine.Position = UDim2.fromScale(0.05, 0.12)
	shine.Size = UDim2.fromScale(0.9, 0.18)
	shine.Parent = header
	corner(shine, 8)
	local title = label(header, "Title", board.Title, Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	title.Size = UDim2.fromScale(0.92, 0.78)
	title.Position = UDim2.fromScale(0.04, 0.11)
	textStroke(title, 4)

	local rows: { RowGui } = {}
	for rank = 1, BOARD_SIZE do
		local top = 0.185 + (rank - 1) * 0.074
		local frame = Instance.new("Frame")
		frame.Name = "Row" .. rank
		frame.BackgroundColor3 = if rank <= 3 then MEDALS[rank]:Lerp(CARD, 0.72) else CARD
		frame.Position = UDim2.fromScale(0.05, top)
		frame.Size = UDim2.fromScale(0.9, 0.064)
		frame.Parent = body
		corner(frame, 12)
		stroke(frame, 3, INK)

		local badge = Instance.new("Frame")
		badge.Name = "Badge"
		badge.BackgroundColor3 = if rank <= 3 then MEDALS[rank] else UNDERLAY
		badge.Position = UDim2.fromScale(0.015, 0.1)
		badge.Size = UDim2.fromScale(0.11, 0.8)
		badge.Parent = frame
		corner(badge, 100)
		stroke(badge, 3, INK)
		local rankLabel = label(badge, "Rank", tostring(rank), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
		rankLabel.Size = UDim2.fromScale(1, 1)
		textStroke(rankLabel, 2.5)

		local nameLabel = label(frame, "Name", "—", INK, Enum.TextXAlignment.Left)
		nameLabel.Position = UDim2.fromScale(0.16, 0.12)
		nameLabel.Size = UDim2.fromScale(0.5, 0.76)
		local valueLabel = label(frame, "Value", "", board.Accent:Lerp(INK, 0.35), Enum.TextXAlignment.Right)
		valueLabel.Position = UDim2.fromScale(0.64, 0.12)
		valueLabel.Size = UDim2.fromScale(0.33, 0.76)
		table.insert(rows, { Frame = frame, Rank = rankLabel, Badge = badge, Name = nameLabel, Value = valueLabel })
	end
	board.Rows = rows

	local footer = label(body, "Footer", "", INK:Lerp(CREAM, 0.4), Enum.TextXAlignment.Center)
	footer.Position = UDim2.fromScale(0.05, 0.93)
	footer.Size = UDim2.fromScale(0.9, 0.05)
	board.Footer = footer
end

local function renderBoard(board: Board)
	for index, row in board.Rows do
		local entry = board.Top[index]
		row.Name.Text = if entry then entry.Name else "—"
		row.Value.Text = if entry then formatValue(board, entry.Value) else ""
		row.Frame.BackgroundTransparency = if entry then 0 else 0.35
	end
	local footer = board.Footer
	if footer then
		footer.Text = if board.Store then "ГЛОБАЛЬНЫЙ РЕЙТИНГ • обновление раз в минуту" else "РЕЙТИНГ СЕРВЕРА • глобальный недоступен"
	end
end

-- ── Подиум ──────────────────────────────────────────────────────────────────

local function makeStatue(userId: number, top: CFrame, parent: Instance, generation: number)
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromUserId(userId)
	end)
	if not ok or typeof(result) ~= "Instance" or not result:IsA("Model") then
		return
	end
	if generation ~= podiumGeneration then
		result:Destroy() -- состав подиума успел смениться, пока грузился аватар
		return
	end
	local statue = result
	statue.Name = "Statue_" .. userId
	for _, descendant in statue:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
		elseif descendant:IsA("Humanoid") then
			descendant.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
			descendant:Destroy()
		end
	end
	pcall(function()
		statue:ScaleTo(1.35)
	end)
	statue:PivotTo(top)
	-- ставим ступнями на ступень: сдвиг по нижней грани габарита
	local boxCFrame, boxSize = statue:GetBoundingBox()
	local bottom = boxCFrame.Position.Y - boxSize.Y * 0.5
	statue:PivotTo(top + Vector3.new(0, top.Position.Y - bottom, 0))
	statue.Parent = parent
end

local function makeNameplate(place: number, entry: Entry, top: CFrame, parent: Instance)
	local anchor = Instance.new("Part")
	anchor.Name = "Nameplate" .. place
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = top + Vector3.new(0, 11, 0)
	anchor.Parent = parent

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Plate"
	billboard.Size = UDim2.fromScale(11, 3.6)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 160
	billboard.Parent = anchor
	local plate = Instance.new("Frame")
	plate.BackgroundColor3 = MEDALS[place] or CARD
	plate.Size = UDim2.fromScale(1, 1)
	plate.Parent = billboard
	corner(plate, 14)
	stroke(plate, 3, INK)
	local nameLabel = label(plate, "Name", string.format("#%d  %s", place, entry.Name), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	nameLabel.Size = UDim2.fromScale(0.92, 0.56)
	nameLabel.Position = UDim2.fromScale(0.04, 0.05)
	textStroke(nameLabel, 2.5)
	local valueLabel = label(plate, "Value", string.format("%d st/s", entry.Value), INK, Enum.TextXAlignment.Center)
	valueLabel.Size = UDim2.fromScale(0.92, 0.36)
	valueLabel.Position = UDim2.fromScale(0.04, 0.6)
end

local function refreshPodium()
	local handles = lobby
	local folder = podiumFolder
	local speedBoard = boardByKind.Speed
	if handles == nil or folder == nil or speedBoard == nil then
		return
	end
	local users: { number } = {}
	for index = 1, 3 do
		local entry = speedBoard.Top[index]
		if entry then
			table.insert(users, entry.UserId)
		end
	end
	local same = #users == #podiumUsers
	if same then
		for index, userId in users do
			if podiumUsers[index] ~= userId then
				same = false
			end
		end
	end
	-- таблички (значения) обновляем всегда, статуи пересоздаём, только если сменился состав
	if not same then
		podiumGeneration += 1
	end
	for _, child in folder:GetChildren() do
		if child.Name:sub(1, 9) == "Nameplate" or not same then
			child:Destroy()
		end
	end
	for place = 1, 3 do
		local entry = speedBoard.Top[place]
		local top = handles.PodiumTops[place]
		if entry and top then
			makeNameplate(place, entry, top, folder)
			if not same then
				task.spawn(makeStatue, entry.UserId, top, folder, podiumGeneration)
			end
		end
	end
	podiumUsers = users
end

-- ── Данные ──────────────────────────────────────────────────────────────────

local function liveEntries(kind: BoardKind): { [number]: Entry }
	local result: { [number]: Entry } = {}
	for _, player in Players:GetPlayers() do
		local profile = PlayerDataService.Get(player)
		if profile then
			local value = valueOf(kind, profile)
			if value > 0 then
				result[player.UserId] = {
					UserId = player.UserId,
					Name = player.DisplayName ~= "" and player.DisplayName or player.Name,
					Value = value,
				}
			end
		end
	end
	return result
end

local function rebuildTop(board: Board)
	local merged: { [number]: Entry } = {}
	for _, entry in board.Global do
		merged[entry.UserId] = entry
	end
	for userId, entry in liveEntries(board.Kind) do
		local existing = merged[userId]
		if existing == nil or entry.Value >= existing.Value then
			merged[userId] = entry
		end
	end
	local list: { Entry } = {}
	for _, entry in merged do
		table.insert(list, entry)
	end
	table.sort(list, function(a: Entry, b: Entry): boolean
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.UserId < b.UserId
	end)
	local top: { Entry } = {}
	for index = 1, math.min(BOARD_SIZE, #list) do
		top[index] = list[index]
	end
	board.Top = top
end

local function renderAll()
	for _, board in boards do
		rebuildTop(board)
		renderBoard(board)
	end
	refreshPodium()
end

local function readGlobal(board: Board)
	local store = board.Store
	if store == nil then
		return
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, BOARD_SIZE)
	end)
	if not ok or typeof(pages) ~= "Instance" then
		return
	end
	local okPage, page = pcall(function()
		return (pages :: DataStorePages):GetCurrentPage()
	end)
	if not okPage or typeof(page) ~= "table" then
		return
	end
	local entries: { Entry } = {}
	for _, item in page :: { any } do
		local userId = tonumber(item.key)
		local value = tonumber(item.value)
		if userId and value and userId > 0 then
			table.insert(entries, { UserId = userId, Name = nameFor(userId), Value = math.floor(value) })
		end
	end
	board.Global = entries
end

local function writePlayer(player: Player)
	local profile = PlayerDataService.Get(player)
	if profile == nil then
		return
	end
	for _, board in boards do
		local store = board.Store
		local value = valueOf(board.Kind, profile)
		if store and value > (board.Written[player.UserId] or 0) then
			local ok = pcall(function()
				store:UpdateAsync(tostring(player.UserId), function(old: unknown): number
					local previous = if typeof(old) == "number" then old else 0
					return math.max(previous, value)
				end)
			end)
			if ok then
				board.Written[player.UserId] = value
			end
		end
	end
end

local function openStores()
	if PlayerDataService.IsOffline() then
		return
	end
	for _, board in boards do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.StoreName)
		end)
		if ok and typeof(store) == "Instance" and store:IsA("OrderedDataStore") then
			board.Store = store
		end
	end
end

-- ── Публичное API ───────────────────────────────────────────────────────────

function LeaderboardService.GetTop(kind: BoardKind): { Entry }
	local board = boardByKind[kind]
	return if board then table.clone(board.Top) else {}
end

-- Немедленно перечитать живые значения (тесты/события сервера)
function LeaderboardService.RefreshLive()
	renderAll()
end

function LeaderboardService.Init(handles: LobbyBuilder.LobbyHandles)
	if initialized then
		return
	end
	initialized = true
	lobby = handles

	local definitions: { { Kind: BoardKind, Title: string, Unit: string, Accent: Color3, Store: string } } = {
		{ Kind = "Speed", Title = "ТОП СКОРОСТИ", Unit = "st/s", Accent = RGB(66, 136, 255), Store = "StretchPop_TopSpeed_" .. STORE_VERSION },
		{ Kind = "Combo", Title = "ТОП КОМБО", Unit = "x", Accent = RGB(255, 90, 150), Store = "StretchPop_TopCombo_" .. STORE_VERSION },
		{ Kind = "Rebirths", Title = "ТОП РЕБЁРТОВ", Unit = "★", Accent = RGB(255, 176, 30), Store = "StretchPop_Rebirths_" .. STORE_VERSION },
	}
	for _, definition in definitions do
		local board: Board = {
			Kind = definition.Kind,
			Title = definition.Title,
			Unit = definition.Unit,
			Accent = definition.Accent,
			StoreName = definition.Store,
			Store = nil,
			Global = {},
			Written = {},
			Rows = {},
			Footer = nil,
			Top = {},
		}
		local screen = handles.Boards[definition.Kind]
		if screen then
			buildBoardGui(board, screen)
		end
		table.insert(boards, board)
		boardByKind[definition.Kind] = board
	end

	local folder = Instance.new("Folder")
	folder.Name = "PodiumChampions"
	folder.Parent = handles.Model
	podiumFolder = folder

	openStores()
	renderAll()

	PlayerDataService.ProfileChanged:Connect(function()
		liveDue = os.clock() + LIVE_DEBOUNCE
	end)
	PlayerDataService.ProfileLoaded:Connect(function()
		liveDue = os.clock() + LIVE_DEBOUNCE
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		task.spawn(writePlayer, player)
		liveDue = os.clock() + LIVE_DEBOUNCE
	end)

	-- живое обновление (дешёвое, без DataStore)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if liveDue > 0 and os.clock() >= liveDue then
				liveDue = 0
				renderAll()
			end
		end
	end)

	-- глобальный цикл: запись рекордов и чтение топ-10
	task.spawn(function()
		local nextWrite = os.clock() + WRITE_INTERVAL
		while true do
			for _, board in boards do
				readGlobal(board)
			end
			renderAll()
			task.wait(READ_INTERVAL)
			if os.clock() >= nextWrite then
				nextWrite = os.clock() + WRITE_INTERVAL
				for _, player in Players:GetPlayers() do
					writePlayer(player)
				end
			end
		end
	end)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			writePlayer(player)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Профили игроков в DataStore.
-- • Сессионный замок (JobId + время) внутри записи: два сервера не перетрут прогресс друг друга.
-- • Все чтения проходят через ProfileTemplate.Sanitize (миграции + защита от битых данных).
-- • Автосейв, сохранение при выходе и в BindToClose; повторы с экспоненциальной задержкой.
-- • Studio без доступа к API / неопубликованное место → сессионный режим без сохранения (с предупреждением).
-- • Значения для клиента отдаются атрибутами Player (реплицируются автоматически) + leaderstats.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)
local ProfileTemplate = require(Shared.Data.ProfileTemplate)
local BuddyConfig = require(Shared.Config.BuddyConfig)
local Signal = require(Shared.Util.Signal)

local STORE_NAME = "StretchPop_Profiles_v1"
local SESSION_LOCK_TIMEOUT = 1800
local AUTOSAVE_INTERVAL = 75
local LOAD_ATTEMPTS = 6
local LOCK_RETRY_DELAY = 4
local SAVE_ATTEMPTS = 4
local CLOSE_SAVE_BUDGET = 25

type Session = {
	Player: Player,
	Key: string,
	Profile: Types.PlayerProfile,
	Offline: boolean,
	Released: boolean,
	Saving: boolean,
	PlayClock: number,
	Leaderstats: Folder,
	CoinsValue: IntValue,
	RebirthsValue: IntValue,
}

local PlayerDataService = {
	ProfileLoaded = Signal.new() :: Signal.Signal<Player, Types.PlayerProfile>,
	ProfileChanged = Signal.new() :: Signal.Signal<Player, Types.PlayerProfile>,
}

local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local store: DataStore? = nil
local offlineMode = false
local offlineWarned = false
local initialized = false

local function enterOfflineMode(reason: string)
	offlineMode = true
	if not offlineWarned then
		offlineWarned = true
		warn(
			"[StretchPop] DataStore недоступен ("
				.. reason
				.. "). Прогресс живёт только в этой сессии. "
				.. "Для сохранений: опубликуй место и включи Game Settings → Security → Enable Studio Access to API Services."
		)
	end
end

local function resolveStore(): DataStore?
	if offlineMode then
		return nil
	end
	if store then
		return store
	end
	if game.PlaceId == 0 then
		enterOfflineMode("место не опубликовано")
		return nil
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		return result
	end
	enterOfflineMode(tostring(result))
	return nil
end

local function syncReplicatedState(session: Session)
	local player = session.Player
	local profile = session.Profile
	local location = ProfileTemplate.GetLocation(profile, profile.ActiveLocation)
	player:SetAttribute("Coins", profile.Coins)
	player:SetAttribute("Stat_Elasticity", profile.Stats.Elasticity)
	player:SetAttribute("Stat_SpringPower", profile.Stats.SpringPower)
	player:SetAttribute("Stat_SmashMass", profile.Stats.SmashMass)
	player:SetAttribute("Glove", profile.Gloves.Equipped)
	player:SetAttribute("Location", profile.ActiveLocation)
	player:SetAttribute("LocationTier", location.Tier)
	player:SetAttribute("LocationRebirths", location.Rebirths)
	player:SetAttribute("TotalRebirths", profile.TotalRebirths)
	player:SetAttribute("TopSpeed", math.floor(profile.Records.TopSpeed))
	-- бадди за плечами видят все клиенты; множители этого же списка входят в StretchPhysics.Derive
	player:SetAttribute("EquippedBuddies", BuddyConfig.EncodeEquipped(ProfileTemplate.EquippedBuddies(profile)))
	player:SetAttribute("DataOffline", session.Offline)
	session.CoinsValue.Value = math.min(profile.Coins, 2 ^ 53)
	session.RebirthsValue.Value = profile.TotalRebirths
end

local function createLeaderstats(player: Player): (Folder, IntValue, IntValue)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder
	folder.Parent = player
	return folder, coins, rebirths
end

-- UpdateAsync с замком. Возвращает: успех, профиль (если взят), «занято другим сервером».
local function tryAcquire(dataStore: DataStore, key: string, force: boolean): (boolean, Types.PlayerProfile?, boolean, string?)
	local acquired: Types.PlayerProfile? = nil
	local lockedByOther = false
	local ok, err = pcall(function()
		dataStore:UpdateAsync(key, function(old: any)
			acquired = nil
			lockedByOther = false
			local now = os.time()
			if type(old) == "table" then
				local lock = old.Session
				if
					not force
					and type(lock) == "table"
					and lock.JobId ~= game.JobId
					and type(lock.LockedAt) == "number"
					and now - lock.LockedAt < SESSION_LOCK_TIMEOUT
				then
					lockedByOther = true
					return nil
				end
			end
			local profile = ProfileTemplate.Sanitize(if type(old) == "table" then old.Profile else nil, now)
			acquired = profile
			return {
				Profile = profile,
				Session = { JobId = game.JobId, LockedAt = now },
				SavedAt = now,
			}
		end)
	end)
	if not ok then
		return false, nil, false, tostring(err)
	end
	return true, acquired, lockedByOther, nil
end

local function loadProfile(player: Player): (Types.PlayerProfile?, boolean)
	local dataStore = resolveStore()
	if dataStore == nil then
		return ProfileTemplate.Create(os.time()), true
	end
	local key = "Player_" .. player.UserId
	local lastError = "unknown"
	for attempt = 1, LOAD_ATTEMPTS do
		if player.Parent ~= Players then
			return nil, false
		end
		local force = attempt == LOAD_ATTEMPTS
		local ok, profile, lockedByOther, err = tryAcquire(dataStore, key, force)
		if ok and profile then
			return profile, false
		end
		if ok and lockedByOther then
			lastError = "session locked by another server"
			task.wait(LOCK_RETRY_DELAY)
		else
			lastError = err or "UpdateAsync failed"
			if RunService:IsStudio() then
				enterOfflineMode(lastError)
				return ProfileTemplate.Create(os.time()), true
			end
			task.wait(math.min(2 ^ attempt, 16))
		end
	end
	warn("[StretchPop] Не удалось загрузить профиль " .. player.Name .. ": " .. lastError)
	return nil, false
end

local function saveSession(session: Session, release: boolean): boolean
	if session.Offline then
		return true
	end
	local dataStore = resolveStore()
	if dataStore == nil then
		return false
	end
	local now = os.clock()
	session.Profile.PlaySeconds += now - session.PlayClock
	session.PlayClock = now
	local snapshot = ProfileTemplate.DeepCopy(session.Profile)
	for attempt = 1, SAVE_ATTEMPTS do
		local stolen = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(session.Key, function(old: any)
				stolen = false
				if type(old) == "table" and type(old.Session) == "table" and old.Session.JobId ~= game.JobId then
					-- Замок забрал другой сервер (игрок перезашёл туда) — не затираем его свежие данные.
					stolen = true
					return nil
				end
				local record: { [string]: any } = {
					Profile = snapshot,
					SavedAt = os.time(),
				}
				if not release then
					record.Session = { JobId = game.JobId, LockedAt = os.time() }
				end
				return record
			end)
		end)
		if ok then
			if stolen then
				warn("[StretchPop] Профиль " .. session.Key .. " удерживается другим сервером, сохранение пропущено")
			end
			return not stolen
		end
		warn(string.format("[StretchPop] Сохранение %s, попытка %d: %s", session.Key, attempt, tostring(err)))
		task.wait(math.min(2 ^ attempt, 8))
	end
	return false
end

local function onPlayerAdded(player: Player)
	if sessions[player] or loading[player] then
		return
	end
	loading[player] = true
	local profile, offline = loadProfile(player)
	loading[player] = nil
	if player.Parent ~= Players then
		return
	end
	if profile == nil then
		player:Kick("STRETCH-POP: не удалось загрузить сохранение. Перезайди через минуту — прогресс в безопасности.")
		return
	end
	profile.LastJoinUnix = os.time()
	local folder, coinsValue, rebirthsValue = createLeaderstats(player)
	local session: Session = {
		Player = player,
		Key = "Player_" .. player.UserId,
		Profile = profile,
		Offline = offline,
		Released = false,
		Saving = false,
		PlayClock = os.clock(),
		Leaderstats = folder,
		CoinsValue = coinsValue,
		RebirthsValue = rebirthsValue,
	}
	sessions[player] = session
	syncReplicatedState(session)
	PlayerDataService.ProfileLoaded:Fire(player, profile)
end

local function onPlayerRemoving(player: Player)
	local session = sessions[player]
	if session == nil then
		return
	end
	sessions[player] = nil
	if session.Released then
		return
	end
	session.Released = true
	saveSession(session, true)
end

function PlayerDataService.Get(player: Player): Types.PlayerProfile?
	local session = sessions[player]
	return if session then session.Profile else nil
end

function PlayerDataService.WaitFor(player: Player, timeout: number): Types.PlayerProfile?
	local deadline = os.clock() + timeout
	while os.clock() < deadline do
		local session = sessions[player]
		if session then
			return session.Profile
		end
		if player.Parent ~= Players then
			return nil
		end
		task.wait(0.1)
	end
	local session = sessions[player]
	return if session then session.Profile else nil
end

-- Единственная точка изменения профиля: мутация → синхронизация атрибутов → событие.
function PlayerDataService.Update(player: Player, mutator: (Types.PlayerProfile) -> ()): boolean
	local session = sessions[player]
	if session == nil then
		return false
	end
	mutator(session.Profile)
	syncReplicatedState(session)
	PlayerDataService.ProfileChanged:Fire(player, session.Profile)
	return true
end

function PlayerDataService.GetLocation(profile: Types.PlayerProfile, locationId: string): Types.LocationProgress
	return ProfileTemplate.GetLocation(profile, locationId)
end

function PlayerDataService.IsOffline(): boolean
	return offlineMode
end

function PlayerDataService.Init()
	if initialized then
		return
	end
	initialized = true
	resolveStore()

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		task.spawn(onPlayerRemoving, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for _, session in sessions do
				if not session.Released and not session.Saving then
					session.Saving = true
					task.spawn(function()
						saveSession(session, false)
						session.Saving = false
					end)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, session in sessions do
			if not session.Released then
				session.Released = true
				pending += 1
				task.spawn(function()
					saveSession(session, true)
					pending -= 1
				end)
			end
			sessions[player] = nil
		end
		local deadline = os.clock() + CLOSE_SAVE_BUDGET
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · ProgressionService (сервер)
-- Прокачка трёх физических статов за монеты, покупка и экипировка перчаток, гача-капсулы
-- с бадди (вылупление, экипировка, отпуск, крафт мутаций 3 → 1), синхронизация профиля.
--
-- Каждый запрос клиента: проверка типов → лимит частоты (token bucket) → проверка профиля →
-- атомарная мутация через PlayerDataService.Update. Между проверкой баланса и списанием нет yield,
-- поэтому двойная покупка невозможна даже при залпе одинаковых запросов.
-- Цена уровня — StretchPhysics.UpgradeCost(уровень), потолок — PhysicsConfig.StatUpgrade.MaxLevel:
-- те же формулы показывает клиентский магазин, расхождений цены нет.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local GloveConfig = require(Shared.Config.GloveConfig)
local BuddyConfig = require(Shared.Config.BuddyConfig)
local ProfileTemplate = require(Shared.Data.ProfileTemplate)
local StretchPhysics = require(Shared.Physics.StretchPhysics)
local Net = require(Shared.Net)

local PlayerDataService = require(script.Parent.PlayerDataService)

local REQUEST_RATE = 6 -- запросов в секунду на игрока (прокачка + перчатки вместе)
local REQUEST_BURST = 10
local REJECT_REPLY_INTERVAL = 0.5 -- не отвечаем на флуд чаще этого (защита от усиления трафика)
local SYNC_DEBOUNCE = 0.5 -- изменения профиля копим и шлём одним снимком
local SYNC_REQUEST_COOLDOWN = 1
local HATCH_COOLDOWN = 1.1 -- анимация вылупления ~2.4 с; чаще одного открытия в секунду нельзя

type Budget = {
	Tokens: number,
	At: number,
	LastRejectReply: number,
	LastSyncRequest: number,
	LastHatch: number,
}

local ProgressionService = {}

local budgets: { [Player]: Budget } = {}
local syncDue: { [Player]: number } = {}
local initialized = false
local rng = Random.new()

local function toStatName(value: unknown): Types.StatName?
	if value == "Elasticity" then
		return "Elasticity"
	elseif value == "SpringPower" then
		return "SpringPower"
	elseif value == "SmashMass" then
		return "SmashMass"
	end
	return nil
end

local function toBuddyAction(value: unknown): Types.BuddyActionKind?
	if value == "Equip" then
		return "Equip"
	elseif value == "Unequip" then
		return "Unequip"
	elseif value == "Release" then
		return "Release"
	elseif value == "Craft" then
		return "Craft"
	end
	return nil
end

local function toGloveAction(value: unknown): Types.GloveActionKind?
	if value == "Buy" then
		return "Buy"
	elseif value == "Equip" then
		return "Equip"
	end
	return nil
end

function ProgressionService.ReadStat(stats: Types.PhysicalStats, stat: Types.StatName): number
	if stat == "Elasticity" then
		return stats.Elasticity
	elseif stat == "SpringPower" then
		return stats.SpringPower
	end
	return stats.SmashMass
end

local function writeStat(stats: Types.PhysicalStats, stat: Types.StatName, value: number)
	if stat == "Elasticity" then
		stats.Elasticity = value
	elseif stat == "SpringPower" then
		stats.SpringPower = value
	else
		stats.SmashMass = value
	end
end

local function getBudget(player: Player): Budget
	local budget = budgets[player]
	if budget == nil then
		budget = { Tokens = REQUEST_BURST, At = os.clock(), LastRejectReply = -math.huge, LastSyncRequest = -math.huge, LastHatch = -math.huge }
		budgets[player] = budget
	end
	return budget
end

-- Token bucket: true — запрос можно обрабатывать
local function allow(player: Player): boolean
	local budget = getBudget(player)
	local now = os.clock()
	budget.Tokens = math.min(REQUEST_BURST, budget.Tokens + (now - budget.At) * REQUEST_RATE)
	budget.At = now
	if budget.Tokens < 1 then
		return false
	end
	budget.Tokens -= 1
	return true
end

-- На флуд отвечаем не чаще раза в REJECT_REPLY_INTERVAL
local function mayReplyToFlood(player: Player): boolean
	local budget = getBudget(player)
	local now = os.clock()
	if now - budget.LastRejectReply < REJECT_REPLY_INTERVAL then
		return false
	end
	budget.LastRejectReply = now
	return true
end

local function isEquipped(profile: Types.PlayerProfile, uid: string): boolean
	return table.find(profile.Buddies.Equipped, uid) ~= nil
end

local function inventoryCount(profile: Types.PlayerProfile): number
	local count = 0
	for _ in profile.Buddies.Inventory do
		count += 1
	end
	return count
end

local function buddySnapshots(profile: Types.PlayerProfile): { Types.BuddySnapshot }
	local list: { Types.BuddySnapshot } = {}
	for uid, instance in profile.Buddies.Inventory do
		if BuddyConfig.Get(instance.BuddyId) then
			table.insert(list, { Uid = uid, BuddyId = instance.BuddyId, Mutation = instance.Mutation, Equipped = isEquipped(profile, uid) })
		end
	end
	-- экипированные → редкость ↓ → мутация ↓ → id → uid: стабильный порядок для витрины
	table.sort(list, function(a: Types.BuddySnapshot, b: Types.BuddySnapshot): boolean
		if a.Equipped ~= b.Equipped then
			return a.Equipped
		end
		local defA, defB = BuddyConfig.Get(a.BuddyId), BuddyConfig.Get(b.BuddyId)
		local rarityA = if defA then BuddyConfig.Rarities[defA.Rarity].Order else 0
		local rarityB = if defB then BuddyConfig.Rarities[defB.Rarity].Order else 0
		if rarityA ~= rarityB then
			return rarityA > rarityB
		end
		local mutationA, mutationB = BuddyConfig.Mutations[a.Mutation].Order, BuddyConfig.Mutations[b.Mutation].Order
		if mutationA ~= mutationB then
			return mutationA > mutationB
		end
		if a.BuddyId ~= b.BuddyId then
			return a.BuddyId < b.BuddyId
		end
		return a.Uid < b.Uid
	end)
	return list
end

function ProgressionService.BuildSnapshot(profile: Types.PlayerProfile): Types.ProfileSnapshot
	local owned: { string } = {}
	for gloveId, isOwned in profile.Gloves.Owned do
		if isOwned and GloveConfig.Exists(gloveId) then
			table.insert(owned, gloveId)
		end
	end
	table.sort(owned, function(a: string, b: string): boolean
		local priceA, priceB = GloveConfig.Get(a).Price, GloveConfig.Get(b).Price
		if priceA == priceB then
			return a < b
		end
		return priceA < priceB
	end)
	local locations: { [string]: Types.LocationProgress } = {}
	for locationId, progress in profile.Locations do
		locations[locationId] = {
			Tier = progress.Tier,
			Rebirths = progress.Rebirths,
			BestSpeed = progress.BestSpeed,
			BestCombo = progress.BestCombo,
		}
	end
	local records = profile.Records
	return {
		Coins = profile.Coins,
		Stats = {
			Elasticity = profile.Stats.Elasticity,
			SpringPower = profile.Stats.SpringPower,
			SmashMass = profile.Stats.SmashMass,
		},
		OwnedGloves = owned,
		EquippedGlove = profile.Gloves.Equipped,
		Buddies = buddySnapshots(profile),
		Records = {
			TopSpeed = records.TopSpeed,
			LongestCombo = records.LongestCombo,
			WallsSmashed = records.WallsSmashed,
			ChestsOpened = records.ChestsOpened,
			LootEarned = records.LootEarned,
			CapsulesOpened = records.CapsulesOpened,
			PinatasPopped = records.PinatasPopped,
		},
		Locations = locations,
		ActiveLocation = profile.ActiveLocation,
		TotalRebirths = profile.TotalRebirths,
		DataOffline = PlayerDataService.IsOffline(),
		ServerTime = workspace:GetServerTimeNow(),
	}
end

local function sendSnapshot(player: Player)
	syncDue[player] = nil
	local profile = PlayerDataService.Get(player)
	if profile and player.Parent == Players then
		Net.ProfileSync:FireClient(player, ProgressionService.BuildSnapshot(profile))
	end
end

local function queueSync(player: Player)
	if syncDue[player] == nil then
		syncDue[player] = os.clock() + SYNC_DEBOUNCE
	end
end

-- ── Прокачка статов ─────────────────────────────────────────────────────────

-- Возвращает (успех, причина, новый уровень). Публично — для тестов и будущих наград.
function ProgressionService.TryUpgrade(player: Player, stat: Types.StatName): (boolean, string, number)
	local profile = PlayerDataService.Get(player)
	if profile == nil then
		return false, "no_profile", 0
	end
	local level = ProgressionService.ReadStat(profile.Stats, stat)
	if level >= PhysicsConfig.StatUpgrade.MaxLevel then
		return false, "max_level", level
	end
	local cost = StretchPhysics.UpgradeCost(level)
	if profile.Coins < cost then
		return false, "not_enough_coins", level
	end
	PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
		mutable.Coins -= cost
		writeStat(mutable.Stats, stat, level + 1)
	end)
	return true, "upgraded", level + 1
end

local function onUpgradeStat(player: Player, rawStat: unknown)
	local stat = toStatName(rawStat)
	if stat == nil then
		return
	end
	if not allow(player) then
		if mayReplyToFlood(player) then
			Net.UpgradeStat:FireClient(player, stat, false, "rate_limited", -1, player:GetAttribute("Coins") or 0)
		end
		return
	end
	local accepted, reason, level = ProgressionService.TryUpgrade(player, stat)
	local profile = PlayerDataService.Get(player)
	Net.UpgradeStat:FireClient(player, stat, accepted, reason, level, if profile then profile.Coins else 0)
	if accepted then
		queueSync(player)
	end
end

-- ── Перчатки ────────────────────────────────────────────────────────────────

function ProgressionService.TryGloveAction(player: Player, action: Types.GloveActionKind, gloveId: string): (boolean, string)
	local profile = PlayerDataService.Get(player)
	if profile == nil then
		return false, "no_profile"
	end
	if not GloveConfig.Exists(gloveId) then
		return false, "unknown_glove"
	end
	local glove = GloveConfig.Get(gloveId)
	local owned = profile.Gloves.Owned[gloveId] == true
	if action == "Buy" then
		if owned then
			return false, "already_owned"
		end
		if profile.Coins < glove.Price then
			return false, "not_enough_coins"
		end
		PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
			mutable.Coins -= glove.Price
			mutable.Gloves.Owned[gloveId] = true
			mutable.Gloves.Equipped = gloveId -- купил — сразу надел
		end)
		return true, "bought"
	end
	if not owned then
		return false, "not_owned"
	end
	if profile.Gloves.Equipped ~= gloveId then
		PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
			mutable.Gloves.Equipped = gloveId
		end)
	end
	return true, "equipped"
end

local function onGloveAction(player: Player, rawAction: unknown, rawGloveId: unknown)
	local action = toGloveAction(rawAction)
	if action == nil or typeof(rawGloveId) ~= "string" or #rawGloveId == 0 or #rawGloveId > 32 then
		return
	end
	local gloveId: string = rawGloveId
	if not allow(player) then
		if mayReplyToFlood(player) then
			Net.GloveAction:FireClient(player, action, gloveId, false, "rate_limited")
		end
		return
	end
	local accepted, reason = ProgressionService.TryGloveAction(player, action, gloveId)
	Net.GloveAction:FireClient(player, action, gloveId, accepted, reason)
	if accepted then
		queueSync(player)
	end
end

-- ── Гача-капсулы и бадди ─────────────────────────────────────────────────────

-- Открыть капсулу: (успех, причина, выпавший бадди). Ролл — на сервере, шанс мутации растёт с тиром локации.
function ProgressionService.TryHatch(player: Player, capsuleId: string): (boolean, string, Types.BuddySnapshot?)
	local capsule = BuddyConfig.Capsules[capsuleId]
	if capsule == nil then
		return false, "unknown_capsule", nil
	end
	local profile = PlayerDataService.Get(player)
	if profile == nil then
		return false, "no_profile", nil
	end
	if inventoryCount(profile) >= BuddyConfig.MaxInventory then
		return false, "inventory_full", nil
	end
	if profile.Coins < capsule.Price then
		return false, "not_enough_coins", nil
	end
	local tier = ProfileTemplate.GetLocation(profile, profile.ActiveLocation).Tier
	local buddyId = BuddyConfig.RollBuddy(capsuleId, rng)
	local mutation = BuddyConfig.RollMutation(tier, capsuleId, rng)
	local uid = "b" .. profile.Buddies.NextUid
	local equipped = false
	PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
		mutable.Coins -= capsule.Price
		mutable.Buddies.Inventory[uid] = { BuddyId = buddyId, Mutation = mutation, Obtained = os.time() }
		mutable.Buddies.NextUid += 1
		mutable.Records.CapsulesOpened += 1
		if #mutable.Buddies.Equipped < BuddyConfig.MaxEquipped then
			table.insert(mutable.Buddies.Equipped, uid)
			equipped = true
		end
	end)
	return true, "hatched", { Uid = uid, BuddyId = buddyId, Mutation = mutation, Equipped = equipped }
end

local function handleHatch(player: Player, capsuleId: string)
	local budget = getBudget(player)
	local now = os.clock()
	if not allow(player) or now - budget.LastHatch < HATCH_COOLDOWN then
		if mayReplyToFlood(player) then
			Net.HatchCapsule:FireClient(player, capsuleId, false, "rate_limited", nil)
		end
		return
	end
	local accepted, reason, buddy = ProgressionService.TryHatch(player, capsuleId)
	if accepted then
		budget.LastHatch = now
		queueSync(player)
	end
	Net.HatchCapsule:FireClient(player, capsuleId, accepted, reason, buddy)
end

local function onHatchRequest(player: Player, rawCapsuleId: unknown)
	if typeof(rawCapsuleId) ~= "string" or BuddyConfig.Capsules[rawCapsuleId] == nil then
		return
	end
	handleHatch(player, rawCapsuleId)
end

-- (успех, причина, uid результата)
function ProgressionService.TryBuddyAction(player: Player, action: Types.BuddyActionKind, a: string, b: string?): (boolean, string, string?)
	local profile = PlayerDataService.Get(player)
	if profile == nil then
		return false, "no_profile", nil
	end
	local buddies = profile.Buddies

	if action == "Craft" then
		local mutation = BuddyConfig.ToMutation(b)
		if BuddyConfig.Get(a) == nil or mutation == nil then
			return false, "unknown_buddy", nil
		end
		local nextMutation = BuddyConfig.NextMutation(mutation)
		if nextMutation == nil then
			return false, "max_mutation", nil
		end
		-- сначала тратим неэкипированных; среди равных — самых старых по uid
		local candidates: { string } = {}
		for uid, instance in buddies.Inventory do
			if instance.BuddyId == a and instance.Mutation == mutation then
				table.insert(candidates, uid)
			end
		end
		if #candidates < BuddyConfig.CraftCount then
			return false, "not_enough_copies", nil
		end
		table.sort(candidates, function(x: string, y: string): boolean
			local ex, ey = isEquipped(profile, x), isEquipped(profile, y)
			if ex ~= ey then
				return not ex
			end
			return (tonumber(x:sub(2)) or 0) < (tonumber(y:sub(2)) or 0)
		end)
		local newUid = "b" .. buddies.NextUid
		PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
			local inventory = mutable.Buddies
			local slot: number? = nil
			for index = 1, BuddyConfig.CraftCount do
				local uid = candidates[index]
				inventory.Inventory[uid] = nil
				local position = table.find(inventory.Equipped, uid)
				if position then
					table.remove(inventory.Equipped, position)
					slot = if slot then math.min(slot, position) else position
				end
			end
			inventory.Inventory[newUid] = { BuddyId = a, Mutation = nextMutation, Obtained = os.time() }
			inventory.NextUid += 1
			if slot then
				table.insert(inventory.Equipped, math.min(slot, #inventory.Equipped + 1), newUid)
			end
		end)
		return true, "crafted", newUid
	end

	local instance = buddies.Inventory[a]
	if instance == nil then
		return false, "not_owned", nil
	end
	if action == "Equip" then
		if isEquipped(profile, a) then
			return true, "equipped", a
		end
		if #buddies.Equipped >= BuddyConfig.MaxEquipped then
			return false, "slots_full", nil
		end
		PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
			table.insert(mutable.Buddies.Equipped, a)
		end)
		return true, "equipped", a
	elseif action == "Unequip" then
		local position = table.find(buddies.Equipped, a)
		if position then
			PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
				local index = table.find(mutable.Buddies.Equipped, a)
				if index then
					table.remove(mutable.Buddies.Equipped, index)
				end
			end)
		end
		return true, "unequipped", a
	end
	-- Release: бадди уходит, игрок получает монеты
	local refund = BuddyConfig.ReleaseValue(instance.BuddyId, instance.Mutation)
	PlayerDataService.Update(player, function(mutable: Types.PlayerProfile)
		mutable.Buddies.Inventory[a] = nil
		local index = table.find(mutable.Buddies.Equipped, a)
		if index then
			table.remove(mutable.Buddies.Equipped, index)
		end
		mutable.Coins += refund
	end)
	return true, "released", a
end

local function onBuddyAction(player: Player, rawAction: unknown, rawA: unknown, rawB: unknown)
	local action = toBuddyAction(rawAction)
	if action == nil or typeof(rawA) ~= "string" or #rawA == 0 or #rawA > 32 then
		return
	end
	if rawB ~= nil and (typeof(rawB) ~= "string" or #rawB > 32) then
		return
	end
	local a: string = rawA
	local b: string? = if typeof(rawB) == "string" then rawB else nil
	if not allow(player) then
		if mayReplyToFlood(player) then
			Net.BuddyAction:FireClient(player, action, false, "rate_limited", nil)
		end
		return
	end
	local accepted, reason, uid = ProgressionService.TryBuddyAction(player, action, a, b)
	Net.BuddyAction:FireClient(player, action, accepted, reason, uid)
	if accepted then
		queueSync(player)
	end
end

-- Автоматы на Капсульной площади: подошёл, зажал E (или тапнул) — капсула открывается
function ProgressionService.BindCapsuleMachines(machines: { [string]: BasePart })
	for capsuleId, body in machines do
		local prompt = body:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Triggered:Connect(function(player: Player)
				handleHatch(player, capsuleId)
			end)
		end
	end
end

-- ── Синхронизация ───────────────────────────────────────────────────────────

local function onSyncRequest(player: Player)
	local budget = getBudget(player)
	local now = os.clock()
	if now - budget.LastSyncRequest < SYNC_REQUEST_COOLDOWN then
		queueSync(player) -- частые запросы схлопываются в один отложенный снимок
		return
	end
	budget.LastSyncRequest = now
	sendSnapshot(player)
end

function ProgressionService.Init()
	if initialized then
		return
	end
	initialized = true

	Net.UpgradeStat.OnServerEvent:Connect(onUpgradeStat)
	Net.GloveAction.OnServerEvent:Connect(onGloveAction)
	Net.ProfileSync.OnServerEvent:Connect(onSyncRequest)
	Net.HatchCapsule.OnServerEvent:Connect(onHatchRequest)
	Net.BuddyAction.OnServerEvent:Connect(onBuddyAction)

	PlayerDataService.ProfileLoaded:Connect(function(player: Player, _profile: Types.PlayerProfile)
		sendSnapshot(player)
	end)
	PlayerDataService.ProfileChanged:Connect(function(player: Player, _profile: Types.PlayerProfile)
		queueSync(player) -- лут, рекорды, ребёрты: один снимок на полсекунды, а не на каждый удар
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		budgets[player] = nil
		syncDue[player] = nil
	end)

	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for player, due in syncDue do
			if now >= due then
				sendSnapshot(player)
			end
		end
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">StretchReplicationService</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Ретрансляция визуального состояния рук/шара другим игрокам.
-- Физика и визуал считаются у каждого клиента локально; остальным нужен только факт
-- «рука прицеплена к точке X» / «игрок в режиме шара». Сервер проверяет типы, лимит частоты
-- и разумную дистанцию точки до персонажа, затем рассылает всем, кроме отправителя.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local StretchPhysics = require(Shared.Physics.StretchPhysics)
local Net = require(Shared.Net)

local MAX_POINT_DISTANCE = PhysicsConfig.GrabRange.Max + 120
local VALID_SIDES = { Left = true, Right = true, Ball = true }

type Budget = {
	Tokens: number,
	At: number,
}

local StretchReplicationService = {}

local budgets: { [Player]: Budget } = {}
local initialized = false

local function allow(player: Player): boolean
	local now = os.clock()
	local budget = budgets[player]
	if budget == nil then
		budget = { Tokens = PhysicsConfig.Validation.ArmEventsPerSecond, At = now }
		budgets[player] = budget
	end
	local rate = PhysicsConfig.Validation.ArmEventsPerSecond
	budget.Tokens = math.min(rate, budget.Tokens + (now - budget.At) * rate)
	budget.At = now
	if budget.Tokens < 1 then
		return false
	end
	budget.Tokens -= 1
	return true
end

local function onArmVisual(player: Player, side: unknown, active: unknown, point: unknown)
	if typeof(side) ~= "string" or VALID_SIDES[side] == nil then
		return
	end
	if typeof(active) ~= "boolean" then
		return
	end
	local relayPoint: Vector3? = nil
	if point ~= nil then
		if typeof(point) ~= "Vector3" or not StretchPhysics.IsFiniteVector(point, 1e6) then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - point).Magnitude > MAX_POINT_DISTANCE then
			return
		end
		relayPoint = point
	end
	if not allow(player) then
		return
	end
	for _, other in Players:GetPlayers() do
		if other ~= player then
			Net.PeerArmVisual:FireClient(other, player, side, active, relayPoint)
		end
	end
end

function StretchReplicationService.Init()
	if initialized then
		return
	end
	initialized = true
	Net.ArmVisual.OnServerEvent:Connect(onArmVisual)
	Players.PlayerRemoving:Connect(function(player)
		budgets[player] = nil
	end)
end

return StretchReplicationService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="56">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">40</float>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="57">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="58">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="59">
