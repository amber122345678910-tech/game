      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">ProfileTemplate</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Шаблон профиля и санитайзер данных из DataStore.
-- Любые данные из хранилища считаются недоверенными: каждое поле проверяется по типу и диапазону,
-- отсутствующие поля (старые версии профиля) получают значения по умолчанию — это и есть миграция.

local Shared = script.Parent.Parent
local Types = require(Shared.Types)
local GloveConfig = require(Shared.Config.GloveConfig)
local LevelConfig = require(Shared.Config.LevelConfig)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local BuddyConfig = require(Shared.Config.BuddyConfig)

local DATA_VERSION = 1
local MAX_NUMBER = 1e15

local ProfileTemplate = {
	DataVersion = DATA_VERSION,
}

local function newLocation(): Types.LocationProgress
	return { Tier = 0, Rebirths = 0, BestSpeed = 0, BestCombo = 0 }
end

function ProfileTemplate.NewLocation(): Types.LocationProgress
	return newLocation()
end

function ProfileTemplate.Create(nowUnix: number): Types.PlayerProfile
	return {
		DataVersion = DATA_VERSION,
		Coins = 0,
		Stats = { Elasticity = 0, SpringPower = 0, SmashMass = 0 },
		Gloves = {
			Owned = { [GloveConfig.DefaultGlove] = true },
			Equipped = GloveConfig.DefaultGlove,
		},
		Buddies = { Inventory = {}, Equipped = {}, NextUid = 1 },
		Locations = { [LevelConfig.DefaultLocation] = newLocation() },
		ActiveLocation = LevelConfig.DefaultLocation,
		TotalRebirths = 0,
		Records = {
			TopSpeed = 0,
			LongestCombo = 0,
			WallsSmashed = 0,
			ChestsOpened = 0,
			LootEarned = 0,
			CapsulesOpened = 0,
			PinatasPopped = 0,
		},
		FirstJoinUnix = nowUnix,
		LastJoinUnix = nowUnix,
		PlaySeconds = 0,
	}
end

local function readNumber(value: any, fallback: number, minValue: number, maxValue: number, integer: boolean): number
	if type(value) ~= "number" or value ~= value then
		return fallback
	end
	local clamped = math.clamp(value, minValue, maxValue)
	if integer then
		clamped = math.floor(clamped)
	end
	return clamped
end

local function readStat(value: any): number
	return readNumber(value, 0, 0, PhysicsConfig.StatUpgrade.MaxLevel, true)
end

function ProfileTemplate.Sanitize(raw: any, nowUnix: number): Types.PlayerProfile
	local profile = ProfileTemplate.Create(nowUnix)
	if type(raw) ~= "table" then
		return profile
	end

	profile.Coins = readNumber(raw.Coins, 0, 0, MAX_NUMBER, true)
	profile.TotalRebirths = readNumber(raw.TotalRebirths, 0, 0, MAX_NUMBER, true)
	profile.FirstJoinUnix = readNumber(raw.FirstJoinUnix, nowUnix, 0, MAX_NUMBER, true)
	profile.LastJoinUnix = nowUnix
	profile.PlaySeconds = readNumber(raw.PlaySeconds, 0, 0, MAX_NUMBER, false)

	local stats = raw.Stats
	if type(stats) == "table" then
		profile.Stats.Elasticity = readStat(stats.Elasticity)
		profile.Stats.SpringPower = readStat(stats.SpringPower)
		profile.Stats.SmashMass = readStat(stats.SmashMass)
	end

	local gloves = raw.Gloves
	if type(gloves) == "table" then
		local owned = gloves.Owned
		if type(owned) == "table" then
			for id, isOwned in owned do
				if type(id) == "string" and isOwned == true and GloveConfig.Exists(id) then
					profile.Gloves.Owned[id] = true
				end
			end
		end
		local equipped = gloves.Equipped
		if type(equipped) == "string" and profile.Gloves.Owned[equipped] then
			profile.Gloves.Equipped = equipped
		end
	end

	local locations = raw.Locations
	if type(locations) == "table" then
		for locationId, progress in locations do
			if type(locationId) == "string" and LevelConfig.Locations[locationId] ~= nil and type(progress) == "table" then
				profile.Locations[locationId] = {
					Tier = readNumber(progress.Tier, 0, 0, 10000, true),
					Rebirths = readNumber(progress.Rebirths, 0, 0, MAX_NUMBER, true),
					BestSpeed = readNumber(progress.BestSpeed, 0, 0, 100000, false),
					BestCombo = readNumber(progress.BestCombo, 0, 0, 100000, true),
				}
			end
		end
	end

	local active = raw.ActiveLocation
	if type(active) == "string" and LevelConfig.Locations[active] ~= nil then
		profile.ActiveLocation = active
	end
	if profile.Locations[profile.ActiveLocation] == nil then
		profile.Locations[profile.ActiveLocation] = newLocation()
	end

	local records = raw.Records
	if type(records) == "table" then
		profile.Records.TopSpeed = readNumber(records.TopSpeed, 0, 0, 100000, false)
		profile.Records.LongestCombo = readNumber(records.LongestCombo, 0, 0, 100000, true)
		profile.Records.WallsSmashed = readNumber(records.WallsSmashed, 0, 0, MAX_NUMBER, true)
		profile.Records.ChestsOpened = readNumber(records.ChestsOpened, 0, 0, MAX_NUMBER, true)
		profile.Records.LootEarned = readNumber(records.LootEarned, 0, 0, MAX_NUMBER, true)
		profile.Records.CapsulesOpened = readNumber(records.CapsulesOpened, 0, 0, MAX_NUMBER, true)
		profile.Records.PinatasPopped = readNumber(records.PinatasPopped, 0, 0, MAX_NUMBER, true)
	end

	-- Бадди: только известные id/мутации, потолок инвентаря, экипировка — существующие уникальные uid
	local buddies = raw.Buddies
	if type(buddies) == "table" then
		local inventory = buddies.Inventory
		local count = 0
		local highest = 0
		if type(inventory) == "table" then
			for uid, entry in inventory do
				if count >= BuddyConfig.MaxInventory then
					break
				end
				if type(uid) == "string" and #uid <= 16 and type(entry) == "table" and type(entry.BuddyId) == "string" then
					local mutation = BuddyConfig.ToMutation(entry.Mutation)
					if BuddyConfig.Get(entry.BuddyId) and mutation then
						profile.Buddies.Inventory[uid] = {
							BuddyId = entry.BuddyId,
							Mutation = mutation,
							Obtained = readNumber(entry.Obtained, nowUnix, 0, MAX_NUMBER, true),
						}
						count += 1
						local numeric = tonumber(string.match(uid, "^b(%d+)$"))
						if numeric and numeric > highest then
							highest = numeric
						end
					end
				end
			end
		end
		local equipped = buddies.Equipped
		if type(equipped) == "table" then
			local seen: { [string]: boolean } = {}
			for _, uid in equipped do
				if type(uid) == "string" and profile.Buddies.Inventory[uid] and not seen[uid] and #profile.Buddies.Equipped < BuddyConfig.MaxEquipped then
					seen[uid] = true
					table.insert(profile.Buddies.Equipped, uid)
				end
			end
		end
		profile.Buddies.NextUid = math.max(readNumber(buddies.NextUid, 1, 1, MAX_NUMBER, true), highest + 1)
	end

	return profile
end

-- Прогресс локации с гарантией существования записи.
function ProfileTemplate.GetLocation(profile: Types.PlayerProfile, locationId: string): Types.LocationProgress
	local progress = profile.Locations[locationId]
	if progress == nil then
		progress = newLocation()
		profile.Locations[locationId] = progress
	end
	return progress
end

-- Экипированные бадди профиля в формате для StretchPhysics.Derive / атрибута EquippedBuddies
function ProfileTemplate.EquippedBuddies(profile: Types.PlayerProfile): { BuddyConfig.EquippedBuddy }
	local result: { BuddyConfig.EquippedBuddy } = {}
	for _, uid in profile.Buddies.Equipped do
		local instance = profile.Buddies.Inventory[uid]
		if instance then
			table.insert(result, { BuddyId = instance.BuddyId, Mutation = instance.Mutation })
		end
	end
	return result
end

function ProfileTemplate.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, item in value :: any do
		copy[key] = ProfileTemplate.DeepCopy(item)
	end
	return (copy :: any) :: T
end

return ProfileTemplate
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Math</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Bezier</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Кривые Безье: рендер резиновых рук и дуги траектории.
-- Кубика B(t) = (1−t)³P0 + 3(1−t)²tP1 + 3(1−t)t²P2 + t³P3.

local Bezier = {}

function Bezier.Quadratic(p0: Vector3, p1: Vector3, p2: Vector3, t: number): Vector3
	local u = 1 - t
	return p0 * (u * u) + p1 * (2 * u * t) + p2 * (t * t)
end

function Bezier.Cubic(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local u = 1 - t
	local uu = u * u
	local tt = t * t
	return p0 * (uu * u) + p1 * (3 * uu * t) + p2 * (3 * u * tt) + p3 * (tt * t)
end

function Bezier.CubicDerivative(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local u = 1 - t
	return (p1 - p0) * (3 * u * u) + (p2 - p1) * (6 * u * t) + (p3 - p2) * (3 * t * t)
end

-- Деление кубики де Кастельжо в точке t.
-- Левая половина: p0, a, d, m. Правая: m, e, c, p3. Касательные в m коллинеарны (гладкий стык).
function Bezier.SplitCubic(
	p0: Vector3,
	p1: Vector3,
	p2: Vector3,
	p3: Vector3,
	t: number
): (Vector3, Vector3, Vector3, Vector3, Vector3, Vector3, Vector3)
	local a = p0:Lerp(p1, t)
	local b = p1:Lerp(p2, t)
	local c = p2:Lerp(p3, t)
	local d = a:Lerp(b, t)
	local e = b:Lerp(c, t)
	local m = d:Lerp(e, t)
	return p0, a, d, m, e, c, p3
end

-- Сегмент Эрмита (позиция + скорость на концах, длительность dt) → внутренние контрольные точки кубики.
-- Для параболы (полёт без сопротивления) результат точный, т.к. парабола — полином степени 2.
function Bezier.FromHermite(p0: Vector3, v0: Vector3, p1: Vector3, v1: Vector3, dt: number): (Vector3, Vector3)
	return p0 + v0 * (dt / 3), p1 - v1 * (dt / 3)
end

-- Точная кубика баллистической дуги p(t) = p0 + v0·t + ½·g·t² на интервале [0, duration].
function Bezier.FromBallistic(
	p0: Vector3,
	v0: Vector3,
	gravity: Vector3,
	duration: number
): (Vector3, Vector3, Vector3, Vector3)
	local p3 = p0 + v0 * duration + gravity * (0.5 * duration * duration)
	local v1 = v0 + gravity * duration
	local c1, c2 = Bezier.FromHermite(p0, v0, p3, v1, duration)
	return p0, c1, c2, p3
end

function Bezier.ApproxLength(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, samples: number): number
	local length = 0
	local previous = p0
	for i = 1, samples do
		local point = Bezier.Cubic(p0, p1, p2, p3, i / samples)
		length += (point - previous).Magnitude
		previous = point
	end
	return length
end

return Bezier
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Пружины по закону Гука: a = −k·(x − target) − c·v.
-- Используются камерой (FOV/дистанция), желе-колебаниями рук, сквош-стретчем шара и VFX,
-- а на следующем шаге — пружинным мультяшным UI.
-- Интегрирование: полунеявный Эйлер с подшагом ≤ 1/240 с (устойчиво при k·h² < 4).

local MAX_STEP = 1 / 240
local MAX_FRAME = 0.25

type NumberSpringData = {
	Position: number,
	Velocity: number,
	Target: number,
	Stiffness: number,
	Damping: number,
}

type VectorSpringData = {
	Position: Vector3,
	Velocity: Vector3,
	Target: Vector3,
	Stiffness: number,
	Damping: number,
}

local NumberSpring = {}
NumberSpring.__index = NumberSpring

local VectorSpring = {}
VectorSpring.__index = VectorSpring

export type NumberSpring = typeof(setmetatable({} :: NumberSpringData, NumberSpring))
export type VectorSpring = typeof(setmetatable({} :: VectorSpringData, VectorSpring))

-- Перевод «частота + коэффициент затухания» в (k, c) для единичной массы.
-- dampingRatio = 1 — критическое затухание, < 1 — мультяшный перелёт и дрожание.
local function fromFrequency(frequencyHz: number, dampingRatio: number): (number, number)
	local omega = 2 * math.pi * frequencyHz
	return omega * omega, 2 * dampingRatio * omega
end

function NumberSpring.new(initial: number, frequencyHz: number, dampingRatio: number): NumberSpring
	local stiffness, damping = fromFrequency(frequencyHz, dampingRatio)
	local self: NumberSpringData = {
		Position = initial,
		Velocity = 0,
		Target = initial,
		Stiffness = stiffness,
		Damping = damping,
	}
	return setmetatable(self, NumberSpring)
end

function NumberSpring.Update(self: NumberSpring, dt: number): number
	local remaining = math.clamp(dt, 0, MAX_FRAME)
	while remaining > 1e-7 do
		local h = math.min(remaining, MAX_STEP)
		local acceleration = -self.Stiffness * (self.Position - self.Target) - self.Damping * self.Velocity
		self.Velocity += acceleration * h
		self.Position += self.Velocity * h
		remaining -= h
	end
	return self.Position
end

function NumberSpring.Impulse(self: NumberSpring, velocity: number)
	self.Velocity += velocity
end

function NumberSpring.Snap(self: NumberSpring, value: number)
	self.Position = value
	self.Target = value
	self.Velocity = 0
end

function NumberSpring.SetFrequency(self: NumberSpring, frequencyHz: number, dampingRatio: number)
	self.Stiffness, self.Damping = fromFrequency(frequencyHz, dampingRatio)
end

function VectorSpring.new(initial: Vector3, frequencyHz: number, dampingRatio: number): VectorSpring
	local stiffness, damping = fromFrequency(frequencyHz, dampingRatio)
	local self: VectorSpringData = {
		Position = initial,
		Velocity = Vector3.zero,
		Target = initial,
		Stiffness = stiffness,
		Damping = damping,
	}
	return setmetatable(self, VectorSpring)
end

function VectorSpring.Update(self: VectorSpring, dt: number): Vector3
	local remaining = math.clamp(dt, 0, MAX_FRAME)
	while remaining > 1e-7 do
		local h = math.min(remaining, MAX_STEP)
		local acceleration = (self.Position - self.Target) * -self.Stiffness - self.Velocity * self.Damping
		self.Velocity += acceleration * h
		self.Position += self.Velocity * h
		remaining -= h
	end
	return self.Position
end

function VectorSpring.Impulse(self: VectorSpring, velocity: Vector3)
	self.Velocity += velocity
end

function VectorSpring.Snap(self: VectorSpring, value: Vector3)
	self.Position = value
	self.Target = value
	self.Velocity = Vector3.zero
end

return {
	Number = NumberSpring,
	Vector = VectorSpring,
	FromFrequency = fromFrequency,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Сетевые события. Сами RemoteEvent лежат в ReplicatedStorage.StretchPopNet
-- (создаются в place-файле через default.project.json, поэтому гонок «remote ещё не создан» нет).
--
-- Клиент → Сервер
--   SmashRequest(obstacleId: string, impactVelocity: Vector3, impactPoint: Vector3, impactSpeed: number, combo: number)
--   GongStrike(laneSlot: number, impactVelocity: Vector3, impactSpeed: number, combo: number)
--   ArmVisual(side: "Left"|"Right"|"Ball", active: boolean, point: Vector3?)
--   UpgradeStat(stat: StatName)                          — купить следующий уровень стата
--   GloveAction(action: "Buy"|"Equip", gloveId: string)  — купить / надеть перчатку
--   ProfileSync()                                         — запросить свежий снимок профиля
--   HatchCapsule(capsuleId: string)                       — открыть гача-капсулу за монеты
--   BuddyAction(action: "Equip"|"Unequip"|"Release"|"Craft", a: string, b: string?) — uid или (buddyId, mutation) для Craft
--   TeleportRequest(target: "Start"|"Hub")                — док «На старт» / «В хаб»
-- Сервер → Клиент
--   SmashResult(obstacleId: string, accepted: boolean, loot: number, reason: string?)
--   ObstacleSmashed(smasherUserId: number, slot: number, obstacleId: string, snapshot: SmashSnapshot, point: Vector3, velocity: Vector3)
--   GongResult(accepted: boolean, reason: string, needSpeed: number, needCombo: number, speed: number, combo: number)
--   RebirthWave(info: RebirthWaveInfo)
--   ControllerReset(target: CFrame?)
--   PeerArmVisual(player: Player, side: string, active: boolean, point: Vector3?)
--   UpgradeStat(stat: string, accepted: boolean, reason: string, level: number, coins: number)
--   GloveAction(action: string, gloveId: string, accepted: boolean, reason: string)
--   ProfileSync(snapshot: ProfileSnapshot)                — купленные перчатки, бадди, рекорды, прогресс локаций
--   HatchCapsule(capsuleId, accepted, reason, buddy: BuddySnapshot?) — результат для анимации вылупления
--   BuddyAction(action, accepted, reason, uid: string?)
--   TeleportRequest(target, accepted)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:WaitForChild("StretchPopNet")

local function remote(name: string): RemoteEvent
	local instance = folder:WaitForChild(name)
	if instance:IsA("RemoteEvent") then
		return instance
	end
	error("StretchPopNet." .. name .. " must be a RemoteEvent")
end

local Net = {
	SmashRequest = remote("SmashRequest"),
	SmashResult = remote("SmashResult"),
	ObstacleSmashed = remote("ObstacleSmashed"),
	GongStrike = remote("GongStrike"),
	GongResult = remote("GongResult"),
	RebirthWave = remote("RebirthWave"),
	ControllerReset = remote("ControllerReset"),
	ArmVisual = remote("ArmVisual"),
	PeerArmVisual = remote("PeerArmVisual"),
	UpgradeStat = remote("UpgradeStat"),
	GloveAction = remote("GloveAction"),
	ProfileSync = remote("ProfileSync"),
	HatchCapsule = remote("HatchCapsule"),
	BuddyAction = remote("BuddyAction"),
	TeleportRequest = remote("TeleportRequest"),
}

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Physics</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">PinataMotion</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Движение золотых пиньят.
-- Пиньята плывёт поперёк полосы по синусоиде от общего серверного времени
-- (workspace:GetServerTimeNow()), поэтому все клиенты рисуют её в одной точке, а сервер
-- проверяет пробитие по той же формуле. Сервер сам деталь не двигает: нет сетевого дрожания.

local PinataMotion = {}

export type MotionSpec = {
	Amplitude: number, -- полуразмах вдоль локальной X полосы, studs
	Frequency: number, -- Гц
	Phase: number, -- радианы
}

-- Смещение от базовой точки в локальных осях полосы
function PinataMotion.Offset(spec: MotionSpec, serverTime: number): Vector3
	local angle = 2 * math.pi * spec.Frequency * serverTime + spec.Phase
	return Vector3.new(spec.Amplitude * math.sin(angle), 1.6 * math.sin(angle * 2.3), 0)
end

-- Поза в момент serverTime: сдвиг + лёгкое покачивание (мультяшная «живость»)
function PinataMotion.CFrameAt(base: CFrame, spec: MotionSpec, serverTime: number): CFrame
	local angle = 2 * math.pi * spec.Frequency * serverTime + spec.Phase
	local sway = math.rad(14) * math.cos(angle)
	local wobble = math.rad(6) * math.sin(angle * 3.1)
	return base * CFrame.new(PinataMotion.Offset(spec, serverTime)) * CFrame.Angles(wobble, sway, 0)
end

-- Габарит «коридора» движения: бокс детали, растянутый на ±Amplitude по локальной X
function PinataMotion.SweepSize(size: Vector3, spec: MotionSpec): Vector3
	return size + Vector3.new(spec.Amplitude * 2, 3.2, 0)
end

-- Читает параметры движения из атрибутов детали (их ставит LevelBuilder)
function PinataMotion.FromAttributes(part: Instance): (CFrame?, MotionSpec?)
	local base = part:GetAttribute("BaseCFrame")
	local amplitude = part:GetAttribute("Amplitude")
	local frequency = part:GetAttribute("Frequency")
	local phase = part:GetAttribute("Phase")
	if typeof(base) ~= "CFrame" or typeof(amplitude) ~= "number" or typeof(frequency) ~= "number" or typeof(phase) ~= "number" then
		return nil, nil
	end
	return base, { Amplitude = amplitude, Frequency = frequency, Phase = phase }
end

return PinataMotion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">StretchPhysics</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Общая физика рогатки, резинок, отскоков и пробития.
-- Клиент использует её для симуляции и предпросмотра дуги, сервер — для валидации.
-- Одни и те же формулы на обеих сторонах = нет рассинхрона «у меня пробилось, а сервер не засчитал».

local Shared = script.Parent.Parent
local Types = require(Shared.Types)
local PhysicsConfig = require(Shared.Config.PhysicsConfig)
local GloveConfig = require(Shared.Config.GloveConfig)
local BuddyConfig = require(Shared.Config.BuddyConfig)

export type StretchParams = {
	Stiffness: number, -- k одной резинки на земле (рогатка)
	AirStiffness: number, -- k резинки в воздухе (банджи)
	MaxStretch: number, -- x_max
	GrabRange: number,
	ImpactMass: number, -- m в E = ½mv²
	FlightMass: number,
	Restitution: number, -- упругость пружинного шара
	CoinMultiplier: number, -- множитель лута от экипированных бадди
}

export type Band = {
	Anchor: Vector3,
	Rest: number,
}

local StretchPhysics = {}

local function curve(statCurve: PhysicsConfig.StatCurve, level: number): number
	return math.min(statCurve.Base + statCurve.PerLevel * math.max(level, 0), statCurve.Max)
end

-- buddies — экипированные компаньоны: их множители входят в жёсткость, ударную массу и лут
-- одинаково на клиенте (предсказание) и сервере (валидация и начисление).
function StretchPhysics.Derive(stats: Types.PhysicalStats, gloveId: string?, buddies: { BuddyConfig.EquippedBuddy }?): StretchParams
	local glove = GloveConfig.Get(gloveId)
	local coinMultiplier, impactMultiplier, springMultiplier = BuddyConfig.Multipliers(buddies)
	local stiffness = curve(PhysicsConfig.Stiffness, stats.SpringPower) * springMultiplier
	return {
		Stiffness = stiffness,
		AirStiffness = stiffness * PhysicsConfig.AirStiffnessScale,
		MaxStretch = curve(PhysicsConfig.MaxStretch, stats.Elasticity),
		GrabRange = curve(PhysicsConfig.GrabRange, stats.Elasticity),
		ImpactMass = curve(PhysicsConfig.ImpactMass, stats.SmashMass) * (1 + glove.ImpactMassBonus) * impactMultiplier,
		FlightMass = PhysicsConfig.FlightMass,
		Restitution = curve(PhysicsConfig.Restitution, stats.SpringPower),
		CoinMultiplier = coinMultiplier,
	}
end

function StretchPhysics.Gravity(): Vector3
	return Vector3.new(0, -workspace.Gravity * PhysicsConfig.FlightGravityScale, 0)
end

-- Квадратичное сопротивление воздуха: a = −c·|v|·v
function StretchPhysics.Drag(velocity: Vector3): Vector3
	return velocity * (-PhysicsConfig.AirDrag * velocity.Magnitude)
end

-- Резинка работает только на растяжение. F = k·x·û (x = d − L₀ > 0),
-- плюс радиальное демпфирование при удалении от якоря (гасит «йо-йо», не съедая тягу).
-- Возвращает силу и текущее растяжение x.
function StretchPhysics.BandForce(
	body: Vector3,
	anchor: Vector3,
	restLength: number,
	stiffness: number,
	velocity: Vector3,
	damping: number
): (Vector3, number)
	local offset = anchor - body
	local distance = offset.Magnitude
	if distance < 1e-4 then
		return Vector3.zero, 0
	end
	local stretch = distance - restLength
	if stretch <= 0 then
		return Vector3.zero, 0
	end
	local direction = offset / distance
	local force = direction * (stiffness * stretch)
	local radialSpeed = velocity:Dot(direction)
	if radialSpeed < 0 then
		force -= direction * (damping * radialSpeed)
	end
	return force, stretch
end

-- Энергия рогатки E = Σ ½·k·xᵢ² и скорость запуска v = √(2E/m) вдоль равнодействующей сил резинок.
-- Возвращает (скорость запуска, энергия, натяжение 0..1 относительно максимума для этих резинок).
function StretchPhysics.SlingshotLaunch(body: Vector3, bands: { Band }, params: StretchParams): (Vector3, number, number)
	local netForce = Vector3.zero
	local energy = 0
	local maxEnergy = 0
	for _, band in bands do
		local offset = band.Anchor - body
		local distance = offset.Magnitude
		maxEnergy += 0.5 * params.Stiffness * params.MaxStretch * params.MaxStretch
		if distance > 1e-4 then
			local stretch = math.clamp(distance - band.Rest, 0, params.MaxStretch)
			if stretch > 0 then
				netForce += (offset / distance) * (params.Stiffness * stretch)
				energy += 0.5 * params.Stiffness * stretch * stretch
			end
		end
	end
	if energy <= 0 or netForce.Magnitude < 1e-4 or maxEnergy <= 0 then
		return Vector3.zero, 0, 0
	end
	local direction = (netForce.Unit + Vector3.yAxis * PhysicsConfig.LaunchUpBias).Unit
	local speed = math.min(math.sqrt(2 * energy / params.FlightMass), PhysicsConfig.LaunchSpeedCap)
	return direction * speed, energy, math.clamp(energy / maxEnergy, 0, 1)
end

-- Максимальное растяжение среди резинок (для ограничения оттягивания).
function StretchPhysics.MaxBandStretch(body: Vector3, bands: { Band }): number
	local maxStretch = 0
	for _, band in bands do
		local stretch = (band.Anchor - body).Magnitude - band.Rest
		if stretch > maxStretch then
			maxStretch = stretch
		end
	end
	return maxStretch
end

function StretchPhysics.MaxLaunchSpeed(params: StretchParams): number
	-- две резинки на полном натяжении: v = x_max·√(2k/m)
	return math.min(params.MaxStretch * math.sqrt(2 * params.Stiffness / params.FlightMass), PhysicsConfig.LaunchSpeedCap)
end

-- Верхняя граница честной скорости: запуск, бамперы, гравитационный разгон до терминальной скорости.
function StretchPhysics.MaxPlausibleSpeed(params: StretchParams): number
	local gravity = workspace.Gravity * PhysicsConfig.FlightGravityScale
	local terminal = math.sqrt(gravity / PhysicsConfig.AirDrag)
	local candidate = math.max(StretchPhysics.MaxLaunchSpeed(params), PhysicsConfig.BouncySurfaceMaxSpeed, terminal)
	return math.min(candidate, PhysicsConfig.MaxFlightSpeed)
end

function StretchPhysics.KineticEnergy(mass: number, speed: number): number
	return 0.5 * mass * speed * speed
end

-- Прочность препятствия в тех же единицах энергии: D = ½·m_base·v_req²·множитель_тира
function StretchPhysics.DurabilityFromSpeed(requiredSpeed: number, tierMultiplier: number): number
	return 0.5 * PhysicsConfig.ImpactMass.Base * requiredSpeed * requiredSpeed * tierMultiplier
end

-- Минимальная скорость, при которой ½mv² ≥ D
function StretchPhysics.SpeedToBreak(durability: number, impactMass: number): number
	return math.sqrt(2 * durability / math.max(impactMass, 1e-3))
end

-- Эффективная скорость удара: нормальная составляющая, но не меньше 60% полной
-- (касательный удар тоже ломает, но слабее лобового).
function StretchPhysics.ImpactSpeed(velocity: Vector3, normal: Vector3): number
	return math.max(math.abs(velocity:Dot(normal)), velocity.Magnitude * 0.6)
end

function StretchPhysics.CanSmash(durability: number, impactMass: number, impactSpeed: number): boolean
	return StretchPhysics.KineticEnergy(impactMass, impactSpeed) >= durability
end

-- Отражение с сохранением импульса: касательная часть сохраняется (·tangentKeep),
-- нормальная разворачивается и масштабируется коэффициентом восстановления e.
function StretchPhysics.Reflect(velocity: Vector3, normal: Vector3, restitution: number, tangentKeep: number): Vector3
	local normalSpeed = velocity:Dot(normal)
	if normalSpeed >= 0 then
		return velocity
	end
	local normalPart = normal * normalSpeed
	local tangentPart = velocity - normalPart
	return tangentPart * tangentKeep - normalPart * restitution
end

-- Полунеявный Эйлер (симплектический): сначала скорость, потом позиция.
function StretchPhysics.Integrate(position: Vector3, velocity: Vector3, acceleration: Vector3, dt: number): (Vector3, Vector3)
	local newVelocity = velocity + acceleration * dt
	return position + newVelocity * dt, newVelocity
end

function StretchPhysics.ClampSpeed(velocity: Vector3, maxSpeed: number): Vector3
	local speed = velocity.Magnitude
	if speed > maxSpeed then
		return velocity * (maxSpeed / speed)
	end
	return velocity
end

function StretchPhysics.UpgradeCost(level: number): number
	local upgrade = PhysicsConfig.StatUpgrade
	return math.floor(upgrade.BaseCost * upgrade.CostGrowth ^ math.max(level, 0) + 0.5)
end

function StretchPhysics.IsFiniteVector(value: Vector3, limit: number): boolean
	local x, y, z = value.X, value.Y, value.Z
	return x == x and y == y and z == z and math.abs(x) < limit and math.abs(y) < limit and math.abs(z) < limit
end

return StretchPhysics
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Общие типы клиента и сервера.
-- Профиль игрока хранится в DataStore целиком (см. Shared/Data/ProfileTemplate.luau).

local BuddyConfig = require(script.Parent.Config.BuddyConfig)

export type StatName = "Elasticity" | "SpringPower" | "SmashMass"

-- Уровни физических статов (0 = базовый). Формулы перевода в физику — Shared/Physics/StretchPhysics.
export type PhysicalStats = {
	Elasticity: number, -- дальность захвата + максимальное натяжение резинки (x_max)
	SpringPower: number, -- жёсткость резинки k + упругость пружинного шара
	SmashMass: number, -- ударная масса m в E = ½·m·v² при пробитии
}

-- Прогресс одной локации (у каждого игрока своя полоса и свой тир).
export type LocationProgress = {
	Tier: number, -- 0 Classic → 1 Golden → 2 Cyber-Slime → 3+ Void (множители растут бесконечно)
	Rebirths: number, -- сколько раз в этой локации засчитан удар в Гонг Эволюции
	BestSpeed: number,
	BestCombo: number,
}

export type GloveInventory = {
	Owned: { [string]: boolean }, -- id перчатки → открыта
	Equipped: string,
}

export type LifetimeRecords = {
	TopSpeed: number,
	LongestCombo: number,
	WallsSmashed: number,
	ChestsOpened: number,
	LootEarned: number,
	CapsulesOpened: number,
	PinatasPopped: number,
}

-- Бадди в инвентаре: uid → экземпляр. Equipped — до BuddyConfig.MaxEquipped uid'ов.
export type BuddyInstance = {
	BuddyId: string,
	Mutation: BuddyConfig.Mutation,
	Obtained: number,
}

export type BuddyInventory = {
	Inventory: { [string]: BuddyInstance },
	Equipped: { string },
	NextUid: number,
}

export type PlayerProfile = {
	DataVersion: number,
	Coins: number,
	Stats: PhysicalStats,
	Gloves: GloveInventory,
	Buddies: BuddyInventory,
	Locations: { [string]: LocationProgress },
	ActiveLocation: string,
	TotalRebirths: number,
	Records: LifetimeRecords,
	FirstJoinUnix: number,
	LastJoinUnix: number,
	PlaySeconds: number,
}

export type HandSide = "Left" | "Right"
export type ObstacleKind = "Wall" | "Chest" | "Pinata"

-- Снимок разрушенного препятствия: отправляется всем клиентам для VFX,
-- потому что сама деталь в этот момент уже убрана сервером из Workspace.
export type SmashSnapshot = {
	CFrame: CFrame,
	Size: Vector3,
	Color: Color3,
	Material: Enum.Material,
	Kind: string,
}

-- Снимок профиля для клиента (ProfileSync): то, чего нет в атрибутах Player —
-- список купленных перчаток, рекорды и прогресс всех локаций.
export type BuddySnapshot = {
	Uid: string,
	BuddyId: string,
	Mutation: BuddyConfig.Mutation,
	Equipped: boolean,
}

export type ProfileSnapshot = {
	Coins: number,
	Stats: PhysicalStats,
	OwnedGloves: { string },
	EquippedGlove: string,
	Buddies: { BuddySnapshot },
	Records: LifetimeRecords,
	Locations: { [string]: LocationProgress },
	ActiveLocation: string,
	TotalRebirths: number,
	DataOffline: boolean,
	ServerTime: number,
}

export type GloveActionKind = "Buy" | "Equip"
export type BuddyActionKind = "Equip" | "Unequip" | "Release" | "Craft"

-- Описание волны перерождения, рассылаемое всем клиентам.
export type RebirthWaveInfo = {
	Slot: number,
	OwnerUserId: number,
	Tier: number,
	LaneOrigin: CFrame,
	OriginZ: number, -- локальная Z полосы, откуда стартует фронт волны (дальний конец)
	EndZ: number, -- локальная Z, где волна гаснет (за стартовой площадкой)
	Speed: number, -- studs/s вдоль полосы
	StartServerTime: number, -- workspace:GetServerTimeNow() момента старта фронта
	LaneWidth: number,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Лёгкий типизированный сигнал для связи модулей на одной стороне
-- (контроллер рогатки → HUD/аудио следующего шага). Без BindableEvent: аргументы не копируются,
-- обработчик, отключённый во время Fire, больше не вызывается, ошибки одного слушателя не ломают остальных.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, callback: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, callback: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	DisconnectAll: (self: Signal<T...>) -> (),
}

type Listener = {
	Callback: (...any) -> (),
	Connection: Connection,
}

type SignalImpl = {
	Listeners: { Listener },
}

local SignalClass = {}
SignalClass.__index = SignalClass

local ConnectionClass = {}
ConnectionClass.__index = ConnectionClass

function ConnectionClass.Disconnect(self: any)
	if not self.Connected then
		return
	end
	self.Connected = false
	local listeners: { Listener } = self._signal.Listeners
	for index, listener in listeners do
		if listener.Connection == self then
			table.remove(listeners, index)
			break
		end
	end
end

function SignalClass.Connect(self: SignalImpl, callback: (...any) -> ()): Connection
	local connection = setmetatable({ Connected = true, _signal = self }, ConnectionClass)
	table.insert(self.Listeners, { Callback = callback, Connection = (connection :: any) :: Connection })
	return (connection :: any) :: Connection
end

function SignalClass.Once(self: SignalImpl, callback: (...any) -> ()): Connection
	local connection: Connection
	connection = SignalClass.Connect(self, function(...: any)
		connection:Disconnect()
		callback(...)
	end)
	return connection
end

function SignalClass.Fire(self: SignalImpl, ...: any)
	-- Снимок списка: подписки/отписки во время рассылки не ломают итерацию.
	local snapshot = table.clone(self.Listeners)
	for _, listener in snapshot do
		if listener.Connection.Connected then
			local ok, err = pcall(listener.Callback, ...)
			if not ok then
				warn("[StretchPop.Signal] listener error: " .. tostring(err))
			end
		end
	end
end

function SignalClass.DisconnectAll(self: SignalImpl)
	for _, listener in self.Listeners do
		listener.Connection.Connected = false
	end
	table.clear(self.Listeners)
end

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	local impl: SignalImpl = { Listeners = {} }
	return (setmetatable(impl, SignalClass) :: any) :: Signal<T...>
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Visual</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ToyModels</string>
            <string name="Source"><![CDATA[--!strict
-- STRETCH-POP · Генератор мультяшных 3D-моделек из примитивов (без ассетов).
-- Используется клиентом (иконки ViewportFrame, бадди за плечами, анимация капсулы) и сервером
-- (капсулы в куполах автоматов, кубки на подиуме, деревья и облака вокруг хаба и полос).
-- Все детали — Anchored, без коллизий и запросов: это чистая декорация.

local Shared = script.Parent.Parent
local BuddyConfig = require(Shared.Config.BuddyConfig)
local GloveConfig = require(Shared.Config.GloveConfig)

export type Toy = {
	Model: Model,
	Radius: number, -- радиус описывающей сферы (для кадрирования камеры)
	Aura: Part?,
}

local RGB = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local INK = RGB(28, 32, 56)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local BALL = Enum.PartType.Ball
local BLOCK = Enum.PartType.Block
local CYLINDER = Enum.PartType.Cylinder
local WEDGE = Enum.PartType.Wedge

local ToyModels = {}

local function axisFrame(position: Vector3, direction: Vector3): CFrame
	local x = if direction.Magnitude > 1e-5 then direction.Unit else Vector3.xAxis
	local helper = if math.abs(x.Y) < 0.95 then Vector3.yAxis else Vector3.zAxis
	local z = x:Cross(helper).Unit
	local y = z:Cross(x)
	return CFrame.fromMatrix(position, x, y, z)
end
ToyModels.AxisFrame = axisFrame

local function newModel(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	return model
end

local function piece(
	model: Instance,
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	transparency: number?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Transparency = transparency or 0
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end
ToyModels.Piece = piece

-- Цилиндр от a до b
local function segment(model: Instance, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material): Part
	local direction = b - a
	return piece(model, name, CYLINDER, Vector3.new(math.max(direction.Magnitude, 0.05), thickness, thickness), axisFrame((a + b) * 0.5, direction), color, material)
end
ToyModels.Segment = segment

local function ellipsoid(model: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, transparency: number?): Part
	local part = piece(model, name, BLOCK, size, cframe, color, material, transparency)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end
ToyModels.Ellipsoid = ellipsoid

-- Все модельки строятся вокруг начала координат «с прямой осанкой». Опорную точку (pivot)
-- кладём ровно туда через PivotOffset — тогда Place/PivotTo/GetPivot работают в системе
-- координат модельки, а не в повёрнутой системе первой детали (цилиндры лежат на боку).
local function finish(model: Model, primary: BasePart, radius: number, aura: Part?): Toy
	model.PrimaryPart = primary
	primary.PivotOffset = primary.CFrame:Inverse()
	return { Model = model, Radius = radius, Aura = aura }
end

local function pivotOf(primary: BasePart): CFrame
	return primary.CFrame * primary.PivotOffset
end
ToyModels.PivotOf = pivotOf

-- ── Иконки статов ──────────────────────────────────────────────────────────

-- Elasticity: рогатка с растянутым неоновым жгутом
function ToyModels.Slingshot(bandColor: Color3): Toy
	local model = newModel("SlingshotToy")
	local wood = RGB(176, 112, 62)
	local handle = segment(model, "Handle", Vector3.new(0, -2.4, 0), Vector3.new(0, 0, 0), 0.75, wood, Enum.Material.Wood)
	local leftTip = Vector3.new(-1.25, 1.7, 0)
	local rightTip = Vector3.new(1.25, 1.7, 0)
	segment(model, "LeftProng", Vector3.zero, leftTip, 0.62, wood, Enum.Material.Wood)
	segment(model, "RightProng", Vector3.zero, rightTip, 0.62, wood, Enum.Material.Wood)
	piece(model, "Knot", BALL, Vector3.one * 0.9, CFrame.new(0, 0, 0), RGB(140, 84, 44), SMOOTH)
	piece(model, "LeftTip", BALL, Vector3.one * 0.62, CFrame.new(leftTip), bandColor, NEON)
	piece(model, "RightTip", BALL, Vector3.one * 0.62, CFrame.new(rightTip), bandColor, NEON)
	local pouch = Vector3.new(0, 0.85, 1.6)
	segment(model, "BandLeft", leftTip, pouch, 0.24, bandColor, NEON)
	segment(model, "BandRight", rightTip, pouch, 0.24, bandColor, NEON)
	piece(model, "Pouch", BALL, Vector3.one * 0.7, CFrame.new(pouch), RGB(90, 50, 30), SMOOTH)
	piece(model, "Grip", CYLINDER, Vector3.new(0.9, 0.85, 0.85), CFrame.new(0, -1.6, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(255, 90, 120), SMOOTH)
	return finish(model, handle, 3)
end

-- SpringPower: витая пружина из сегментов-цилиндров
function ToyModels.Spring(color: Color3): Toy
	local model = newModel("SpringToy")
	local turns, steps, radius, height = 4, 44, 1.05, 3.4
	local previous = Vector3.new(radius, -height / 2, 0)
	for index = 1, steps do
		local t = index / steps
		local angle = t * turns * 2 * math.pi
		local point = Vector3.new(math.cos(angle) * radius, -height / 2 + height * t, math.sin(angle) * radius)
		segment(model, "Coil" .. index, previous, point, 0.36, color, Enum.Material.Metal)
		previous = point
	end
	local bottom = piece(model, "BottomCap", CYLINDER, Vector3.new(0.3, 2.7, 2.7), CFrame.new(0, -height / 2 - 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(60, 70, 96), SMOOTH)
	piece(model, "TopCap", CYLINDER, Vector3.new(0.3, 2.7, 2.7), CFrame.new(0, height / 2 + 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(255, 214, 64), NEON)
	return finish(model, bottom, 2.6)
end

-- SmashMass: тяжёлая шипастая гиря
function ToyModels.Kettlebell(accent: Color3): Toy
	local model = newModel("KettlebellToy")
	local iron = RGB(70, 76, 98)
	local body = piece(model, "Body", BALL, Vector3.one * 3, CFrame.new(0, -0.4, 0), iron, Enum.Material.Metal)
	piece(model, "Band", CYLINDER, Vector3.new(0.42, 3.08, 3.08), CFrame.new(0, -0.4, 0) * CFrame.Angles(0, 0, math.pi / 2), accent, NEON)
	local previous = Vector3.new(1.05, 0.7, 0)
	for index = 1, 8 do
		local angle = index / 8 * math.pi
		local point = Vector3.new(math.cos(angle) * 1.05, 0.7 + math.sin(angle) * 1.15, 0)
		segment(model, "Handle" .. index, previous, point, 0.48, iron, Enum.Material.Metal)
		previous = point
	end
	for index = 1, 8 do
		local angle = index / 8 * 2 * math.pi
		local direction = Vector3.new(math.cos(angle), -0.05, math.sin(angle))
		local base = Vector3.new(0, -0.4, 0) + direction * 1.45
		local spike = piece(model, "Spike" .. index, WEDGE, Vector3.new(0.5, 0.75, 0.5), CFrame.lookAt(base, base + direction) * CFrame.Angles(-math.pi / 2, 0, 0), RGB(230, 236, 250), Enum.Material.Metal)
		spike.Name = "Spike" .. index
	end
	for _, y in { -1.95, 1.15 } do
		piece(model, "Pip", BALL, Vector3.one * 0.5, CFrame.new(0, y, 0), RGB(230, 236, 250), Enum.Material.Metal)
	end
	return finish(model, body, 2.6)
end

-- ── Перчатка ───────────────────────────────────────────────────────────────

function ToyModels.Glove(glove: GloveConfig.GloveDef): Toy
	local model = newModel("GloveToy_" .. glove.Id)
	local color, material = glove.Color, glove.Material
	local palm = ellipsoid(model, "Palm", Vector3.new(2.3, 2.1, 1.5), CFrame.new(0, 0, 0), color, material)
	for index, x in { -0.72, -0.24, 0.24, 0.72 } do
		local length = if index == 1 or index == 4 then 1.05 else 1.3
		local base = Vector3.new(x, 0.75, -0.05)
		local tip = base + Vector3.new(x * 0.12, length, -0.25)
		segment(model, "Finger" .. index, base, tip, 0.56, color, material)
		piece(model, "Tip" .. index, BALL, Vector3.one * 0.58, CFrame.new(tip), color, material)
	end
	local thumbBase = Vector3.new(-1, 0, 0)
	local thumbTip = Vector3.new(-1.55, 0.75, -0.3)
	segment(model, "Thumb", thumbBase, thumbTip, 0.62, color, material)
	piece(model, "ThumbTip", BALL, Vector3.one * 0.64, CFrame.new(thumbTip), color, material)
	piece(model, "Cuff", CYLINDER, Vector3.new(0.95, 2.1, 2.1), CFrame.new(0, -1.25, 0) * CFrame.Angles(0, 0, math.pi / 2), glove.Accent, SMOOTH)
	piece(model, "CuffStripe", CYLINDER, Vector3.new(0.22, 2.18, 2.18), CFrame.new(0, -1.1, 0) * CFrame.Angles(0, 0, math.pi / 2), color, NEON)
	piece(model, "Shine", BALL, Vector3.one * 0.42, CFrame.new(0.55, 0.35, -0.68), WHITE, SMOOTH, 0.2)
	return finish(model, palm, 2.6)
end

-- ── Бадди ──────────────────────────────────────────────────────────────────

-- Собирает фигурку по описанию формы; мутация перекрашивает тело и даёт ауру.
function ToyModels.Buddy(buddyId: string, mutation: BuddyConfig.Mutation): Toy
	local def = BuddyConfig.Buddies[buddyId] or BuddyConfig.Buddies.SlimeCube
	local mutationDef = BuddyConfig.Mutations[mutation] or BuddyConfig.Mutations.Normal
	local shape = def.Form
	local model = newModel("Buddy_" .. def.Id)

	local tint = mutationDef.Tint
	local function tone(color: Color3): Color3
		return if tint then color:Lerp(tint, mutationDef.TintAlpha) else color
	end
	local bodyColor = tone(shape.BodyColor)
	local accentColor = if mutation == "Void" then RGB(220, 110, 255) else tone(shape.AccentColor)
	local material = mutationDef.Material

	local body: Part
	local half: Vector3
	if shape.Body == "Cube" then
		body = piece(model, "Body", BLOCK, Vector3.new(2.5, 2.3, 2.5), CFrame.new(), bodyColor, material)
		half = Vector3.new(1.25, 1.15, 1.25)
	elseif shape.Body == "Egg" then
		body = ellipsoid(model, "Body", Vector3.new(2.5, 3, 2.5), CFrame.new(), bodyColor, material)
		half = Vector3.new(1.25, 1.5, 1.25)
	else
		body = piece(model, "Body", BALL, Vector3.one * 2.7, CFrame.new(), bodyColor, material)
		half = Vector3.new(1.35, 1.35, 1.35)
	end
	local front = -half.Z + 0.12
	local top = half.Y

	-- Глазки: белок, зрачок, блик
	local pupilColor = if mutation == "Void" then RGB(230, 120, 255) else RGB(20, 20, 34)
	local pupilMaterial = if mutation == "Void" or mutation == "CyberSlime" then NEON else SMOOTH
	for _, side in { -1, 1 } do
		local eye = Vector3.new(side * 0.5, 0.28, front)
		piece(model, "EyeWhite", BALL, Vector3.one * 0.78, CFrame.new(eye), WHITE, SMOOTH)
		piece(model, "Pupil", BALL, Vector3.one * 0.42, CFrame.new(eye + Vector3.new(0, -0.02, -0.25)), pupilColor, pupilMaterial)
		piece(model, "Glint", BALL, Vector3.one * 0.14, CFrame.new(eye + Vector3.new(0.1, 0.12, -0.42)), WHITE, NEON)
		piece(model, "Cheek", BALL, Vector3.one * 0.36, CFrame.new(side * 0.85, -0.18, front + 0.12), RGB(255, 140, 170), SMOOTH, 0.35)
	end
	for index = -1, 1 do
		piece(model, "Smile", BALL, Vector3.one * 0.17, CFrame.new(index * 0.17, -0.3 - (1 - math.abs(index)) * 0.08, front - 0.02), INK, SMOOTH)
	end

	-- Уши / рога
	if shape.Ears == "Cat" or shape.Ears == "Fox" then
		local big = shape.Ears == "Fox"
		for _, side in { -1, 1 } do
			local ear = piece(model, "Ear", WEDGE, if big then Vector3.new(0.35, 1.25, 0.85) else Vector3.new(0.3, 0.85, 0.7), CFrame.new(side * 0.72, top + (if big then 0.45 else 0.3), 0.1) * CFrame.Angles(0, math.pi / 2, side * 0.18), accentColor, material)
			ear.Name = "Ear"
			if big then
				piece(model, "EarTip", BALL, Vector3.one * 0.32, CFrame.new(side * 0.78, top + 1.02, 0.1), WHITE, SMOOTH)
			end
		end
	elseif shape.Ears == "Floppy" then
		for _, side in { -1, 1 } do
			ellipsoid(model, "Ear", Vector3.new(0.5, 1.4, 0.9), CFrame.new(side * 1.3, 0.25, 0.05) * CFrame.Angles(0, 0, side * 0.35), accentColor, material)
		end
	elseif shape.Ears == "Horns" then
		for _, side in { -1, 1 } do
			local base = Vector3.new(side * 0.55, top - 0.1, 0.2)
			local tip = base + Vector3.new(side * 0.35, 0.95, 0.45)
			segment(model, "Horn", base, tip, 0.36, RGB(255, 246, 220), SMOOTH)
			piece(model, "HornTip", BALL, Vector3.one * 0.3, CFrame.new(tip), RGB(255, 246, 220), SMOOTH)
		end
	end

	-- Крылья
	if shape.Wings == "Chick" then
		for _, side in { -1, 1 } do
			ellipsoid(model, "Wing", Vector3.new(0.45, 1.1, 1.2), CFrame.new(side * (half.X + 0.12), -0.1, 0.2) * CFrame.Angles(0, 0, side * 0.4), accentColor, material)
		end
	elseif shape.Wings == "Bee" then
		for _, side in { -1, 1 } do
			ellipsoid(model, "Wing", Vector3.new(0.2, 1.3, 1.6), CFrame.new(side * 0.8, top - 0.1, 0.6) * CFrame.Angles(0.5, 0, side * 0.7), RGB(220, 245, 255), Enum.Material.Glass, 0.35)
		end
	elseif shape.Wings == "Dragon" then
		for _, side in { -1, 1 } do
			for index = 1, 3 do
				local spread = 0.35 + index * 0.32
				piece(model, "WingBlade", BLOCK, Vector3.new(0.12, 0.5, 1.9 - index * 0.25), CFrame.new(side * (0.9 + index * 0.35), 0.4 + index * 0.18, 0.85) * CFrame.Angles(0.35, side * spread, side * 0.5), accentColor, material)
			end
		end
	end

	-- Хвост
	if shape.Tail == "Fluffy" then
		piece(model, "Tail", BALL, Vector3.one * 1, CFrame.new(0, -0.35, half.Z + 0.35), accentColor, material)
		piece(model, "TailTip", BALL, Vector3.one * 0.62, CFrame.new(0, -0.05, half.Z + 0.95), WHITE, SMOOTH)
	elseif shape.Tail == "Dragon" then
		local points = { Vector3.new(0, -0.6, half.Z), Vector3.new(0, -0.8, half.Z + 0.7), Vector3.new(0, -0.6, half.Z + 1.3), Vector3.new(0, -0.2, half.Z + 1.75) }
		for index = 1, #points - 1 do
			segment(model, "Tail", points[index], points[index + 1], 0.55 - index * 0.1, bodyColor, material)
		end
		piece(model, "TailSpike", WEDGE, Vector3.new(0.2, 0.5, 0.6), CFrame.new(points[#points] + Vector3.new(0, 0.2, 0.1)), accentColor, material)
	end

	-- Особенности
	if shape.Extra == "Beak" then
		piece(model, "Beak", WEDGE, Vector3.new(0.6, 0.35, 0.5), CFrame.new(0, -0.02, front - 0.2) * CFrame.Angles(0, math.pi, 0), RGB(255, 150, 40), SMOOTH)
	elseif shape.Extra == "Rocket" then
		for _, side in { -1, 1 } do
			local x = side * 0.5
			segment(model, "Jet", Vector3.new(x, -0.7, half.Z + 0.25), Vector3.new(x, 0.6, half.Z + 0.25), 0.62, RGB(210, 216, 230), Enum.Material.Metal)
			piece(model, "Flame", BALL, Vector3.new(0.5, 0.5, 0.5), CFrame.new(x, -0.95, half.Z + 0.25), RGB(255, 170, 40), NEON)
		end
	elseif shape.Extra == "Stripes" then
		for _, y in { -0.45, 0.25 } do
			piece(model, "Stripe", CYLINDER, Vector3.new(0.3, half.X * 2 + 0.06, half.Z * 2 + 0.06), CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.pi / 2), accentColor, material)
		end
		segment(model, "Stinger", Vector3.new(0, -0.9, half.Z - 0.2), Vector3.new(0, -1.1, half.Z + 0.5), 0.22, INK, SMOOTH)
	elseif shape.Extra == "Visor" then
		piece(model, "Visor", BLOCK, Vector3.new(1.7, 0.5, 0.25), CFrame.new(0, 0.3, front - 0.3), RGB(70, 240, 255), Enum.Material.Glass, 0.25)
	elseif shape.Extra == "Tentacles" then
		for index = 1, 5 do
			local angle = (index - 3) * 0.55
			local base = Vector3.new(math.sin(angle) * 0.85, -half.Y + 0.3, math.cos(angle) * 0.35)
			local previous = base
			for step = 1, 3 do
				local point = base + Vector3.new(math.sin(angle) * 0.35 * step, -0.45 * step, 0.18 * step)
				segment(model, "Tentacle", previous, point, 0.42 - step * 0.08, bodyColor, material)
				previous = point
			end
			piece(model, "Sucker", BALL, Vector3.one * 0.22, CFrame.new(previous), accentColor, NEON)
		end
	elseif shape.Extra == "Drip" then
		for index, offset in { Vector3.new(-0.9, -1.15, -0.6), Vector3.new(0.6, -1.2, -0.9), Vector3.new(1.0, -0.6, 0.7) } do
			ellipsoid(model, "Drip" .. index, Vector3.new(0.45, 0.7, 0.45), CFrame.new(offset), bodyColor, material, 0.1)
		end
	end

	local aura: Part? = nil
	if mutation ~= "Normal" then
		aura = piece(model, "Aura", BALL, Vector3.one * (math.max(half.X, half.Y) * 2 + 1.4), CFrame.new(), mutationDef.AuraColor, Enum.Material.ForceField, 0.15)
	end
	return finish(model, body, (math.max(half.X, half.Y) + 1.4) * shape.Scale, aura)
end

-- ── Капсула, монета, ракета, кубок ─────────────────────────────────────────

function ToyModels.Capsule(capsuleId: string): Toy
	local def = BuddyConfig.Capsules[capsuleId] or BuddyConfig.Capsules.Basic
	local model = newModel("Capsule_" .. def.Id)
	local glossTop = if capsuleId == "Basic" then SMOOTH else Enum.Material.Glass
	local bottom = piece(model, "Bottom", BALL, Vector3.one * 2.4, CFrame.new(0, -0.55, 0), def.BottomColor, SMOOTH)
	piece(model, "BottomBody", CYLINDER, Vector3.new(0.6, 2.4, 2.4), CFrame.new(0, -0.25, 0) * CFrame.Angles(0, 0, math.pi / 2), def.BottomColor, SMOOTH)
	piece(model, "Top", BALL, Vector3.one * 2.4, CFrame.new(0, 0.55, 0), def.TopColor, glossTop)
	piece(model, "TopBody", CYLINDER, Vector3.new(0.6, 2.4, 2.4), CFrame.new(0, 0.25, 0) * CFrame.Angles(0, 0, math.pi / 2), def.TopColor, glossTop)
	piece(model, "Band", CYLINDER, Vector3.new(0.24, 2.52, 2.52), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), WHITE, NEON)
	piece(model, "Shine", BALL, Vector3.one * 0.5, CFrame.new(-0.55, 1.05, -0.75), WHITE, SMOOTH, 0.15)
	return finish(model, bottom, 2.1)
end

function ToyModels.Coin(): Toy
	local model = newModel("CoinToy")
	local disc = piece(model, "Disc", CYLINDER, Vector3.new(0.45, 2.6, 2.6), CFrame.Angles(0, math.pi / 2, 0), RGB(255, 200, 40), Enum.Material.Foil)
	piece(model, "Inner", CYLINDER, Vector3.new(0.5, 1.8, 1.8), CFrame.Angles(0, math.pi / 2, 0), RGB(255, 236, 120), NEON)
	piece(model, "Rim", CYLINDER, Vector3.new(0.4, 2.8, 2.8), CFrame.Angles(0, math.pi / 2, 0), RGB(230, 150, 20), Enum.Material.Foil)
	return finish(model, disc, 1.6)
end

function ToyModels.Rocket(): Toy
	local model = newModel("RocketToy")
	local body = piece(model, "Body", CYLINDER, Vector3.new(2.4, 1.2, 1.2), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(248, 250, 255), SMOOTH)
	piece(model, "Nose", BALL, Vector3.one * 1.2, CFrame.new(0, 1.2, 0), RGB(255, 80, 96), SMOOTH)
	piece(model, "Window", BALL, Vector3.one * 0.55, CFrame.new(0, 0.35, -0.5), RGB(80, 220, 255), Enum.Material.Glass)
	for index = 1, 3 do
		local angle = index / 3 * 2 * math.pi
		local fin = piece(model, "Fin" .. index, WEDGE, Vector3.new(0.16, 0.9, 0.7), CFrame.Angles(0, angle, 0) * CFrame.new(0, -0.95, -0.75), RGB(255, 80, 96), SMOOTH)
		fin.Name = "Fin" .. index
	end
	piece(model, "Flame", BALL, Vector3.new(0.8, 0.8, 0.8), CFrame.new(0, -1.55, 0), RGB(255, 170, 40), NEON)
	piece(model, "FlameCore", BALL, Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, -1.75, 0), RGB(255, 250, 200), NEON)
	return finish(model, body, 2.2)
end

function ToyModels.Trophy(color: Color3): Toy
	local model = newModel("Trophy")
	local base = piece(model, "Base", BLOCK, Vector3.new(2, 0.6, 2), CFrame.new(0, -1.5, 0), RGB(54, 44, 80), SMOOTH)
	piece(model, "Plinth", BLOCK, Vector3.new(1.4, 0.4, 1.4), CFrame.new(0, -1.0, 0), color, Enum.Material.Foil)
	segment(model, "Stem", Vector3.new(0, -0.8, 0), Vector3.new(0, 0.2, 0), 0.45, color, Enum.Material.Foil)
	piece(model, "Cup", BALL, Vector3.one * 1.7, CFrame.new(0, 0.9, 0), color, Enum.Material.Foil)
	piece(model, "Rim", CYLINDER, Vector3.new(0.3, 1.85, 1.85), CFrame.new(0, 1.55, 0) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Foil)
	for _, side in { -1, 1 } do
		segment(model, "HandleTop", Vector3.new(side * 0.8, 1.35, 0), Vector3.new(side * 1.25, 1.1, 0), 0.22, color, Enum.Material.Foil)
		segment(model, "HandleBottom", Vector3.new(side * 1.25, 1.1, 0), Vector3.new(side * 0.75, 0.55, 0), 0.22, color, Enum.Material.Foil)
	end
	piece(model, "Star", BALL, Vector3.one * 0.55, CFrame.new(0, 2.0, 0), RGB(255, 250, 200), NEON)
	return finish(model, base, 2.4)
end

-- ── Декор мира ─────────────────────────────────────────────────────────────

-- Мультяшное дерево: ствол + пышная крона из сфер
function ToyModels.Tree(scale: number, trunkColor: Color3, trunkMaterial: Enum.Material, leaves: Color3, leavesMaterial: Enum.Material, rng: Random): Toy
	local model = newModel("Tree")
	local height = (6 + rng:NextNumber() * 4) * scale
	local trunk = segment(model, "Trunk", Vector3.zero, Vector3.new(0, height, 0), 1.4 * scale, trunkColor, trunkMaterial)
	local crown = Vector3.new(0, height + 1.5 * scale, 0)
	piece(model, "Crown", BALL, Vector3.one * 6 * scale, CFrame.new(crown), leaves, leavesMaterial)
	for index = 1, 4 do
		local angle = index / 4 * 2 * math.pi + rng:NextNumber() * 0.6
		local offset = Vector3.new(math.cos(angle) * 2.4, rng:NextNumber(-0.8, 1.2), math.sin(angle) * 2.4) * scale
		piece(model, "Puff" .. index, BALL, Vector3.one * (3.6 + rng:NextNumber() * 1.4) * scale, CFrame.new(crown + offset), leaves:Lerp(WHITE, 0.08 * index), leavesMaterial)
	end
	return finish(model, trunk, height + 5 * scale)
end

function ToyModels.Cloud(scale: number, color: Color3, rng: Random): Toy
	local model = newModel("Cloud")
	local core = piece(model, "Core", BALL, Vector3.one * 10 * scale, CFrame.new(), color, SMOOTH, 0.05)
	for index = 1, 5 do
		local offset = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-1.5, 2.5), rng:NextNumber(-3, 3)) * scale
		piece(model, "Puff" .. index, BALL, Vector3.one * rng:NextNumber(6, 9) * scale, CFrame.new(offset), color, SMOOTH, 0.05)
	end
	piece(model, "Base", CYLINDER, Vector3.new(4 * scale, 20 * scale, 9 * scale), CFrame.new(0, -2.5 * scale, 0) * CFrame.Angles(0, 0, math.pi / 2), color, SMOOTH, 0.05)
	return finish(model, core, 14 * scale)
end

-- Парящий островок: трава сверху, скальный «корень» снизу
function ToyModels.Island(radius: number, grass: Color3, rock: Color3, rockDark: Color3): Toy
	local model = newModel("FloatingIsland")
	local top = piece(model, "Grass", CYLINDER, Vector3.new(1.6, radius * 2, radius * 2), CFrame.new(0, -0.8, 0) * CFrame.Angles(0, 0, math.pi / 2), grass, SMOOTH)
	piece(model, "Dirt", CYLINDER, Vector3.new(3, radius * 1.9, radius * 1.9), CFrame.new(0, -3, 0) * CFrame.Angles(0, 0, math.pi / 2), rock, Enum.Material.Slate)
	piece(model, "Root1", CYLINDER, Vector3.new(4, radius * 1.4, radius * 1.4), CFrame.new(0, -6.5, 0) * CFrame.Angles(0, 0, math.pi / 2), rockDark, Enum.Material.Rock)
	piece(model, "Root2", CYLINDER, Vector3.new(4, radius * 0.8, radius * 0.8), CFrame.new(0, -10, 0) * CFrame.Angles(0, 0, math.pi / 2), rockDark, Enum.Material.Rock)
	piece(model, "Tip", BALL, Vector3.one * radius * 0.6, CFrame.new(0, -12.5, 0), rockDark, Enum.Material.Rock)
	return finish(model, top, radius + 4)
end

-- Декоративное парящее кольцо из сегментов
function ToyModels.Ring(radius: number, color: Color3, segments: number): Toy
	local model = newModel("Ring")
	local first: Part? = nil
	for index = 1, segments do
		local a0 = (index - 1) / segments * 2 * math.pi
		local a1 = index / segments * 2 * math.pi
		local p0 = Vector3.new(math.cos(a0) * radius, math.sin(a0) * radius, 0)
		local p1 = Vector3.new(math.cos(a1) * radius, math.sin(a1) * radius, 0)
		local part = segment(model, "Segment" .. index, p0, p1, 1.1, color, NEON)
		if first == nil then
			first = part
		end
	end
	local primary = first or piece(model, "Center", BALL, Vector3.one, CFrame.new(), color, NEON, 1)
	return finish(model, primary, radius + 1)
end

-- Сдвигает/поворачивает всю модельку так, что её опорная точка встаёт в cframe
-- (без Model:PivotTo — работает и вне Workspace, и в тестовом движке)
function ToyModels.Place(toy: Toy, cframe: CFrame)
	local model = toy.Model
	local primary = model.PrimaryPart
	if primary == nil then
		return
	end
	local inverse = pivotOf(primary):Inverse()
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CFrame = cframe * (inverse * descendant.CFrame)
		end
	end
end

-- Равномерно масштабирует модельку вокруг её опорной точки (Ball/Sphere-меши остаются круглыми)
function ToyModels.Scale(toy: Toy, factor: number)
	local primary = toy.Model.PrimaryPart
	if primary == nil or factor <= 0 then
		return
	end
	local pivot = pivotOf(primary)
	for _, descendant in toy.Model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local relative = pivot:ToObjectSpace(descendant.CFrame)
			descendant.Size *= factor
			descendant.CFrame = pivot * (relative - relative.Position + relative.Position * factor)
		end
	end
	primary.PivotOffset = primary.CFrame:ToObjectSpace(pivot)
	toy.Radius *= factor
end

-- Вклеивает модельку guest в host: ставит её в localCFrame относительно опоры host
-- и переносит детали внутрь host.Model (дерево на острове, капсулы в куполе и т.п.)
function ToyModels.Attach(host: Toy, guest: Toy, localCFrame: CFrame)
	local hostPrimary = host.Model.PrimaryPart
	if hostPrimary == nil then
		return
	end
	ToyModels.Place(guest, pivotOf(hostPrimary) * localCFrame)
	for _, child in guest.Model:GetChildren() do
		child.Parent = host.Model
	end
	guest.Model:Destroy()
end

-- Запоминает смещения деталей от опорной точки (для покадрового переноса через BulkMoveTo:
-- part[i].CFrame = pivot * offsets[i])
function ToyModels.Offsets(toy: Toy): ({ BasePart }, { CFrame })
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local primary = toy.Model.PrimaryPart
	if primary == nil then
		return parts, offsets
	end
	local inverse = pivotOf(primary):Inverse()
	for _, descendant in toy.Model:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
			table.insert(offsets, inverse * descendant.CFrame)
		end
	end
	return parts, offsets
end

return ToyModels
]]></string>
