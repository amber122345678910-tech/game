{
  "name": "RyuVsYuta",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Cutscene": {
        "$path": "src/shared"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
