--!strict
-- Расстановка в мире (студы, земля Y = 0). Те же числа использует строитель окружения.

local Layout = {}

-- Рика и Юта медленно выходят из дыма в сторону -Z (к камере кадра A).
-- Юта идёт перед животом Рики, между её рук: ~0.9 стада правее её оси (в кадре) и на 1.3 ближе к камере.
Layout.rikaFrom = Vector3.new(0, 0, 63)
Layout.rikaTo = Vector3.new(0, 0, 47)
Layout.yutaFrom = Vector3.new(-0.9, 0, 61.7)
Layout.yutaTo = Vector3.new(-0.9, 0, 45.7)

-- Рю стоит на плите поверх обрушенного здания, лицом к +Z (туда, откуда идут Рика и Юта)
Layout.ryuSpot = Vector3.new(0, 30, -120)
Layout.ryuFacing = CFrame.Angles(0, math.pi, 0) -- по умолчанию модели смотрят в -Z

-- Желаемое направление НА солнце (свет на Рю спереди-сверху; в кадре A — контровой свет сквозь туман)
Layout.sunDirection = Vector3.new(0.35, 0.78, 0.52).Unit

return Layout
